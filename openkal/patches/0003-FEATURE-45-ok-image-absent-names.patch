@@ -826,10 +912,16 @@ buildModuleInWorker(const CompilerInvocation &Invocation,
     if (auto Error = (*Unit)->retainImplicitOutputs())
       return std::move(Error);
   Success = true;
-  return std::optional<ModuleBuildWorkerResult>(
-      {std::chrono::duration_cast<std::chrono::milliseconds>(
-           std::chrono::steady_clock::now() - Started),
-       Child.Statistics});
+  ModuleBuildWorkerResult Result{
+      std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::steady_clock::now() - Started),
+      Child.Statistics};
+#if defined(__OPENKAL__)
+  Result.AbsentNames = recordedAbsentNames(
+      llvm::sys::path::parent_path(Path("request.json")), Options.UnitRoot,
+      BeganNs);
+#endif
+  return std::optional<ModuleBuildWorkerResult>(std::move(Result));
 }
 
