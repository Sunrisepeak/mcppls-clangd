diff --git a/clang-tools-extra/clangd/ModulesBuilder.cpp b/clang-tools-extra/clangd/ModulesBuilder.cpp
index b7d2b243c..0a1aa734b 100644
--- a/clang-tools-extra/clangd/ModulesBuilder.cpp
+++ b/clang-tools-extra/clangd/ModulesBuilder.cpp
@@ -1262,10 +1262,114 @@ bool readModuleFileForValidation(
   return Success;
 }
 
+#if defined(__OPENKAL__)
+// THE NAMES A WORKER FOUND ABSENT ARE ABSENT STILL (openkal 0.23,
+// KAL_DIR_RECORDED; ModuleBuildWorker.cpp records them). clang validates the
+// inputs a BMI was built from, and nothing else: a header created since,
+// earlier on the search path than the one the BMI read, is not one of them,
+// and a BMI that would now include another header was reused. The names sit
+// beside the BMI (`<bmi>.inputs'), written before it is published. A
+// directory last changed before the worker began has had no name added since,
+// so a name is asked about only where its directory changed --- a few
+// directories for a module, not each name its search missed. A check that
+// held is not repeated within the recheck interval while no change is
+// reported, as clang's validation verdicts are not (ModuleInputSources.h).
+std::string absentNamesFile(PathRef ModuleFilePath) {
+  return (ModuleFilePath + ".inputs").str();
+}
+
+void publishAbsentNames(PathRef ModuleFilePath, llvm::StringRef Names) {
+  const std::string Published = absentNamesFile(ModuleFilePath);
+  if (Names.empty()) {
+    // A BMI built without a record has none: an earlier build's would
+    // describe another build.
+    llvm::sys::fs::remove(Published);
+    return;
+  }
+  const std::string Staged = Published + ".staged";
+  {
+    std::error_code EC;
+    llvm::raw_fd_ostream Out(Staged, EC);
+    if (EC)
+      return;
+    Out << Names;
+  }
+  if (llvm::sys::fs::rename(Staged, Published))
+    llvm::sys::fs::remove(Staged);
+}
+
+bool absentNamesHold(PathRef ModuleFilePath, std::string *Why) {
+  const std::string File = absentNamesFile(ModuleFilePath);
+  llvm::sys::fs::file_status Status;
+  if (llvm::sys::fs::status(File, Status))
+    return true;
+  struct Held {
+    uint64_t Size = 0;
+    llvm::sys::TimePoint<> ModTime;
+    RecentInputCheck Check;
+  };
+  static std::mutex Mutex;
+  static llvm::StringMap<Held> Checks;
+  const uint64_t Epoch = ModuleInputSources::currentInputEpoch();
+  RecentInputCheck Check;
+  {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    auto &Entry = Checks[File];
+    if (Entry.Size != Status.getSize() ||
+        Entry.ModTime != Status.getLastModificationTime())
+      Entry = Held{Status.getSize(), Status.getLastModificationTime(), {}};
+    else if (Entry.Check.holds(Epoch))
+      return true;
+    Check = Entry.Check;
+  }
+  auto Buffer = llvm::MemoryBuffer::getFile(File);
+  if (!Buffer)
+    return true;
+  llvm::SmallVector<llvm::StringRef> Entries;
+  (*Buffer)->getBuffer().split(Entries, '\0', -1, /*KeepEmpty=*/false);
+  int64_t BeganNs = 0;
+  if (Entries.empty() || !Entries.front().consume_front("t") ||
+      Entries.front().getAsInteger(10, BeganNs))
+    return true;
+  // Two seconds: the coarsest time of change a volume keeps.
+  const int64_t Slack = 2'000'000'000;
+  llvm::StringMap<std::vector<llvm::StringRef>> ByDirectory;
+  for (llvm::StringRef Entry : llvm::drop_begin(Entries))
+    if (Entry.consume_front("a"))
+      ByDirectory[llvm::sys::path::parent_path(Entry)].push_back(Entry);
+  for (const auto &Directory : ByDirectory) {
+    llvm::sys::fs::file_status DirectoryStatus;
+    if (llvm::sys::fs::status(Directory.getKey(), DirectoryStatus))
+      continue;   // absent, and its names with it
+    const int64_t Changed =
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            DirectoryStatus.getLastModificationTime().time_since_epoch())
+            .count();
+    if (Changed + Slack < BeganNs)
+      continue;
+    for (llvm::StringRef Name : Directory.getValue())
+      if (llvm::sys::fs::exists(Name)) {
+        if (Why)
+          *Why = llvm::formatv("{0} was absent when the module was built, and "
+                               "is present now",
+                               Name)
+                     .str();
+        return false;
+      }
+  }
+  Check.held(Epoch);
+  return true;
+}
+#endif
+
 bool IsModuleFileUpToDate(PathRef ModuleFilePath,
                           const PrerequisiteModules &RequisiteModules,
                           llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> VFS,
