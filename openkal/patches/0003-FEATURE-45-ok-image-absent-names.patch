 clang-tools-extra/clangd/ModuleBuildWorker.h  |   5 +
 .../clangd/ModuleBuildWorkerStorage.cpp       |  13 ++-
 clang-tools-extra/clangd/ModulesBuilder.cpp   | 108 ++++++++++++++++++
 5 files changed, 233 insertions(+), 6 deletions(-)

