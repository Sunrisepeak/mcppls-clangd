+#if defined(__OPENKAL__)
+// WHAT A WORKER REACHED OF ITS DIRECTORIES (openkal 0.23, KAL_DIR_RECORDED).
+// A worker records each directory it holds, at its own request
+// (okm_preopen_attenuate, openkal-musl 0.27.0), in `inputs-<n>' of its unit,
+// headed by the directory's name: `g<name>\0', then what the implementation
+// appends, `<kind><name beneath>\0', and `e\0' when the worker ends. A
+// directory whose volume does not record keeps its handle, and its record has
+// no end.
+static void recordHeldDirectories(llvm::StringRef UnitDirectory) {
+  const kal_uintptr Count = kal_fs_preopen_count();
+  for (kal_uintptr I = 0; I < Count; ++I) {
+    kal_dir Dir{};
+    char Name[4096];
+    kal_uintptr Length = 0;
+    if (kal_fs_preopen(I, &Dir, Name, sizeof(Name) - 1, &Length) != kal_ok ||
+        Length >= sizeof(Name) - 1)
+      continue;
+    Name[Length] = '\0';
+    llvm::SmallString<256> Record(UnitDirectory);
+    llvm::sys::path::append(Record, "inputs-" + std::to_string(I));
+    {
+      std::error_code EC;
+      llvm::raw_fd_ostream Heading(Record, EC);
+      if (EC)
+        continue;
+      Heading << 'g' << llvm::StringRef(Name, Length) << '\0';
+    }
+    (void)okm_preopen_attenuate(Name, KAL_DIR_RECORDED, Record.c_str());
+  }
+}
+
+// The names an ended worker asked about and found absent, from its complete
+// records, made absolute; those beneath the units' root are its own. The list
+// is `t<ns>\0' --- the wall time before the worker started --- then
+// `a<name>\0' for each name. Empty where nothing was recorded. A name the
+// worker read is an input of the BMI, which clang validates (size, time and
+// content) before the BMI is used; a name it found absent is not, and a header
+// created since, earlier on the search path, is what clang's validation does
+// not see.
+static std::string recordedAbsentNames(llvm::StringRef UnitDirectory,
+                                       llvm::StringRef UnitRoot,
+                                       int64_t BeganNs) {
+  std::string Out;
+  std::error_code EC;
+  for (llvm::sys::fs::directory_iterator It(UnitDirectory, EC), End;
+       It != End && !EC; It.increment(EC)) {
+    if (!llvm::sys::path::filename(It->path()).starts_with("inputs-"))
+      continue;
+    auto Buffer = llvm::MemoryBuffer::getFile(It->path());
+    if (!Buffer)
+      continue;
+    llvm::SmallVector<llvm::StringRef> Entries;
+    (*Buffer)->getBuffer().split(Entries, '\0', -1, /*KeepEmpty=*/false);
+    if (Entries.empty() || !Entries.front().consume_front("g") ||
+        llvm::find(Entries, "e") == Entries.end())
+      continue;
+    const llvm::StringRef Granted = Entries.front();
+    for (llvm::StringRef Entry : llvm::drop_begin(Entries)) {
+      if (!Entry.consume_front("a"))
+        continue;
+      llvm::SmallString<256> Name(Granted);
+      llvm::sys::path::append(Name, Entry);
+      const std::string Normal = ModuleInputSources::normalized(Name, "");
+      if (Normal.empty() ||
+          llvm::StringRef(Normal).starts_with(
+              ModuleInputSources::normalized(UnitRoot, "")))
+        continue;
+      Out += 'a';
+      Out += Normal;
+      Out += '\0';
+    }
+  }
+  if (Out.empty())
+    return Out;
+  return "t" + std::to_string(BeganNs) + '\0' + Out;
+}
+#endif
+
