+/// Keeps the first problem a read of a module file reports, formatted: what
+/// made a BMI stale ("file 'x.h' has been modified since the module file was
+/// built: content changed"), for the log line that says why it is rebuilt.
+class FirstProblemConsumer : public DiagnosticConsumer {
+public:
+  std::string First;
+  void HandleDiagnostic(DiagnosticsEngine::Level Level,
+                        const clang::Diagnostic &Info) override {
+    DiagnosticConsumer::HandleDiagnostic(Level, Info);
+    if (Level < DiagnosticsEngine::Warning || !First.empty())
+      return;
+    llvm::SmallString<256> Message;
+    Info.FormatDiagnostic(Message);
+    First = Message.str().str();
+  }
+};
