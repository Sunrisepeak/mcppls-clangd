+  bool TallyBuilt = false;   // compiled (or tried to)
+  bool TallyOk = false;      // and published
+  llvm::scope_exit TallyOne([&] {
+    PrerequisiteTally *const *Tally = Context::current().get(PrerequisiteTallyKey);
+    if (!Tally || !*Tally)
