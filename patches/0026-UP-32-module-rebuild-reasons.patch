+bool IsModuleFileUpToDate(PathRef ModuleFilePath,
+                          const PrerequisiteModules &RequisiteModules,
+                          llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> VFS,
+                          std::string *Why = nullptr) {
+  // Validating a BMI re-hashes all its inputs; the preamble redoes it for
+  // every request reusing the same prerequisite modules. A memoized verdict
+  // (keyed by the BMI, the dependency chain, and the input identities the
+  // validation read) turns that into a handful of stats. Any doubt falls
+  // back to the full validation below.
+  std::string ChainKey;
+  RequisiteModules.getValidationChainKey(ChainKey);
+  ModuleValidationCache &ValidationCache = getModuleValidationCache();
+  if (ValidationCache.isFresh(ModuleFilePath, ChainKey, *VFS)) {
+    log("Module file {0} is up to date via the validation cache",
+        ModuleFilePath);
+    return true;
+  }
+
+  // ARR_OutOfDate: a modified input makes ReadAST return OutOfDate instead
+  // of failing, and reports nothing; ReadAST validates every input itself.
+  clang::clangd::IgnoreDiagnostics IgnoreDiags;
+  if (readModuleFileForValidation(ModuleFilePath, RequisiteModules, VFS,
+                                  IgnoreDiags, /*Complain=*/false,
+                                  &ValidationCache, ChainKey))
+    return true;
+  if (Why) {
+    // Only on the way to a rebuild, which costs far more than this second
+    // read: the same validation, reporting, so the log can say what changed.
+    FirstProblemConsumer Problem;
+    (void)readModuleFileForValidation(ModuleFilePath, RequisiteModules, VFS,
+                                      Problem, /*Complain=*/true, nullptr, "");
+    *Why = Problem.First.empty() ? "the module file could not be validated"
+                                 : Problem.First;
+  }
+  return false;
+}
