+/// Why a module has no reusable BMI under its directory: never built with
+/// this command and these prerequisites, or built only with others (their
+/// count says how often the inputs that key the BMI changed).
+std::string missingModuleFileReason(PathRef PublishedModuleFilePath) {
+  llvm::SmallString<256> Directory(PublishedModuleFilePath);
+  llvm::sys::path::remove_filename(Directory);   // .../<command-hash>[/chain]
+  llvm::StringRef Leaf = llvm::sys::path::filename(Directory);
+  if (Leaf.starts_with("producer-chain-v2-"))
+    llvm::sys::path::remove_filename(Directory);
+  llvm::StringRef Mine = llvm::sys::path::filename(Directory);
+  llvm::SmallString<256> Source(Directory);
+  llvm::sys::path::remove_filename(Source);       // .../<source>-<hash>
+  unsigned Others = 0;
+  std::error_code EC;
+  for (llvm::sys::fs::directory_iterator It(Source, EC), End; It != End && !EC;
+       It.increment(EC))
+    if (llvm::sys::path::filename(It->path()) != Mine)
+      ++Others;
+  if (Others == 0)
+    return "no BMI was built for it before";
+  return llvm::formatv("no BMI for this command and these prerequisites ({0} "
+                       "built with other commands or prerequisites)",
+                       Others)
+      .str();
+}
