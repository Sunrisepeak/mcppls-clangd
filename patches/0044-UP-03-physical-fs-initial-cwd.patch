From 829b8adac82ffc8e5baca9dba6b90f48ad235a32 Mon Sep 17 00:00:00 2001
From: Sunrisepeak <speakshen@163.com>
Date: Wed, 4 Nov 2026 18:27:19 +0900
Subject: [PATCH] [Support][clangd] Initialize physical views at the requested
 working directory

A module scan asks for an independent filesystem view and immediately sets its command directory. Initializing the view from the process directory first repeats metadata and canonical-path queries for every scan, including memo hits.

Provide a checked absolute-directory factory and forward the requested directory through real and request-overlay views. Preserve ordinary creation and custom filesystem fallback, independent views, volatile reads and all module validation.

Co-authored-by: speak-agent <248744407+speak-agent@users.noreply.github.com>
---
 clang-tools-extra/clangd/ModulesBuilder.cpp   | 12 ++++-
 .../clangd/support/ThreadsafeFS.cpp           | 13 +++++
 .../clangd/support/ThreadsafeFS.h             |  9 +++-
 .../clangd/unittests/FSTests.cpp              | 36 +++++++++++++
 llvm/include/llvm/Support/VirtualFileSystem.h |  8 +++
 llvm/lib/Support/VirtualFileSystem.cpp        | 22 ++++++++
 .../Support/VirtualFileSystemTest.cpp         | 54 +++++++++++++++++++
 7 files changed, 152 insertions(+), 2 deletions(-)

diff --git a/clang-tools-extra/clangd/ModulesBuilder.cpp b/clang-tools-extra/clangd/ModulesBuilder.cpp
index 0a1aa734b..e8010d9da 100644
--- a/clang-tools-extra/clangd/ModulesBuilder.cpp
+++ b/clang-tools-extra/clangd/ModulesBuilder.cpp
@@ -88,8 +88,18 @@ public:
 
 private:
   llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const override {
+    return withMainFile(Base.view(std::nullopt));
+  }
+
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+  viewWithCWDImpl(PathRef CWD) const override {
+    return withMainFile(Base.view(CWD));
+  }
+
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+  withMainFile(llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> FS) const {
     auto Overlay = llvm::makeIntrusiveRefCnt<llvm::vfs::OverlayFileSystem>(
-        Base.view(std::nullopt));
+        std::move(FS));
     auto Main = llvm::makeIntrusiveRefCnt<llvm::vfs::InMemoryFileSystem>();
     // DependencyScanningService keeps borrowed VFS buffers across worker
     // views. Back this buffer with the request-owned string, whose lifetime
diff --git a/clang-tools-extra/clangd/support/ThreadsafeFS.cpp b/clang-tools-extra/clangd/support/ThreadsafeFS.cpp
index 7398e4258..8fee03acf 100644
--- a/clang-tools-extra/clangd/support/ThreadsafeFS.cpp
+++ b/clang-tools-extra/clangd/support/ThreadsafeFS.cpp
@@ -73,6 +73,11 @@ private:
 
 llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
 ThreadsafeFS::view(PathRef CWD) const {
+  return viewWithCWDImpl(CWD);
+}
+
+llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+ThreadsafeFS::viewWithCWDImpl(PathRef CWD) const {
   auto FS = view(std::nullopt);
   if (auto EC = FS->setCurrentWorkingDirectory(CWD))
     elog("VFS: failed to set CWD to {0}: {1}", CWD, EC.message());
@@ -86,5 +91,13 @@ RealThreadsafeFS::viewImpl() const {
   //        propagation of the 'isVolatile' flag through all layers.
   return new VolatileFileSystem(llvm::vfs::createPhysicalFileSystem());
 }
+
+llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+RealThreadsafeFS::viewWithCWDImpl(PathRef CWD) const {
+  if (auto FS = llvm::vfs::createPhysicalFileSystem(CWD))
+    return new VolatileFileSystem(std::move(*FS));
+  // Invalid or relative directories retain the existing fallback and log.
+  return ThreadsafeFS::viewWithCWDImpl(CWD);
+}
 } // namespace clangd
 } // namespace clang
diff --git a/clang-tools-extra/clangd/support/ThreadsafeFS.h b/clang-tools-extra/clangd/support/ThreadsafeFS.h
index 939747214..9480e9814 100644
--- a/clang-tools-extra/clangd/support/ThreadsafeFS.h
+++ b/clang-tools-extra/clangd/support/ThreadsafeFS.h
@@ -54,11 +54,16 @@ public:
   /// returns the FS anyway.
   llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> view(PathRef CWD) const;
 
-private:
+protected:
   /// Overridden by implementations to provide a vfs::FileSystem.
   /// This is distinct from view(NoneType) to avoid GCC's -Woverloaded-virtual.
   virtual llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const = 0;
 
+  /// An implementation may initialize a view directly at the requested CWD.
+  /// The default retains the ordinary view and set-CWD behavior.
+  virtual llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+  viewWithCWDImpl(PathRef CWD) const;
+
 public:
   // nullopt means this view cannot be faithfully exported to a disk-based
   // compiler worker. It does not authorize replacing the view with real disk.
@@ -77,6 +82,8 @@ public:
 
 private:
   llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const override;
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+  viewWithCWDImpl(PathRef CWD) const override;
 };
 
 } // namespace clangd
