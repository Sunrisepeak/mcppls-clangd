diff --git a/llvm/unittests/Support/VirtualFileSystemTest.cpp b/llvm/unittests/Support/VirtualFileSystemTest.cpp
index 507a0e410..280b412fc 100644
--- a/llvm/unittests/Support/VirtualFileSystemTest.cpp
+++ b/llvm/unittests/Support/VirtualFileSystemTest.cpp
@@ -475,7 +475,57 @@ TEST(VirtualFileSystemTest, BasicRealFSIteration) {
   EXPECT_EQ(vfs::directory_iterator(), I);
 }
 
+TEST(VirtualFileSystemTest, PhysicalFileSystemInitialWorkingDirectory) {
+  TempDir Root("initial-cwd", /*Unique=*/true);
+  TempDir ADir(Root.path("a"));
+  TempDir BDir(Root.path("b"));
+  TempFile AA(ADir.path("value"), "", "aaaa");
+  TempFile BB(BDir.path("value"), "", "bbbb");
+  SmallString<128> Before, After;
+  ASSERT_FALSE(sys::fs::current_path(Before));
+  auto A = vfs::createPhysicalFileSystem(ADir.path());
+  auto B = vfs::createPhysicalFileSystem(BDir.path());
+  ASSERT_TRUE(A);
+  ASSERT_TRUE(B);
+  EXPECT_EQ(ADir.path(), *(*A)->getCurrentWorkingDirectory());
+  EXPECT_EQ(BDir.path(), *(*B)->getCurrentWorkingDirectory());
+  auto ABuffer = (*A)->getBufferForFile("value");
+  auto BBuffer = (*B)->getBufferForFile("value");
+  ASSERT_TRUE(ABuffer);
+  ASSERT_TRUE(BBuffer);
+  EXPECT_EQ("aaaa", (*ABuffer)->getBuffer());
+  EXPECT_EQ("bbbb", (*BBuffer)->getBuffer());
+  ASSERT_FALSE((*A)->setCurrentWorkingDirectory(BDir.path()));
+  EXPECT_EQ(BDir.path(), *(*B)->getCurrentWorkingDirectory());
+  ASSERT_FALSE(sys::fs::current_path(After));
+  EXPECT_EQ(Before, After);
+}
+
+TEST(VirtualFileSystemTest, PhysicalFileSystemInitialWorkingDirectoryErrors) {
+  TempDir Root("initial-cwd-errors", /*Unique=*/true);
+  TempFile File(Root.path("file"), "", "contents");
+  auto Relative = vfs::createPhysicalFileSystem(".");
+  EXPECT_EQ(errc::invalid_argument, Relative.getError());
+  auto Missing = vfs::createPhysicalFileSystem(Root.path("missing"));
+  EXPECT_EQ(errc::no_such_file_or_directory, Missing.getError());
+  auto NotDirectory = vfs::createPhysicalFileSystem(File.path());
+  EXPECT_EQ(errc::not_a_directory, NotDirectory.getError());
+}
+
 #ifdef LLVM_ON_UNIX
+TEST(VirtualFileSystemTest, PhysicalFileSystemInitialSymlinkDirectory) {
+  TempDir Root("initial-cwd-link", /*Unique=*/true);
+  TempDir Real(Root.path("real"));
+  TempLink Link(Real.path(), Root.path("link"));
+  TempFile File(Real.path("value"), "", "contents");
+  auto FS = vfs::createPhysicalFileSystem(Link.path());
+  ASSERT_TRUE(FS);
+  EXPECT_EQ(Link.path(), *(*FS)->getCurrentWorkingDirectory());
+  SmallString<128> Resolved;
+  ASSERT_FALSE((*FS)->getRealPath("value", Resolved));
+  EXPECT_EQ(File.path(), Resolved);
+}
+
