diff --git a/llvm/include/llvm/Support/VirtualFileSystem.h b/llvm/include/llvm/Support/VirtualFileSystem.h
index d22c53422..0c5e8ccc2 100644
--- a/llvm/include/llvm/Support/VirtualFileSystem.h
+++ b/llvm/include/llvm/Support/VirtualFileSystem.h
@@ -383,6 +383,14 @@ LLVM_ABI IntrusiveRefCntPtr<FileSystem> getRealFileSystem();
 /// This may only be called outside the IO sandbox.
 LLVM_ABI std::unique_ptr<FileSystem> createPhysicalFileSystem();
 
+/// Create an independent real file system directly at an absolute directory.
+/// The specified directory is checked and its symlinks are resolved, without
+/// first querying the process's working directory. Returns an error if the
+/// directory is relative, absent, or cannot be used as a working directory.
+/// This may only be called outside the IO sandbox.
+LLVM_ABI ErrorOr<std::unique_ptr<FileSystem>>
+createPhysicalFileSystem(const Twine &WorkingDirectory);
+
 /// A file system that allows overlaying one \p AbstractFileSystem on top
 /// of another.
 ///
diff --git a/llvm/lib/Support/VirtualFileSystem.cpp b/llvm/lib/Support/VirtualFileSystem.cpp
index 42e8bb4f9..f9985f2fd 100644
--- a/llvm/lib/Support/VirtualFileSystem.cpp
+++ b/llvm/lib/Support/VirtualFileSystem.cpp
@@ -286,6 +286,17 @@ public:
     }
   }
 
+  RealFileSystem(const Twine &InitialCWD, std::error_code &EC) {
+    // Engage the independent-directory state without inheriting the process
+    // directory. An absolute name needs no previous directory to resolve it.
+    WD = std::make_error_code(std::errc::invalid_argument);
+    if (!sys::path::is_absolute(InitialCWD)) {
+      EC = std::make_error_code(std::errc::invalid_argument);
+      return;
+    }
+    EC = setCurrentWorkingDirectory(InitialCWD);
+  }
+
   ErrorOr<Status> status(const Twine &Path) override;
   ErrorOr<std::unique_ptr<File>> openFileForRead(const Twine &Path) override;
   ErrorOr<std::unique_ptr<File>>
@@ -433,6 +444,17 @@ std::unique_ptr<FileSystem> vfs::createPhysicalFileSystem() {
   return std::make_unique<RealFileSystem>(false);
 }
 
+ErrorOr<std::unique_ptr<FileSystem>>
+vfs::createPhysicalFileSystem(const Twine &WorkingDirectory) {
+  sys::sandbox::violationIfEnabled();
+
+  std::error_code EC;
+  auto FS = std::make_unique<RealFileSystem>(WorkingDirectory, EC);
+  if (EC)
+    return EC;
+  return std::unique_ptr<FileSystem>(std::move(FS));
+}
+
