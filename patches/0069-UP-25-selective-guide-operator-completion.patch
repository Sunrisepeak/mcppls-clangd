+TEST(CompletionTest, SelectedExternalOperatorNamesPreserveOverloadsAndLookup) {
+  TestTU TU;
+  TU.HeaderCode = R"cpp(
+    namespace api {
+      struct value {};
+      value operator+(value, int);
+      value operator+(value, double);
+      value operator-(value, int);
+      value operator<<(value, int);
+    }
+  )cpp";
+  auto AST = TU.build();
+  ASSERT_TRUE(AST.getDiagnostics().empty());
+  auto &Ctx = AST.getASTContext();
+  auto *NS = cast<NamespaceDecl>(Ctx.getTranslationUnitDecl()
+                                    ->lookup(&Ctx.Idents.get("api")).front())
+                 ->getPrimaryContext();
+  auto Plus = Ctx.DeclarationNames.getCXXOperatorName(OO_Plus);
+  auto Minus = Ctx.DeclarationNames.getCXXOperatorName(OO_Minus);
+  ASSERT_TRUE(NS->noload_lookup(Plus).empty());
+  ASSERT_TRUE(NS->noload_lookup(Minus).empty());
+  auto Filter = [](llvm::StringRef Name) { return Name == "operator+"; };
+  Ctx.getExternalSource()->completeVisibleDeclsMapForCompletion(NS, Filter);
+  EXPECT_EQ(llvm::range_size(NS->noload_lookup(Plus)), 2u);
+  EXPECT_TRUE(NS->noload_lookup(Minus).empty());
+  EXPECT_TRUE(NS->hasExternalVisibleStorage());
+  EXPECT_EQ(llvm::range_size(NS->lookup(Minus)), 1u);
+  Ctx.getExternalSource()->completeVisibleDeclsMap(NS);
+  EXPECT_FALSE(NS->hasExternalVisibleStorage());
+  EXPECT_EQ(llvm::range_size(NS->lookup(Plus)), 2u);
+}
+
+TEST(CompletionTest, ExternalQualifiedOperatorNamesMatchTextualResults) {
+  TestTU TU;
+  TU.ExtraArgs.push_back("-std=c++20");
+  TU.HeaderCode = R"cpp(
+    namespace api {
+      struct value {};
+      value operator+(value, int);
+      value operator+(value, double);
+      value operator-(value, int);
+      value operator<<(value, int);
+      value operator co_await(value);
+      int ordinary();
+    }
+  )cpp";
+  CodeCompleteOptions Opts;
+  Opts.ForceLoadPreamble = true;
+  auto Keys = [](const CodeCompleteResult &R) {
+    std::vector<std::string> Keys;
+    for (const auto &C : R.Completions)
+      Keys.push_back(C.Name + "|" + C.RequiredQualifier + "|" + C.Signature +
+                     "|" + C.SnippetSuffix + "|" +
+                     std::to_string(static_cast<unsigned>(C.Kind)));
+    llvm::sort(Keys);
+    return Keys;
+  };
+  for (llvm::StringRef Pattern : {"ope", "op", "operatorco", "ord", ""}) {
+    Annotations Code(("void probe() { api::" + Pattern + "^ }").str());
+    TU.Code = Code.code().str();
+    auto Result = completions(TU, Code.point(), {}, Opts);
+    Annotations LocalCode(TU.HeaderCode + "\nvoid probe() { api::" +
+                          Pattern.str() + "^ }");
+    auto LocalTU = TestTU::withCode(LocalCode.code());
+    LocalTU.ExtraArgs.push_back("-std=c++20");
+    auto Local = completions(LocalTU, LocalCode.point(), {}, Opts);
+    ASSERT_FALSE(Result.Completions.empty());
+    if (Pattern == "ope" || Pattern == "op" || Pattern.empty()) {
+      EXPECT_THAT(Result.Completions, Contains(named("operator+")));
+      EXPECT_THAT(Result.Completions, Contains(named("operator<<")));
+    }
+    if (Pattern == "operatorco") {
+      EXPECT_THAT(Result.Completions, Contains(named("operatorco_await")));
+    }
+    EXPECT_EQ(Keys(Result), Keys(Local));
+  }
+}
+
+TEST(CompletionTest, SelectedExternalNamesPreserveOrdinaryDeductionGuideLookup) {
+  TestTU TU;
+  TU.ExtraArgs.push_back("-std=c++20");
+  TU.HeaderCode = R"cpp(
+    namespace api {
+      template <typename T> struct vector { vector(T); };
+      vector(int) -> vector<int>;
+      template <typename T> struct ordinary { ordinary(T); };
+      ordinary(int) -> ordinary<int>;
+    }
+  )cpp";
+  auto AST = TU.build();
+  ASSERT_TRUE(AST.getDiagnostics().empty());
+  auto &Ctx = AST.getASTContext();
+  auto *NS = cast<NamespaceDecl>(Ctx.getTranslationUnitDecl()
+                                    ->lookup(&Ctx.Idents.get("api"))
+                                    .front())
+                 ->getPrimaryContext();
+  auto *OrdinaryName = &Ctx.Idents.get("ordinary");
+  ASSERT_TRUE(NS->noload_lookup(OrdinaryName).empty());
+  auto Filter = [](llvm::StringRef Name) {
+    return Name == "vector";
+  };
+  Ctx.getExternalSource()->completeVisibleDeclsMapForCompletion(NS, Filter);
+  EXPECT_TRUE(NS->hasExternalVisibleStorage());
+  // Deserializing a guide also loads its template. Checking the template before
+  // lookup therefore proves that neither its name nor its guides were loaded.
+  EXPECT_TRUE(NS->noload_lookup(OrdinaryName).empty());
+  auto *Ordinary = cast<ClassTemplateDecl>(NS->lookup(OrdinaryName).front());
+  auto GuideName = Ctx.DeclarationNames.getCXXDeductionGuideName(Ordinary);
+  auto Guides = NS->lookup(GuideName);
+  ASSERT_FALSE(Guides.empty());
+  bool HasExplicitGuide = false;
+  for (auto *D : Guides) {
+    if (auto *Template = dyn_cast<FunctionTemplateDecl>(D))
+      D = Template->getTemplatedDecl();
+    ASSERT_TRUE(isa<CXXDeductionGuideDecl>(D));
+    HasExplicitGuide |= !D->isImplicit();
+  }
+  EXPECT_TRUE(HasExplicitGuide);
+  Ctx.getExternalSource()->completeVisibleDeclsMap(NS);
+  EXPECT_FALSE(NS->hasExternalVisibleStorage());
+  EXPECT_FALSE(NS->lookup(GuideName).empty());
+}
+
+TEST(CompletionTest, ExternalQualifiedDeductionGuidesPreserveAliasResults) {
+  TestTU TU;
+  TU.ExtraArgs.push_back("-std=c++20");
+  TU.HeaderCode = R"cpp(
+    namespace api {
+      template <typename T> struct vector {
+        vector(T);
+      };
+      vector(int) -> vector<int>;
+      template <typename T> struct ordinary {
+        ordinary(T);
+      };
+      ordinary(int) -> ordinary<int>;
+      template <typename T> using view = ordinary<T>;
+      int version();
+    }
+  )cpp";
+  CodeCompleteOptions Opts;
+  Opts.ForceLoadPreamble = true;
+  auto Keys = [](const CodeCompleteResult &R) {
+    std::vector<std::string> Keys;
+    for (const auto &C : R.Completions)
+      Keys.push_back(C.Name + "|" + C.RequiredQualifier + "|" + C.Signature +
+                     "|" + C.SnippetSuffix + "|" +
+                     std::to_string(static_cast<unsigned>(C.Kind)));
+    llvm::sort(Keys);
+    return Keys;
+  };
+  // The alias's own name can match even when its underlying template does not.
+  // Compare the full result fields with ordinary, nonserialized declarations.
+  for (llvm::StringRef Pattern : {"ve", "vi", "", "ord"}) {
+    Annotations Code(("void probe() { api::" + Pattern + "^ }").str());
+    TU.Code = Code.code().str();
+    auto Result = completions(TU, Code.point(), {}, Opts);
+    Annotations LocalCode(TU.HeaderCode + "\nvoid probe() { api::" +
+                          Pattern.str() + "^ }");
+    auto LocalTU = TestTU::withCode(LocalCode.code());
+    LocalTU.ExtraArgs.push_back("-std=c++20");
+    auto Local = completions(LocalTU, LocalCode.point(), {}, Opts);
+    ASSERT_FALSE(Result.Completions.empty());
+    if (Pattern == "vi") {
+      EXPECT_THAT(Result.Completions, Contains(named("view")));
+    }
+    if (Pattern == "ord") {
+      EXPECT_THAT(Result.Completions, Contains(named("ordinary")));
+    }
+    if (Pattern == "ve" || Pattern.empty()) {
+      EXPECT_THAT(Result.Completions, Contains(named("vector")));
+    }
+    EXPECT_EQ(Keys(Result), Keys(Local));
+  }
+}
