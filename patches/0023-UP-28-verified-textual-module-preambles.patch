+TEST_F(PrerequisiteModulesTests, VerifiedTextualPrefixPreservesFreshHeaderBytes) {
+  VerifiedScanCompilationDatabase CDB(TestDir, FS);
+  Annotations Use("#include \"Header.hpp\"\nimport M;\nvoid use() { text_^; }\n");
+  CDB.addFile("M.cppm", "export module M;\nexport int fn_m();\n");
+  CDB.addFile("Header.hpp", "int text_before;\n");
+  CDB.addFile("Use.cpp", Use.code());
+  ModulesBuilder Builder(CDB);
+  auto Inputs = getInputs("Use.cpp", CDB);
+  Inputs.ModulesManager = &Builder;
+  auto CI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(CI);
+  auto Proof = Builder.getTextualPreambleInputs(
+      getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand, *CI);
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux()) {
+    EXPECT_FALSE(Proof); // Unsupported driver observations must decline.
+    return;
+  }
+  ASSERT_TRUE(Proof);
+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Inputs, true, nullptr);
+  ASSERT_TRUE(Preamble);
+  ASSERT_TRUE(Preamble->TextualModuleInputs);
+  EXPECT_FALSE(Preamble->SkipPreambleBuild);
+  EXPECT_GT(Preamble->Preamble.getBounds().Size, 0u);
+  ASSERT_TRUE(Preamble->RequiredModules);
+  HeaderSearchOptions Modules;
+  Preamble->RequiredModules->adjustHeaderSearchOptions(Modules);
+  ASSERT_EQ(Modules.PrebuiltModuleFiles.count("M"), 1u);
+  EXPECT_TRUE(isPreambleCompatible(*Preamble, Inputs, getFullPath("Use.cpp"), *CI));
+  auto Complete = [&] {
+    return codeComplete(getFullPath("Use.cpp"), Use.point(), Preamble.get(),
+                        Inputs, {});
+  };
+  EXPECT_THAT(Complete().Completions, testing::Contains(named("text_before")));
+  auto Header = getFullPath("Header.hpp");
+  llvm::sys::fs::file_status Before;
+  ASSERT_FALSE(llvm::sys::fs::status(Header, Before));
+  {
+    std::error_code EC;
+    llvm::raw_fd_ostream Out(Header, EC);
+    ASSERT_FALSE(EC);
+    Out << "int text_after_;\n";
+  }
+  ASSERT_FALSE(llvm::sys::fs::setLastAccessAndModificationTime(
+      Header, Before.getLastAccessedTime(), Before.getLastModificationTime()));
+  llvm::sys::fs::file_status After;
+  ASSERT_FALSE(llvm::sys::fs::status(Header, After));
+  ASSERT_EQ(Before.getSize(), After.getSize());
+  ASSERT_EQ(Before.getLastModificationTime(), After.getLastModificationTime());
+  EXPECT_FALSE(isPreambleCompatible(*Preamble, Inputs, getFullPath("Use.cpp"), *CI));
+  EXPECT_THAT(Complete().Completions, testing::Contains(named("text_after_")));
+  EXPECT_THAT(Complete().Completions,
+              testing::Not(testing::Contains(named("text_before"))));
+  MockFS DraftFS;
+  DraftFS.OverlayRealFileSystemForModules = true;
+  DraftFS.Files[Header] = "int text_draft_;\n";
+  Inputs.TFS = &DraftFS;
+  EXPECT_FALSE(isPreambleCompatible(*Preamble, Inputs, getFullPath("Use.cpp"), *CI));
+  EXPECT_THAT(Complete().Completions, testing::Contains(named("text_draft_")));
+}
