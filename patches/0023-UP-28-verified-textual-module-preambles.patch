+TEST_F(PrerequisiteModulesTests, TextualPreambleConstructionFailureUsesSemanticFallback) {
+  VerifiedScanCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("M.cppm", "export module M;\nexport int fn_m();\n");
+  CDB.addFile("Header.hpp", "int header_value;\n");
+  Annotations Use("#include \"Header.hpp\"\nimport M;\nvoid use() { fn_^; }\n");
+  CDB.addFile("Use.cpp", Use.code());
+  auto BrokenPCM = (llvm::Twine(TestDir) + "/Broken.pcm").str();
+  {
+    std::error_code EC;
+    llvm::raw_fd_ostream Out(BrokenPCM, EC);
+    ASSERT_FALSE(EC);
+    Out << "not a Clang AST file";
+  }
+  ModulesBuilder Builder(CDB);
+  auto Inputs = getInputs("Use.cpp", CDB);
+  Inputs.ModulesManager = &Builder;
+  auto CI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(CI);
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux()) {
+    EXPECT_FALSE(Builder.getTextualPreambleInputs(
+        getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand, *CI));
+    return;
+  }
+  ASSERT_TRUE(Builder.getTextualPreambleInputs(
+      getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand, *CI));
+  unsigned BeforeExecutions = 0;
+  bool FatalModuleLoad = false;
+  class FailingModuleLoad final : public FeatureModule {
+  public:
+    FailingModuleLoad(std::string Path, unsigned &Calls, bool &Fatal)
+        : Path(std::move(Path)), Calls(Calls), Fatal(Fatal) {}
+    std::unique_ptr<ASTListener> astListeners() override {
+      struct Listener : ASTListener {
+        Listener(std::string Path, unsigned &Calls, bool &Fatal)
+            : Path(std::move(Path)), Calls(Calls), Fatal(Fatal) {}
+        void beforeExecute(CompilerInstance &CI) override {
+          if (++Calls != 1)
+            return;
+          // Exercise the real ASTReader failure, not the audit's decline path.
+          // PCHGenerator refuses to emit after a fatal module loading error.
+          CI.getHeaderSearchOpts().PrebuiltModuleFiles["Broken"] = Path;
+          IdentifierLoc ID(SourceLocation(),
+                           CI.getPreprocessor().getIdentifierInfo("Broken"));
+          CI.loadModule(SourceLocation(), {ID}, Module::AllVisible, false);
+          Fatal = CI.HadFatalFailure;
+        }
+        std::string Path;
+        unsigned &Calls;
+        bool &Fatal;
+      };
+      return std::make_unique<Listener>(Path, Calls, Fatal);
+    }
+    std::string Path;
+    unsigned &Calls;
+    bool &Fatal;
+  };
+  FeatureModuleSet Extensions;
+  Extensions.add(std::make_unique<FailingModuleLoad>(
+      BrokenPCM, BeforeExecutions, FatalModuleLoad));
+  Inputs.FeatureModules = &Extensions;
+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Inputs, true, nullptr);
+  ASSERT_TRUE(FatalModuleLoad);
+  ASSERT_TRUE(Preamble);
+  EXPECT_EQ(BeforeExecutions, 2u);
+  EXPECT_TRUE(Preamble->SkipPreambleBuild);
+  EXPECT_EQ(Preamble->Preamble.getBounds().Size, 0u);
+  EXPECT_FALSE(Preamble->TextualModuleInputs);
+  ASSERT_TRUE(Preamble->RequiredModules);
+  auto Result = codeComplete(getFullPath("Use.cpp"), Use.point(), Preamble.get(),
+                             Inputs, {});
+  auto Found = llvm::find_if(Result.Completions,
+                            [](const auto &C) { return C.Name == "fn_m"; });
+  ASSERT_NE(Found, Result.Completions.end());
+  EXPECT_NE(Found->Kind, CompletionItemKind::Text);
+  // Explicit skip cannot re-enter candidate admission or recurse on failure.
+  BeforeExecutions = 0;
+  FatalModuleLoad = false;
+  Inputs.Opts.SkipPreambleBuild = true;
+  EXPECT_FALSE(buildPreamble(getFullPath("Use.cpp"), *CI, Inputs, true, nullptr));
+  EXPECT_TRUE(FatalModuleLoad);
+  EXPECT_EQ(BeforeExecutions, 1u);
+  // Ordinary no-candidate failure preserves the prior nullptr/error path.
+  BeforeExecutions = 0;
+  FatalModuleLoad = false;
+  Inputs.Opts.SkipPreambleBuild = false;
+  Inputs.ModulesManager = nullptr;
+  EXPECT_FALSE(buildPreamble(getFullPath("Use.cpp"), *CI, Inputs, true, nullptr));
+  EXPECT_TRUE(FatalModuleLoad);
+  EXPECT_EQ(BeforeExecutions, 1u);
+}
