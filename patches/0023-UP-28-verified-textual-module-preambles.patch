+  auto Found = llvm::find_if(Result.Completions,
+                            [](const auto &C) { return C.Name == "fn_m"; });
+  ASSERT_NE(Found, Result.Completions.end());
+  EXPECT_NE(Found->Kind, CompletionItemKind::Text);
