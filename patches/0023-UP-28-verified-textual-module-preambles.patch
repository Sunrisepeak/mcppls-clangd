+  ASSERT_TRUE(Builder.getTextualPreambleInputs(
+      getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand, *CI));
+  unsigned BeforeExecutions = 0;
+  class UnobservableExtension final : public FeatureModule {
+  public:
+    explicit UnobservableExtension(unsigned &Calls) : Calls(Calls) {}
+    std::unique_ptr<ASTListener> astListeners() override {
+      struct Listener : ASTListener {
+        explicit Listener(unsigned &Calls) : Calls(Calls) {}
+        void beforeExecute(CompilerInstance &CI) override {
+          ++Calls;
+          CI.getFileManager().getVirtualFileSystem().visitChildFileSystems(
+              [](llvm::vfs::FileSystem &) {});
+        }
+        unsigned &Calls;
+      };
+      return std::make_unique<Listener>(Calls);
+    }
+    unsigned &Calls;
