+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Inputs, true, nullptr);
+  ASSERT_TRUE(Preamble);
+  EXPECT_EQ(BeforeExecutions, 2u); // Candidate and exactly one zero-prefix retry.
+  EXPECT_TRUE(Preamble->SkipPreambleBuild);
+  EXPECT_EQ(Preamble->Preamble.getBounds().Size, 0u);
+  EXPECT_FALSE(Preamble->TextualModuleInputs);
