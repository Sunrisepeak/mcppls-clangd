+TEST_F(PrerequisiteModulesTests, VerifiedTextualPrefixRequiresActualRequestCommand) {
+  VerifiedScanCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("M.cppm", "export module M;\nexport int fn_m();\n");
+  CDB.addFile("Header.hpp", "#if IMPORT_IN_HEADER\nimport M;\n#else\nint safe;\n#endif\n");
+  CDB.addFile("Use.cpp", "#include \"Header.hpp\"\nimport M;\nvoid use() {}\n");
+  auto Inputs = getInputs("Use.cpp", CDB);
+  ModulesBuilder Builder(CDB);
+  auto CI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(CI);
+  auto Original = Builder.getTextualPreambleInputs(
+      getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand, *CI);
+  if (llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    ASSERT_TRUE(Original);
+  else
+    EXPECT_FALSE(Original);
+  // An explicit global override may differ from the project inventory command.
+  // Do not certify its header under the inventory's old macro configuration.
+  OverlayCDB Overlay(&CDB);
+  auto Changed = Inputs.CompileCommand;
+  Changed.CommandLine.insert(Changed.CommandLine.begin() + 1,
+                             "-DIMPORT_IN_HEADER=1");
+  ASSERT_TRUE(Overlay.setCompileCommand(getFullPath("Use.cpp"), Changed));
+  ModulesBuilder OverlayBuilder(Overlay);
+  Inputs.CompileCommand = *Overlay.getCompileCommand(getFullPath("Use.cpp"));
+  auto ChangedCI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(ChangedCI);
+  EXPECT_FALSE(OverlayBuilder.getTextualPreambleInputs(
+      getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand,
+      *ChangedCI));
+  // A real project command transition must also expose the newly active import.
+  CDB.addFile("Use.cpp", Inputs.Contents, {"-DIMPORT_IN_HEADER=1"});
+  Inputs.CompileCommand = *CDB.getCompileCommand(getFullPath("Use.cpp"));
+  ChangedCI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(ChangedCI);
+  EXPECT_FALSE(Builder.getTextualPreambleInputs(
+      getFullPath("Use.cpp"), FS, Inputs.Contents, Inputs.CompileCommand,
+      *ChangedCI));
+}
