+TEST_F(PrerequisiteModulesTests, PreambleAuditReadsOriginalUnusedFileObjects) {
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Header.hpp", "int old_header;\n");
+  auto View = FS.view(TestDir);
+  auto Inputs = std::make_shared<ModuleScanManifest>();
+  auto Recording = llvm::makeIntrusiveRefCnt<ModuleScanRecordingFS>(
+      View, Inputs, /*AuditLiveFiles=*/true);
+  auto File = Recording->openFileForRead("Header.hpp");
+  ASSERT_TRUE(File);
+  ASSERT_EQ(Inputs->OpenFiles, 1u);
+  ASSERT_TRUE(Recording->auditOpenFiles());
+  EXPECT_THAT(Inputs->observations(), testing::Contains(testing::Field(
+      &ModuleScanManifest::Observation::Operation, ModuleScanManifest::Read)));
+  EXPECT_TRUE(Inputs->matches(*FS.view(TestDir)));
+  EXPECT_GE(Inputs->AuxiliaryBytes, ModuleScanManifest::ProbeLimit * sizeof(void *));
+  // Do not close FileManager's descriptor as an audit shortcut. It remains
+  // usable, and auditing it again observes the original inode after retargeting.
+  auto Header = getFullPath("Header.hpp");
+  llvm::sys::fs::file_status Before;
+  ASSERT_FALSE(llvm::sys::fs::status(Header, Before));
+  CDB.addFile("Replacement.hpp", "int new_header;\n");
+  auto Replacement = getFullPath("Replacement.hpp");
+  ASSERT_FALSE(llvm::sys::fs::setLastAccessAndModificationTime(
+      Replacement, Before.getLastAccessedTime(), Before.getLastModificationTime()));
+  ASSERT_FALSE(llvm::sys::fs::rename(Replacement, Header));
+  ASSERT_TRUE(Recording->auditOpenFiles());
+  auto Buffer = (*File)->getBuffer("Header.hpp", -1, true, true);
+  ASSERT_TRUE(Buffer);
+  EXPECT_EQ((*Buffer)->getBuffer(), "int old_header;\n");
+  EXPECT_FALSE(Inputs->matches(*FS.view(TestDir)));
+  ASSERT_FALSE((*File)->close());
+  EXPECT_EQ(Inputs->OpenFiles, 0u);
+}
