-    if (!Parent)
-      return Parent.takeError();
-    if ((*Parent)->State->Description.Type != Stable)
-      return failure("managed companion is not stable");
-    Companion = std::move(*Parent);
-  }
+  auto Bundle = inventoryBundle(Gen.Value);
+  if (!Bundle)
+    return Bundle.takeError();
+  if (Bundle->Bytes != R->Bytes || Bundle->MainBytes != R->MainBytes ||
+      Bundle->CacheFiles != R->BundleFiles ||
+      Bundle->Digest != R->BundleDigest)
+    return failure("managed input bundle changed");
   auto I = std::make_unique<ModuleBuildCacheLease::Impl>();
   I->Cache = shared_from_this();
   I->Slot = Slot;
   I->Lease.Value = Lease.release();
   I->Description = *R;
-  I->Companion = std::move(Companion);
   return std::shared_ptr<ModuleBuildCacheLease>(
       new ModuleBuildCacheLease(std::move(I)));
 #endif
