-llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>> ModuleBuildCache::copy(
-    const std::shared_ptr<ModuleBuildCacheLease> &StableLease) {
-#if !CLANGD_OWNED_MODULE_CACHE
-  return failure("unsupported copy");
-#else
-  if (!StableLease || StableLease->State->Cache.get() != this ||
-      StableLease->State->Description.Type != Stable)
-    return failure("copy requires this namespace's stable lease");
-  const auto &R = StableLease->State->Description;
-  auto Result = reserve("read-copy", R.Source, R.MainBytes);
-  if (!Result)
-    return Result.takeError();
-  {
-    std::lock_guard<std::mutex> Guard(State->Mutex);
-    Lock Ledger(State->Ledger.Value);
-    if (!Ledger.acquire())
-      return ioError();
-    auto Entry = State->read((*Result)->State->Slot);
-    if (!Entry)
-      return Entry.takeError();
-    Entry->StableSlot = StableLease->State->Slot;
-    Entry->StableGeneration = R.Generation;
-    if (auto Error = State->write((*Result)->State->Slot, *Entry))
-      return std::move(Error);
-    (*Result)->State->Companion = StableLease;
-  }
-  FD Input(::open(StableLease->payload().c_str(),
-                  O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
-  FD Output(::open((*Result)->payload().c_str(),
-                   O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
-  if (Input.Value < 0 || Output.Value < 0)
-    return ioError();
-  std::array<char, 65536> Buffer;
-  uint64_t Written = 0;
-  for (;;) {
-    ssize_t N = read(Input.Value, Buffer.data(), Buffer.size());
-    if (N < 0 && errno == EINTR)
-      continue;
-    if (N < 0)
-      return ioError();
-    if (!N)
-      break;
-    // Even a changed source cannot grow the copy past its PRE-WRITE charge.
-    if (uint64_t(N) > R.MainBytes - Written)
-      return failure("copy source grew");
-    if (!exactWrite(Output.Value, Buffer.data(), N, Written))
-      return ioError();
-    Written += N;
-  }
-  if (Written != R.MainBytes)
-    return failure("copy source size changed");
-  if (int Error = Platform::syncData(Output.Value))
-    return ioError(Error);
-  auto &C = *State;
-  std::lock_guard<std::mutex> Guard(C.Mutex);
-  Lock Ledger(C.Ledger.Value);
-  if (!Ledger.acquire())
-    return ioError();
-  auto Current = C.read((*Result)->State->Slot);
-  if (!Current)
-    return Current.takeError();
-  Current->Type = Copy;
-  Current->MainBytes = Written;
-  if (auto E = C.write((*Result)->State->Slot, *Current))
-    return std::move(E);
-  (*Result)->State->Description.Type = Copy;
-  (*Result)->State->Description.MainBytes = Written;
-  if (int Error = Platform::lock((*Result)->State->Lease.Value, false, false))
-    return ioError(Error);
-  return Result;
-#endif
-}
