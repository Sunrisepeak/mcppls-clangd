+// Maintenance-only. A cursor replaces recursive all-file materialization;
+// fixed layout depth and no-follow traversal bound its open-directory state.
+// Legacy, stable, foreign, and prebuilt files without a verified copy lease
+// are retained. Stable-cache admission/eviction is a separate policy.
+class ModuleReadCopyCollector {
+public:
+  struct Result {
+    unsigned Examined = 0, Removed = 0;
+    bool More = false;
+  };
+  explicit ModuleReadCopyCollector(PathRef Root) : Root(Root) {}
+
+  Result collect(unsigned MaxEntries = 32) {
+    Result R;
+    auto Now = std::chrono::steady_clock::now();
+    std::error_code EC;
+    if (!Walking) {
+      if (Now < NextSweep)
+        return R;
+      NextSweep = Now + std::chrono::seconds(30);
+      llvm::sys::fs::file_status RootStatus;
+      if (llvm::sys::fs::status(Root, RootStatus, false) ||
+          !llvm::sys::fs::is_directory(RootStatus))
+        return R;
+      Cursor = llvm::sys::fs::recursive_directory_iterator(Root, EC, false);
+      Walking = !EC && Cursor != End;
+    }
+    unsigned Limit = (std::min)(MaxEntries, 128u);
+    while (Walking && R.Examined < Limit) {
+      ++R.Examined;
+      const std::string Path = Cursor->path();
+      llvm::sys::fs::file_status Status;
+      if (llvm::sys::fs::status(Path, Status, false)) {
+        Cursor.no_push(); // Unknown filesystem states are never candidates.
+      } else if (llvm::sys::fs::is_directory(Status)) {
+        auto Name = llvm::sys::path::filename(Path);
+        // The BMI layout is source-hash / command-hash / file. Never inspect
+        // worker units, lock namespaces, foreign directories, or deeper trees.
+        auto Hash = Cursor.level() == 0 ? Name.rsplit('-').second : Name;
+        bool CacheDirectory =
+            Hash.size() == FileDigest{}.size() * 2 &&
+            llvm::all_of(Hash, [](char C) { return llvm::isHexDigit(C); });
+        if (Cursor.level() >= 2 || !CacheDirectory)
+          Cursor.no_push();
+      } else if (llvm::sys::fs::is_regular_file(Status) &&
+                 Cursor.level() == 2 &&
+                 llvm::sys::path::extension(Path) == ".pcm") {
+        R.Removed += reclaim(Path, Status);
+      }
+      Cursor.increment(EC);
+      if (EC || Cursor == End) {
+        if (EC)
+          vlog("Stopped bounded BMI copy scan {0}: {1}", Root, EC.message());
+        Cursor = End;
+        Walking = false;
+      }
+    }
+    R.More = Walking;
+    vlog("BMI copy maintenance {0}: examined={1} removed={2} more={3}", Root,
+         R.Examined, R.Removed, R.More);
+    return R;
+  }
+
+private:
+  bool reclaim(PathRef PCM, const llvm::sys::fs::file_status &PCMStatus) {
+    const std::string LeasePath = (PCM + ".lease").str();
+    llvm::sys::fs::file_status Before;
+    if (llvm::sys::fs::status(LeasePath, Before, false) ||
+        !llvm::sys::fs::is_regular_file(Before) || Before.getSize() != 0 ||
+        Before.getLinkCount() != 1)
+      return false;
+    auto ID = Before.getUniqueID();
+    {
+      std::lock_guard<std::mutex> Lock(ModuleReadLeasesMutex);
+      if (PendingModuleReadLeaseCreators ||
+          ActiveModuleReadLeaseIDs.contains(ID) ||
+          ActiveModuleReadLeases.contains(LeasePath) ||
+          !CollectingModuleReadLeaseIDs.insert(ID).second)
+        return false;
+    }
+    auto Reserved = llvm::scope_exit([&] {
+      std::lock_guard<std::mutex> Lock(ModuleReadLeasesMutex);
+      CollectingModuleReadLeaseIDs.erase(ID);
+    });
+    auto Descriptor = openModuleReadLeaseNoFollow(LeasePath);
+    if (!Descriptor) {
+      llvm::consumeError(Descriptor.takeError());
+      return false;
+    }
+    int FD = *Descriptor;
     auto Close = llvm::scope_exit([&] {
       llvm::sys::fs::unlockFile(FD);
       llvm::sys::Process::SafelyCloseFileDescriptor(FD);
     });
-    if (llvm::sys::fs::tryLockFile(FD))
-      continue;
-    if (auto EC = llvm::sys::fs::remove(ModuleFilePath)) {
-      vlog("Failed to reclaim unowned BMI copy {0}: {1}", ModuleFilePath,
-           EC.message());
-      continue;
-    }
-    // Closing happens first on Windows, where open sidecars cannot be removed.
+    llvm::sys::fs::file_status Opened, CurrentLease, CurrentPCM;
+    if (llvm::sys::fs::status(FD, Opened) || Opened.getUniqueID() != ID ||
+        !llvm::sys::fs::is_regular_file(Opened) || Opened.getSize() != 0 ||
+        llvm::sys::fs::tryLockFile(FD) ||
+        llvm::sys::fs::status(LeasePath, CurrentLease, false) ||
+        CurrentLease.getUniqueID() != ID ||
+        llvm::sys::fs::status(PCM, CurrentPCM, false) ||
+        !llvm::sys::fs::is_regular_file(CurrentPCM) ||
+        CurrentPCM.getUniqueID() != PCMStatus.getUniqueID())
+      return false;
+    if (llvm::sys::fs::remove(PCM))
+      return false;
+    // Reservation survives close: closing a second local descriptor must not
+    // unlock another collector's fcntl lease. Windows needs close before
+    // remove.
     Close.release();
     llvm::sys::fs::unlockFile(FD);
     llvm::sys::Process::SafelyCloseFileDescriptor(FD);
-    llvm::sys::fs::remove(LeasePath);
-    log("Removed unowned copy-on-read module file {0}", ModuleFilePath);
+    if (!llvm::sys::fs::status(LeasePath, CurrentLease, false) &&
+        CurrentLease.getUniqueID() == ID)
+      llvm::sys::fs::remove(LeasePath);
+    return true;
   }
