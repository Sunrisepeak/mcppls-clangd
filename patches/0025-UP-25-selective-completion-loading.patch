+namespace {
+struct CompletionVisibleLookup {
+  const ExternalASTSource *Source;
+  const DeclContext *Context;
+  llvm::function_ref<bool(llvm::StringRef)> NameMayMatch;
+  bool Consumed = false;
+};
+// The public call provides a synchronous, source/context-bound scope. This
+// private stack pointer adds no persistent AST state or object-layout change.
+thread_local CompletionVisibleLookup *CurrentCompletionLookup = nullptr;
+}
+
+void ExternalASTSource::completeVisibleDeclsMapForCompletion(
+    const DeclContext *DC,
+    llvm::function_ref<bool(llvm::StringRef)> NameMayMatch) {
+  if (!NameMayMatch) {
+    completeVisibleDeclsMap(DC);
+    return;
+  }
+  CompletionVisibleLookup Lookup{this, DC, NameMayMatch};
+  auto *Previous = CurrentCompletionLookup;
+  CurrentCompletionLookup = &Lookup;
+  llvm::scope_exit Restore([&] { CurrentCompletionLookup = Previous; });
+  completeVisibleDeclsMap(DC);
+}
+
+llvm::function_ref<bool(llvm::StringRef)>
+ExternalASTSource::takeCompletionNameFilter(const DeclContext *DC) {
+  auto *Lookup = CurrentCompletionLookup;
+  if (!Lookup || Lookup->Source != this || Lookup->Context != DC ||
+      Lookup->Consumed)
+    return {};
+  Lookup->Consumed = true;
+  return Lookup->NameMayMatch;
+}
