+TEST_F(PrerequisiteModulesTests, CompletionInputsKeepDraftRoleAndPrefixIndependent) {
+  VerifiedScanCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("M.cppm", "export module M;\nexport int fn_m();\n");
+  CDB.addFile("Header.hpp", "int header_value;\n");
+  CDB.addFile("Use.cpp", "#include \"Header.hpp\"\nimport M;\nvoid use() {}\n");
+  ModulesBuilder Builder(CDB);
+  auto Inputs = getInputs("Use.cpp", CDB);
+  auto CI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(CI);
+  auto Check = [&](llvm::StringRef Draft, const tooling::CompileCommand &Command) {
+    return Builder.getCompletionInputs(getFullPath("Use.cpp"), FS, Draft,
+                                       Command, *CI);
+  };
+  auto First = Check(Inputs.Contents, Inputs.CompileCommand);
+  EXPECT_THAT(First.RequiredModules, testing::ElementsAre("M"));
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux()) {
+    EXPECT_FALSE(First.TextualPreamble);
+    return;
+  }
+  ASSERT_TRUE(First.TextualPreamble);
+  auto Before = getModuleDependencyScanCache().stats();
+  auto Warm = Check(Inputs.Contents, Inputs.CompileCommand);
+  ASSERT_TRUE(Warm.TextualPreamble);
+  EXPECT_EQ(*Warm.TextualPreamble, *First.TextualPreamble);
+  // One full draft replay and one prefix replay. No second full draft replay.
+  EXPECT_EQ(getModuleDependencyScanCache().stats().Hits - Before.Hits, 2u);
+
+  auto Body = Check("#include \"Header.hpp\"\nimport M;\nvoid use() { int local; }\n",
+                    Inputs.CompileCommand);
+  ASSERT_TRUE(Body.TextualPreamble);
+  EXPECT_EQ(*Body.TextualPreamble, *First.TextualPreamble);
+
+  auto ModuleUnit = Check("#include \"Header.hpp\"\nexport module Other;\nimport M;\n",
+                          Inputs.CompileCommand);
+  EXPECT_THAT(ModuleUnit.RequiredModules, testing::ElementsAre("M"));
+  EXPECT_FALSE(ModuleUnit.TextualPreamble);
+
+  auto ChangedCommand = Inputs.CompileCommand;
+  ChangedCommand.CommandLine.push_back("-DNEW_MACRO=1");
+  auto Mismatch = Check(Inputs.Contents, ChangedCommand);
+  EXPECT_THAT(Mismatch.RequiredModules, testing::ElementsAre("M"));
+  EXPECT_FALSE(Mismatch.TextualPreamble);
+
+  auto PrefixImport = Check("#include \"Header.hpp\"\n", Inputs.CompileCommand);
+  ASSERT_TRUE(PrefixImport.TextualPreamble);
+  EXPECT_TRUE(PrefixImport.RequiredModules.empty());
+}
