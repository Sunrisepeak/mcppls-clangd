+  CDB.addFile("N.cppm", "export module N;\n");
+  CDB.addFile("Header.hpp", "int from_header;\n");
+  const std::string Prefix = "#include \"Header.hpp\"\n";
+  CDB.addFile("Use.cpp", Prefix + "import M;\nint use() { return 0; }\n");
+  ModulesBuilder Builder(CDB);
+  const auto Use = getFullPath("Use.cpp");
+  auto Names = [&](llvm::StringRef Body) {
+    return Builder.getRequiredModuleNames(Use, FS, Prefix + Body.str());
+  };
+  EXPECT_THAT(Names("import M;\nint use() { return 0; }\n"),
+              testing::ElementsAre("M"));
+  // Typing in the body is the preamble's own scan again, memoized, with the
+  // body's imports.
+  auto Before = getModuleDependencyScanCache().stats();
+  EXPECT_THAT(Names("import M;\nint use() { return 1; }\n"),
+              testing::ElementsAre("M"));
+  EXPECT_THAT(Names("import M;\nimport N;\nint use() { return 2; }\n"),
+              testing::ElementsAre("M", "N"));
+  auto After = getModuleDependencyScanCache().stats();
+  EXPECT_EQ(After.Misses, Before.Misses);
+  EXPECT_GT(After.Hits, Before.Hits);
+  // A directive in the body may read a file or change an import, and an
+  // unfinished import is the scanner's to judge: such drafts are scanned whole.
+  EXPECT_THAT(Names("import M;\n#define LATER 1\nint use() { return 3; }\n"),
+              testing::ElementsAre("M"));
+  EXPECT_GT(getModuleDependencyScanCache().stats().Misses, After.Misses);
+  After = getModuleDependencyScanCache().stats();
+  (void)Names("import M.\nint use() { return 4; }\n");
+  EXPECT_GT(getModuleDependencyScanCache().stats().Misses, After.Misses);
+}
