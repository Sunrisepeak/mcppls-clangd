+TEST(CompletionTest, ExternalNameFilterBindsExactSourceAndContext) {
+  auto AST = TestTU::withCode("namespace one {} namespace two {}").build();
+  auto &Ctx = AST.getASTContext();
+  auto *TU = Ctx.getTranslationUnitDecl();
+  auto *One = cast<NamespaceDecl>(TU->lookup(&Ctx.Idents.get("one")).front());
+  auto *Two = cast<NamespaceDecl>(TU->lookup(&Ctx.Idents.get("two")).front());
+  class Source : public ExternalASTSource {
+  public:
+    Source *Other = nullptr;
+    const DeclContext *WrongContext = nullptr;
+    bool Inside = false;
+    std::vector<bool> SawFilter;
+    void completeVisibleDeclsMap(const DeclContext *DC) override {
+      if (!Inside && Other) {
+        Inside = true;
+        // Another source and another context cannot consume this predicate.
+        Other->completeVisibleDeclsMap(DC);
+        SawFilter.push_back(bool(takeCompletionNameFilter(WrongContext)));
+        Inside = false;
+      }
+      SawFilter.push_back(bool(takeCompletionNameFilter(DC)));
+    }
+  } Parent, Other;
+  Parent.Other = &Other;
+  Parent.WrongContext = Two;
+  auto Filter = [](llvm::StringRef) { return true; };
+  Parent.completeVisibleDeclsMapForCompletion(One, Filter);
+  EXPECT_THAT(Other.SawFilter, ElementsAre(false));
+  EXPECT_THAT(Parent.SawFilter, ElementsAre(false, true));
+  Parent.Other = nullptr;
+  Parent.completeVisibleDeclsMap(One);
+  EXPECT_THAT(Parent.SawFilter, ElementsAre(false, true, false));
+}
