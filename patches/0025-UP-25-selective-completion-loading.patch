+TEST(CompletionTest, ExternalUnqualifiedNamesPreserveScopesAndUsing) {
+  TestTU TU;
+  TU.HeaderCode = R"cpp(
+    int visible(int);
+    int visible(double);
+    int unrelated();
+    namespace backing { int vector_api(int); int version_api(); }
+    namespace bridge { using namespace backing; }
+    using namespace bridge;
+    namespace host { inline namespace abi { int vector_abi(); } }
+    using namespace host;
+    struct vehicle { vehicle(int); };
+    using vehicle_alias = vehicle;
+  )cpp";
+  CodeCompleteOptions Opts;
+  Opts.ForceLoadPreamble = true;
+  Opts.BundleOverloads = true;
+  // An empty pattern selects no names: the external lookup is the ordinary one,
+  // and a textual TU also lists what the target predeclares and defines (on
+  // x86_64-pc-windows-msvc size_t, type_info and macros a preamble does not
+  // offer). There, what the header declares is compared.
+  auto Keys = [](const CodeCompleteResult &R, bool HeaderOnly) {
+    static const llvm::StringSet<> Header = {
+        "visible", "unrelated", "backing", "vector_api", "version_api",
+        "bridge",  "host",      "abi",     "vector_abi", "vehicle",
+        "vehicle_alias"};
+    std::vector<std::string> Keys;
+    for (const auto &C : R.Completions) {
+      if (HeaderOnly && !Header.contains(C.Name))
+        continue;
+      Keys.push_back(C.Name + "|" + C.RequiredQualifier + "|" + C.Signature +
+                     "|" + C.SnippetSuffix + "|" +
+                     std::to_string(static_cast<unsigned>(C.Kind)));
+    }
+    llvm::sort(Keys);
+    return Keys;
+  };
+  for (llvm::StringRef Pattern : {"vi", "ve", "v_a", ""}) {
+    for (llvm::StringRef Body : {"void probe() { ",
+                                "void probe() { int visible = 0; (void)",
+                                "void probe() { ::"}) {
+      Annotations Code((Body + Pattern + "^ }").str());
+      TU.Code = Code.code().str();
+      auto Result = completions(TU, Code.point(), {}, Opts);
+      // Preserve the completion marker in the textual comparison.
+      Annotations Textual(TU.HeaderCode + "\n" +
+                          (Body + Pattern + "^ }").str());
+      auto LocalTU = TestTU::withCode(Textual.code());
+      auto Local = completions(LocalTU, Textual.point(), {}, Opts);
+      EXPECT_EQ(Keys(Result, Pattern.empty()), Keys(Local, Pattern.empty()))
+          << Pattern.str() << Body.str();
+      if (Pattern == "ve" && !Body.ends_with("::")) {
+        EXPECT_THAT(Result.Completions, has("vector_api"));
+        EXPECT_THAT(Result.Completions, has("vector_abi"));
+      }
+      if (Pattern == "vi" && Body == "void probe() { ")
+        EXPECT_THAT(Result.Completions,
+                    Contains(AllOf(named("visible"),
+                                   Field(&CodeCompletion::BundleSize, 2u))));
+      if (Pattern == "vi" && Body.contains("int visible"))
+        EXPECT_THAT(Result.Completions,
+                    Contains(AllOf(named("visible"),
+                                   kind(CompletionItemKind::Variable))));
+    }
+  }
+}
