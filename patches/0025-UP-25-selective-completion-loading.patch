+namespace {
+bool completionNameMayMatch(
+    serialization::DeclarationNameKey Key,
+    llvm::function_ref<bool(llvm::StringRef)> NameMayMatch) {
+  // Deduction-guide keys carry their class template's identifier. Retain all
+  // guides for a matching template; omitted guides remain available to ordinary
+  // lookup because selective completion does not close external storage.
+  if (Key.getKind() == DeclarationName::CXXOperatorName) {
+    auto Op = Key.getOperatorKind();
+    // Invalid/non-overloadable operator keys keep the conservative path.
+    if (Op == OO_None || Op == OO_Conditional || Op == NUM_OVERLOADED_OPERATORS)
+      return true;
+    // Match Sema's AddTypedNameChunk spelling, which differs from diagnostic
+    // DeclarationName printing for co_await. Do not intern synthetic identifiers.
+    switch (Op) {
+#define OVERLOADED_OPERATOR(Name, Spelling, Token, Unary, Binary, MemberOnly) \
+    case OO_##Name: return NameMayMatch("operator" Spelling);
+#define OVERLOADED_OPERATOR_MULTI(Name, Spelling, Unary, Binary, MemberOnly)
+#include "clang/Basic/OperatorKinds.def"
+    case OO_New: return NameMayMatch("operator new");
+    case OO_Delete: return NameMayMatch("operator delete");
+    case OO_Array_New: return NameMayMatch("operator new[]");
+    case OO_Array_Delete: return NameMayMatch("operator delete[]");
+    case OO_Call: return NameMayMatch("operator()");
+    case OO_Subscript: return NameMayMatch("operator[]");
+    default: return true;
+    }
+  }
+  if (Key.getKind() != DeclarationName::Identifier &&
+      Key.getKind() != DeclarationName::CXXDeductionGuideName)
+    return true;
+  auto *II = Key.getIdentifier();
+  return !II || NameMayMatch(II->getName());
+}
