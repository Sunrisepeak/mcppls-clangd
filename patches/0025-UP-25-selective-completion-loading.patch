+TEST(CompletionTest, ExternalQualifiedDeductionGuidesPreserveAliasResults) {
+  TestTU TU;
+  TU.ExtraArgs.push_back("-std=c++20");
+  TU.HeaderCode = R"cpp(
+    namespace api {
+      template <typename T> struct vector {
+        vector(T);
+      };
+      vector(int) -> vector<int>;
+      template <typename T> struct ordinary {
+        ordinary(T);
+      };
+      ordinary(int) -> ordinary<int>;
+      template <typename T> using view = ordinary<T>;
+      int version();
+    }
+  )cpp";
+  CodeCompleteOptions Opts;
+  Opts.ForceLoadPreamble = true;
+  auto Keys = [](const CodeCompleteResult &R) {
+    std::vector<std::string> Keys;
+    for (const auto &C : R.Completions)
+      Keys.push_back(C.Name + "|" + C.RequiredQualifier + "|" + C.Signature +
+                     "|" + C.SnippetSuffix + "|" +
+                     std::to_string(static_cast<unsigned>(C.Kind)));
+    llvm::sort(Keys);
+    return Keys;
+  };
+  // The alias's own name can match even when its underlying template does not.
+  // Compare the full result fields with ordinary, nonserialized declarations.
+  for (llvm::StringRef Pattern : {"ve", "vi", "", "ord"}) {
+    Annotations Code(("void probe() { api::" + Pattern + "^ }").str());
+    TU.Code = Code.code().str();
+    auto Result = completions(TU, Code.point(), {}, Opts);
+    Annotations LocalCode(TU.HeaderCode + "\nvoid probe() { api::" +
+                          Pattern.str() + "^ }");
+    auto LocalTU = TestTU::withCode(LocalCode.code());
+    LocalTU.ExtraArgs.push_back("-std=c++20");
+    auto Local = completions(LocalTU, LocalCode.point(), {}, Opts);
+    ASSERT_FALSE(Result.Completions.empty());
+    if (Pattern == "vi") {
+      EXPECT_THAT(Result.Completions, Contains(named("view")));
+    }
+    if (Pattern == "ord") {
+      EXPECT_THAT(Result.Completions, Contains(named("ordinary")));
+    }
+    if (Pattern == "ve" || Pattern.empty()) {
+      EXPECT_THAT(Result.Completions, Contains(named("vector")));
+    }
+    EXPECT_EQ(Keys(Result), Keys(Local));
+  }
+}
