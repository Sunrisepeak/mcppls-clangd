+// Typing an import line changes the draft's imports at every key. Completion
+// there parses the draft alone, without the preamble, so it must not rebuild
+// the prerequisites on each keystroke the way a body completion after a
+// dependency edit does.
+TEST_F(PrerequisiteModulesTests, CompletionInImportLineKeepsPrerequisites) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("A.cppm", R"cpp(
+export module A;
+export void printA();
+  )cpp");
+  CDB.addFile("Use.cpp", R"cpp(
+import A;
+void func() {}
+)cpp");
+  ModulesBuilder Builder(CDB);
+  ParseInputs Use = getInputs("Use.cpp", CDB);
+  Use.ModulesManager = &Builder;
+  std::unique_ptr<CompilerInvocation> CI =
+      buildCompilerInvocation(Use, DiagConsumer);
+  ASSERT_TRUE(CI);
+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Use,
+                                /*InMemory=*/true, /*Callback=*/nullptr);
+  ASSERT_TRUE(Preamble && Preamble->RequiredModules);
+  const unsigned Before = CDB.getGlobalScanningCount();
+
+  Annotations Typing(R"cpp(
+import A;
+import B^
+void func() {}
+)cpp");
+  Use.Contents = Typing.code().str();
+  codeComplete(getFullPath("Use.cpp"), Typing.point(), Preamble.get(), Use, {});
+  EXPECT_EQ(CDB.getGlobalScanningCount(), Before);
+  // So is a blank line between two imports, where the next one is typed.
+  Annotations Between(R"cpp(
+import A;
+^
+import B;
+void func() {}
+)cpp");
+  Use.Contents = Between.code().str();
+  codeComplete(getFullPath("Use.cpp"), Between.point(), Preamble.get(), Use,
+               {});
+  EXPECT_EQ(CDB.getGlobalScanningCount(), Before);
+
+  // Below the imports, completion still sees what the modules export.
+  Annotations Body(R"cpp(
+import A;
+void func() { print^ }
+)cpp");
+  Use.Contents = Body.code().str();
+  auto Result =
+      codeComplete(getFullPath("Use.cpp"), Body.point(), Preamble.get(), Use, {});
+  EXPECT_THAT(Result.Completions, testing::Contains(named("printA")));
+}
