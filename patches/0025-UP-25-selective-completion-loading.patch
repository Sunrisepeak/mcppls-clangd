+TEST_F(PrerequisiteModulesTests, ConstructorsFromSharedHeaderModulesAreUnique) {
+  VerifiedScanCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Shared.hpp", R"cpp(
+    #pragma once
+    template <typename T> struct SharedBox {
+      SharedBox();
+      SharedBox(int value);
+      template <typename U> SharedBox(U *value);
+    };
+  )cpp");
+  for (auto Name : {"First", "Second"}) {
+    CDB.addFile(std::string(Name) + ".cppm",
+                std::string("module;\n#include \"Shared.hpp\"\nexport module ") +
+                    Name + ";\nexport namespace api { using ::SharedBox; }\n");
