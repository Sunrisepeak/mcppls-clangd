+  TU.HeaderCode = R"cpp(
+    namespace api {
+      template <typename T> struct vector { vector(T); };
+      vector(int) -> vector<int>;
+      template <typename T> struct ordinary { ordinary(T); };
+      ordinary(int) -> ordinary<int>;
+    }
+  )cpp";
+  auto AST = TU.build();
+  ASSERT_TRUE(AST.getDiagnostics().empty());
+  auto &Ctx = AST.getASTContext();
+  auto *NS = cast<NamespaceDecl>(Ctx.getTranslationUnitDecl()
+                                    ->lookup(&Ctx.Idents.get("api"))
+                                    .front())
+                 ->getPrimaryContext();
+  auto *OrdinaryName = &Ctx.Idents.get("ordinary");
+  ASSERT_TRUE(NS->noload_lookup(OrdinaryName).empty());
+  auto Filter = [](llvm::StringRef Name) {
+    return Name == "vector";
+  };
+  Ctx.getExternalSource()->completeVisibleDeclsMapForCompletion(NS, Filter);
+  EXPECT_TRUE(NS->hasExternalVisibleStorage());
+  // Deserializing a guide also loads its template. Checking the template before
+  // lookup therefore proves that neither its name nor its guides were loaded.
+  EXPECT_TRUE(NS->noload_lookup(OrdinaryName).empty());
+  auto *Ordinary = cast<ClassTemplateDecl>(NS->lookup(OrdinaryName).front());
+  auto GuideName = Ctx.DeclarationNames.getCXXDeductionGuideName(Ordinary);
+  auto Guides = NS->lookup(GuideName);
+  ASSERT_FALSE(Guides.empty());
+  bool HasExplicitGuide = false;
+  for (auto *D : Guides) {
+    if (auto *Template = dyn_cast<FunctionTemplateDecl>(D))
+      D = Template->getTemplatedDecl();
+    ASSERT_TRUE(isa<CXXDeductionGuideDecl>(D));
+    HasExplicitGuide |= !D->isImplicit();
+  }
+  EXPECT_TRUE(HasExplicitGuide);
+  Ctx.getExternalSource()->completeVisibleDeclsMap(NS);
+  EXPECT_FALSE(NS->hasExternalVisibleStorage());
+  EXPECT_FALSE(NS->lookup(GuideName).empty());
