+ModulesBuilder::CompletionInputs ModulesBuilder::getCompletionInputs(
+    PathRef File, const ThreadsafeFS &TFS, llvm::StringRef Contents,
+    const tooling::CompileCommand &Command, const CompilerInvocation &CI) {
+  RequestModuleFS MainFS(TFS, File, Contents);
+  auto MDB = Impl->getCDB().getProjectModules(File);
+  if (!MDB)
+    return {};
+  MDB->setFileSystem(MainFS);
+  auto Inputs = MDB->getRequiredModulesAndInputs(File);
+  CompletionInputs Result{std::move(Inputs.RequiredModules), std::nullopt};
+  const auto &Lang = CI.getLangOpts();
+  const auto &HS = CI.getHeaderSearchOpts();
+  if (!Inputs.OrdinaryTU || !Lang.CPlusPlus || !Lang.CPlusPlus20 || Lang.ObjC ||
+      HS.ImplicitModuleMaps || !CI.getFrontendOpts().ModuleMapFiles.empty() ||
+      !CI.getFrontendOpts().ModuleFiles.empty() ||
+      !CI.getPreprocessorOpts().ImplicitPCHInclude.empty())
+    return Result;
+  auto ScanCommand = MDB->getCompileCommand(File);
+  if (!ScanCommand || ScanCommand->Directory != Command.Directory ||
+      ScanCommand->Filename != Command.Filename ||
+      ScanCommand->CommandLine != Command.CommandLine)
+    return Result;
+  auto Bounds = Lexer::ComputePreamble(Contents, Lang);
+  if (!Bounds.Size)
+    return Result;
+  RequestModuleFS PrefixFS(TFS, File, Contents.take_front(Bounds.Size));
+  MDB->setFileSystem(PrefixFS);
+  Result.TextualPreamble = MDB->getVerifiedInputs(File, /*ImportFree=*/true);
+  return Result;
+}
