+// Whether Offset lies in the file's leading module and import declarations
+// (or the directives among them), where completion names a module and needs
+// nothing the modules export. An unfinished declaration owns its line, and a
+// blank line between two of them is among them.
+bool inModuleDeclarations(llvm::StringRef Code, unsigned Offset,
+                          const LangOptions &LangOpts) {
+  const SourceLocation Start = SourceLocation::getFromRawEncoding(1);
+  Lexer Lex(Start, LangOpts, Code.begin(), Code.begin(), Code.end());
+  auto OffsetOf = [&](const Token &T) {
+    return T.getLocation().getRawEncoding() - Start.getRawEncoding();
+  };
+  Token Tok;
+  Lex.LexFromRawLexer(Tok);
+  while (Tok.isNot(tok::eof)) {
+    const bool Ahead = OffsetOf(Tok) > Offset;
+    if (Tok.isAtStartOfLine() && Tok.is(tok::hash)) {
+      if (Ahead)
+        return true;
+      do
+        Lex.LexFromRawLexer(Tok);
+      while (Tok.isNot(tok::eof) && !Tok.isAtStartOfLine());
+      continue;
+    }
+    if (Tok.is(tok::raw_identifier) && Tok.getRawIdentifier() == "export")
+      Lex.LexFromRawLexer(Tok);
+    if (Tok.isNot(tok::raw_identifier) ||
+        (Tok.getRawIdentifier() != "import" &&
+         Tok.getRawIdentifier() != "module"))
+      return false;
+    if (Ahead)
+      return true;
+    Token Last = Tok;
+    while (true) {
+      Lex.LexFromRawLexer(Tok);
+      if (Tok.is(tok::semi)) {
+        if (Offset <= OffsetOf(Tok))
+          return true;
+        Lex.LexFromRawLexer(Tok);
+        break;
+      }
+      if (Tok.is(tok::eof) || Tok.isAtStartOfLine()) {
+        size_t LineEnd = Code.find('\n', OffsetOf(Last) + Last.getLength());
+        if (Offset <= std::min(LineEnd, Code.size()))
+          return true;
+        break;
+      }
+      Last = Tok;
+    }
+  }
+  return false;
+}
