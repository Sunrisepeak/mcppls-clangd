+// A draft's body, the text after its preamble, adds to what the preamble's own
+// scan finds only its `import` declarations when it holds no directive and no
+// module declaration: preprocessing it reads no file and defines nothing an
+// import depends on. Such a draft is scanned as its preamble -- a scan that
+// stays memoized while only the body changes, keystroke after keystroke -- plus
+// those imports. A body this cannot vouch for is scanned whole.
+struct DraftParts {
+  llvm::StringRef Prefix;
+  std::vector<std::string> BodyImports;
+};
+
+LangOptions draftLangOptions() {
+  LangOptions Lang;
+  Lang.CPlusPlus = Lang.CPlusPlus11 = Lang.CPlusPlus14 = Lang.CPlusPlus17 = 1;
+  Lang.CPlusPlus20 = Lang.CPlusPlusModules = 1;
+  return Lang;
+}
+
+std::optional<DraftParts> splitDraft(llvm::StringRef Contents,
+                                     const LangOptions &Lang) {
+  auto Bounds = Lexer::ComputePreamble(Contents, Lang);
+  if (Bounds.Size && !Bounds.PreambleEndsAtStartOfLine)
+    return std::nullopt;
+  DraftParts Parts{Contents.take_front(Bounds.Size), {}};
+  llvm::StringRef Body = Contents.drop_front(Bounds.Size);
+  Lexer Lex(SourceLocation::getFromRawEncoding(1), Lang, Body.begin(),
+            Body.begin(), Body.end());
+  Token Tok;
+  Lex.LexFromRawLexer(Tok);
+  while (Tok.isNot(tok::eof)) {
+    if (!Tok.isAtStartOfLine()) {
+      Lex.LexFromRawLexer(Tok);
+      continue;
+    }
+    if (Tok.is(tok::hash))
+      return std::nullopt;
+    if (Tok.is(tok::raw_identifier) && Tok.getRawIdentifier() == "export")
+      Lex.LexFromRawLexer(Tok);
+    if (Tok.is(tok::raw_identifier) && Tok.getRawIdentifier() == "module")
+      return std::nullopt;
+    if (!Tok.is(tok::raw_identifier) || Tok.getRawIdentifier() != "import") {
+      Lex.LexFromRawLexer(Tok);
+      continue;
+    }
+    // A named module only; a partition, a header unit, an attribute or an
+    // unfinished name is left to the scanner.
+    std::string Name;
+    bool AfterDot = true;
+    for (Lex.LexFromRawLexer(Tok); Tok.isNot(tok::semi);
+         Lex.LexFromRawLexer(Tok)) {
+      if (Tok.is(tok::raw_identifier) && AfterDot)
+        Name += Tok.getRawIdentifier();
+      else if (Tok.is(tok::period) && !AfterDot)
+        Name += '.';
+      else
+        return std::nullopt;
+      AfterDot = Tok.is(tok::period);
+    }
+    if (Name.empty() || AfterDot)
+      return std::nullopt;
+    if (!llvm::is_contained(Parts.BodyImports, Name))
+      Parts.BodyImports.push_back(std::move(Name));
+    Lex.LexFromRawLexer(Tok);
+  }
+  return Parts;
+}
+
+void addBodyImports(std::vector<std::string> &Names,
+                    const std::optional<DraftParts> &Parts) {
+  if (!Parts)
+    return;
+  for (const auto &Name : Parts->BodyImports)
+    if (!llvm::is_contained(Names, Name))
+      Names.push_back(Name);
+}
