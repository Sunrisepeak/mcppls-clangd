+TEST_F(NamespaceLookupTest, SelectedNamesPreserveImportedAndMergedOverloads) {
+  const char *Types[] = {"int", "double", "char", "long", "float"};
+  std::string Imports;
+  for (unsigned I = 0; I != 5; ++I) {
+    auto Name = "Select" + std::to_string(I);
+    GenerateModuleInterface(Name, "export module " + Name +
+        ";\nexport namespace N { int selected(" + Types[I] +
+        "*); int omitted(" + Types[I] + "*); int anchor(" + Types[I] + "*); }");
+    Imports += "import " + Name + ";\n";
+  }
+  auto Args = std::vector<std::string>{
+      "-std=c++20", "-fprebuilt-module-path=" + TestDir.str().str()};
+  // Exercise both independent on-disk tables and an already merged table.
+  for (bool MergeFirst : {false, true})
+    EXPECT_TRUE(runToolOnCodeWithArgs(
+        std::make_unique<SelectedNamespaceAction>(5, MergeFirst), Imports,
+        Args, "main.cpp"));
+}
