+//===--- ModuleScanEpoch.h ---------------------------------------*- C++-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULESCANEPOCH_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULESCANEPOCH_H
+
+#include "support/Context.h"
+#include <atomic>
+#include <cstdint>
+
+namespace clang::clangd {
+
+// One operation (a document update, a completion) replays each memoized
+// dependency scan at most once: within it, the inputs a scan observed are taken
+// as they were when the operation first replayed them, however many of its
+// queries ask for that scan. The operation sets a fresh epoch; a lookup outside
+// one replays every time, as does a preamble build, whose audit must see the
+// inputs as they are after it.
+inline constexpr Key<uint64_t> ModuleScanReplayEpoch;
+
+inline uint64_t nextModuleScanReplayEpoch() {
+  static std::atomic<uint64_t> Next{0};
+  return ++Next;
+}
+
+} // namespace clang::clangd
+
+#endif
