+TEST_F(NamespaceLookupTest, SelectedNamesPreserveOverridingModuleTables) {
+  std::string Imports;
+  std::string Reexports = "export module Combined;\n";
+  const char *Types[] = {"int", "double", "char", "long", "float"};
+  for (unsigned I = 0; I != 5; ++I) {
+    auto Name = "Select" + std::to_string(I);
+    GenerateModuleInterface(Name, "export module " + Name +
+        ";\nexport namespace N { int selected(" + Types[I] +
+        "*); int omitted(" + Types[I] + "*); int anchor(" + Types[I] + "*); }");
+    Imports += "import " + Name + ";\n";
+    Reexports += "export import " + Name + ";\n";
+  }
+  // The ordinary lookup condenses imported namespace tables before the writer
+  // emits the namespace update. Its table replaces those imported tables.
+  Reexports += "int force_lookup = N::anchor((int*)nullptr);\n"
+               "export namespace N { int selected(unsigned*); "
+               "int omitted(unsigned*); int anchor(unsigned*); }\n";
+  GenerateModuleInterface("Combined", Reexports);
+  Imports += "import Combined;\n";
+  EXPECT_TRUE(runToolOnCodeWithArgs(
+      std::make_unique<SelectedNamespaceAction>(6, false), Imports,
+      {"-std=c++20", "-fprebuilt-module-path=" + TestDir.str().str()},
+      "main.cpp"));
+}
