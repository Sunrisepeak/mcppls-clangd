+TEST(CompletionTest, SelectedExternalTUNamesPreserveOrdinaryLookup) {
+  TestTU TU;
+  TU.HeaderCode = "int visible(int); int visible(double); int unrelated();";
+  auto AST = TU.build();
+  ASSERT_TRUE(AST.getDiagnostics().empty());
+  auto &Ctx = AST.getASTContext();
+  auto *DC = Ctx.getTranslationUnitDecl();
+  auto *Visible = &Ctx.Idents.get("visible");
+  auto *Unrelated = &Ctx.Idents.get("unrelated");
+  ASSERT_TRUE(DC->noload_lookup(Visible).empty());
+  ASSERT_TRUE(DC->noload_lookup(Unrelated).empty());
+  auto Filter = [](llvm::StringRef Name) { return Name == "visible"; };
+  Ctx.getExternalSource()->completeVisibleDeclsMapForCompletion(DC, Filter);
+  EXPECT_EQ(llvm::range_size(DC->noload_lookup(Visible)), 2u);
+  EXPECT_TRUE(DC->noload_lookup(Unrelated).empty());
+  EXPECT_TRUE(DC->hasExternalVisibleStorage());
+  EXPECT_EQ(llvm::range_size(DC->lookup(Unrelated)), 1u);
+  Ctx.getExternalSource()->completeVisibleDeclsMap(DC);
+  EXPECT_FALSE(DC->hasExternalVisibleStorage());
+  EXPECT_EQ(llvm::range_size(DC->lookup(Visible)), 2u);
+}
