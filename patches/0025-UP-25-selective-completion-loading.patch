+struct ModulesBuilder::BoundedBuild {
+  std::string Contents;
+  Canceler Cancel;
+  std::mutex Mu;
+  std::condition_variable Finished;
+  bool Done = false;
+  std::unique_ptr<PrerequisiteModules> Result;
+};
+
+std::unique_ptr<PrerequisiteModules>
+ModulesBuilder::buildPrerequisiteModulesWithin(PathRef File,
+                                               const ThreadsafeFS &TFS,
+                                               llvm::StringRef Contents,
+                                               std::chrono::milliseconds Wait) {
+  const std::string Key = maybeCaseFoldPath(File);
+  std::shared_ptr<BoundedBuild> Build;
+  {
+    std::lock_guard<std::mutex> Lock(BoundedMutex);
+    auto &Running = BoundedBuilds[Key];
+    if (!Running) {
+      Running = std::make_shared<BoundedBuild>();
+      Running->Contents = Contents.str();
+      auto Task = cancelableTask();
+      Running->Cancel = std::move(Task.second);
+      WithContext Cancelable(std::move(Task.first));
+      BoundedRunner.runAsync(
+          "prerequisites:" + llvm::sys::path::filename(File),
+          [this, Build = Running, Key, File = File.str(), &TFS] {
+            auto Result =
+                buildPrerequisiteModulesFor(File, TFS, Build->Contents);
+            {
+              std::lock_guard<std::mutex> Lock(BoundedMutex);
+              auto It = BoundedBuilds.find(Key);
+              if (It != BoundedBuilds.end() && It->second == Build)
+                BoundedBuilds.erase(It);
+            }
+            std::lock_guard<std::mutex> Lock(Build->Mu);
+            Build->Result = std::move(Result);
+            Build->Done = true;
+            Build->Finished.notify_all();
+          });
+    }
+    Build = Running;
+  }
+  std::unique_lock<std::mutex> Lock(Build->Mu);
+  if (!Build->Finished.wait_for(Lock, Wait, [&] { return Build->Done; }) ||
+      Build->Contents != Contents)
+    return nullptr;
+  return std::move(Build->Result);
+}
+
+void ModulesBuilder::stopBackgroundBuilds() {
+  {
+    std::lock_guard<std::mutex> Lock(BoundedMutex);
+    for (auto &Running : BoundedBuilds)
+      Running.second->Cancel();
+  }
+  BoundedRunner.wait();
+}
