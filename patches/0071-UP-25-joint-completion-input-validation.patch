 clang-tools-extra/clangd/ModulesBuilder.cpp   | 31 ++++++++++++
 clang-tools-extra/clangd/ModulesBuilder.h     | 11 +++++
 clang-tools-extra/clangd/ProjectModules.cpp   | 15 ++++++
 clang-tools-extra/clangd/ProjectModules.h     | 11 +++++
 .../unittests/PrerequisiteModulesTest.cpp     | 48 +++++++++++++++++++
 6 files changed, 130 insertions(+), 3 deletions(-)

