+
   /// Returns the list of directly required module names
   std::vector<std::string> getRequiredModuleNames(PathRef File);
   std::vector<std::string> getRequiredModuleNames(PathRef File,
diff --git a/clang-tools-extra/clangd/ProjectModules.cpp b/clang-tools-extra/clangd/ProjectModules.cpp
index 4258a891a..457c40370 100644
--- a/clang-tools-extra/clangd/ProjectModules.cpp
+++ b/clang-tools-extra/clangd/ProjectModules.cpp
@@ -569,6 +569,17 @@ public:
     return Scanner.getRequiredModules(File, Mangler);
   }
 
+  RequiredModulesAndInputs getRequiredModulesAndInputs(PathRef File) override {
+    auto Result = Scanner.scan(File, Mangler);
+    if (!Result)
+      return {};
+    RequiredModulesAndInputs Inputs;
+    Inputs.RequiredModules = std::move(Result->RequiredModules);
+    if (!Result->ModuleName && !Result->VerifiedInputsKey.empty())
