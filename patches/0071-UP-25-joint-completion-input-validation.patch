   const PrerequisiteModules *RequiredModules = Input.Preamble.RequiredModules.get();
   std::unique_ptr<PrerequisiteModules> FreshModules;
   bool ReusePreamble = true;
+  std::optional<ModulesBuilder::CompletionInputs> CompletionInputs;
   // Body edits can safely use a stale preamble, but dependency edits cannot:
   // its copy-on-read BMIs describe the old exports even after the current AST
   // update has noticed the invalidation. Validate against this request's VFS.
   if (RequiredModules && Input.ParseInput.ModulesManager) {
     trace::Span ModuleTracer("Completion module validation");
-    auto CurrentNames = Input.ParseInput.ModulesManager->getRequiredModuleNames(
-        Input.FileName, *Input.ParseInput.TFS, Input.ParseInput.Contents);
+    std::vector<std::string> CurrentNames;
+    if (Input.Preamble.TextualModuleInputs) {
+      CompletionInputs = Input.ParseInput.ModulesManager->getCompletionInputs(
+          Input.FileName, *Input.ParseInput.TFS, Input.ParseInput.Contents,
+          Input.ParseInput.CompileCommand, *CI);
+      CurrentNames = std::move(CompletionInputs->RequiredModules);
+    } else {
+      CurrentNames = Input.ParseInput.ModulesManager->getRequiredModuleNames(
+          Input.FileName, *Input.ParseInput.TFS, Input.ParseInput.Contents);
+    }
     llvm::StringSet<> CurrentNameSet;
     for (const auto &Name : CurrentNames)
       CurrentNameSet.insert(Name);
@@ -1430,7 +1439,9 @@ bool semaCodeComplete(std::unique_ptr<CodeCompleteConsumer> Consumer,
     }
   }
   if (Input.Preamble.TextualModuleInputs) {
-    auto Current = Input.ParseInput.ModulesManager
+    auto Current = CompletionInputs
+                       ? std::move(CompletionInputs->TextualPreamble)
+                       : Input.ParseInput.ModulesManager
                        ? Input.ParseInput.ModulesManager->getTextualPreambleInputs(
                              Input.FileName, *Input.ParseInput.TFS,
                              Input.ParseInput.Contents,
diff --git a/clang-tools-extra/clangd/ModulesBuilder.cpp b/clang-tools-extra/clangd/ModulesBuilder.cpp
index 9d59502d4..e3bd1c523 100644
--- a/clang-tools-extra/clangd/ModulesBuilder.cpp
+++ b/clang-tools-extra/clangd/ModulesBuilder.cpp
@@ -2324,6 +2324,37 @@ ModulesBuilder::getTextualPreambleInputs(PathRef File, const ThreadsafeFS &TFS,
   return MDB->getVerifiedInputs(File, /*ImportFree=*/true);
 }
 
+ModulesBuilder::CompletionInputs ModulesBuilder::getCompletionInputs(
+    PathRef File, const ThreadsafeFS &TFS, llvm::StringRef Contents,
+    const tooling::CompileCommand &Command, const CompilerInvocation &CI) {
+  RequestModuleFS MainFS(TFS, File, Contents);
+  auto MDB = Impl->getCDB().getProjectModules(File);
+  if (!MDB)
+    return {};
+  MDB->setFileSystem(MainFS);
+  auto Inputs = MDB->getRequiredModulesAndInputs(File);
+  CompletionInputs Result{std::move(Inputs.RequiredModules), std::nullopt};
+  const auto &Lang = CI.getLangOpts();
+  const auto &HS = CI.getHeaderSearchOpts();
+  if (!Inputs.OrdinaryTU || !Lang.CPlusPlus || !Lang.CPlusPlus20 || Lang.ObjC ||
+      HS.ImplicitModuleMaps || !CI.getFrontendOpts().ModuleMapFiles.empty() ||
+      !CI.getFrontendOpts().ModuleFiles.empty() ||
+      !CI.getPreprocessorOpts().ImplicitPCHInclude.empty())
+    return Result;
+  auto ScanCommand = MDB->getCompileCommand(File);
+  if (!ScanCommand || ScanCommand->Directory != Command.Directory ||
+      ScanCommand->Filename != Command.Filename ||
+      ScanCommand->CommandLine != Command.CommandLine)
+    return Result;
+  auto Bounds = Lexer::ComputePreamble(Contents, Lang);
+  if (!Bounds.Size)
+    return Result;
+  RequestModuleFS PrefixFS(TFS, File, Contents.take_front(Bounds.Size));
+  MDB->setFileSystem(PrefixFS);
+  Result.TextualPreamble = MDB->getVerifiedInputs(File, /*ImportFree=*/true);
+  return Result;
+}
+
 bool ModulesBuilder::hasBuildableRequiredModules(PathRef File,
                                                  const ThreadsafeFS &TFS,
                                                  llvm::StringRef Contents) {
diff --git a/clang-tools-extra/clangd/ModulesBuilder.h b/clang-tools-extra/clangd/ModulesBuilder.h
