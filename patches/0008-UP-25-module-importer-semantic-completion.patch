+TEST(ClangdServerTest, CompletionReusesPreambleBuildMode) {
+  class EmptyModules : public ProjectModules {
+  public:
+    std::vector<std::string> getRequiredModules(PathRef) override { return {}; }
+    std::string getModuleNameForSource(PathRef) override { return {}; }
+    std::string getSourceForModuleName(llvm::StringRef, PathRef) override {
+      return {};
+    }
+  };
+  class CountingCDB : public MockCompilationDatabase {
+  public:
+    mutable std::atomic<unsigned> ModuleQueries{0};
+    std::unique_ptr<ProjectModules> getProjectModules(PathRef) const override {
+      ++ModuleQueries;
+      return std::make_unique<EmptyModules>();
+    }
+  } CDB;
+  MockFS FS;
+  ErrorCheckingCallbacks DiagConsumer;
+  ModulesBuilder Modules(CDB);
+  auto Options = ClangdServer::optsForTest();
+  Options.ModulesManager = &Modules;
+  ClangdServer Server(CDB, FS, Options, &DiagConsumer);
+  auto File = testPath("mode.cpp");
+  Annotations Code("#define VALUE 1\nint value;\nvoid f() { val^; }\n");
+  Server.addDocument(File, Code.code());
+  ASSERT_TRUE(Server.blockUntilIdleForTest());
+  CDB.ModuleQueries = 0;
+  auto Result = cantFail(runCodeComplete(Server, File, Code.point(), {}));
+  EXPECT_THAT(Result.Completions,
+              Contains(Field(&CodeCompletion::Name, "value")));
+  // The late semantic freshness check still obtains the current module names.
+  // No separate provider inventory is needed just to patch this preamble.
+  EXPECT_EQ(CDB.ModuleQueries.load(), 1u);
+}
