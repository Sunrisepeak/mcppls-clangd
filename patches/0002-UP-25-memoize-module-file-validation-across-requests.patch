+/// Records the (size, mtime) identity of every user input file a successful
+/// validation read, so its verdict can be memoized. Inputs read through an
+/// overlay buffer (unsaved edits) or missing on disk make the verdict
+/// unrecordable - the fast path re-stats real files, so such validations are
+/// simply not memoized.
+void recordValidationInputs(
+    ASTReader &Reader, ModuleValidationCache &Cache, PathRef ModuleFilePath,
+    llvm::StringRef ChainKey) {
+  std::vector<std::pair<std::string, ModuleValidationCache::FileIdentity>>
+      Inputs;
+  bool Unrecordable = false;
+  for (serialization::ModuleFile &MF : Reader.getModuleManager()) {
+    Reader.visitInputFiles(MF, /*IncludeSystem=*/false, /*Complain=*/false,
+                           [&](const serialization::InputFile &IF, bool) {
+      if (Unrecordable)
+        return;
+      auto FE = IF.getFile();
+      if (!FE)
+        return;
+      auto Disk = ModuleValidationCache::identityOf(FE->getName());
+      if (!Disk || Disk->Size != static_cast<uint64_t>(FE->getSize()) ||
+          Disk->ModTime != llvm::sys::toTimePoint(FE->getModificationTime())) {
+        Inputs.clear();
+        Unrecordable = true;
+        return;
+      }
+      Inputs.emplace_back(FE->getName().str(), *Disk);
+    });
+  }
+  if (!Unrecordable)
+    Cache.markFresh(ModuleFilePath, ChainKey, std::move(Inputs));
+}
+
 bool IsModuleFileUpToDate(PathRef ModuleFilePath,
                           const PrerequisiteModules &RequisiteModules,
                           llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> VFS) {
   HeaderSearchOptions HSOpts;
-  RequisiteModules.adjustHeaderSearchOptions(HSOpts);
+  RequisiteModules.adjustHeaderSearchOptionsForValidation(HSOpts);
   HSOpts.ForceCheckCXX20ModulesInputFiles = true;
   HSOpts.ValidateASTInputFilesContent = true;
 
+  // Validating a BMI re-hashes all its inputs; the preamble redoes it for
+  // every request reusing the same prerequisite modules. A memoized verdict
+  // (keyed by the BMI, the dependency chain, and the input identities the
+  // validation read) turns that into a handful of stats. Any doubt falls
+  // back to the full validation below.
+  std::string ChainKey;
+  RequisiteModules.getValidationChainKey(ChainKey);
+  ModuleValidationCache &ValidationCache = getModuleValidationCache();
+  if (ValidationCache.isFresh(ModuleFilePath, ChainKey)) {
+    log("Module file {0} is up to date via the validation cache",
+        ModuleFilePath);
+    return true;
+  }
+
   clang::clangd::IgnoreDiagnostics IgnoreDiags;
   DiagnosticOptions DiagOpts;
   IntrusiveRefCntPtr<DiagnosticsEngine> Diags =
@@ -573,9 +684,12 @@ bool IsModuleFileUpToDate(PathRef ModuleFilePath,
   // without treating it as a hard error.
   // ReadAST will validate all input files internally and return OutOfDate
   // if any file is modified.
-  return Reader.ReadAST(ModuleFileName::makeExplicit(ModuleFilePath),
-                        serialization::MK_MainFile, SourceLocation(),
-                        ASTReader::ARR_OutOfDate) == ASTReader::Success;
+  bool Success = Reader.ReadAST(ModuleFileName::makeExplicit(ModuleFilePath),
+                                serialization::MK_MainFile, SourceLocation(),
+                                ASTReader::ARR_OutOfDate) == ASTReader::Success;
+  if (Success)
+    recordValidationInputs(Reader, ValidationCache, ModuleFilePath, ChainKey);
+  return Success;
 }
 
