 }
 
 bool ReusablePrerequisiteModules::canReuse(
@@ -712,9 +827,24 @@ bool ReusablePrerequisiteModules::canReuse(
   if (RequiredModules.empty())
     return true;
 
-  llvm::SmallVector<llvm::StringRef> BMIPaths;
-  for (auto &MF : RequiredModules)
-    BMIPaths.push_back(MF->getModuleFilePath());
+  // Validate the published files where possible: they are stable across
+  // requests, so their validation results can be memoized. A copy-on-read
+  // view may be validated via its published source only while that source is
+  // unchanged; once the published file was replaced, only the view itself
+  // knows the inputs it was built for, so the view gets validated directly.
+  llvm::SmallVector<PathRef> BMIPaths;
+  for (auto &MF : RequiredModules) {
+    if (!MF->getPublishedSourceIdentity()) {
+      BMIPaths.push_back(MF->getModuleFilePath());
+      continue;
+    }
+    auto Current =
+        ModuleValidationCache::identityOf(MF->getPublishedModuleFilePath());
+    if (Current && *Current == *MF->getPublishedSourceIdentity())
+      BMIPaths.push_back(MF->getPublishedModuleFilePath());
+    else
+      BMIPaths.push_back(MF->getModuleFilePath());
+  }
   return IsModuleFilesUpToDate(BMIPaths, *this, VFS);
 }
 
