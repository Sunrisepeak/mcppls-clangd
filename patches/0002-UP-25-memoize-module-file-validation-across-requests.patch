+  /// Validation of built module files reads the *published* BMI paths, which
+  /// are stable across requests, while parsing consumes the copy-on-read
+  /// files handed out by adjustHeaderSearchOptions. Validation results are
+  /// memoized per (BMI, chain), so the published paths keep the memo key
+  /// stable. The default mirrors adjustHeaderSearchOptions.
+  virtual void
+  adjustHeaderSearchOptionsForValidation(HeaderSearchOptions &Options) const {
+    adjustHeaderSearchOptions(Options);
+  }
+
+  /// A stable fingerprint of the dependency chain validation resolves
+  /// imports against. Two objects with the same key have identically shaped
+  /// validations. The default (empty) means results are not memoized.
+  virtual void getValidationChainKey(std::string &) const {}
+
   virtual ~PrerequisiteModules() = default;
 };
 
diff --git a/clang-tools-extra/clangd/test/Inputs/modules-cache-driver.py b/clang-tools-extra/clangd/test/Inputs/modules-cache-driver.py
new file mode 100644
index 000000000..58058c2b2
--- /dev/null
+++ b/clang-tools-extra/clangd/test/Inputs/modules-cache-driver.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Drives clangd through the module validation-cache scenario.
+
+Run: %python modules-cache-driver.py <clangd> <workdir>
+
+Creates a small module project, then requests three completions on the same
+file, each after a body-only edit that keeps the preamble valid:
+  round 1: the prerequisite module is built and validated (cold);
+  round 2: the preamble-compatibility check re-validates the published BMI
+           (cold - the dependency chain now contains the module itself);
+  round 3: the compatibility check must hit the validation cache.
+
+The driver asserts both the build and the cache hit appeared in clangd's log,
+and exits non-zero otherwise.
+"""
+import json
+import os
+import subprocess
+import sys
+import time
+
+CLANGD, TMP = sys.argv[1], os.path.abspath(sys.argv[2])
+CLANG = sys.argv[3]
+os.makedirs(TMP, exist_ok=True)
+
+with open(os.path.join(TMP, "A.cppm"), "w") as F:
+    F.write("export module A;\nexport void printA() {}\n")
+
+USE = "import A;\nvoid foo() {\n    printA();\n}\n"
+
+with open(os.path.join(TMP, "Use.cpp"), "w") as F:
+    F.write(USE)
+
+with open(os.path.join(TMP, "compile_commands.json"), "w") as F:
+    F.write(json.dumps([
+        {"directory": TMP,
+         "command": CLANG + " -std=c++20 -o " + TMP + "/Use.cpp.o -c " + TMP + "/Use.cpp",
+         "file": TMP + "/Use.cpp"},
+        {"directory": TMP,
+         "command": CLANG + " -std=c++20 " + TMP + "/A.cppm --precompile -o " + TMP + "/A.pcm",
+         "file": TMP + "/A.cppm"},
+    ]))
+
+LOG = os.path.join(TMP, "log")
+Proc = subprocess.Popen([CLANGD, "--experimental-modules-support", "--lit-test"],
+                        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
+                        stderr=open(LOG, "w"))
+
+_next_id = 0
+def send(Method, Params=None, Notify=False):
+    global _next_id
+    Msg = {"jsonrpc": "2.0", "method": Method}
+    if Params is not None:
+        Msg["params"] = Params
+    if not Notify:
+        _next_id += 1
+        Msg["id"] = _next_id
+    Proc.stdin.write(b"---\n" + json.dumps(Msg).encode() + b"\n")
+    Proc.stdin.flush()
+
+USE_URI = "file://" + TMP + "/Use.cpp"
+
+send("initialize", {"processId": 123, "rootPath": TMP, "capabilities": {}})
+send("initialized", {}, Notify=True)
+
+def round_n(Version, Body):
+    if Version == 1:
+        send("textDocument/didOpen",
+             {"textDocument": {"uri": USE_URI, "languageId": "cpp", "version": 1,
+                               "text": Body}},
+             Notify=True)
+    else:
+        send("textDocument/didChange",
+             {"textDocument": {"uri": USE_URI, "version": Version},
+              "contentChanges": [{"text": Body}]},
+             Notify=True)
+    time.sleep(0.2)
+    send("textDocument/completion",
+         {"textDocument": {"uri": USE_URI}, "position": {"line": 2, "character": 4}})
+    time.sleep(4)
+
+round_n(1, USE)
+round_n(2, "import A;\nvoid foo() {\n    printA();\n    (void)0;\n}\n")
+round_n(3, "import A;\nvoid foo() {\n    printA();\n    (void)0;\n    (void)0;\n}\n")
+
+send("shutdown", None)
+send("exit", None, Notify=True)
+Proc.stdin.close()
+try:
+    Proc.wait(timeout=30)
+except subprocess.TimeoutExpired:
+    Proc.kill()
+    sys.exit("clangd did not exit")
+
+LogText = open(LOG, errors="replace").read()
+Failures = []
+if "Built module A to" not in LogText:
+    Failures.append("module A was never built")
+if "is up to date via the validation cache" not in LogText:
+    Failures.append("validation cache was never hit on the third round")
+if Failures:
+    sys.exit("modules-cache-driver: FAILED:\n  " + "\n  ".join(Failures) +
+             "\nlog:\n" + LogText[-4000:])
+print("modules-cache-driver: OK")
