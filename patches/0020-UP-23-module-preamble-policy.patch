+TEST(PreambleTest, TraceFilenameSurvivesRetainedCallbackContext) {
+  MockFS FS;
+  auto TU = TestTU::withCode("#define VALUE 1\nint value = VALUE;\n");
+  auto Inputs = TU.inputs(FS);
+  IgnoreDiagnostics Diags;
+  auto CI = buildCompilerInvocation(Inputs, Diags);
+  ASSERT_TRUE(CI);
+  const std::string Expected = testPath(TU.Filename);
+  std::string Filename = Expected;
+  std::string JSON;
+  llvm::raw_string_ostream OS(JSON);
+  auto Tracer = trace::createJSONTracer(OS);
+  {
+    trace::Session Session(*Tracer);
+    std::optional<Context> Retained;
+    auto Preamble = buildPreamble(
+        Filename, *CI, Inputs, true,
+        [&](CapturedASTCtx, std::shared_ptr<const include_cleaner::PragmaIncludes>) {
+          Retained.emplace(Context::current().clone());
+        });
+    ASSERT_TRUE(Preamble);
+    ASSERT_TRUE(Retained);
+    // The real callback retained the BuildPreamble span. Overwrite the caller's
+    // storage after return, before releasing the asynchronous event context.
+    Filename.assign(Filename.size(), 'x');
+    Retained.reset();
+  }
+  Tracer.reset();
+  auto Parsed = llvm::json::parse(JSON);
+  ASSERT_TRUE(static_cast<bool>(Parsed)) << llvm::toString(Parsed.takeError());
+  auto *Events = Parsed->getAsObject()->getArray("traceEvents");
+  ASSERT_TRUE(Events);
+  bool Found = false;
+  for (const auto &Event : *Events) {
+    const auto *Object = Event.getAsObject();
+    if (!Object || Object->getString("name") != "BuildPreamble")
+      continue;
+    Found = true;
+    const auto *Args = Object->getObject("args");
+    ASSERT_TRUE(Args);
+    EXPECT_EQ(Args->getString("File"), Expected);
+  }
+  EXPECT_TRUE(Found);
+}
