+TEST_F(PrerequisiteModulesTests, PreambleBuildResolvesLateModuleImport) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+  Annotations UseCpp("#include \"Header.hpp\"\nvoid use() { fn_^; }\n");
+  CDB.addFile("M.cppm", "export module M;\nexport int fn_m() { return 1; }\n");
+  CDB.addFile("Header.hpp", "import M;\n");
+  CDB.addFile("Use.cpp", UseCpp.code());
+  ModulesBuilder Builder(CDB);
+  auto Inputs = getInputs("Use.cpp", CDB);
+  Inputs.ModulesManager = &Builder;
+  Inputs.Opts.SkipPreambleBuild = false;
+  auto CI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(CI);
+
+  // Simulate a preliminary update policy that ran before the header import
+  // became visible. Actual attached prerequisites must keep the import textual.
+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Inputs,
+                                /*StoreInMemory=*/true, nullptr);
+  ASSERT_TRUE(Preamble);
+  EXPECT_TRUE(Preamble->SkipPreambleBuild);
+  EXPECT_EQ(Preamble->Preamble.getBounds().Size, 0u);
+  EXPECT_TRUE(Preamble->Diags.empty());
+  EXPECT_TRUE(isPreambleCompatible(*Preamble, Inputs, getFullPath("Use.cpp"), *CI));
+  ASSERT_TRUE(Preamble->RequiredModules);
+  HeaderSearchOptions ModuleOptions;
+  Preamble->RequiredModules->adjustHeaderSearchOptions(ModuleOptions);
+  ASSERT_EQ(ModuleOptions.PrebuiltModuleFiles.count("M"), 1u);
+  const auto ReadCopy = ModuleOptions.PrebuiltModuleFiles.at("M");
+  EXPECT_TRUE(llvm::sys::fs::exists(ReadCopy));
+  // ClangdServer carries the actual published preamble mode into completion.
+  Inputs.Opts.SkipPreambleBuild = Preamble->SkipPreambleBuild;
+  for (unsigned Request = 0; Request != 2; ++Request) {
+    auto Result = codeComplete(getFullPath("Use.cpp"), UseCpp.point(),
+                               Preamble.get(), Inputs, {});
+    EXPECT_THAT(Result.Completions, testing::Contains(named("fn_m")));
+    EXPECT_TRUE(llvm::sys::fs::exists(ReadCopy));
+  }
+  Preamble.reset();
+  EXPECT_FALSE(llvm::sys::fs::exists(ReadCopy));
+}
