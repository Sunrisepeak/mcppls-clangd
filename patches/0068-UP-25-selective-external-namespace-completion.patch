+TEST(CompletionTest, ExternalNameFilterScopeIsSynchronous) {
+  class Source : public ExternalASTSource {
+  public:
+    IdentifierTable Idents;
+    std::vector<bool> SawFilter;
+    bool Recurse = false;
+    void completeVisibleDeclsMap(const DeclContext *DC) override {
+      auto Filter = takeCompletionNameFilter(DC);
+      SawFilter.push_back(bool(Filter));
+      if (Filter) {
+        EXPECT_TRUE(Filter(&Idents.get("selected")));
+        EXPECT_FALSE(Filter(&Idents.get("ordinary")));
+        if (Recurse) {
+          Recurse = false;
+          completeVisibleDeclsMap(DC);
+        }
+      }
+    }
+  } External;
+  External.Recurse = true;
+  unsigned Calls = 0;
+  auto Filter = [&](const IdentifierInfo *II) {
+    ++Calls;
+    return II->getName() == "selected";
+  };
+  External.completeVisibleDeclsMapForCompletion(nullptr, Filter);
+  EXPECT_THAT(External.SawFilter, ElementsAre(true, false));
+  EXPECT_EQ(Calls, 2u);
+  External.completeVisibleDeclsMap(nullptr);
+  EXPECT_THAT(External.SawFilter, ElementsAre(true, false, false));
+  EXPECT_EQ(Calls, 2u);
+}
+
+TEST(CompletionTest, ExternalNameFilterScopeClearsAfterCancelledReturn) {
+  class Source : public ExternalASTSource {
+  public:
+    IdentifierTable Idents;
+    std::vector<bool> SawFilter;
+    void completeVisibleDeclsMap(const DeclContext *DC) override {
+      auto Filter = takeCompletionNameFilter(DC);
+      SawFilter.push_back(bool(Filter));
+      if (Filter) {
+        Filter(&Idents.get("selected"));
+        if (isCancelled())
+          return;
+      }
+    }
+  } External;
+  auto Task = cancelableTask();
+  unsigned Calls = 0;
+  {
+    WithContext Context(std::move(Task.first));
+    auto Filter = [&](const IdentifierInfo *) {
+      ++Calls;
+      Task.second();
+      return false;
+    };
+    External.completeVisibleDeclsMapForCompletion(nullptr, Filter);
+    EXPECT_TRUE(isCancelled());
+  }
+  EXPECT_FALSE(isCancelled());
+  External.completeVisibleDeclsMap(nullptr);
+  EXPECT_THAT(External.SawFilter, ElementsAre(true, false));
+  EXPECT_EQ(Calls, 1u);
+}
+
+TEST(CompletionTest, SelectedExternalNamesPreserveOrdinaryLookup) {
+  TestTU TU;
+  TU.HeaderCode = "namespace api { int selected; int ordinary; }";
+  auto AST = TU.build();
+  auto &Ctx = AST.getASTContext();
+  auto *TUDecl = Ctx.getTranslationUnitDecl();
+  auto Names = TUDecl->lookup(&Ctx.Idents.get("api"));
+  ASSERT_FALSE(Names.empty());
+  auto *NS = cast<NamespaceDecl>(Names.front())->getPrimaryContext();
+  ASSERT_TRUE(NS->hasExternalVisibleStorage());
+  ASSERT_TRUE(NS->noload_lookup(&Ctx.Idents.get("ordinary")).empty());
+  auto Filter = [](const IdentifierInfo *II) {
+    return II->getName() == "selected";
+  };
+  Ctx.getExternalSource()->completeVisibleDeclsMapForCompletion(NS, Filter);
+  EXPECT_TRUE(NS->hasExternalVisibleStorage());
+  EXPECT_TRUE(NS->noload_lookup(&Ctx.Idents.get("ordinary")).empty());
+  auto Selected = NS->lookup(&Ctx.Idents.get("selected"));
+  ASSERT_FALSE(Selected.empty());
+  EXPECT_EQ(Selected.front()->getName(), "selected");
+  auto Ordinary = NS->lookup(&Ctx.Idents.get("ordinary"));
+  ASSERT_FALSE(Ordinary.empty());
+  EXPECT_EQ(Ordinary.front()->getName(), "ordinary");
+  Ctx.getExternalSource()->completeVisibleDeclsMap(NS);
+  EXPECT_FALSE(NS->hasExternalVisibleStorage());
+}
+
+TEST(CompletionTest, ExternalQualifiedFuzzyUsingAndOverloads) {
+  TestTU TU;
+  TU.HeaderCode = R"cpp(
+    namespace backing {
+      int vector(int);
+      int vector(double);
+      template<class T> T vector_template(T);
+    }
+    namespace api {
+      using namespace backing;
+      inline namespace abi { int verifier(int); }
+    }
+  )cpp";
+  for (auto Query : {"ve", "v_t", ""}) {
+    Annotations Code("void probe() { api::" + std::string(Query) + "^ }");
+    TU.Code = Code.code().str();
+    CodeCompleteOptions Opts;
+    Opts.ForceLoadPreamble = true;
+    Opts.BundleOverloads = true;
+    auto Result = completions(TU, Code.point(), {}, Opts);
+    EXPECT_THAT(Result.Completions, has("vector_template"));
+    if (llvm::StringRef(Query) != "v_t") {
+      EXPECT_THAT(Result.Completions, has("verifier"));
+      EXPECT_THAT(Result.Completions,
+                  Contains(AllOf(named("vector"),
+                                 Field(&CodeCompletion::BundleSize, 2u))));
+    }
+  }
+}
+
+TEST(CompletionTest, ExternalNameFilterBindsExactSourceAndContext) {
+  auto AST = TestTU::withCode("namespace one {} namespace two {}").build();
+  auto &Ctx = AST.getASTContext();
+  auto *TU = Ctx.getTranslationUnitDecl();
+  auto *One = cast<NamespaceDecl>(TU->lookup(&Ctx.Idents.get("one")).front());
+  auto *Two = cast<NamespaceDecl>(TU->lookup(&Ctx.Idents.get("two")).front());
+  class Source : public ExternalASTSource {
+  public:
+    Source *Other = nullptr;
+    const DeclContext *WrongContext = nullptr;
+    bool Inside = false;
+    std::vector<bool> SawFilter;
+    void completeVisibleDeclsMap(const DeclContext *DC) override {
+      if (!Inside && Other) {
+        Inside = true;
+        // Another source and another context cannot consume this predicate.
+        Other->completeVisibleDeclsMap(DC);
+        SawFilter.push_back(bool(takeCompletionNameFilter(WrongContext)));
+        Inside = false;
+      }
+      SawFilter.push_back(bool(takeCompletionNameFilter(DC)));
+    }
+  } Parent, Other;
+  Parent.Other = &Other;
+  Parent.WrongContext = Two;
+  auto Filter = [](const IdentifierInfo *) { return true; };
+  Parent.completeVisibleDeclsMapForCompletion(One, Filter);
+  EXPECT_THAT(Other.SawFilter, ElementsAre(false));
+  EXPECT_THAT(Parent.SawFilter, ElementsAre(false, true));
+  Parent.Other = nullptr;
+  Parent.completeVisibleDeclsMap(One);
+  EXPECT_THAT(Parent.SawFilter, ElementsAre(false, true, false));
+}
+
+TEST(CompletionTest, ExternalQualifiedAliasAndNameHiding) {
+  TestTU TU;
+  TU.HeaderCode = R"cpp(
+    namespace backing { int vector(int); int vector(double); }
+    namespace api {
+      using namespace backing;
+      int vector;
+      int version();
+    }
+    namespace alias = api;
+  )cpp";
+  Annotations Code("void probe() { alias::ve^ }");
+  TU.Code = Code.code().str();
+  CodeCompleteOptions Opts;
+  Opts.ForceLoadPreamble = true;
+  Opts.BundleOverloads = true;
+  auto Result = completions(TU, Code.point(), {}, Opts);
+  EXPECT_THAT(Result.Completions,
+              Contains(AllOf(named("vector"),
+                             kind(CompletionItemKind::Variable))));
+  EXPECT_THAT(Result.Completions,
+              Contains(AllOf(named("version"),
+                             kind(CompletionItemKind::Function))));
+  // Compare against ordinary local declarations, which have no external map
+  // to select. This retains any qualified hidden-function suggestions too.
+  Annotations InlineCode(TU.HeaderCode + "\nvoid probe() { alias::ve^ }");
+  auto InlineTU = TestTU::withCode(InlineCode.code());
+  auto Complete = completions(InlineTU, InlineCode.point(), {}, Opts);
+  auto Keys = [](const CodeCompleteResult &R) {
+    std::vector<std::string> Keys;
+    for (const auto &C : R.Completions)
+      Keys.push_back(C.Name + "|" + C.RequiredQualifier + "|" + C.Signature +
+                     "|" + C.SnippetSuffix + "|" +
+                     std::to_string(static_cast<unsigned>(C.Kind)) + "|" +
+                     std::to_string(C.BundleSize));
+    llvm::sort(Keys);
+    return Keys;
+  };
+  EXPECT_EQ(Keys(Result), Keys(Complete));
+}
+
 } // namespace
 } // namespace clangd
 } // namespace clang
