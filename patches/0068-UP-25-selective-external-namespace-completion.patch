+namespace {
+bool completionNameMayMatch(
+    serialization::DeclarationNameKey Key,
+    llvm::function_ref<bool(const IdentifierInfo *)> NameMayMatch) {
+  if (Key.getKind() != DeclarationName::Identifier)
+    return true;
+  auto *II = Key.getIdentifier();
+  return !II || NameMayMatch(II);
+}
+bool completionNameMayMatch(
+    std::pair<serialization::DeclarationNameKey, unsigned> Key,
+    llvm::function_ref<bool(const IdentifierInfo *)> NameMayMatch) {
+  return completionNameMayMatch(Key.first, NameMayMatch);
+}
+}
+
 void ASTReader::completeVisibleDeclsMap(const DeclContext *DC) {
   if (!DC->hasExternalVisibleStorage())
     return;
 
+  auto NameMayMatch = takeCompletionNameFilter(DC);
   DeclsMap Decls;
 
   auto findAll = [&](auto &LookupTables, unsigned &NumRead) {
@@ -8983,7 +9000,10 @@ void ASTReader::completeVisibleDeclsMap(const DeclContext *DC) {
 
     NumRead++;
 
-    for (GlobalDeclID ID : It->second.Table.findAll()) {
+    auto IDs = NameMayMatch ? It->second.Table.findAllIf([&](auto Key) {
+      return completionNameMayMatch(Key, NameMayMatch);
+    }) : It->second.Table.findAll();
+    for (GlobalDeclID ID : IDs) {
       NamedDecl *ND = cast<NamedDecl>(GetDecl(ID));
       // Special case for namespaces: There can be a lot of redeclarations of
       // some namespaces, and we import a "key declaration" per imported module.
@@ -9007,7 +9027,10 @@ void ASTReader::completeVisibleDeclsMap(const DeclContext *DC) {
   for (auto &[Name, DS] : Decls)
     SetExternalVisibleDeclsForName(DC, Name, DS);
 
-  const_cast<DeclContext *>(DC)->setHasExternalVisibleStorage(false);
+  // Selected names are complete; the context as a whole may still contain
+  // unloaded names needed by later ordinary lookup.
+  if (!NameMayMatch)
+    const_cast<DeclContext *>(DC)->setHasExternalVisibleStorage(false);
 }
 
