+class SelectedNamespaceConsumer : public ASTConsumer {
+  unsigned ExpectedOverloads;
+  bool MergeBeforeSelection;
+
+public:
+  SelectedNamespaceConsumer(unsigned ExpectedOverloads, bool MergeBeforeSelection)
+      : ExpectedOverloads(ExpectedOverloads),
+        MergeBeforeSelection(MergeBeforeSelection) {}
+
+  void HandleTranslationUnit(ASTContext &Context) override {
+    auto *Reader = dyn_cast_or_null<ASTReader>(Context.getExternalSource());
+    ASSERT_TRUE(Reader);
+    auto Namespaces = Context.getTranslationUnitDecl()->lookup(
+        &Context.Idents.get("N"));
+    ASSERT_FALSE(Namespaces.empty());
+    auto *DC = cast<NamespaceDecl>(Namespaces.front())->getPrimaryContext();
+    auto Selected = DeclarationName(&Context.Idents.get("selected"));
+    auto Omitted = DeclarationName(&Context.Idents.get("omitted"));
+    ASSERT_TRUE(DC->hasExternalVisibleStorage());
+    ASSERT_TRUE(DC->noload_lookup(Selected).empty());
+    ASSERT_TRUE(DC->noload_lookup(Omitted).empty());
+    if (MergeBeforeSelection) {
+      // Five independently imported tables exceed the reader's merge limit.
+      // A lookup for another name condenses them without loading our names.
+      auto Anchor = DeclarationName(&Context.Idents.get("anchor"));
+      EXPECT_EQ(llvm::range_size(DC->lookup(Anchor)), ExpectedOverloads);
+      ASSERT_TRUE(DC->noload_lookup(Selected).empty());
+      ASSERT_TRUE(DC->noload_lookup(Omitted).empty());
+    }
+    auto Filter = [](const IdentifierInfo *II) {
+      return II && II->getName() == "selected";
+    };
+    Reader->completeVisibleDeclsMapForCompletion(DC, Filter);
+    EXPECT_EQ(llvm::range_size(DC->noload_lookup(Selected)), ExpectedOverloads);
+    EXPECT_TRUE(DC->noload_lookup(Omitted).empty());
+    EXPECT_TRUE(DC->hasExternalVisibleStorage());
+    // Omitted overloads must still be available to subsequent ordinary lookup.
+    EXPECT_EQ(llvm::range_size(DC->lookup(Omitted)), ExpectedOverloads);
+    Reader->completeVisibleDeclsMap(DC);
+    EXPECT_FALSE(DC->hasExternalVisibleStorage());
+    EXPECT_EQ(llvm::range_size(DC->lookup(Selected)), ExpectedOverloads);
+    EXPECT_EQ(llvm::range_size(DC->lookup(Omitted)), ExpectedOverloads);
+  }
+};
+
+class SelectedNamespaceAction : public ASTFrontendAction {
+  unsigned ExpectedOverloads;
+  bool MergeBeforeSelection;
+
+public:
+  SelectedNamespaceAction(unsigned ExpectedOverloads, bool MergeBeforeSelection)
+      : ExpectedOverloads(ExpectedOverloads),
+        MergeBeforeSelection(MergeBeforeSelection) {}
+
+  std::unique_ptr<ASTConsumer>
+  CreateASTConsumer(CompilerInstance &, StringRef) override {
+    return std::make_unique<SelectedNamespaceConsumer>(ExpectedOverloads,
+                                                       MergeBeforeSelection);
+  }
+};
