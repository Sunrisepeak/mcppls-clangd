diff --git a/clang-tools-extra/clangd/CodeComplete.cpp b/clang-tools-extra/clangd/CodeComplete.cpp
index c6f47280b3af80df2a72a406ba12175132f16713..fd259d2248dfa0a5a5917e8741b12e6365d0ab75 100644
--- a/clang-tools-extra/clangd/CodeComplete.cpp
+++ b/clang-tools-extra/clangd/CodeComplete.cpp
@@ -914,6 +914,22 @@ struct CompletionRecorder : public CodeCompleteConsumer {
     assert(this->ResultsCallback);
   }
 
+  // This matcher and callable are owned by the synchronous recorder. The
+  // AST source borrows the predicate only while enumerating external names.
+  std::optional<FuzzyMatcher> ExternalNameMatcher;
+  std::function<bool(const IdentifierInfo *)> ExternalNamePredicate =
+      [this](const IdentifierInfo *II) {
+        return !II || ExternalNameMatcher->match(II->getName()).has_value();
+      };
+
+  llvm::function_ref<bool(const IdentifierInfo *)>
+  getExternalNameFilter(llvm::StringRef Pattern) override {
+    if (Pattern.empty())
+      return {};
+    ExternalNameMatcher.emplace(Pattern);
+    return ExternalNamePredicate;
+  }
+
   std::vector<CodeCompletionResult> Results;
   CodeCompletionContext CCContext;
   Sema *CCSema = nullptr; // Sema that created the results.
