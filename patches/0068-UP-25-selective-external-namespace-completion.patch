+  /// Read all values whose keys satisfy Accept, respecting table overrides.
+  template <typename Predicate> data_type findAllIf(Predicate Accept) {
+    data_type Result;
+    data_type_builder Builder(Result);
+    if (!PendingOverrides.empty())
+      removeOverriddenTables();
+    if (MergedTable *M = getMergedTable())
+      for (auto &KV : M->Data)
+        if (Accept(KV.first))
+          Info::MergeDataInto(KV.second, Builder);
+    for (auto *ODT : tables()) {
+      auto &HT = ODT->Table;
+      Info &InfoObj = HT.getInfoObj();
+      for (auto I = HT.data_begin(), E = HT.data_end(); I != E; ++I) {
+        auto *Ptr = I.getItem();
+        auto Length = InfoObj.ReadKeyDataLength(Ptr);
+        const internal_key_type &Key = InfoObj.ReadKey(Ptr, Length.first);
+        if (Accept(Key))
+          InfoObj.ReadDataInto(Key, Ptr + Length.first, Length.second, Builder);
+      }
+    }
+    return Result;
+  }
