+        return llvm::make_error<CancelledError>(Reason);
       auto Lock = std::make_unique<llvm::LockFileManager>(LockPath);
       auto TryLock = Lock->tryLock();
       if (!TryLock)
@@ -277,6 +324,18 @@ public:
         Waited += LockWaitInterval;
         log("Still waiting for module lock {0} after {1}s", LockPath,
             Waited.count());
+        if (ModuleLockStaleBreakSeconds &&
+            Waited >= std::chrono::seconds(ModuleLockStaleBreakSeconds) &&
+            isLockOwnerDead(LockPath)) {
+          llvm::SmallString<256> LockFilePath(LockPath);
+          LockFilePath.append(".lock");
+          log("Breaking module lock {0} whose owner died", LockFilePath);
+          std::error_code RemoveEC = llvm::sys::fs::remove(LockFilePath);
+          if (RemoveEC)
+            log("Failed to break module lock {0}: {1}", LockFilePath,
+                RemoveEC.message());
+          Waited = std::chrono::seconds::zero();
+        }
         continue;
       }
       llvm_unreachable("Unhandled lock wait result");
