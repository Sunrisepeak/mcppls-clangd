+TEST_F(DirectoryBasedGlobalCompilationDatabaseCacheTest,
+       ResponseInputsPublishImmutableGenerations) {
+  MockFS FS;
+  auto Stale = std::chrono::steady_clock::now() - std::chrono::minutes(1);
+  auto A = testPath("a.cc"), B = testPath("b.cc");
+  llvm::json::Array Commands{
+      llvm::json::Object{
+          {"directory", std::string(testRoot())},
+          {"file", "a.cc"},
+          {"arguments", llvm::json::Array{"clang", "@a.rsp", "a.cc"}}},
+      llvm::json::Object{
+          {"directory", std::string(testRoot())},
+          {"file", "b.cc"},
+          {"arguments", llvm::json::Array{"clang", "--precompile", "-o",
+                                          "module.pcm", "@b.rsp", "b.cc"}}}};
+  FS.Files["compile_commands.json"] =
+      llvm::formatv("{0}", llvm::json::Value(std::move(Commands))).str();
+  FS.Files["a.rsp"] = "@nested.rsp";
+  FS.Files["nested.rsp"] = "-DOLD -fmodule-file=M=module.pcm";
+  FS.Files["b.rsp"] = "-DBEFORE";
+  DirectoryBasedGlobalCompilationDatabase GDB(FS);
+  auto Old = lookupCDB(GDB, A, Stale);
+  ASSERT_THAT(Old, hasFlag("-DOLD", A));
+  auto OldModules = GDB.getProjectModules(A);
+  ASSERT_EQ(OldModules->getModuleNameState("M"),
+            ProjectModules::ModuleNameState::Unique);
+  FS.Files["nested.rsp"] =
+      "-DNEW -fmodule-file=N=module.pcm"; // Same size/mtime.
+  auto New = lookupCDB(GDB, A, Stale);
+  EXPECT_NE(Old, New);
+  EXPECT_THAT(New, hasFlag("-DNEW", A));
+  auto NewModules = GDB.getProjectModules(A);
+  EXPECT_EQ(NewModules->getModuleNameState("N"),
+            ProjectModules::ModuleNameState::Unique);
+  EXPECT_EQ(OldModules->getModuleNameState("M"),
+            ProjectModules::ModuleNameState::Unique);
+  EXPECT_THAT(Old, hasFlag("-DOLD", A));
+  EXPECT_EQ(New, lookupCDB(GDB, A, Stale)); // Fresh VFS UIDs aren't changes.
+  FS.Files["b.rsp"] = "-DAFTER!";
+  EXPECT_EQ(New, lookupCDB(GDB, A, Stale)); // Query-local response chain.
+  auto Full = lookupCDB(GDB, A, Stale, true);
+  EXPECT_NE(New, Full); // Module inventory validates even unrelated commands.
+  EXPECT_THAT(Full, hasFlag("-DAFTER!", B));
+  FS.Files.erase("nested.rsp");
+  auto Missing = lookupCDB(GDB, A, Stale);
+  EXPECT_NE(Full, Missing);
+  EXPECT_THAT(Missing, hasFlag("@nested.rsp", A));
+  FS.Files["nested.rsp"] = "-DBACK";
+  auto Back = lookupCDB(GDB, A, Stale);
+  EXPECT_NE(Missing, Back);
+  EXPECT_THAT(Back, hasFlag("-DBACK", A));
+}
