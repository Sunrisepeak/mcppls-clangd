+  auto New = lookupCDB(GDB, Use, Stale);
+  EXPECT_NE(Old, New);
+  EXPECT_THAT(Old, hasFlag("-fmodule-file=M=module.pcm", Use));
+  EXPECT_THAT(New, hasFlag("-fmodule-file=N=module.pcm", Use));
+  auto NewModules = GDB.getProjectModules(Use);
+  EXPECT_EQ(NewModules->getModuleNameState("N"),
+            ProjectModules::ModuleNameState::Unique);
+  EXPECT_EQ(OldModules->getModuleNameState("M"),
+            ProjectModules::ModuleNameState::Unique);
