+TEST_F(DirectoryBasedGlobalCompilationDatabaseCacheTest,
+       UnstableResponsePublicationRetainsPreviousGeneration) {
+  class RacingFS : public MockFS {
+  public:
+    mutable unsigned Reads = 0;
+    bool Race = false;
+    llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const override {
+      class View : public llvm::vfs::ProxyFileSystem {
+        const RacingFS &Owner;
+        llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> ChangedFS;
+
+      public:
+        View(llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> FS,
+             const RacingFS &Owner)
+            : ProxyFileSystem(std::move(FS)), Owner(Owner) {}
+        llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>
+        openFileForRead(const llvm::Twine &Name) override {
+          // First: old-generation validation; second: new discovery; third:
+          // final publication verification observes a different byte sequence.
+          if (Owner.Race && Name.str() == testPath("args.rsp") &&
+              ++Owner.Reads == 3) {
+            llvm::StringMap<std::string> Changed;
+            Changed[testPath("args.rsp")] = "-DBAD";
+            ChangedFS = buildTestFS(Changed);
+            return ChangedFS->openFileForRead(Name);
+          }
+          return ProxyFileSystem::openFileForRead(Name);
+        }
+      };
+      return new View(MockFS::viewImpl(), *this);
+    }
+  } FS;
+  auto Stale = std::chrono::steady_clock::now() - std::chrono::minutes(1);
+  auto File = testPath("a.cc");
+  llvm::json::Array Commands{llvm::json::Object{
+      {"directory", std::string(testRoot())},
+      {"file", "a.cc"},
+      {"arguments", llvm::json::Array{"clang", "@args.rsp", "a.cc"}}}};
+  FS.Files["compile_commands.json"] =
+      llvm::formatv("{0}", llvm::json::Value(std::move(Commands))).str();
+  FS.Files["args.rsp"] = "-DOLD";
+  DirectoryBasedGlobalCompilationDatabase GDB(FS);
+  auto Old = lookupCDB(GDB, File, Stale);
+  ASSERT_THAT(Old, hasFlag("-DOLD", File));
+  FS.Files["args.rsp"] = "-DNEW";
+  FS.Race = true;
+  EXPECT_EQ(Old, lookupCDB(GDB, File, Stale));
+  EXPECT_THAT(Old, hasFlag("-DOLD", File));
+  auto New = lookupCDB(GDB, File, Stale);
+  EXPECT_NE(Old, New);
+  EXPECT_THAT(New, hasFlag("-DNEW", File));
+}
