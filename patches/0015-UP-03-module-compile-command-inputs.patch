+TEST(CommandMangler, GCCModuleMapperDialectPreservesExplicitClangInputs) {
+  auto Mangler = CommandMangler::forTests();
+  struct Case {
+    const char *Driver;
+    std::vector<std::string> Flags;
+    bool Translate;
+  };
+  const Case Cases[] = {
+      {"g++", {"-fmodules", "-fmodule-mapper=mapper.map"}, true},
+      {"x86_64-linux-gnu-g++-16",
+       {"-fmodules", "-fmodule-mapper=mapper.map"},
+       true},
+      {"clang++", {"-fmodules", "-fmodule-mapper=mapper.map"}, false},
+      {"g++", {"-fmodules"}, false},
+      {"c++", {"-fmodules", "-fmodule-mapper=mapper.map"}, false},
+      {"g++",
+       {"-fmodules", "-fmodule-mapper=mapper.map",
+        "-fmodule-map-file=explicit.modulemap"},
+       false},
+      {"g++",
+       {"-fmodules", "-fmodule-mapper=mapper.map", "-fimplicit-module-maps"},
+       false},
+      {"g++",
+       {"-fmodules", "-fmodule-mapper=mapper.map",
+        "-fmodule-file=M=explicit.pcm"},
+       false},
+      {"g++", {"-fno-modules", "-fmodule-mapper=mapper.map"}, false},
+  };
+  for (const auto &Case : Cases) {
+    SCOPED_TRACE(Case.Driver);
+    SCOPED_TRACE(llvm::join(Case.Flags, " "));
+    tooling::CompileCommand Cmd;
+    // Nonexistent absolute names keep this test independent of PATH/symlinks.
+    Cmd.CommandLine = {testPath(std::string("gcc-dialect/") + Case.Driver)};
+    Cmd.CommandLine.insert(Cmd.CommandLine.end(), Case.Flags.begin(),
+                           Case.Flags.end());
