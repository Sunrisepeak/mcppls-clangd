+//===--- ResponseFileSnapshot.h ----------------------------------*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_RESPONSEFILESNAPSHOT_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_RESPONSEFILESNAPSHOT_H
+
+#include "llvm/ADT/StringMap.h"
+#include "llvm/ADT/StringSet.h"
+#include "llvm/Support/VirtualFileSystem.h"
+#include <map>
+#include <optional>
+
+namespace clang::clangd {
+// A generation owns response bytes, including negative observations. Discovery
+// uses the first observation of each spelling; publication revalidates them
+// all. After freeze this filesystem never accesses the underlying filesystem.
+class ResponseFileSnapshot : public llvm::vfs::FileSystem {
+  struct Input {
+    std::optional<llvm::vfs::Status> Stat;
+    std::error_code StatError, ReadError;
+    std::string Bytes;
+    bool Read = false;
+  };
+  llvm::StringMap<Input> Inputs;
+  llvm::StringMap<llvm::StringSet<>> Groups;
+  llvm::StringSet<> *Group = nullptr;
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> Base;
+  llvm::ErrorOr<std::string> CWD;
+  bool Frozen = false;
+
+  Input *observe(const llvm::Twine &Name) {
+    auto Path = Name.str();
+    if (Group)
+      Group->insert(Path);
+    auto It = Inputs.find(Path);
+    if (It != Inputs.end())
+      return &It->second;
+    if (Frozen)
+      return nullptr;
+    auto &I = Inputs[Path];
+    auto S = Base->status(Path);
+    if (S)
+      I.Stat = *S;
+    else
+      I.StatError = S.getError();
+    return &I;
+  }
+  class File : public llvm::vfs::File {
+    Input &I;
+
+  public:
+    explicit File(Input &I) : I(I) {}
+    llvm::ErrorOr<llvm::vfs::Status> status() override {
+      if (I.Stat)
+        return *I.Stat;
+      return I.StatError;
+    }
+    llvm::ErrorOr<std::unique_ptr<llvm::MemoryBuffer>>
+    getBuffer(const llvm::Twine &Name, int64_t, bool, bool) override {
+      if (I.ReadError)
+        return I.ReadError;
+      return llvm::MemoryBuffer::getMemBufferCopy(I.Bytes, Name.str());
+    }
+    std::error_code close() override { return {}; }
+  };
+
+public:
+  explicit ResponseFileSnapshot(
+      llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> FS)
+      : Base(std::move(FS)), CWD(Base->getCurrentWorkingDirectory()) {}
+  void beginCommand(llvm::StringRef Filename) { Group = &Groups[Filename]; }
+  void endCommand() { Group = nullptr; }
+  void freeze() {
+    Frozen = true;
+    Base.reset();
+  }
+  llvm::ErrorOr<llvm::vfs::Status> status(const llvm::Twine &Path) override {
+    auto *I = observe(Path);
+    if (!I)
+      return std::make_error_code(std::errc::no_such_file_or_directory);
+    if (I->Stat)
+      return *I->Stat;
+    return I->StatError;
+  }
+  llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>
+  openFileForRead(const llvm::Twine &Path) override {
+    auto *I = observe(Path);
+    if (!I)
+      return std::make_error_code(std::errc::no_such_file_or_directory);
+    if (!I->Read) {
+      if (Frozen)
+        return std::make_error_code(std::errc::operation_not_permitted);
+      I->Read = true;
+      auto B = Base->getBufferForFile(Path, -1, true, true);
+      if (B)
+        I->Bytes = (*B)->getBuffer().str();
+      else
+        I->ReadError = B.getError();
+    }
+    if (I->ReadError)
+      return I->ReadError;
+    return std::unique_ptr<llvm::vfs::File>(new File(*I));
+  }
+  llvm::vfs::directory_iterator dir_begin(const llvm::Twine &,
+                                          std::error_code &EC) override {
+    EC = std::make_error_code(std::errc::operation_not_permitted);
+    return {};
+  }
+  std::error_code setCurrentWorkingDirectory(const llvm::Twine &) override {
+    return std::make_error_code(std::errc::operation_not_permitted);
+  }
+  llvm::ErrorOr<std::string> getCurrentWorkingDirectory() const override {
+    return CWD;
+  }
+  // An unknown/inferred source needs the whole set. UID equality also preserves
+  // response recursion detection. Exact bytes detect same-size/mtime rewrites.
+  bool matches(llvm::vfs::FileSystem &FS, llvm::StringRef Source = {}) const {
+    auto G = Groups.find(Source);
+    using ID = std::pair<uint64_t, uint64_t>;
+    std::map<ID, ID> OldToNew, NewToOld;
+    auto Check = [&](llvm::StringRef Path, const Input &I) {
+      auto S = FS.status(Path);
+      if (bool(S) != bool(I.Stat))
+        return false;
+      if (!S) {
+        if (S.getError() != I.StatError)
+          return false;
+      } else {
+        auto OldUID = I.Stat->getUniqueID(), NewUID = S->getUniqueID();
+        ID Old{OldUID.getDevice(), OldUID.getFile()};
+        ID New{NewUID.getDevice(), NewUID.getFile()};
+        auto O = OldToNew.emplace(Old, New), N = NewToOld.emplace(New, Old);
+        if ((!O.second && O.first->second != New) ||
+            (!N.second && N.first->second != Old))
+          return false;
+        if (S->getName() != I.Stat->getName() ||
+            S->getLastModificationTime() != I.Stat->getLastModificationTime() ||
+            S->getSize() != I.Stat->getSize() ||
+            S->getType() != I.Stat->getType() ||
+            S->getPermissions() != I.Stat->getPermissions() ||
+            S->getUser() != I.Stat->getUser() ||
+            S->getGroup() != I.Stat->getGroup() ||
+            S->ExposesExternalVFSPath != I.Stat->ExposesExternalVFSPath)
+          return false;
+      }
+      if (I.Read) {
+        auto B = FS.getBufferForFile(Path, -1, true, true);
+        if (bool(B) != !bool(I.ReadError))
+          return false;
+        if (B ? (*B)->getBuffer() != I.Bytes : B.getError() != I.ReadError)
+          return false;
+      }
+      return true;
+    };
+    if (!Source.empty() && G != Groups.end()) {
+      for (const auto &Path : G->second)
+        if (!Check(Path.first(), Inputs.find(Path.first())->second))
+          return false;
+    } else {
+      for (const auto &KV : Inputs)
+        if (!Check(KV.first(), KV.second))
+          return false;
+    }
+    return true;
+  }
+};
+} // namespace clang::clangd
+#endif
