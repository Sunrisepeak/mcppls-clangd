 }
+
+struct BundleNode {
+  std::string Relative;
+  bool Directory;
+  uint64_t Device, Inode;
+  std::shared_ptr<FD> Parent;
+};
+struct BundleInventory {
+  uint64_t Bytes = 0, MainBytes = 0, CacheFiles = 0;
+  std::array<uint8_t, 32> Digest{};
+  std::vector<BundleNode> Nodes;
+};
+
+// Inspect only this leased, same-user generation. These bounds match the
+// supervisor's existing bounded unit cleanup, rather than admitting arbitrary
+// recursive trees. Directory cursors, names and inode identities are retained
+// for verified FD-relative deletion; no path alias or symlink is followed.
+llvm::Expected<BundleInventory> inventoryBundle(int Generation,
+                                                bool Retiring = false) {
+  BundleInventory Result;
+  llvm::SHA256 Hash;
+  auto Add = [&](StringRef Value) {
+    Hash.update(Value);
+    Hash.update(StringRef("\0", 1));
+  };
+  auto Marker = [](int Directory, StringRef Name, StringRef Expected) {
+    FD File(openat(Directory, Name.str().c_str(),
+                   O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+    struct stat S;
+    std::array<char, 64> Bytes{};
+    return File.Value >= 0 && !fstat(File.Value, &S) &&
+           uint64_t(S.st_size) == Expected.size() &&
+           Expected.size() <= Bytes.size() &&
+           exactRead(File.Value, Bytes.data(), Expected.size(), 0) &&
+           StringRef(Bytes.data(), Expected.size()) == Expected;
+  };
+  unsigned Units = 0;
+  std::function<llvm::Error(int, StringRef, unsigned)> Visit =
+      [&](int Directory, StringRef Relative, unsigned Depth) -> llvm::Error {
+    auto Parent = std::make_shared<FD>(fcntl(Directory, F_DUPFD_CLOEXEC, 0));
+    if (Parent->Value < 0)
+      return ioError();
+    if (!Retiring &&
+        ((Relative == "workers" &&
+          !Marker(Directory, "owned.root", "clangd-worker-root-v1\n")) ||
+         (Depth == 2 &&
+          !Marker(Directory, "bundle.unit", "clangd-worker-bundle-v1\n"))))
+      return failure("bundle ownership marker missing");
+    FD Cursor(openat(Directory, ".",
+                     O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    DIR *Stream = Cursor.Value < 0 ? nullptr : fdopendir(Cursor.release());
+    if (!Stream)
+      return ioError();
+    auto Close = llvm::scope_exit([&] { closedir(Stream); });
+    std::vector<std::string> Names;
+    errno = 0;
+    while (auto *Entry = readdir(Stream)) {
+      StringRef Name(Entry->d_name);
+      if (Name == "." || Name == "..")
+        continue;
+      if (Names.size() + Result.Nodes.size() >= 4608)
+        return failure("bundle inventory entry limit");
+      Names.push_back(Name.str());
+    }
+    if (errno)
+      return ioError();
+    llvm::sort(Names);
+    for (const auto &Name : Names) {
+      const std::string Child = Relative.empty() ? Name : path(Relative, Name);
+      if (Child.size() >= 1024 || Result.Nodes.size() >= 4608)
+        return failure("bundle inventory path/entry limit");
+      struct stat S;
+      if (fstatat(Directory, Name.c_str(), &S, AT_SYMLINK_NOFOLLOW))
+        return ioError();
+      if (S.st_uid != geteuid() ||
+          (!S_ISDIR(S.st_mode) && (!S_ISREG(S.st_mode) || S.st_nlink != 1)))
+        return failure("bundle contains foreign, aliased or nonregular output");
+      bool Metadata = false;
+      if (S_ISDIR(S.st_mode)) {
+        bool Known = false;
+        if (Relative.empty())
+          Known = Name == "workers";
+        else if (Relative == "workers") {
+          Known = StringRef(Name).starts_with("unit-") && ++Units == 1;
+        } else if (Depth == 2)
+          Known = Name == "module-cache";
+        else
+          Known = Relative.contains("/module-cache") && Depth < 6;
+        if (!Known)
+          return failure("unknown bundle directory");
+      } else if (Relative.empty()) {
+        Metadata = Name == "owned.generation";
+        if (!Metadata && Name != "payload.pcm" &&
+            !(Retiring && Name == "staged.pcm"))
+          return failure("unknown generation payload");
+        if (Name == "payload.pcm")
+          Result.MainBytes = S.st_size;
+      } else if (Relative == "workers") {
+        Metadata = Name == "owned.root" &&
+                   Marker(Directory, Name, "clangd-worker-root-v1\n");
+        if (!Metadata)
+          return failure("unknown bundle root marker");
+      } else if (Depth == 2) {
+        Metadata = Name == "bundle.unit" &&
+                   Marker(Directory, Name, "clangd-worker-bundle-v1\n");
+        if (!Metadata)
+          return failure("worker capture/startup payload remains");
+      } else {
+        if (!Relative.contains("/module-cache") ||
+            (llvm::sys::path::extension(Name) != ".pcm" &&
+             Name != "modules.idx" && Name != "modules.timestamp") ||
+            ++Result.CacheFiles > 128)
+          return failure("unknown or excessive implicit bundle output");
+      }
+      Result.Nodes.push_back({Child, bool(S_ISDIR(S.st_mode)),
+                              uint64_t(S.st_dev), uint64_t(S.st_ino), Parent});
+      Add(Child);
+      Add(std::to_string(S.st_mode));
+      Add(std::to_string(S.st_dev));
+      Add(std::to_string(S.st_ino));
+      Add(std::to_string(S.st_size));
+      Add(std::to_string(S.st_mtim.tv_sec));
+      Add(std::to_string(S.st_mtim.tv_nsec));
+      if (S_ISDIR(S.st_mode)) {
+        FD ChildFD(openat(Directory, Name.c_str(),
+                          O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+        struct stat Opened;
+        if (ChildFD.Value < 0 || fstat(ChildFD.Value, &Opened) ||
+            Opened.st_dev != S.st_dev || Opened.st_ino != S.st_ino)
+          return failure("bundle directory identity changed");
+        if (auto Error = Visit(ChildFD.Value, Child, Depth + 1))
+          return Error;
+      } else if (!Metadata) {
+        if (S.st_size < 0 || uint64_t(S.st_size) > UINT64_MAX - Result.Bytes)
+          return failure("bundle size overflow");
+        Result.Bytes += S.st_size;
+      }
+    }
+    return llvm::Error::success();
+  };
+  if (auto Error = Visit(Generation, {}, 0))
+    return std::move(Error);
+  Result.Digest = Hash.final();
+  return Result;
+}
+
+bool bundleNodeMatches(const BundleNode &Node) {
+  struct stat Named;
+  const auto Name = llvm::sys::path::filename(Node.Relative);
+  return !fstatat(Node.Parent->Value, Name.str().c_str(), &Named,
+                  AT_SYMLINK_NOFOLLOW) &&
+         uint64_t(Named.st_dev) == Node.Device &&
+         uint64_t(Named.st_ino) == Node.Inode &&
+         bool(S_ISDIR(Named.st_mode)) == Node.Directory &&
+         (Node.Directory || (S_ISREG(Named.st_mode) && Named.st_nlink == 1));
+}
+
+llvm::Error syncBundle(const BundleInventory &Bundle) {
+  for (const auto &Node : Bundle.Nodes) {
+    if (!bundleNodeMatches(Node))
+      return failure("bundle identity changed before durability");
+    const auto Name = llvm::sys::path::filename(Node.Relative);
+    FD File(openat(Node.Parent->Value, Name.str().c_str(),
+                   O_RDONLY | O_NOFOLLOW | O_CLOEXEC |
+                       (Node.Directory ? O_DIRECTORY : 0)));
+    struct stat Opened;
+    if (File.Value < 0 || fstat(File.Value, &Opened) ||
+        uint64_t(Opened.st_dev) != Node.Device ||
+        uint64_t(Opened.st_ino) != Node.Inode || fsync(File.Value))
+      return ioError();
+  }
+  return llvm::Error::success();
+}
 #endif
 } // namespace
