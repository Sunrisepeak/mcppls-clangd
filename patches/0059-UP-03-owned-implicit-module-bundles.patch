+TEST_F(PrerequisiteModulesTests, OwnedImplicitBundleMainCopyAndCompanionLease) {
+  const auto Root = (TestDir + "/bundles/.owned-payload-v1").str();
+  const auto Anchor = (TestDir + "/source-anchor").str();
+  auto Write = [](StringRef File, StringRef Text) {
+    EXPECT_FALSE(
