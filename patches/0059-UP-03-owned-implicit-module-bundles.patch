+  // existing generation remains charged; a new independent quota is absent.
+  EXPECT_THAT_EXPECTED((*Cache)->lookup("M"), llvm::Failed());
+  Stable->reset();
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("pressure", Anchor, 9),
+                       llvm::Failed());
+  auto Collected = (*Cache)->collect(4);
+  ASSERT_THAT_EXPECTED(Collected, llvm::Succeeded());
+  EXPECT_EQ(*Collected, 0u);
+  EXPECT_TRUE(llvm::sys::fs::exists(Implicit + ".foreign"));
