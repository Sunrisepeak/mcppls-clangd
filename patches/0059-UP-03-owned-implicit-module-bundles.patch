+llvm::Error ModuleBuildWorkerUnit::retainImplicitOutputs() {
+  if (auto EC = validateUnitContents(Directory))
+    return llvm::errorCodeToError(EC);
+  // The parent still holds both the unit lease and the enclosing generation's
+  // exclusive admission lease. No collector can cross this ownership transfer.
+  if (auto Err = writeMarker(file("bundle.unit"), "clangd-worker-bundle-v1\n"))
+    return Err;
+  if (auto EC = llvm::sys::fs::rename(file("owned.unit"), file("retired.unit")))
+    return llvm::errorCodeToError(EC);
+  if (auto EC = removeOwnerPipe(Directory))
+    return llvm::errorCodeToError(EC);
+  std::error_code EC;
+  for (llvm::sys::fs::directory_iterator I(Directory, EC), End; I != End && !EC;
+       I.increment(EC)) {
+    StringRef Name = llvm::sys::path::filename(I->path());
+    if (Name == "module-cache" || Name == "bundle.unit")
+      continue;
+    if (auto Error = llvm::sys::fs::remove(I->path()))
+      return llvm::errorCodeToError(Error);
+  }
+  if (EC)
+    return llvm::errorCodeToError(EC);
+  // Neither startup nor the separate orphan-unit collector accepts bundle.unit.
+  // It is removed only while holding the enclosing generation's exclusive
+  // lease.
+  ParentLease.reset();
+  Directory.clear();
+  return llvm::Error::success();
+}
