+TEST_F(PrerequisiteModulesTests, OwnedImplicitBundleChecksOutputAndIdentity) {
+  const auto Root = (TestDir + "/bundle-guards").str();
+  const auto Anchor = (TestDir + "/source-anchor").str();
+  auto Write = [](StringRef File, StringRef Text) {
+    EXPECT_FALSE(
+        llvm::sys::fs::create_directories(llvm::sys::path::parent_path(File)));
+    std::error_code EC;
+    llvm::raw_fd_ostream Out(File, EC);
+    EXPECT_FALSE(EC);
+    Out << Text;
+  };
+  Write(Anchor, "");
+  auto Cache = ModuleBuildCache::open(Root, 20, 4);
+  ASSERT_THAT_EXPECTED(Cache, llvm::Succeeded());
+  auto Make = [&](unsigned HeaderBytes) {
+    auto Reservation = (*Cache)->reserve("M", Anchor, 20, 16, 4);
+    EXPECT_THAT_EXPECTED(Reservation, llvm::Succeeded());
+    auto Unit = ModuleBuildWorkerUnit::create((*Reservation)->payload(),
+                                              (*Reservation)->workers());
+    EXPECT_THAT_EXPECTED(Unit, llvm::Succeeded());
+    Write((*Unit)->file("module-cache/Builtin.pcm"),
+          std::string(HeaderBytes, 'x'));
+    Write((*Reservation)->payload(), "MAIN");
+    EXPECT_THAT_ERROR((*Unit)->retainImplicitOutputs(), llvm::Succeeded());
+    return Reservation;
+  };
+  auto Oversized = Make(16);
+  // Within total capture+output reservation, but exceeds the distinct output
+  // envelope: captures cannot be silently converted to extra compiler output.
+  EXPECT_THAT_ERROR((*Oversized)->publish(), llvm::Failed());
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("pressure", Anchor, 1),
+                       llvm::Failed());
+  Oversized->reset();
+  auto Stable = Make(8);
+  ASSERT_THAT_ERROR((*Stable)->publish(), llvm::Succeeded());
+  std::string Implicit;
+  std::error_code EC;
+  for (llvm::sys::fs::recursive_directory_iterator I((*Stable)->workers(), EC),
+       End;
+       I != End && !EC; I.increment(EC))
+    if (llvm::sys::path::extension(I->path()) == ".pcm")
+      Implicit = I->path();
+  ASSERT_FALSE(EC);
+  ASSERT_FALSE(Implicit.empty());
+  ASSERT_FALSE(llvm::sys::fs::rename(Implicit, Implicit + ".foreign"));
+  Write(Implicit, "xxxxxxxx");
