+  Write((*Stable)->payload(), "MAIN");
+  ASSERT_THAT_ERROR((*Unit)->retainImplicitOutputs(), llvm::Succeeded());
+  EXPECT_FALSE(llvm::sys::fs::exists(Snapshot));
+  ASSERT_THAT_ERROR((*Stable)->publish(), llvm::Succeeded());
+  EXPECT_EQ((*Stable)->mainBytes(), 4u);
+  EXPECT_EQ((*Stable)->payloadBytes(), 12u);
+  auto Copy = (*Cache)->copy(*Stable);
+  ASSERT_THAT_EXPECTED(Copy, llvm::Succeeded());
+  EXPECT_EQ((*Copy)->payloadBytes(), 4u);
+  // Copying the entire 12-byte bundle would exhaust this exact 20-byte quota.
+  const auto CopyPath = (*Copy)->payload();
+  int Ready[2], Continue[2];
+  ASSERT_EQ(pipe(Ready), 0);
+  ASSERT_EQ(pipe(Continue), 0);
+  pid_t Child = fork();
+  ASSERT_GE(Child, 0);
+  if (!Child) {
+    close(Ready[0]);
+    close(Continue[1]);
+    // Close every inherited cache/OFD handle: the independent input API must
+    // acquire both copy and stable companion, rather than inherit ownership.
+    DIR *Descriptors = opendir("/proc/self/fd");
+    if (!Descriptors)
