 clang-tools-extra/clangd/ModuleMemoStore.cpp  | 94 +++++++++++--------
 clang-tools-extra/clangd/ModuleMemoStore.h    | 14 +++
 .../clangd/ModuleValidationCache.h            |  6 ++
 .../unittests/PrerequisiteModulesTest.cpp     | 39 ++++++++
 5 files changed, 115 insertions(+), 41 deletions(-)

