+llvm::Error ModulesBuilder::ModulesBuilderImpl::getOrBuildModuleFiles(
+    PathRef RequiredSource, llvm::ArrayRef<std::string> ModuleNames,
+    const ThreadsafeFS &TFS, CachingProjectModules &MDB,
+    ReusablePrerequisiteModules &BuiltModuleFiles) {
+  llvm::SmallVector<std::string> Roots;
+  for (StringRef Name : ModuleNames) {
+    if (BuiltModuleFiles.isModuleUnitBuilt(Name))
+      continue;
+    std::string Source = MDB.getSourceForModuleName(Name, RequiredSource);
+    bool Buildable = !Source.empty();
+    if (Buildable && !getCDB().getCompileCommand(Source)) {
+      auto PI = getCDB().getProjectInfo(Source);
+      Buildable = PI && !PI->SourceRoot.empty();
+    }
+    if (!Buildable) {
+      elog("Keeping import of third-party module {0} textual; no module "
+           "unit for it in this project",
+           Name);
+      continue;
+    }
+    getPrebuiltModuleFile(Name, Source, TFS, BuiltModuleFiles);
+    Roots.push_back(Name.str());
+  }
+  auto Plan = getModuleBuildPlan(RequiredSource, MDB, Roots, BuiltModuleFiles);
+  if (!Plan)
+    return Plan.takeError();
+  llvm::stable_sort(*Plan,
+                    [](const ModuleBuildNode &L, const ModuleBuildNode &R) {
+                      return L.Depth < R.Depth;
+                    });
+  using Result = llvm::Expected<std::shared_ptr<const ModuleFile>>;
+  for (size_t Begin = 0; Begin < Plan->size();) {
+    if (int Reason = isCancelled())
+      return llvm::make_error<CancelledError>(Reason);
+    size_t End = Begin;
+    while (End < Plan->size() && (*Plan)[End].Depth == (*Plan)[Begin].Depth)
+      ++End;
+    // Bound queued work as well as active compilation. Every wave sees one
+    // immutable prerequisite snapshot; workers never wait on peer tasks.
+    for (size_t Batch = Begin; Batch < End;) {
+      size_t BatchEnd = std::min(End, Batch + BuildPool.getMaxConcurrency());
+      auto Snapshot =
+          std::make_shared<const ReusablePrerequisiteModules>(BuiltModuleFiles);
+      std::vector<std::optional<Result>> Results(BatchEnd - Batch);
+      llvm::SmallVector<std::future<void>> Futures;
+      llvm::Error PreparationError = llvm::Error::success();
+      for (size_t Index = Batch; Index < BatchEnd; ++Index) {
+        const auto &Node = (*Plan)[Index];
+        if (BuiltModuleFiles.isModuleUnitBuilt(Node.Name))
+          continue;
+        auto Cmd = getCDB().getCompileCommand(Node.Source);
+        if (!Cmd) {
+          PreparationError = llvm::createStringError(
+              llvm::formatv("No compile command for {0}", Node.Source));
+          break;
+        }
+        if (auto PI = getCDB().getProjectInfo(Node.Source);
+            PI && !PI->SourceRoot.empty())
+          garbageCollectModuleCacheForProjectRoot(PI->SourceRoot);
+        // ThreadPool's returned future is deferred: waiting on it may run
+        // the compilation on this caller, bypassing the pool's global limit.
+        // Wait instead on a separate promise set only by the pool worker.
+        std::promise<void> Completed;
+        Futures.push_back(Completed.get_future());
+        BuildPool.async([this, Name = Node.Name, Source = Node.Source,
+                         Cmd = std::move(*Cmd), &TFS, Snapshot,
+                         &ResultSlot = Results[Index - Batch],
+                         Completed = std::move(Completed),
+                         Ctx = Context::current().clone()]() mutable {
+          WithContext ContextScope(std::move(Ctx));
+          ResultSlot.emplace(getOrBuildSingleModule(
+              Name, Source, std::move(Cmd), TFS, *Snapshot));
+          Completed.set_value();
+        });
+      }
+      // Drain all jobs even after an error, so referenced request state and
+      // read leases cannot be destroyed while a worker still uses them.
+      // A no-threads LLVM build queues work until the caller drains it.
+      if (!llvm::llvm_is_multithreaded())
+        BuildPool.wait();
+      for (auto &Future : Futures)
+        Future.wait();
+      llvm::Error Errors = std::move(PreparationError);
+      for (auto &ResultSlot : Results) {
+        if (!ResultSlot)
+          continue;
+        if (llvm::Error Err = ResultSlot->takeError())
+          Errors = llvm::joinErrors(std::move(Errors), std::move(Err));
+        else
+          BuiltModuleFiles.addModuleFile(std::move(**ResultSlot));
+      }
+      if (Errors)
+        return Errors;
+      Batch = BatchEnd;
+    }
+    Begin = End;
+  }
   return llvm::Error::success();
 }
 
