+llvm::Expected<llvm::SmallVector<ModuleBuildNode>>
+getModuleBuildPlan(PathRef RequiredSource, CachingProjectModules &MDB,
+                   llvm::ArrayRef<std::string> Roots,
+                   const ReusablePrerequisiteModules &AlreadyBuilt) {
+  llvm::SmallVector<ModuleBuildNode> Plan;
+  llvm::StringMap<unsigned> Completed;
+  llvm::StringSet<> Active;
+  auto Visit = [&](StringRef Name, auto Visitor) -> llvm::Error {
     if (int Reason = isCancelled())
       return llvm::make_error<CancelledError>(Reason);
     if (Completed.contains(Name))
       return llvm::Error::success();
+    // Validated prebuilt BMIs may have no provider command/source in this
+    // project. Their already-validated dependency chain is a ready leaf.
+    if (AlreadyBuilt.isModuleUnitBuilt(Name)) {
+      Completed.insert({Name, 0});
+      return llvm::Error::success();
+    }
     if (!Active.insert(Name).second)
       return llvm::createStringError(
           llvm::formatv("Cyclic module dependency involving {0}", Name));
     llvm::scope_exit RemoveActive([&] { Active.erase(Name); });
-    for (StringRef Dependency : MDB.getRequiredModules(
-             MDB.getSourceForModuleName(Name, RequiredSource)))
+    std::string Source = MDB.getSourceForModuleName(Name, RequiredSource);
+    if (Source.empty())
+      return llvm::make_error<ModuleUnitNotFound>(
+          Name.str(), "no unit source in this project");
+    unsigned Depth = 0;
+    for (StringRef Dependency : MDB.getRequiredModules(Source)) {
       if (llvm::Error Err = Visitor(Dependency, Visitor))
         return Err;
-    Completed.insert(Name);
-    ModuleNames.push_back(Name.str());
+      Depth = std::max(Depth, Completed.find(Dependency)->second + 1);
+    }
+    Completed.insert({Name, Depth});
+    Plan.push_back({Name.str(), std::move(Source), Depth});
     return llvm::Error::success();
   };
-  if (llvm::Error Err = VisitDeps(ModuleName, VisitDeps))
-    return std::move(Err);
-  return ModuleNames;
+  for (StringRef Root : Roots) {
+    if (llvm::Error Err = Visit(Root, Visit)) {
+      // A root depending on an unavailable toolchain module cannot load a
+      // BMI here either. Keep that import textual, without discarding other
+      // roots which did resolve. Compilation, cycle and cancellation errors
+      // remain hard failures.
+      Err = llvm::handleErrors(
+          std::move(Err), [&](const ModuleUnitNotFound &NotFound) {
+            elog("Keeping import of third-party module {0} textual; no module "
+                 "unit for it in this project", NotFound.ModuleName);
+          });
+      if (Err)
+        return std::move(Err);
+    }
+  }
+  return Plan;
 }
 
