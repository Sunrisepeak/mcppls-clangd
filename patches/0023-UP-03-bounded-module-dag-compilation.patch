@@ -0,0 +1,63 @@
+# UNSUPPORTED: system-windows
+# RUN: rm -rf %t
+# RUN: split-file %s %t
+# RUN: sed -e "s|DIR|%/t|g" -e "s|CLANG_CC|%clang|g" %t/compile_commands.json.tmpl > %t/compile_commands.json
+# RUN: sed -e "s|DIR|%/t|g" %t/input.jsonrpc.tmpl > %t/input.jsonrpc
+# RUN: clangd -experimental-modules-support -modules-builder-workers=4 -log=verbose -lit-test < %t/input.jsonrpc > %t/reply 2> %t/log
+# RUN: FileCheck %s --check-prefix=LOG < %t/log
+# RUN: FileCheck %s --check-prefix=REPLY < %t/reply
+
+# A shared D is planned once. Parent A cannot enter a worker until both B and
+# C have completed. The portable e2e stress test additionally measures actual
+# overlap and bounds jobs across simultaneous documents.
+# LOG: Module build task D started (active=1, limit={{[1-4]}})
