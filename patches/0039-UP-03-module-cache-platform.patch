+++ b/clang-tools-extra/clangd/ModuleCachePlatform.h
@@ -0,0 +1,116 @@
+//===--- ModuleCachePlatform.h - what the owned module cache needs -*- C++-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The owned module cache (ModuleBuildCache) and the supervised module workers
+// rely on a few facilities of the system. This interface names them, states
+// which of them this system provides, and measures a cache directory once,
+// since a volume can lack what its system provides. Where a facility is
+// missing, modules are compiled in clangd and each reader is given a copy of
+// the published BMI (the portable path).
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULECACHEPLATFORM_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULECACHEPLATFORM_H
+
+#include "support/Path.h"
+#include <cstdint>
+#include <string>
+
+// The owned cache is written against POSIX names: directory handles, open
+// files and their locks. A system without them (Windows) compiles none of it.
+#if !defined(_WIN32)
+#define CLANGD_OWNED_MODULE_CACHE 1
+#include <sys/stat.h>
+#include <time.h>
+#else
+#define CLANGD_OWNED_MODULE_CACHE 0
+#endif
+
+namespace clang {
+namespace clangd {
+
+class ModuleCachePlatform {
+public:
+  /// How a group of module workers is held to a memory budget.
+  enum class Budget {
+    None,       ///< It is not held.
+    Supervised, ///< The implementation watches the group and ends it.
+    Hard,       ///< The environment holds the group to it.
+  };
+
+  struct Capabilities {
+    /// A byte-range lock is held by the open file that took it: another open
+    /// of the same file, in this process as well, is excluded by it.
+    bool OpenFileLocks = false;
+    /// Files and directories are made, opened and removed by name relative
+    /// to an open directory.
+    bool RelativeDirectories = false;
+    /// A name is removed while its file or directory is open.
+    bool RemoveOpen = false;
+    /// How the supervised workers can be held to a memory budget.
+    Budget WorkerBudget = Budget::None;
+
+    /// The owned cache needs the three facilities above.
+    bool ownedCache() const {
+      return OpenFileLocks && RelativeDirectories && RemoveOpen;
+    }
+  };
+
+  /// What this system provides, as it states it: at compile time, and at run
+  /// time where an environment states it then.
+  static const Capabilities &stated();
+
+  /// Measures \p Directory once, making it if it is absent: a scratch file and
+  /// a scratch directory are made there, locked through two open files,
+  /// synced, and removed while open. Returns an empty string when the owned
+  /// cache can be used there, and otherwise what was found missing.
+  static std::string measure(PathRef Directory);
+
+  /// One line naming the facilities of \p C, for a log.
+  static std::string describe(const Capabilities &C);
+
+  /// Raises the number of files this process may hold open to the most its
+  /// system allows, once, and returns that number (0 where the system states
+  /// none). A reader of the owned cache holds one open file for each module
+  /// it reads (its lease), and a worker one for each prerequisite.
+  static uint64_t openFiles();
+
+#if CLANGD_OWNED_MODULE_CACHE
+  /// Takes the whole-file lock of the open file \p FD: exclusive or shared,
+  /// waiting or not. A lock this open file holds already is converted in one
+  /// step. Returns 0, or an errno value (EAGAIN or EACCES: another open file
+  /// holds a conflicting lock).
+  static int lock(int FD, bool Exclusive, bool Wait);
+  /// Writes the data of \p FD to storage, with the metadata needed to read
+  /// them back. Returns 0 or an errno value.
+  static int syncData(int FD);
+  /// Writes the names in the directory \p FD to storage. Returns 0 or an
+  /// errno value.
+  static int syncDirectory(int FD);
+  /// Whether \p S belongs to this program's user, where the system states an
+  /// owner.
+  static bool thisUser(const struct stat &S);
+  /// Whether \p S is this program's user's alone: its owner, and no access for
+  /// others in its permission word, where the system states them.
+  static bool privateTo(const struct stat &S);
+  /// Whether the file \p S describes has one name, where the system states a
+  /// count of names.
+  static bool singleName(const struct stat &S);
+  /// Whether the open file or directory \p S describes, whose name was
+  /// removed, has no name left, where the system states a count of names.
+  static bool unnamed(const struct stat &S);
+  /// When \p S was last modified.
+  static struct timespec modified(const struct stat &S);
+#endif
+};
+
+} // namespace clangd
+} // namespace clang
+
+#endif
