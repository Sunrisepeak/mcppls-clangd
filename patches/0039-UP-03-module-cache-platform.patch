diff --git a/clang-tools-extra/clangd/ModuleCachePlatform.cpp b/clang-tools-extra/clangd/ModuleCachePlatform.cpp
new file mode 100644
index 000000000..1e4bcff95
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleCachePlatform.cpp
@@ -0,0 +1,279 @@
+//===--- ModuleCachePlatform.cpp - what the owned module cache needs ------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "ModuleCachePlatform.h"
+#include "llvm/ADT/ScopeExit.h"
+#include "llvm/ADT/SmallString.h"
+#include "llvm/Support/FileSystem.h"
+#include <atomic>
+#include <cerrno>
+#include <cstring>
+#if CLANGD_OWNED_MODULE_CACHE
+#include <algorithm>
+#include <climits>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#endif
+
+namespace clang {
+namespace clangd {
+namespace {
+
+#if CLANGD_OWNED_MODULE_CACHE
+// The lock of an open file description. Linux names it; macOS has it under
+// the same numbers and does not name it in its headers.
+#if defined(F_OFD_SETLK) && defined(F_OFD_SETLKW)
+constexpr int SetLock = F_OFD_SETLK, SetLockWait = F_OFD_SETLKW;
+constexpr bool HasOpenFileLocks = true;
+#elif defined(__APPLE__)
+constexpr int SetLock = 90, SetLockWait = 91;
+constexpr bool HasOpenFileLocks = true;
+#else
+constexpr int SetLock = -1, SetLockWait = -1;
+constexpr bool HasOpenFileLocks = false;
+#endif
+
+std::string errnoText(llvm::StringRef What, int Error) {
+  return (What + ": " + std::strerror(Error)).str();
+}
+
+// A descriptor closed when the measurement ends, however it ends.
+struct Descriptor {
+  int Value = -1;
+  ~Descriptor() {
+    if (Value >= 0)
+      close(Value);
+  }
+};
+
+// The owned cache compares what a name refers to with what an open file or
+// directory is (st_dev and st_ino), before it trusts or removes either.
+bool sameNode(const struct stat &A, const struct stat &B) {
+  return A.st_dev == B.st_dev && A.st_ino == B.st_ino;
+}
+
+std::string measureIn(PathRef Directory, int Dir) {
+  static std::atomic<unsigned> Count{0};
+  const std::string Stem = ".measure-" + std::to_string(getpid()) + "-" +
+                           std::to_string(Count++);
+  const std::string File = Stem + ".file", Sub = Stem + ".directory";
+  Descriptor A, B, D;
+  auto Remove = llvm::scope_exit([&] {
+    unlinkat(Dir, File.c_str(), 0);
+    unlinkat(Dir, Sub.c_str(), AT_REMOVEDIR);
+  });
+  struct stat S, Named;
+  if (fstat(Dir, &S) || stat(Directory.str().c_str(), &Named) ||
+      !sameNode(S, Named))
+    return "an open directory is not the node its name refers to";
+  A.Value = openat(Dir, File.c_str(),
+                   O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+  if (A.Value < 0)
+    return errnoText("a file is not made relative to an open directory", errno);
+  if (fstat(A.Value, &S) || !S_ISREG(S.st_mode) ||
+      !ModuleCachePlatform::privateTo(S) ||
+      !ModuleCachePlatform::singleName(S))
+    return "a file made private is not reported as this user's alone, with "
+           "one name";
+  if (fstatat(Dir, File.c_str(), &Named, AT_SYMLINK_NOFOLLOW) ||
+      !sameNode(S, Named))
+    return "an open file is not the node its name refers to";
+  B.Value = openat(Dir, File.c_str(), O_RDWR | O_NOFOLLOW | O_CLOEXEC);
+  if (B.Value < 0)
+    return errnoText("a file is not opened relative to an open directory",
+                     errno);
+  // The ledger's lock, then the leases' (never both on one file, where some
+  // systems make the two kinds conflict).
+  if (flock(A.Value, LOCK_EX | LOCK_NB))
+    return errnoText("a file lock is not taken", errno);
+  if (!flock(B.Value, LOCK_EX | LOCK_NB))
+    return "a file lock held through one open file does not exclude another "
+           "open of the same file";
+  if (flock(A.Value, LOCK_UN))
+    return errnoText("a file lock is not released", errno);
+  if (int Error = ModuleCachePlatform::lock(A.Value, true, false))
+    return errnoText("an open-file lock is not taken", Error);
+  int Error = ModuleCachePlatform::lock(B.Value, false, false);
+  if (!Error)
+    return "a lock held through one open file does not exclude another open "
+           "of the same file";
+  if (Error != EAGAIN && Error != EACCES)
+    return errnoText("an open-file lock is not tried", Error);
+  if ((Error = ModuleCachePlatform::lock(A.Value, false, false)) ||
+      (Error = ModuleCachePlatform::lock(B.Value, false, false)))
+    return errnoText("a shared open-file lock is not shared", Error);
+  if (write(A.Value, "m", 1) != 1)
+    return errnoText("a file is not written", errno);
+  if ((Error = ModuleCachePlatform::syncData(A.Value)))
+    return errnoText("a file's data are not synced", Error);
+  if (unlinkat(Dir, File.c_str(), 0))
+    return errnoText("an open file's name is not removed", errno);
+  if (!fstatat(Dir, File.c_str(), &S, AT_SYMLINK_NOFOLLOW) || errno != ENOENT)
+    return "a removed name is still found";
+  if (fstat(A.Value, &S) || !ModuleCachePlatform::unnamed(S))
+    return "an open file whose name was removed still reports a name";
+  if (mkdirat(Dir, Sub.c_str(), 0700))
+    return errnoText("a directory is not made relative to an open directory",
+                     errno);
+  D.Value = openat(Dir, Sub.c_str(),
+                   O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (D.Value < 0)
+    return errnoText("a directory is not opened relative to an open "
+                     "directory", errno);
+  if (fstat(D.Value, &S) || !S_ISDIR(S.st_mode) ||
+      !ModuleCachePlatform::privateTo(S))
+    return "a directory made private is not reported as this user's alone";
+  if (fstatat(Dir, Sub.c_str(), &Named, AT_SYMLINK_NOFOLLOW) ||
+      !sameNode(S, Named))
+    return "an open directory is not the node its name refers to";
+  if (unlinkat(Dir, Sub.c_str(), AT_REMOVEDIR))
+    return errnoText("an open directory's name is not removed", errno);
+  if (fstat(D.Value, &S) || !ModuleCachePlatform::unnamed(S))
+    return "an open directory whose name was removed still reports a name";
+  if ((Error = ModuleCachePlatform::syncDirectory(Dir)))
+    return errnoText("a directory's names are not synced", Error);
+  return {};
+}
+#endif
+
+} // namespace
+
+const ModuleCachePlatform::Capabilities &ModuleCachePlatform::stated() {
+  static const Capabilities C = [] {
+    Capabilities C;
+#if CLANGD_OWNED_MODULE_CACHE
+    C.OpenFileLocks = HasOpenFileLocks;
+    C.RelativeDirectories = true;
+    C.RemoveOpen = true;
+#if defined(__linux__)
+    // A delegated cgroup v2 group (ModuleBuildMemoryBudget.cpp).
+    C.WorkerBudget = Budget::Hard;
+#endif
+#endif
+    return C;
+  }();
+  return C;
+}
+
+std::string ModuleCachePlatform::describe(const Capabilities &C) {
+  std::string Text;
+  auto Add = [&](bool Has, llvm::StringRef Name) {
+    if (!Text.empty())
+      Text += ", ";
+    Text += (Has ? "" : "no ");
+    Text += Name;
+  };
+  Add(C.OpenFileLocks, "open-file locks");
+  Add(C.RelativeDirectories, "relative directories");
+  Add(C.RemoveOpen, "removal while open");
+  Text += "; worker budget: ";
+  Text += C.WorkerBudget == Budget::Hard         ? "hard"
+          : C.WorkerBudget == Budget::Supervised ? "supervised"
+                                                 : "none";
+  return Text;
+}
+
+uint64_t ModuleCachePlatform::openFiles() {
+#if CLANGD_OWNED_MODULE_CACHE
+  static const uint64_t Count = []() -> uint64_t {
+    struct rlimit Limit;
+    if (getrlimit(RLIMIT_NOFILE, &Limit))
+      return 0;
+    rlim_t Most = Limit.rlim_max;
+#if defined(__APPLE__)
+    // The system refuses a limit above OPEN_MAX, whatever the hard limit is.
+    Most = (std::min)(Most, rlim_t(OPEN_MAX));
+#endif
+    if (Limit.rlim_cur < Most) {
+      struct rlimit Raised = {Most, Limit.rlim_max};
+      if (!setrlimit(RLIMIT_NOFILE, &Raised))
+        Limit.rlim_cur = Most;
+    }
+    return Limit.rlim_cur == RLIM_INFINITY ? UINT64_MAX
+                                           : uint64_t(Limit.rlim_cur);
+  }();
+  return Count;
+#else
+  return 0;
+#endif
+}
+
+std::string ModuleCachePlatform::measure(PathRef Directory) {
+  const Capabilities &C = stated();
+  if (!C.ownedCache())
+    return "this system provides " + describe(C);
+#if CLANGD_OWNED_MODULE_CACHE
+  if (auto EC = llvm::sys::fs::create_directories(Directory))
+    return "the directory is not made: " + EC.message();
+  Descriptor Dir;
+  Dir.Value = open(Directory.str().c_str(),
+                   O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (Dir.Value < 0)
+    return errnoText("the directory is not opened", errno);
+  return measureIn(Directory, Dir.Value);
+#else
+  (void)Directory;
+  return {};
+#endif
+}
+
+#if CLANGD_OWNED_MODULE_CACHE
+int ModuleCachePlatform::lock(int FD, bool Exclusive, bool Wait) {
+  if (!HasOpenFileLocks)
+    return ENOTSUP;
+  struct flock Range;
+  std::memset(&Range, 0, sizeof(Range));
+  Range.l_type = Exclusive ? F_WRLCK : F_RDLCK;
+  Range.l_whence = SEEK_SET;
+  int R;
+  do {
+    R = fcntl(FD, Wait ? SetLockWait : SetLock, &Range);
+  } while (R < 0 && errno == EINTR);
+  return R ? errno : 0;
+}
+
+int ModuleCachePlatform::syncData(int FD) {
+#if defined(__APPLE__)
+  // The system declares no fdatasync; fsync writes the data and metadata.
+  return fsync(FD) ? errno : 0;
+#else
+  return fdatasync(FD) ? errno : 0;
+#endif
+}
+
+int ModuleCachePlatform::syncDirectory(int FD) { return fsync(FD) ? errno : 0; }
+
+bool ModuleCachePlatform::thisUser(const struct stat &S) {
+  return S.st_uid == geteuid();
+}
+
+bool ModuleCachePlatform::privateTo(const struct stat &S) {
+  return thisUser(S) && !(S.st_mode & 0077);
+}
+
+bool ModuleCachePlatform::singleName(const struct stat &S) {
+  return S.st_nlink == 1;
+}
+
+bool ModuleCachePlatform::unnamed(const struct stat &S) {
+  return S.st_nlink == 0;
+}
+
+struct timespec ModuleCachePlatform::modified(const struct stat &S) {
+#if defined(__APPLE__)
+  return S.st_mtimespec;
+#else
+  return S.st_mtim;
+#endif
+}
+#endif
+
+} // namespace clangd
+} // namespace clang
