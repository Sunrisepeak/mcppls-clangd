+// A worker's leases on its prerequisites share one open cache of their root:
+// each lease adds one open file, its own, and the root's directory and ledger
+// are opened once, so a module that imports many is not limited by the files
+// a process may hold open.
+TEST_F(PrerequisiteModulesTests, OwnedInputLeasesShareTheirRootsCache) {
+  const auto Root = (TestDir + "/inputs/.owned-payload-v1").str();
+  const auto Anchor = (TestDir + "/inputs-anchor").str();
+  { std::error_code EC; llvm::raw_fd_ostream F(Anchor, EC); ASSERT_FALSE(EC); }
+  ASSERT_FALSE(
+      llvm::sys::fs::create_directories(llvm::sys::path::parent_path(Root)));
+  auto Cache = ModuleBuildCache::open(Root, 64, 8);
+  ASSERT_THAT_EXPECTED(Cache, llvm::Succeeded());
+  std::vector<std::string> Payloads;
+  for (const char *Key : {"A", "B", "C", "D"}) {
+    auto Stable = (*Cache)->reserve(Key, Anchor, 8);
+    ASSERT_THAT_EXPECTED(Stable, llvm::Succeeded());
+    { std::error_code EC; llvm::raw_fd_ostream F((*Stable)->payload(), EC); ASSERT_FALSE(EC); F << "BMI"; }
+    ASSERT_THAT_ERROR((*Stable)->publish(), llvm::Succeeded());
+    Payloads.push_back((*Stable)->payload());
+  }
+  auto OpenFiles = [] {
+    unsigned N = 0;
+    for (int FD = 0; FD < 4096; ++FD)
+      N += fcntl(FD, F_GETFD) != -1;
+    return N;
+  };
+  const unsigned Before = OpenFiles();
+  std::vector<std::shared_ptr<ModuleBuildCacheLease>> Inputs;
+  for (const auto &Payload : Payloads) {
+    auto Input = ModuleBuildCache::acquireInput(Payload);
+    ASSERT_THAT_EXPECTED(Input, llvm::Succeeded());
+    ASSERT_TRUE(*Input);
+    Inputs.push_back(std::move(*Input));
+  }
+  // The root's directory and ledger, and a lease for each input.
+  EXPECT_EQ(OpenFiles() - Before, 2u + Payloads.size());
+  Inputs.clear();
+  EXPECT_EQ(OpenFiles(), Before);
+  EXPECT_GE(ModuleCachePlatform::openFiles(), 256u);
+}
