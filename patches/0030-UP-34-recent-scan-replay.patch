               FileName, *Inputs.TFS, Inputs.Contents))
         Inputs.Opts.SkipPreambleBuild =
diff --git a/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp b/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
index 3bc6056..d2bbb98 100644
--- a/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
+++ b/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
@@ -4371,6 +4371,48 @@ TEST_F(PrerequisiteModulesTests, ScanReplayEpochReplaysOncePerOperation) {
   EXPECT_THAT(Scan(), testing::ElementsAre("N"));
 }
 
+TEST_F(PrerequisiteModulesTests, ScanReplayWithinTakesARecentReplay) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission covers this host's test commands only";
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include \"dep.h\"\n");
+  CDB.addFile("dep.h", "import M;\n");
+  auto Generation = CDB.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  auto Scan = [&] {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    return Modules->getRequiredModules(getFullPath("Use.cpp"));
+  };
+  // An operation that allows `Within`, or none.
+  auto Operation = [&](std::optional<std::chrono::milliseconds> Within) {
+    WithContextValue Once(ModuleScanReplayEpoch, nextModuleScanReplayEpoch());
+    std::optional<WithContextValue> Allowance;
+    if (Within)
+      Allowance.emplace(ModuleScanReplayWithin, *Within);
+    return Scan();
+  };
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  // A replay made within the allowance is taken: a file changed outside the
+  // editor that nothing watches is seen by a later operation, not this one.
+  CDB.addFile("dep.h", "import N;\n");
+  auto Before = getModuleDependencyScanCache().stats();
+  EXPECT_THAT(Operation(std::chrono::minutes(1)), testing::ElementsAre("M"));
+  EXPECT_EQ(getModuleDependencyScanCache().stats().Replays, Before.Replays);
+  EXPECT_THAT(Operation(std::nullopt), testing::ElementsAre("N"));
+  EXPECT_THAT(Operation(std::chrono::milliseconds(0)), testing::ElementsAre("N"));
+  // A watched file's change ends the allowance.
+  CDB.addFile("dep.h", "import M;\n");
+  noteModuleScanInputsChanged();
+  EXPECT_THAT(Operation(std::chrono::minutes(1)), testing::ElementsAre("M"));
+  // So does its passing.
+  CDB.addFile("dep.h", "import N;\n");
+  EXPECT_THAT(Operation(std::chrono::milliseconds(0)), testing::ElementsAre("N"));
+  // Outside an operation every lookup replays, whatever it allows.
+  CDB.addFile("dep.h", "import M;\n");
+  WithContextValue Allowance(ModuleScanReplayWithin, std::chrono::minutes(1));
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+}
