diff --git a/clang-tools-extra/clangd/ModuleScanEpoch.h b/clang-tools-extra/clangd/ModuleScanEpoch.h
index ea7d60f..b8b1aac 100644
--- a/clang-tools-extra/clangd/ModuleScanEpoch.h
+++ b/clang-tools-extra/clangd/ModuleScanEpoch.h
@@ -10,6 +10,7 @@
 
 #include "support/Context.h"
 #include <atomic>
+#include <chrono>
 #include <cstdint>
 
 namespace clang::clangd {
@@ -27,6 +28,26 @@ inline uint64_t nextModuleScanReplayEpoch() {
   return ++Next;
 }
 
+// How long ago an earlier operation may have replayed a scan for this one to
+// take it as replayed. Replaying observes every file the scan read -- each
+// header of a global module fragment that includes a platform or framework
+// header, hundreds of opens and stats -- and an operation that sets this has
+// a reason not to wait for that so soon again: a document update, which comes
+// with each keystroke, or a completion, which a person waits for. A file the
+// editor has open is never in a memoized scan, and a watched file's change
+// ends every allowance (noteModuleScanInputsChanged), so what goes unseen
+// meanwhile is a file changed outside the editor that nothing watches. A
+// preamble build sets none, and replays.
+inline constexpr Key<std::chrono::milliseconds> ModuleScanReplayWithin;
+
+inline std::atomic<uint64_t> &moduleScanInputChanges() {
+  static std::atomic<uint64_t> Changes{0};
+  return Changes;
+}
+
+// A watched file changed: no scan replayed before now is taken as replayed.
+inline void noteModuleScanInputsChanged() { ++moduleScanInputChanges(); }
+
 } // namespace clang::clangd
 
 #endif
