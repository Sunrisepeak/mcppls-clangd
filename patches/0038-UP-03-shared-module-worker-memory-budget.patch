+TEST_F(PrerequisiteModulesTests,
+       ModuleWorkerBudgetFailsClosedBeforeRequestRead) {
+  // Ordinary files named like controls are never evidence of a kernel bound.
+  auto Budget = createModuleBuildWorkerMemoryBudget(TestDir, 64 * 1024 * 1024);
+  ASSERT_FALSE(static_cast<bool>(Budget));
+#ifdef __linux__
+  EXPECT_THAT(llvm::toString(Budget.takeError()),
+              testing::HasSubstr("cgroup v2"));
+#else
+  EXPECT_THAT(llvm::toString(Budget.takeError()),
+              testing::HasSubstr("unavailable"));
+#endif
+  auto Err = runModuleBuildWorker((TestDir + "/nonexistent-request.json").str(), "",
+                                  "67108864:0:0:" + TestDir.str().str());
+  ASSERT_TRUE(static_cast<bool>(Err));
+#ifdef __linux__
+  EXPECT_THAT(llvm::toString(std::move(Err)), testing::HasSubstr("cgroup v2"));
+#else
+  EXPECT_THAT(llvm::toString(std::move(Err)),
+              testing::HasSubstr("unavailable"));
+#endif
+  Budget = createModuleBuildWorkerMemoryBudget("relative", 1);
+  ASSERT_FALSE(static_cast<bool>(Budget));
+  llvm::consumeError(Budget.takeError());
+  Budget = createModuleBuildWorkerMemoryBudget(TestDir, 0);
+  ASSERT_FALSE(static_cast<bool>(Budget));
+  llvm::consumeError(Budget.takeError());
+  Err = enterModuleBuildWorkerMemoryBudget("bad-token");
+  ASSERT_TRUE(static_cast<bool>(Err));
+  llvm::consumeError(std::move(Err));
+}
+
 TEST_F(PrerequisiteModulesTests, ModuleWorkerPreservesCapturedInputs) {
   MockDirectoryCompilationDatabase CDB(TestDir, FS);
   CDB.addFile("M.cppm", "#error disk main must not be read\n");
