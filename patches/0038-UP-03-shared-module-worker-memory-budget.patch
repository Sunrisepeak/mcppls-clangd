   if (!Snapshot) {
-    if (Options.Isolation == ModuleBuildWorkerOptions::Policy::WhenSupported)
+    if (Options.Isolation == ModuleBuildWorkerOptions::Policy::WhenSupported &&
+        !MemoryBudget)
       return std::optional<ModuleBuildWorkerResult>{};
     return llvm::createStringError(
         "required module worker cannot export request filesystem");
@@ -438,8 +447,10 @@ buildModuleInWorker(const CompilerInvocation &Invocation,
         "module worker cancelled or timed out during owner setup");
   std::array<std::optional<StringRef>, 3> Redirects{
       StringRef(""), StringRef(""), StringRef(DiagnosticsPath)};
-  std::array<StringRef, 4> Args{Options.Executable, "--module-build-worker",
-                                RequestPath, OwnerToken};
+  const std::string MemoryToken =
+      MemoryBudget ? MemoryBudget->bootstrapToken() : "";
+  std::array<StringRef, 5> Args{Options.Executable, "--module-build-worker",
+                                RequestPath, OwnerToken, MemoryToken};
   std::string LaunchError;
   bool Failed = false;
   auto Process =
@@ -499,6 +510,11 @@ buildModuleInWorker(const CompilerInvocation &Invocation,
 }
 
 llvm::Error runModuleBuildWorker(PathRef RequestFile, StringRef OwnerToken) {
+  return runModuleBuildWorker(RequestFile, OwnerToken, {});
+}
+
+llvm::Error runModuleBuildWorker(PathRef RequestFile, StringRef OwnerToken,
+                                 StringRef MemoryBudgetToken) {
   std::unique_ptr<WorkerOwnerMonitor> Owner;
   if (!OwnerToken.empty()) {
     auto Monitor = WorkerOwnerMonitor::create(OwnerToken);
@@ -506,6 +522,8 @@ llvm::Error runModuleBuildWorker(PathRef RequestFile, StringRef OwnerToken) {
       return Monitor.takeError();
     Owner = std::move(*Monitor);
   }
+  if (auto Err = enterModuleBuildWorkerMemoryBudget(MemoryBudgetToken))
+    return Err;
   auto Buffer = llvm::MemoryBuffer::getFile(RequestFile);
   if (!Buffer)
     return llvm::errorCodeToError(Buffer.getError());
