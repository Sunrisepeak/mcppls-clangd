@@ -0,0 +1,7 @@
+// RUN: %clang_cc1 -std=c++20 -fsyntax-only -verify %s
+
+// A physical continuation and trailing comment must not move the diagnostic
+// onto the next declaration. The insertion belongs immediately after M.
+export module \
+  M // expected-error {{unexpected preprocessing token 'int' after module name}}
+int marker;
