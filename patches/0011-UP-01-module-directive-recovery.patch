+TEST_F(TokenCollectorTest, CXX20MalformedModuleDirectiveHasNoEodToken) {
+  LangStandard = "-std=c++20";
+  AllowErrors = true;
+
+  for (const char *Source : {"import Non.Existent.\n",
+                             "export module Non.Existent.\n",
+                             "module Non.Existent.\n"}) {
+    recordTokens(Source);
+    EXPECT_THAT(Buffer.expandedTokens(),
+                Not(Contains(Kind(tok::eod))));
+    ASSERT_FALSE(Buffer.expandedTokens().empty());
+    EXPECT_EQ(Buffer.expandedTokens().back().kind(), tok::eof);
+  }
+}
+
+TEST_F(TokenCollectorTest, CXX20MissingPrebuiltImportsDoNotRepeatKeywords) {
+  LangStandard = "-std=c++20";
+  AllowErrors = true;
+  recordTokens("export module Main;\n"
+               "export import Missing;\n"
+               "export import Another;\n"
+               "export int marker;\n",
+               {"-fmodule-file=Missing=missing.pcm",
+                "-fmodule-file=Another=another-missing.pcm"});
+  EXPECT_EQ(llvm::count_if(Buffer.expandedTokens(), [](const syntax::Token &T) {
+              return T.kind() == tok::kw_import;
+            }),
+            2);
+  ASSERT_FALSE(Buffer.expandedTokens().empty());
+  EXPECT_EQ(Buffer.expandedTokens().back().kind(), tok::eof);
+}
