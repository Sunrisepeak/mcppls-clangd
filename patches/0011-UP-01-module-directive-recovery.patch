+TEST(DiagnosticsTest, ModuleDirectiveMissingSemicolonRange) {
+  for (const auto &Case : std::vector<std::pair<StringRef, StringRef>>{
+           {"expected_semi_after_module_or_import",
+            "import A[[]]\nimport B;\n"},
+           {"expected_semi_after_module_or_import",
+            "import \\\n  A[[]]\nimport B;\n"},
+           {"pp_unexpected_tok_after_module_name",
+            "export module M[[]] // pending\nint marker;\n"},
+           {"pp_unexpected_tok_after_module_name",
+            "export module \\\n  M[[]]\nint marker;\n"}}) {
+    Annotations Code(Case.second);
+    auto TU = TestTU::withCode(Code.code());
+    TU.Code += "\n// error-ok\n";
+    TU.ExtraArgs.push_back("-std=c++20");
+    EXPECT_THAT(TU.build().getDiagnostics(),
+                Contains(AllOf(diagName(Case.first), hasRange(Code.range()),
+                               withFix(Fix(Code.range(), ";", "insert ';'")))))
+        << Case.second;
+  }
+}
