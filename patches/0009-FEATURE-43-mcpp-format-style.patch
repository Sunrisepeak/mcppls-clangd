diff --git a/clang/unittests/Format/ConfigParseTest.cpp b/clang/unittests/Format/ConfigParseTest.cpp
index 205cc9b..60c4b24 100644
--- a/clang/unittests/Format/ConfigParseTest.cpp
+++ b/clang/unittests/Format/ConfigParseTest.cpp
@@ -1921,4 +1921,14 @@ TEST(ConfigParseTest, RedirectInheritance) {
 
 } // namespace
 } // namespace format
+TEST(ConfigParseTest, McppPreset) {
+  FormatStyle Style = getLLVMStyle(FormatStyle::LK_Cpp);
+  ASSERT_TRUE(getPredefinedStyle("mcpp", FormatStyle::LK_Cpp, &Style));
+  EXPECT_EQ(4u, Style.IndentWidth);
+  EXPECT_EQ(100u, Style.ColumnLimit);
+  EXPECT_EQ(FormatStyle::PAS_Left, Style.PointerAlignment);
+  EXPECT_EQ(FormatStyle::SFS_Empty, Style.AllowShortFunctionsOnASingleLine);
+  EXPECT_FALSE(getPredefinedStyle("mcpp", FormatStyle::LK_JavaScript, &Style));
+}
