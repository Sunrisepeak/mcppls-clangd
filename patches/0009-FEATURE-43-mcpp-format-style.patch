+---
+{"jsonrpc": "2.0", "id": 1, "method": "textDocument/formatting", "params": {"textDocument": {"uri": "test:///style.cpp"}, "options": {"tabSize": 4, "insertSpaces": true}}}
+# CHECK: "id": 1,
+# CHECK: "result": []
+---
+{"jsonrpc":"2.0","id":2,"method":"shutdown","params":null}
+---
+{"jsonrpc":"2.0","method":"exit"}
