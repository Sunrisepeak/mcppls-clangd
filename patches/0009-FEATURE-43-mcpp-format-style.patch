+# RUN: split-file %s %t
+# RUN: clang-format -style=file -fallback-style=mcpp %t/override/input.cpp | FileCheck %s --check-prefix=OVERRIDE --strict-whitespace
+# RUN: clang-format -style=Google -fallback-style=mcpp %t/override/input.cpp | FileCheck %s --check-prefix=USER --strict-whitespace
+# OVERRIDE: void f() {
+# OVERRIDE-NEXT:   int x;
+# OVERRIDE-NEXT: }
+# USER: void f() { int x; }
