From 07d1384ad742d51289079fc609022b9f1c155ece Mon Sep 17 00:00:00 2001
From: sunrisepeak <speakshen@163.com>
Date: Wed, 7 Oct 2026 01:26:20 +0900
Subject: [PATCH] [clangd] Validation memo respects the request filesystem

---
 .../clangd/ModuleValidationCache.h            | 13 +++++--
 clang-tools-extra/clangd/ModulesBuilder.cpp   |  5 +--
 clang-tools-extra/clangd/test/CMakeLists.txt  |  8 +++++
 .../test/Inputs/validation-overlay-probe.cpp  | 34 +++++++++++++++++++
 .../test/modules-validation-overlay.test      |  7 ++++
 5 files changed, 62 insertions(+), 5 deletions(-)
 create mode 100644 clang-tools-extra/clangd/test/Inputs/validation-overlay-probe.cpp
 create mode 100644 clang-tools-extra/clangd/test/modules-validation-overlay.test

diff --git a/clang-tools-extra/clangd/ModuleValidationCache.h b/clang-tools-extra/clangd/ModuleValidationCache.h
index f04a76aa0..c2cb062ba 100644
--- a/clang-tools-extra/clangd/ModuleValidationCache.h
+++ b/clang-tools-extra/clangd/ModuleValidationCache.h
@@ -40,6 +40,7 @@
 #include "llvm/ADT/StringMap.h"
 #include "llvm/ADT/StringRef.h"
 #include "llvm/Support/FileSystem.h"
+#include "llvm/Support/VirtualFileSystem.h"
 #include <chrono>
 #include <cstdint>
 #include <mutex>
@@ -81,7 +82,8 @@ public:
   /// Returns true when a previous validation of \p BMIPath under the
   /// dependency chain \p ChainKey concluded up-to-date and neither the BMI
   /// nor any recorded input has moved since. Any doubt returns false.
-  bool isFresh(llvm::StringRef BMIPath, llvm::StringRef ChainKey) {
+  bool isFresh(llvm::StringRef BMIPath, llvm::StringRef ChainKey,
+               llvm::vfs::FileSystem &FS) {
     std::lock_guard<std::mutex> Lock(Mutex);
     auto It = Entries.find(key(BMIPath, ChainKey));
     if (It == Entries.end())
@@ -90,11 +92,16 @@ public:
       Entries.erase(It);
       return false;
     }
-    for (const auto &Input : It->second.Inputs)
-      if (identityOf(Input.first) != Input.second) {
+    for (const auto &Input : It->second.Inputs) {
+      auto Visible = FS.status(Input.first);
+      if (!Visible || Visible->getUniqueID() != Input.second.ID ||
+          Visible->getSize() != Input.second.Size ||
+          Visible->getLastModificationTime() != Input.second.ModTime ||
+          identityOf(Input.first) != Input.second) {
         Entries.erase(It);
         return false;
       }
+    }
     return true;
   }
 
diff --git a/clang-tools-extra/clangd/ModulesBuilder.cpp b/clang-tools-extra/clangd/ModulesBuilder.cpp
index 4bd39f953..2e4fcd218 100644
--- a/clang-tools-extra/clangd/ModulesBuilder.cpp
+++ b/clang-tools-extra/clangd/ModulesBuilder.cpp
@@ -661,7 +661,8 @@ void recordValidationInputs(
       if (!FE)
         return;
       auto Disk = ModuleValidationCache::identityOf(FE->getName());
-      if (!Disk || Disk->Size != static_cast<uint64_t>(FE->getSize()) ||
+      if (!Disk || Disk->ID != FE->getUniqueID() ||
+          Disk->Size != static_cast<uint64_t>(FE->getSize()) ||
           std::chrono::time_point_cast<std::chrono::seconds>(Disk->ModTime) !=
               llvm::sys::toTimePoint(FE->getModificationTime())) {
         Inputs.clear();
@@ -691,7 +692,7 @@ bool IsModuleFileUpToDate(PathRef ModuleFilePath,
   std::string ChainKey;
   RequisiteModules.getValidationChainKey(ChainKey);
   ModuleValidationCache &ValidationCache = getModuleValidationCache();
-  if (ValidationCache.isFresh(ModuleFilePath, ChainKey)) {
+  if (ValidationCache.isFresh(ModuleFilePath, ChainKey, *VFS)) {
     log("Module file {0} is up to date via the validation cache",
         ModuleFilePath);
     return true;
diff --git a/clang-tools-extra/clangd/test/CMakeLists.txt b/clang-tools-extra/clangd/test/CMakeLists.txt
index 608835cab..0f84b8007 100644
--- a/clang-tools-extra/clangd/test/CMakeLists.txt
+++ b/clang-tools-extra/clangd/test/CMakeLists.txt
@@ -50,3 +50,11 @@ add_lit_testsuite(check-clangd "Running the Clangd regression tests"
   # project only needs to pass CMAKE_CURRENT_BINARY_DIR.
   ${CMAKE_CURRENT_BINARY_DIR}/../unittests;${CMAKE_CURRENT_BINARY_DIR}
   DEPENDS ${CLANGD_TEST_DEPS})
+
+# A focused cache contract probe avoids linking the complete server test suite.
+set(LLVM_LINK_COMPONENTS Support)
+add_llvm_executable(clangd-validation-overlay-probe EXCLUDE_FROM_ALL
+  Inputs/validation-overlay-probe.cpp)
+target_include_directories(clangd-validation-overlay-probe PRIVATE
+  ${CMAKE_CURRENT_SOURCE_DIR}/..)
+add_dependencies(check-clangd clangd-validation-overlay-probe)
diff --git a/clang-tools-extra/clangd/test/Inputs/validation-overlay-probe.cpp b/clang-tools-extra/clangd/test/Inputs/validation-overlay-probe.cpp
new file mode 100644
index 000000000..ffaefb3ec
--- /dev/null
+++ b/clang-tools-extra/clangd/test/Inputs/validation-overlay-probe.cpp
@@ -0,0 +1,34 @@
+//===-- validation-overlay-probe.cpp ---------------------------------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//===----------------------------------------------------------------------===//
+#include "ModuleValidationCache.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/VirtualFileSystem.h"
+#include "llvm/Support/raw_ostream.h"
+
+int main(int argc, char **argv) {
+  if (argc != 3)
+    return 2;
+  llvm::StringRef BMI = argv[1], Input = argv[2];
+  auto ID = clang::clangd::ModuleValidationCache::identityOf(Input);
+  if (!ID)
+    return 3;
+  clang::clangd::ModuleValidationCache Cache;
+  Cache.markFresh(BMI, "dependency", {{Input.str(), *ID}});
+  auto Disk = llvm::vfs::getRealFileSystem();
+  if (!Cache.isFresh(BMI, "dependency", *Disk))
+    return 4;
+  auto Draft = llvm::makeIntrusiveRefCnt<llvm::vfs::InMemoryFileSystem>();
+  std::string DraftContents(ID->Size, 'x');
+  Draft->addFile(Input, llvm::sys::toTimeT(ID->ModTime),
+                 llvm::MemoryBuffer::getMemBufferCopy(DraftContents));
+  auto Overlay = llvm::makeIntrusiveRefCnt<llvm::vfs::OverlayFileSystem>(Disk);
+  Overlay->pushOverlay(Draft);
+  if (Cache.isFresh(BMI, "dependency", *Overlay)) {
+    llvm::errs() << "disk validation verdict accepted a draft overlay\n";
+    return 5;
+  }
+  return 0;
+}
diff --git a/clang-tools-extra/clangd/test/modules-validation-overlay.test b/clang-tools-extra/clangd/test/modules-validation-overlay.test
new file mode 100644
index 000000000..dda41392a
--- /dev/null
+++ b/clang-tools-extra/clangd/test/modules-validation-overlay.test
@@ -0,0 +1,7 @@
+# A disk-only validation verdict must not be accepted for an unsaved draft,
+# even when its size matches the disk input. Ordinary disk lookup still hits.
+# RUN: rm -fr %t
+# RUN: mkdir -p %t
+# RUN: echo bmi > %t/bmi
+# RUN: echo input > %t/input
+# RUN: clangd-validation-overlay-probe %t/bmi %t/input
