index 0123b3d64..d6fc221b9 100644
--- a/clang-tools-extra/clangd/ModuleDependencyScanCache.h
+++ b/clang-tools-extra/clangd/ModuleDependencyScanCache.h
@@ -29,6 +29,10 @@ extern char **environ;
 #include "llvm/Support/VirtualFileSystem.h"
 #include <algorithm>
 #include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <thread>
+#include <utility>
 #include <list>
 #include <map>
