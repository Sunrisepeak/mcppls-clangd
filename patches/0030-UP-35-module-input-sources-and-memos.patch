new file mode 100644
index 0000000..f2ae9f1
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleInputSources.h
@@ -0,0 +1,244 @@
+//===--- ModuleInputSources.h - Where a module input comes from -*- C++-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// A memoized dependency scan, and a BMI's validation verdict, are reused only
+// while every file they read is as it was. Checking that is a stat or an open
+// per file, and a global module fragment that includes a platform or framework
+// header reads hundreds of them -- on Windows, where a stat opens a handle,
+// that is most of the cost of a completion.
+//
+// Not every input changes the same way:
+//
+// - Files under a managed root (--managed-input-root) belong to a package
+//   version: <root>/<package>/<version>/. A package manager installs a version
+//   into its own directory, writes its completion markers last, and is the
+//   only one to touch it afterwards; any change of its own rewrites a marker.
+//   A package version is checked by its markers, not file by file.
+// - Files under a system root -- what the command searches as system headers
+//   (-isystem, -idirafter, the sysroot) and the toolchain the driver belongs
+//   to -- change with a system or toolchain update. Like clang's own module
+//   input validation, which skips system inputs, they are checked once per
+//   session.
+// - Everything else is the project's, and is checked every time.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEINPUTSOURCES_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEINPUTSOURCES_H
+
+#include "clang/Tooling/CompilationDatabase.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/ADT/StringSet.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/SHA256.h"
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace clang::clangd {
+
+/// How far a check of the inputs a scan or validation read went, per source.
+/// Thread-local: an operation reads the difference around its own work.
+struct ModuleInputCounters {
+  uint64_t Project = 0;       // observations or inputs checked one by one
+  uint64_t Package = 0;       // of a package version whose markers held
+  uint64_t System = 0;        // under a system root already checked
+  uint64_t PackageChecks = 0; // package versions checked by their markers
+  ModuleInputCounters operator-(const ModuleInputCounters &O) const {
+    return {Project - O.Project, Package - O.Package, System - O.System,
+            PackageChecks - O.PackageChecks};
+  }
+};
+inline ModuleInputCounters &moduleInputCounters() {
+  static thread_local ModuleInputCounters Counters;
+  return Counters;
+}
+
+class ModuleInputSources {
+public:
+  enum Kind { Project, Package, System };
+  using Identity = std::array<uint8_t, 32>;
+
+  /// The package managers' stores, process-wide (--managed-input-root).
+  static void setManagedRoots(const std::vector<std::string> &Roots) {
+    std::vector<std::string> Normal;
+    for (const auto &Root : Roots)
+      if (!Root.empty())
+        Normal.push_back(normalized(Root, "") + "/");
+    std::lock_guard<std::mutex> Lock(rootsMutex());
+    managedRoots() = std::move(Normal);
+  }
+  static std::vector<std::string> getManagedRoots() {
+    std::lock_guard<std::mutex> Lock(rootsMutex());
+    return managedRoots();
+  }
+
+  /// The system roots of a scan or build command.
+  static std::shared_ptr<const ModuleInputSources>
+  forCommand(const tooling::CompileCommand &Command) {
+    auto Result = std::make_shared<ModuleInputSources>();
+    Result->Managed = getManagedRoots();
+    auto Add = [&](llvm::StringRef Dir) {
+      if (Dir.empty())
+        return;
+      std::string Root = normalized(Dir, Command.Directory);
+      // A root of the whole filesystem would make every file a system one.
+      if (llvm::StringRef(Root).count('/') < 2)
+        return;
+      Result->SystemRoots.push_back(Root + "/");
+    };
+    const auto &Args = Command.CommandLine;
+    if (!Args.empty() && llvm::sys::path::is_absolute(Args.front())) {
+      // <toolchain>/bin/<driver>: the toolchain's own headers and libraries.
+      llvm::StringRef Bin = llvm::sys::path::parent_path(Args.front());
+      if (llvm::sys::path::filename(Bin) == "bin")
+        Add(llvm::sys::path::parent_path(Bin));
+    }
+    for (size_t I = 1; I < Args.size(); ++I) {
+      llvm::StringRef Arg = Args[I];
+      for (llvm::StringRef Flag :
+           {"-isystem", "-idirafter", "-isysroot", "--sysroot", "-imsvc",
+            "/imsvc", "-external:I", "/external:I"}) {
+        if (Arg == Flag && I + 1 < Args.size()) {
+          Add(Args[I + 1]);
+          break;
+        }
+        if (Arg.consume_front(Flag)) {
+          Arg.consume_front("=");
+          Add(Arg);
+          break;
+        }
+      }
+    }
+    return Result;
+  }
+
+  /// Which source `Path` (absolute, or relative to `WorkingDirectory`) is
+  /// from; for a package, `PackageDir` is its version directory.
+  Kind classify(llvm::StringRef Path, llvm::StringRef WorkingDirectory,
+                std::string *PackageDir = nullptr) const {
+    std::string Normal = normalized(Path, WorkingDirectory);
+    llvm::StringRef File(Normal);
+    for (const auto &Root : Managed) {
+      if (!File.starts_with(Root))
+        continue;
+      // <root>/<package>/<version>/<file within it>
+      llvm::StringRef Rest = File.drop_front(Root.size());
+      auto [Name, AfterName] = Rest.split('/');
+      auto [Version, Within] = AfterName.split('/');
+      if (Name.empty() || Version.empty() || Within.empty())
+        return Project;
+      if (PackageDir)
+        *PackageDir = Root + Name.str() + "/" + Version.str();
+      return Kind::Package;
+    }
+    for (const auto &Root : SystemRoots)
+      if (File.starts_with(Root))
+        return System;
+    return Project;
+  }
+
+  /// A package version's identity: its markers' size, time and file id, in
+  /// a fixed order. nullopt when it has none, and is then no package at all.
+  static std::optional<Identity> packageIdentity(llvm::StringRef PackageDir) {
+    llvm::SHA256 Hash;
+    bool Any = false;
+    for (llvm::StringRef Marker :
+         {".mcpp_ok", ".xpkg-install.json", ".mcpp-fixup.json",
+          ".xlings-resolution.json"}) {
+      llvm::SmallString<256> File(PackageDir);
+      llvm::sys::path::append(File, Marker);
+      llvm::sys::fs::file_status Status;
+      Hash.update(Marker);
+      if (llvm::sys::fs::status(File, Status) ||
+          !llvm::sys::fs::is_regular_file(Status)) {
+        Hash.update(llvm::StringRef("-", 1));
+        continue;
+      }
+      Any |= Marker == ".mcpp_ok" || Marker == ".xpkg-install.json";
+      uint64_t Fields[] = {
+          Status.getSize(),
+          static_cast<uint64_t>(
+              Status.getLastModificationTime().time_since_epoch().count()),
+          Status.getUniqueID().getDevice(), Status.getUniqueID().getFile()};
+      Hash.update(llvm::ArrayRef<uint8_t>(
+          reinterpret_cast<const uint8_t *>(Fields), sizeof(Fields)));
+    }
+    if (!Any)
+      return std::nullopt;
+    return Hash.final();
+  }
+
+  /// System inputs replayed this session: they are not replayed again.
+  static bool systemChecked(llvm::StringRef NormalPath) {
+    std::lock_guard<std::mutex> Lock(systemMutex());
+    return systemPaths().contains(NormalPath);
+  }
+  static void noteSystemChecked(llvm::ArrayRef<std::string> NormalPaths) {
+    if (NormalPaths.empty())
+      return;
+    std::lock_guard<std::mutex> Lock(systemMutex());
+    for (const auto &Path : NormalPaths)
+      systemPaths().insert(Path);
+  }
+
+  /// `Path` made absolute against `WorkingDirectory`, with `/` separators,
+  /// no `.` or `..`, and lower case where the filesystem ignores it.
+  static std::string normalized(llvm::StringRef Path,
+                                llvm::StringRef WorkingDirectory) {
+    llvm::SmallString<256> Result(Path);
+    if (!llvm::sys::path::is_absolute(Result) && !WorkingDirectory.empty()) {
+      llvm::SmallString<256> Base(WorkingDirectory);
+      llvm::sys::path::append(Base, Result);
+      Result = Base;
+    }
+    llvm::sys::path::remove_dots(Result, /*remove_dot_dot=*/true);
+    std::string Out = Result.str().str();
+    for (char &C : Out) {
+      if (C == '\\')
+        C = '/';
+#ifdef _WIN32
+      C = static_cast<char>(llvm::toLower(C));
+#endif
+    }
+    while (Out.size() > 1 && Out.back() == '/')
+      Out.pop_back();
+    return Out;
+  }
+
+  std::vector<std::string> Managed;
+  std::vector<std::string> SystemRoots;
+
+private:
+  static std::mutex &rootsMutex() {
+    static std::mutex M;
+    return M;
+  }
+  static std::vector<std::string> &managedRoots() {
+    static std::vector<std::string> Roots;
+    return Roots;
+  }
+  static std::mutex &systemMutex() {
+    static std::mutex M;
+    return M;
+  }
+  static llvm::StringSet<> &systemPaths() {
+    static llvm::StringSet<> Paths;
+    return Paths;
+  }
+};
+
+} // namespace clang::clangd
+
+#endif
