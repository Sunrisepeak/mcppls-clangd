+TEST_F(PrerequisiteModulesTests, ValidationVerdictsCheckPackagesByTheirMarkers) {
+  writeTestFile(TestDir, "store/lib/2.0/.mcpp_ok", "1\n");
+  writeTestFile(TestDir, "store/lib/2.0/include/lib.h", "int lib;\n");
+  writeTestFile(TestDir, "own.h", "int own;\n");
+  writeTestFile(TestDir, "M.pcm", "bmi\n");
+  ModuleInputSources::setManagedRoots({getFullPath("store")});
+  auto Reset = llvm::make_scope_exit([] { ModuleInputSources::setManagedRoots({}); });
+  const std::string Lib = getFullPath("store/lib/2.0/include/lib.h");
+  const std::string Own = getFullPath("own.h");
+  const std::string BMI = getFullPath("M.pcm");
+  ModuleValidationCache Cache;
+  Cache.markFresh(BMI, "chain",
+                  {{Lib, *ModuleValidationCache::identityOf(Lib)},
+                   {Own, *ModuleValidationCache::identityOf(Own)}});
+  auto RealFS = llvm::vfs::getRealFileSystem();
+  EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+  // The package's header changed without its markers: still fresh.
+  writeTestFile(TestDir, "store/lib/2.0/include/lib.h", "int library_changed;\n");
+  EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+  // The project's own input changed: stale.
+  writeTestFile(TestDir, "own.h", "int own_changed;\n");
+  EXPECT_FALSE(Cache.isFresh(BMI, "chain", *RealFS));
+  // A marker changed: the package's inputs are checked one by one again.
+  Cache.markFresh(BMI, "chain",
+                  {{Lib, *ModuleValidationCache::identityOf(Lib)},
+                   {Own, *ModuleValidationCache::identityOf(Own)}});
+  writeTestFile(TestDir, "store/lib/2.0/include/lib.h", "int library_again;\n");
+  EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+  writeTestFile(TestDir, "store/lib/2.0/.mcpp_ok", "reinstalled\n");
+  EXPECT_FALSE(Cache.isFresh(BMI, "chain", *RealFS));
+}
