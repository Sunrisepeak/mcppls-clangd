+  /// A scan an earlier session kept (ModuleMemoStore.h). Its environment is
+  /// persistedEnvironment(): the complete one changes from one session to the
+  /// next (an editor sets variables of its own), so what is kept names only
+  /// the variables a driver reads for headers, macros and tools.
+  struct KeptScan {
+    std::string File;
+    tooling::CompileCommand Command;
+    ModuleScanManifest::Digest MainBytes, Environment;
+    ModuleScanManifest Inputs;
+    ModuleScanResult Result;
+  };
+  static ModuleScanManifest::Digest persistedEnvironment() {
+    llvm::SHA256 Hash;
+    for (const char *Name :
+         {"PATH", "CPATH", "C_INCLUDE_PATH", "CPLUS_INCLUDE_PATH",
+          "OBJC_INCLUDE_PATH", "OBJCPLUS_INCLUDE_PATH", "INCLUDE",
+          "EXTERNAL_INCLUDE", "CL", "_CL_", "SDKROOT", "DEVELOPER_DIR",
+          "MACOSX_DEPLOYMENT_TARGET", "IPHONEOS_DEPLOYMENT_TARGET",
+          "CCC_OVERRIDE_OPTIONS", "COMPILER_PATH", "GCC_EXEC_PREFIX",
+          "VCINSTALLDIR", "VCToolsInstallDir", "VSINSTALLDIR",
+          "WindowsSdkDir", "WindowsSDKVersion", "UniversalCRTSdkDir",
+          "UCRTVersion"}) {
+      Hash.update(llvm::StringRef(Name));
+      Hash.update(llvm::StringRef("=", 1));
+      if (auto Value = llvm::sys::Process::GetEnv(Name))
+        Hash.update(*Value);
+      Hash.update(llvm::StringRef("\0", 1));
+    }
+    return Hash.final();
+  }
+  /// What the store writes: every live scan whose manifest can be replayed
+  /// in another session, and the kept ones not yet replayed in this one.
+  std::vector<KeptScan> snapshot(uint64_t &StoredSoFar) {
+    std::lock_guard<std::mutex> Lock(Mu);
+    StoredSoFar = Stores.load();
+    std::vector<KeptScan> Out;
+    const auto Kept = persistedEnvironment();
+    // Kept by command, not by database: one whose database is gone (a
+    // reload, or a check that has returned) is as good for the next session.
+    for (const auto &E : Entries) {
+      if (!E->Inputs.Complete || E->Inputs.OpenFiles)
+        continue;
+      Out.push_back({E->File, E->Command, E->MainBytes, Kept, E->Inputs,
+                     E->Result});
+    }
+    for (const auto &K : Earlier)
+      Out.push_back(K);
+    return Out;
+  }
+  void adopt(std::vector<KeptScan> Scans) {
+    std::lock_guard<std::mutex> Lock(Mu);
+    for (auto &S : Scans)
+      if (Earlier.size() < EarlierBound)
+        Earlier.push_back(std::move(S));
+  }
+  uint64_t keptHits() const { return KeptHits.load(); }
+
 private:
+  // A kept scan for this request: replayed against what is there now, as a
+  // scan made in this session would be on publication, and stored for this
+  // database when it holds.
+  std::optional<ModuleScanResult>
+  fromEarlierSession(
+      const std::shared_ptr<const tooling::CompilationDatabase> &CDB,
+      llvm::StringRef File, const tooling::CompileCommand &Command,
+      ModuleScanManifest::Digest MainBytes,
+      ModuleScanManifest::Digest Environment, llvm::vfs::FileSystem &FS) {
+    std::optional<KeptScan> Found;
+    {
+      std::lock_guard<std::mutex> Lock(Mu);
+      if (Earlier.empty())
+        return std::nullopt;
+      const auto Kept = persistedEnvironment();
+      for (auto I = Earlier.begin(); I != Earlier.end(); ++I)
+        if (I->File == File && I->Command == Command &&
+            I->MainBytes == MainBytes && I->Environment == Kept) {
+          Found = std::move(*I);
+          Earlier.erase(I);
+          break;
+        }
+    }
+    if (!Found)
+      return std::nullopt;
+    auto Key = store(CDB, File, Command, MainBytes, Environment,
+                     std::move(Found->Inputs), Found->Result, FS);
+    if (Key.empty())
+      return std::nullopt;
+    ++KeptHits;
+    Found->Result.VerifiedInputsKey = std::move(Key);
+    vlog("Module dependency scan kept from an earlier session: {0}", File);
+    return std::move(Found->Result);
+  }
+
+  static constexpr size_t EarlierBound = 4096;
+  std::list<KeptScan> Earlier;
+  std::atomic<uint64_t> KeptHits{0};
   std::shared_ptr<Flights> FlightRegistry = std::make_shared<Flights>();
   std::mutex Mu;
   std::list<std::shared_ptr<Entry>> Entries;
