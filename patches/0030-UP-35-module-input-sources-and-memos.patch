+//===--- ModuleMemoStore.cpp - Module memos kept across sessions -*- C++-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "ModuleMemoStore.h"
+#include "ModuleDependencyScanCache.h"
+#include "ModuleValidationCache.h"
+#include "support/Logger.h"
+#include "clang/Basic/Version.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/JSON.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/raw_ostream.h"
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+namespace clang::clangd {
+namespace {
+
+constexpr int FormatVersion = 1;
+constexpr llvm::StringLiteral FileName = "module-memos.json";
+
+using llvm::json::Array;
+using llvm::json::Object;
+using llvm::json::Value;
+
+// 64-bit values as hexadecimal: JSON numbers stop at 2^53.
+std::string hex64(uint64_t V) { return llvm::utohexstr(V); }
+std::optional<uint64_t> unhex64(const Value *V) {
+  auto S = V ? V->getAsString() : std::nullopt;
+  uint64_t Out;
+  if (!S || S->getAsInteger(16, Out))
+    return std::nullopt;
+  return Out;
+}
+template <size_t N> std::string hexDigest(const std::array<uint8_t, N> &D) {
+  return llvm::toHex(llvm::ArrayRef<uint8_t>(D.data(), D.size()));
+}
+template <size_t N>
+bool unhexDigest(const Value *V, std::array<uint8_t, N> &Out) {
+  auto S = V ? V->getAsString() : std::nullopt;
+  if (!S || S->size() != 2 * N)
+    return false;
+  std::string Bytes;
+  if (!llvm::tryGetFromHex(*S, Bytes) || Bytes.size() != N)
+    return false;
+  std::copy(Bytes.begin(), Bytes.end(), Out.begin());
+  return true;
+}
+int64_t nanos(llvm::sys::TimePoint<> T) {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             T.time_since_epoch())
+      .count();
+}
+llvm::sys::TimePoint<> fromNanos(int64_t N) {
+  return llvm::sys::TimePoint<>(std::chrono::nanoseconds(N));
+}
+
+Value packagesJSON(
+    const std::map<std::string, std::optional<ModuleInputSources::Identity>>
+        &Packages) {
+  Array Out;
+  for (const auto &[Dir, Identity] : Packages)
+    Out.push_back(Array{Dir, Identity ? Value(hexDigest(*Identity))
+                                      : Value(nullptr)});
+  return Out;
+}
+bool packagesFrom(
+    const Array *In,
+    std::map<std::string, std::optional<ModuleInputSources::Identity>> &Out) {
+  if (!In)
+    return false;
+  for (const auto &Item : *In) {
+    const Array *Pair = Item.getAsArray();
+    if (!Pair || Pair->size() != 2 || !(*Pair)[0].getAsString())
+      return false;
+    std::optional<ModuleInputSources::Identity> Identity;
+    if ((*Pair)[1].kind() != Value::Null) {
+      Identity.emplace();
+      if (!unhexDigest(&(*Pair)[1], *Identity))
+        return false;
+    }
+    Out.emplace((*Pair)[0].getAsString()->str(), Identity);
+  }
+  return true;
+}
+
+Value identityJSON(const ModuleValidationCache::FileIdentity &I) {
+  return Array{hex64(I.Size), nanos(I.ModTime), hex64(I.ID.getDevice()),
+               hex64(I.ID.getFile())};
+}
+std::optional<ModuleValidationCache::FileIdentity>
+identityFrom(const Value *V) {
+  const Array *A = V ? V->getAsArray() : nullptr;
+  if (!A || A->size() != 4)
+    return std::nullopt;
+  auto Size = unhex64(&(*A)[0]);
+  auto Time = (*A)[1].getAsInteger();
+  auto Device = unhex64(&(*A)[2]);
+  auto File = unhex64(&(*A)[3]);
+  if (!Size || !Time || !Device || !File)
+    return std::nullopt;
+  ModuleValidationCache::FileIdentity I;
+  I.Size = *Size;
+  I.ModTime = fromNanos(*Time);
+  I.ID = llvm::sys::fs::UniqueID(*Device, *File);
+  return I;
+}
+
+// ---- BMI validation verdicts ---------------------------------------------
+
+// json::Value keeps a StringRef without copying it: every string given here
+// is a std::string, owned by the value.
+Value verdictJSON(const std::string &Key,
+                  const ModuleValidationCache::Entry &E) {
+  Array Inputs;
+  for (const auto &In : E.Inputs)
+    Inputs.push_back(Array{In.Path, identityJSON(In.Identity), In.Package});
+  return Object{{"key", Key},
+                {"bmi", identityJSON(E.BMI)},
+                {"inputs", std::move(Inputs)},
+                {"packages", packagesJSON(E.Packages)}};
+}
+std::optional<std::pair<std::string,
+                        std::shared_ptr<const ModuleValidationCache::Entry>>>
+verdictFrom(const Value &V) {
+  const Object *O = V.getAsObject();
+  if (!O)
+    return std::nullopt;
+  auto Key = O->getString("key");
+  auto BMI = identityFrom(O->get("bmi"));
+  const Array *Inputs = O->getArray("inputs");
+  if (!Key || !BMI || !Inputs)
+    return std::nullopt;
+  auto E = std::make_shared<ModuleValidationCache::Entry>();
+  E->BMI = *BMI;
+  for (const auto &Item : *Inputs) {
+    const Array *A = Item.getAsArray();
+    if (!A || A->size() != 3 || !(*A)[0].getAsString() ||
+        !(*A)[2].getAsString())
+      return std::nullopt;
+    auto Identity = identityFrom(&(*A)[1]);
+    if (!Identity)
+      return std::nullopt;
+    E->Inputs.push_back({(*A)[0].getAsString()->str(), *Identity,
+                         (*A)[2].getAsString()->str()});
+  }
+  if (E->Inputs.empty() || !packagesFrom(O->getArray("packages"), E->Packages))
+    return std::nullopt;
+  return std::make_pair(Key->str(),
+                        std::shared_ptr<const ModuleValidationCache::Entry>(E));
+}
+
+// ---- dependency scans ------------------------------------------------------
+
+// Errors a real filesystem gives; any other category is not kept.
+std::optional<Value> errorJSON(std::error_code EC) {
+  if (!EC)
+    return Value(nullptr);
+  if (EC.category() == std::generic_category())
+    return Array{"generic", EC.value()};
+  if (EC.category() == std::system_category())
+    return Array{"system", EC.value()};
+  return std::nullopt;
+}
+std::optional<std::error_code> errorFrom(const Value *V) {
+  if (!V || V->kind() == Value::Null)
+    return std::error_code();
+  const Array *A = V->getAsArray();
+  if (!A || A->size() != 2)
+    return std::nullopt;
+  auto Category = (*A)[0].getAsString();
+  auto Code = (*A)[1].getAsInteger();
+  if (!Category || !Code)
+    return std::nullopt;
+  if (*Category == "generic")
+    return std::error_code(static_cast<int>(*Code), std::generic_category());
+  if (*Category == "system")
+    return std::error_code(static_cast<int>(*Code), std::system_category());
+  return std::nullopt;
+}
+
+std::optional<Value> scanJSON(
+    const ModuleDependencyScanCache::KeptScan &S) {
+  Array Observations;
+  for (const auto &O : S.Inputs.observations()) {
+    auto Error = errorJSON(O.Error);
+    if (!Error)
+      return std::nullopt;
+    Value Info(nullptr);
+    if (O.Info)
+      Info = Array{O.Info->Name,
+                   hex64(O.Info->ID.getDevice()),
+                   hex64(O.Info->ID.getFile()),
+                   nanos(O.Info->MTime),
+                   hex64(O.Info->Size),
+                   O.Info->User,
+                   O.Info->Group,
+                   static_cast<int64_t>(O.Info->Type),
+                   static_cast<int64_t>(O.Info->Permissions),
+                   O.Info->External};
+    Observations.push_back(Array{
+        static_cast<int64_t>(O.Operation), O.Path, std::move(*Error),
+        std::move(Info), O.Name, hexDigest(O.Bytes), hex64(O.Size),
+        O.RequestedSize, O.NullTerminated, O.Found, O.Binary,
+        static_cast<int64_t>(O.EntryType)});
+  }
+  Array Args;
+  for (const auto &A : S.Command.CommandLine)
+    Args.push_back(A);
+  Array Requires;
+  for (const auto &R : S.Result.RequiredModules)
+    Requires.push_back(R);
+  Array Managed, System;
+  if (S.Inputs.Sources) {
+    for (const auto &R : S.Inputs.Sources->Managed)
+      Managed.push_back(R);
+    for (const auto &R : S.Inputs.Sources->SystemRoots)
+      System.push_back(R);
+  }
+  return Object{
+      {"file", S.File},
+      {"command", Object{{"directory", S.Command.Directory},
+                         {"file", S.Command.Filename},
+                         {"output", S.Command.Output},
+                         {"heuristic", S.Command.Heuristic},
+                         {"arguments", std::move(Args)}}},
+      {"main", hexDigest(S.MainBytes)},
+      {"environment", hexDigest(S.Environment)},
+      {"workingDirectory", S.Inputs.WorkingDirectory},
+      {"recordedAt",
+       std::chrono::duration_cast<std::chrono::nanoseconds>(
+           S.Inputs.RecordedAt.time_since_epoch())
+           .count()},
+      {"sources", Object{{"managed", std::move(Managed)},
+                         {"system", std::move(System)},
+                         {"present", S.Inputs.Sources != nullptr}}},
+      {"packages", packagesJSON(S.Inputs.Packages)},
+      {"observations", std::move(Observations)},
+      {"module", S.Result.ModuleName ? Value(*S.Result.ModuleName)
+                                     : Value(nullptr)},
+      {"requires", std::move(Requires)},
+      {"failure", S.Result.FailureDiagnostic
+                      ? Value(*S.Result.FailureDiagnostic)
+                      : Value(nullptr)}};
+}
+
+std::optional<ModuleDependencyScanCache::KeptScan> scanFrom(const Value &V) {
+  const Object *O = V.getAsObject();
+  if (!O)
+    return std::nullopt;
+  ModuleDependencyScanCache::KeptScan S;
+  auto File = O->getString("file");
+  const Object *Command = O->getObject("command");
+  auto WorkingDirectory = O->getString("workingDirectory");
+  auto RecordedAt = O->getInteger("recordedAt");
+  const Object *Sources = O->getObject("sources");
+  const Array *Observations = O->getArray("observations");
+  if (!File || !Command || !WorkingDirectory || !RecordedAt || !Sources ||
+      !Observations || !unhexDigest(O->get("main"), S.MainBytes) ||
+      !unhexDigest(O->get("environment"), S.Environment))
+    return std::nullopt;
+  S.File = File->str();
+  auto Directory = Command->getString("directory");
+  auto CommandFile = Command->getString("file");
+  auto Output = Command->getString("output");
+  auto Heuristic = Command->getString("heuristic");
+  const Array *Args = Command->getArray("arguments");
+  if (!Directory || !CommandFile || !Output || !Heuristic || !Args)
+    return std::nullopt;
+  S.Command.Directory = Directory->str();
+  S.Command.Filename = CommandFile->str();
+  S.Command.Output = Output->str();
+  S.Command.Heuristic = Heuristic->str();
+  for (const auto &A : *Args) {
+    auto Arg = A.getAsString();
+    if (!Arg)
+      return std::nullopt;
+    S.Command.CommandLine.push_back(Arg->str());
+  }
+  // The observations first, with no sources: adding one with sources would
+  // take a package's identity as it is now, not as it was when it was read.
+  S.Inputs.WorkingDirectory = WorkingDirectory->str();
+  S.Inputs.RecordedAt = std::chrono::system_clock::time_point(
+      std::chrono::duration_cast<std::chrono::system_clock::duration>(
+          std::chrono::nanoseconds(*RecordedAt)));
+  for (const auto &Item : *Observations) {
+    const Array *A = Item.getAsArray();
+    if (!A || A->size() != 12)
+      return std::nullopt;
+    ModuleScanManifest::Observation Ob;
+    auto Op = (*A)[0].getAsInteger();
+    auto Path = (*A)[1].getAsString();
+    auto Error = errorFrom(&(*A)[2]);
+    auto Name = (*A)[4].getAsString();
+    auto Size = unhex64(&(*A)[6]);
+    auto Requested = (*A)[7].getAsInteger();
+    auto NullTerminated = (*A)[8].getAsBoolean();
+    auto Found = (*A)[9].getAsBoolean();
+    auto Binary = (*A)[10].getAsBoolean();
+    auto EntryType = (*A)[11].getAsInteger();
+    if (!Op || *Op < 0 || *Op > ModuleScanManifest::RealPath || !Path ||
+        !Error || !Name || !Size || !Requested || !NullTerminated || !Found ||
+        !Binary || !EntryType || !unhexDigest(&(*A)[5], Ob.Bytes))
+      return std::nullopt;
+    Ob.Operation = static_cast<ModuleScanManifest::Kind>(*Op);
+    Ob.Path = Path->str();
+    Ob.Error = *Error;
+    Ob.Name = Name->str();
+    Ob.Size = *Size;
+    Ob.RequestedSize = *Requested;
+    Ob.NullTerminated = *NullTerminated;
+    Ob.Found = *Found;
+    Ob.Binary = *Binary;
+    Ob.EntryType = static_cast<llvm::sys::fs::file_type>(*EntryType);
+    if ((*A)[3].kind() != Value::Null) {
+      const Array *I = (*A)[3].getAsArray();
+      if (!I || I->size() != 10)
+        return std::nullopt;
+      auto InfoName = (*I)[0].getAsString();
+      auto Device = unhex64(&(*I)[1]);
+      auto FileID = unhex64(&(*I)[2]);
+      auto Time = (*I)[3].getAsInteger();
+      auto InfoSize = unhex64(&(*I)[4]);
+      auto User = (*I)[5].getAsInteger();
+      auto Group = (*I)[6].getAsInteger();
+      auto Type = (*I)[7].getAsInteger();
+      auto Perms = (*I)[8].getAsInteger();
+      auto External = (*I)[9].getAsBoolean();
+      if (!InfoName || !Device || !FileID || !Time || !InfoSize || !User ||
+          !Group || !Type || !Perms || !External)
+        return std::nullopt;
+      llvm::vfs::Status Status(
+          *InfoName, llvm::sys::fs::UniqueID(*Device, *FileID),
+          fromNanos(*Time), static_cast<uint32_t>(*User),
+          static_cast<uint32_t>(*Group), *InfoSize,
+          static_cast<llvm::sys::fs::file_type>(*Type),
+          static_cast<llvm::sys::fs::perms>(*Perms));
+      Status.ExposesExternalVFSPath = *External;
+      Ob.Info.emplace(Status);
+    }
+    S.Inputs.add(std::move(Ob));
+  }
+  if (!S.Inputs.Complete || S.Inputs.observations().size() != Observations->size())
+    return std::nullopt;
+  if (Sources->getBoolean("present").value_or(false)) {
+    auto Made = std::make_shared<ModuleInputSources>();
+    for (const char *Field : {"managed", "system"}) {
+      const Array *Roots = Sources->getArray(Field);
+      if (!Roots)
+        return std::nullopt;
+      for (const auto &R : *Roots) {
+        auto Root = R.getAsString();
+        if (!Root)
+          return std::nullopt;
+        (llvm::StringRef(Field) == "managed" ? Made->Managed
+                                             : Made->SystemRoots)
+            .push_back(Root->str());
+      }
+    }
+    S.Inputs.Sources = std::move(Made);
+  }
+  if (!packagesFrom(O->getArray("packages"), S.Inputs.Packages))
+    return std::nullopt;
+  if (auto Module = O->getString("module"))
+    S.Result.ModuleName = Module->str();
+  if (const Array *Requires = O->getArray("requires"))
+    for (const auto &R : *Requires)
+      if (auto Name = R.getAsString())
+        S.Result.RequiredModules.push_back(Name->str());
+  if (auto Failure = O->getString("failure"))
+    S.Result.FailureDiagnostic = Failure->str();
+  return S;
+}
+
+// ---- the whole --------------------------------------------------------------
+
+Value memos(uint64_t &Verdicts, uint64_t &Scans) {
+  auto VerdictSnapshot = getModuleValidationCache().snapshot(Verdicts);
+  auto ScanSnapshot = getModuleDependencyScanCache().snapshot(Scans);
+  Array VerdictsJSON;
+  for (const auto &[Key, E] : VerdictSnapshot)
+    VerdictsJSON.push_back(verdictJSON(Key, *E));
+  Array ScansJSON;
+  for (const auto &S : ScanSnapshot)
+    if (auto V = scanJSON(S))
+      ScansJSON.push_back(std::move(*V));
+  return Object{{"format", FormatVersion},
+                {"engine", getClangToolFullVersion("clangd")},
+                {"verdicts", std::move(VerdictsJSON)},
+                {"scans", std::move(ScansJSON)}};
+}
+
+struct Adopted {
+  size_t Verdicts = 0, Scans = 0, Dropped = 0;
+};
+Adopted adopt(const Object &Root) {
+  Adopted Counts;
+  std::vector<std::pair<std::string,
+                        std::shared_ptr<const ModuleValidationCache::Entry>>>
+      Verdicts;
+  if (const Array *A = Root.getArray("verdicts"))
+    for (const auto &V : *A) {
+      if (auto E = verdictFrom(V))
+        Verdicts.push_back(std::move(*E));
+      else
+        ++Counts.Dropped;
+    }
+  std::vector<ModuleDependencyScanCache::KeptScan> Scans;
+  if (const Array *A = Root.getArray("scans"))
+    for (const auto &V : *A) {
+      if (auto S = scanFrom(V))
+        Scans.push_back(std::move(*S));
+      else
+        ++Counts.Dropped;
+    }
+  Counts.Verdicts = Verdicts.size();
+  Counts.Scans = Scans.size();
+  getModuleValidationCache().adopt(std::move(Verdicts));
+  getModuleDependencyScanCache().adopt(std::move(Scans));
+  return Counts;
+}
+
+// ---- the store ---------------------------------------------------------------
+
+class Store {
+public:
+  explicit Store(std::string Directory) : Directory(std::move(Directory)) {}
+
+  void start() {
+    Worker = std::thread([this] {
+      load();
+      std::unique_lock<std::mutex> Lock(Mu);
+      while (!Stopping) {
+        Wake.wait_for(Lock, std::chrono::seconds(30));
+        if (Stopping)
+          break;
+        Lock.unlock();
+        write();
+        Lock.lock();
+      }
+    });
+  }
+
+  void flush() {
+    {
+      std::lock_guard<std::mutex> Lock(Mu);
+      Stopping = true;
+    }
+    Wake.notify_all();
+    if (Worker.joinable())
+      Worker.join();
+    write();
+  }
+
+private:
+  std::string path() const {
+    llvm::SmallString<256> P(Directory);
+    llvm::sys::path::append(P, FileName);
+    return P.str().str();
+  }
+
+  void load() {
+    const auto Began = std::chrono::steady_clock::now();
+    auto Buffer = llvm::MemoryBuffer::getFile(path());
+    if (!Buffer) {
+      log("Module memos: none kept in {0}", Directory);
+      return;
+    }
+    auto Parsed = llvm::json::parse((*Buffer)->getBuffer());
+    if (!Parsed) {
+      llvm::consumeError(Parsed.takeError());
+      log("Module memos: {0} could not be read; starting without them",
+          path());
+      return;
+    }
+    const Object *Root = Parsed->getAsObject();
+    if (!Root || Root->getInteger("format") != FormatVersion ||
+        Root->getString("engine") != getClangToolFullVersion("clangd")) {
+      log("Module memos: {0} was written by another engine or format; "
+          "starting without them",
+          path());
+      return;
+    }
+    const Adopted Counts = adopt(*Root);
+    log("Module memos: {0} BMI verdicts and {1} scans kept from the last "
+        "session ({2} unreadable), read in {3} ms; each is checked again "
+        "before it is used",
+        Counts.Verdicts, Counts.Scans, Counts.Dropped,
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - Began)
+            .count());
+  }
+
+  void write() {
+    uint64_t Verdicts = 0, Scans = 0;
+    Value Root = memos(Verdicts, Scans);
+    if (Verdicts == WrittenVerdicts && Scans == WrittenScans)
+      return;
+    if (std::error_code EC = llvm::sys::fs::create_directories(Directory)) {
+      log("Module memos: cannot write {0}: {1}", Directory, EC.message());
+      return;
+    }
+    llvm::SmallString<256> Temporary(path());
+    Temporary += ".tmp-%%%%%%";
+    int FD;
+    llvm::SmallString<256> Made;
+    if (llvm::sys::fs::createUniqueFile(Temporary, FD, Made)) {
+      log("Module memos: cannot write {0}", path());
+      return;
+    }
+    {
+      llvm::raw_fd_ostream OS(FD, /*shouldClose=*/true);
+      OS << Root;
+      OS.flush();
+      if (OS.has_error()) {
+        OS.clear_error();
+        llvm::sys::fs::remove(Made);
+        return;
+      }
+    }
+    if (llvm::sys::fs::rename(Made, path())) {
+      llvm::sys::fs::remove(Made);
+      return;
+    }
+    WrittenVerdicts = Verdicts;
+    WrittenScans = Scans;
+    vlog("Module memos written to {0}", path());
+  }
+
+  const std::string Directory;
+  std::thread Worker;
+  std::mutex Mu;
+  std::condition_variable Wake;
+  bool Stopping = false;
+  uint64_t WrittenVerdicts = 0, WrittenScans = 0;
+};
+
+Store *&theStore() {
+  static Store *S = nullptr;
+  return S;
+}
+
+} // namespace
+
+void startModuleMemoStore(llvm::StringRef Directory) {
+  if (Directory.empty() || theStore())
+    return;
+  theStore() = new Store(Directory.str());
+  theStore()->start();
+}
+
+void flushModuleMemoStore() {
+  if (Store *S = theStore())
+    S->flush();
+}
+
+llvm::json::Value moduleMemosJSON() {
+  uint64_t Verdicts, Scans;
+  return memos(Verdicts, Scans);
+}
+
+size_t adoptModuleMemos(const llvm::json::Value &Memos) {
+  const Object *Root = Memos.getAsObject();
+  if (!Root || Root->getInteger("format") != FormatVersion)
+    return 0;
+  const Adopted Counts = adopt(*Root);
+  return Counts.Verdicts + Counts.Scans;
+}
+
+} // namespace clang::clangd
diff --git a/clang-tools-extra/clangd/ModuleMemoStore.h b/clang-tools-extra/clangd/ModuleMemoStore.h
new file mode 100644
index 0000000..e9cf8ee
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleMemoStore.h
@@ -0,0 +1,49 @@
+//===--- ModuleMemoStore.h - Module memos kept across sessions --*- C++-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The validation verdicts of BMIs (ModuleValidationCache.h) and the memoized
+// dependency scans (ModuleDependencyScanCache.h) live in the process: a new
+// session re-hashes every input of every BMI it reuses and preprocesses every
+// module unit again, which is most of what opening a project the second time
+// costs. With a directory (--module-memo-dir), both are written there and read
+// back by the next session.
+//
+// What is read back is only a candidate: a verdict is used after its inputs
+// are checked as for any other verdict, and a scan after its manifest is
+// replayed as on publication. A file that cannot be read, or that another
+// format or engine wrote, is ignored. Writes go to a temporary file renamed
+// over the old one, so a reader sees one whole file or the previous one.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEMEMOSTORE_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEMEMOSTORE_H
+
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/JSON.h"
+#include <cstddef>
+
+namespace clang::clangd {
+
+/// Reads the memos kept in `Directory` in the background, and keeps writing
+/// them there while the process runs. Called once, at startup.
+void startModuleMemoStore(llvm::StringRef Directory);
+
+/// Writes the memos now, if they changed since they were last written. For
+/// the end of the process; a no-op without a directory.
+void flushModuleMemoStore();
+
+/// The memos as the store writes them, and taking them back as it reads
+/// them (returns how many were readable). The store's own format; exposed
+/// for tests.
+llvm::json::Value moduleMemosJSON();
+size_t adoptModuleMemos(const llvm::json::Value &Memos);
+
+} // namespace clang::clangd
+
+#endif
