+TEST_F(PrerequisiteModulesTests, MemosKeptForTheNextSession) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission covers this host's test commands only";
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include \"dep.h\"\nimport O;\n");
+  CDB.addFile("dep.h", "import M;\n");
+  {
+    auto Generation = CDB.toolingCDB();
+    auto Commands = createProjectModulesCommandCache(Generation, true);
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    EXPECT_THAT(Modules->getRequiredModules(getFullPath("Use.cpp")),
+                testing::ElementsAre("M", "O"));
+  }
+  // What the store writes, as text and back.
+  std::string Text;
+  llvm::raw_string_ostream(Text) << moduleMemosJSON();
+  auto Parsed = llvm::json::parse(Text);
+  ASSERT_TRUE(bool(Parsed)) << llvm::toString(Parsed.takeError());
+  const llvm::json::Array *Scans = Parsed->getAsObject()->getArray("scans");
+  ASSERT_TRUE(Scans);
+  ASSERT_GT(Scans->size(), 0u) << Text.substr(0, 2000);
+  // The next session: another database, nothing of its own memoized yet,
+  // and the files as they were (writing them again would move their times).
+  auto TimeOf = [&](llvm::StringRef File) {
+    llvm::sys::fs::file_status Status;
+    EXPECT_FALSE(llvm::sys::fs::status(getFullPath(File), Status));
+    return Status.getLastModificationTime();
+  };
+  auto Restore = [&](llvm::StringRef File, llvm::sys::TimePoint<> Time) {
+    int FD;
+    ASSERT_FALSE(llvm::sys::fs::openFileForWrite(
+        getFullPath(File), FD, llvm::sys::fs::CD_OpenExisting,
+        llvm::sys::fs::OF_Append));
+    EXPECT_FALSE(llvm::sys::fs::setLastAccessAndModificationTime(FD, Time));
+    llvm::sys::Process::SafelyCloseFileDescriptor(FD);
+  };
+  const auto UseTime = TimeOf("Use.cpp"), DepTime = TimeOf("dep.h");
+  PerFileModulesCompilationDatabase Next(TestDir, FS);
+  Next.addFile("Use.cpp", "#include \"dep.h\"\nimport O;\n");
+  Next.addFile("dep.h", "import M;\n");
+  Restore("Use.cpp", UseTime);
+  Restore("dep.h", DepTime);
+  EXPECT_GT(adoptModuleMemos(*Parsed), 0u);
+  const auto Kept = getModuleDependencyScanCache().keptHits();
+  auto Generation = Next.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+  EXPECT_THAT(Modules->getRequiredModules(getFullPath("Use.cpp")),
+              testing::ElementsAre("M", "O"));
+  EXPECT_GT(getModuleDependencyScanCache().keptHits(), Kept);
+  // A kept scan is replayed before it is used: an input that changed since
+  // is seen.
+  PerFileModulesCompilationDatabase Third(TestDir, FS);
+  Third.addFile("Use.cpp", "#include \"dep.h\"\nimport O;\n");
