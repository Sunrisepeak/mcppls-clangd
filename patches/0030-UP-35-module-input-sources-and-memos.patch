+  EXPECT_GT(adoptModuleMemos(*Parsed), 0u);
+  auto ThirdGeneration = Third.toolingCDB();
+  auto ThirdCommands = createProjectModulesCommandCache(ThirdGeneration, true);
+  auto ThirdModules =
+      clang::clangd::getProjectModules(ThirdGeneration, FS, ThirdCommands);
+  EXPECT_THAT(ThirdModules->getRequiredModules(getFullPath("Use.cpp")),
+              testing::ElementsAre("N", "O"));
+}
