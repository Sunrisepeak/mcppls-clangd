+// Writes `Contents` to `Path` under the test directory, without a command.
+static void writeTestFile(llvm::StringRef Dir, llvm::StringRef Path,
+                          llvm::StringRef Contents) {
+  SmallString<256> Abs(Dir);
+  llvm::sys::path::append(Abs, Path);
+  ASSERT_FALSE(
+      llvm::sys::fs::create_directories(llvm::sys::path::parent_path(Abs)));
+  std::error_code EC;
+  llvm::raw_fd_ostream OS(Abs, EC);
+  ASSERT_FALSE(EC);
+  OS << Contents;
+}
+
+TEST_F(PrerequisiteModulesTests, PackageInputsAreCheckedByTheirMarkers) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission covers this host's test commands only";
+  // A package store: lib 1.0, installed with its markers.
+  writeTestFile(TestDir, "store/lib/1.0/.mcpp_ok", "1\n");
+  writeTestFile(TestDir, "store/lib/1.0/.xpkg-install.json", "{}\n");
+  writeTestFile(TestDir, "store/lib/1.0/include/dep.h", "import M;\n");
+  ModuleInputSources::setManagedRoots({getFullPath("store")});
+  auto Reset = llvm::make_scope_exit([] { ModuleInputSources::setManagedRoots({}); });
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include \"dep.h\"\n",
+              {"-I" + getFullPath("store/lib/1.0/include")});
+  auto Generation = CDB.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  auto Scan = [&] {
+    WithContextValue Once(ModuleScanReplayEpoch, nextModuleScanReplayEpoch());
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    return Modules->getRequiredModules(getFullPath("Use.cpp"));
+  };
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  // A header of the package changed without its markers: no package manager
+  // did that, and the version is taken as installed.
+  writeTestFile(TestDir, "store/lib/1.0/include/dep.h", "import N;\n");
+  const auto Before = moduleInputCounters();
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  EXPECT_GT((moduleInputCounters() - Before).Package, 0u);
+  // Reinstalled: a marker changed, and the version's files are replayed.
+  writeTestFile(TestDir, "store/lib/1.0/.mcpp_ok", "reinstalled\n");
+  EXPECT_THAT(Scan(), testing::ElementsAre("N"));
+  // The project's own headers are replayed every time (see
+  // ScanReplayEpochReplaysOncePerOperation).
+}
+
+TEST_F(PrerequisiteModulesTests, SystemInputsAreReplayedOncePerSession) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission covers this host's test commands only";
+  writeTestFile(TestDir, "sysroot/include/dep.h", "import M;\n");
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include <dep.h>\n",
+              {"-isystem", getFullPath("sysroot/include")});
+  auto Generation = CDB.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  auto Scan = [&] {
+    WithContextValue Once(ModuleScanReplayEpoch, nextModuleScanReplayEpoch());
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    return Modules->getRequiredModules(getFullPath("Use.cpp"));
+  };
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  // Like clang's own module input validation, which skips system inputs: a
+  // system header is not checked again in this session.
+  writeTestFile(TestDir, "sysroot/include/dep.h", "import N;\n");
+  const auto Before = moduleInputCounters();
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  EXPECT_GT((moduleInputCounters() - Before).System, 0u);
+}
