     CodeCompleteResult Result = clangd::codeComplete(
         File, Pos, IP->Preamble, ParseInput, CodeCompleteOpts,
         SpecFuzzyFind ? &*SpecFuzzyFind : nullptr);
+    // Answered without the first preamble of a module importer (its modules
+    // are still being built): incomplete, so the client asks again and gets
+    // the imported names once the preamble is there.
+    if (!IP->Preamble && ModulesManager &&
+        CodeCompleteOpts.RunParser != CodeCompleteOptions::NeverParse) {
+      log("Completion in {0} answered before its first preamble", File);
+      Result.HasMore = true;
+    }
     // We don't want `codeComplete` to wait for the async call if it doesn't use
     // the result (e.g. non-index completion, speculation fails), so that `CB`
     // is called as soon as results are available.
@@ -485,15 +494,17 @@ void ClangdServer::codeComplete(PathRef File, Position Pos,
 
   // Reuse a potentially-stale preamble without waiting for an edit rebuild.
   // In modules mode, the first preamble owns prerequisite construction: an
-  // absent preamble would silently omit imported declarations from fallback
-  // completion. Wait for that initial build unless parsing was disabled.
-  bool NeedsInitialBuild =
-      Opts.RunParser == CodeCompleteOptions::AlwaysParse ||
-      (ModulesManager && Opts.RunParser != CodeCompleteOptions::NeverParse);
-  WorkScheduler->runWithPreamble(
-      "CodeComplete", File,
-      NeedsInitialBuild ? TUScheduler::Stale : TUScheduler::StaleOrAbsent,
-      std::move(Task));
+  // absent preamble omits imported declarations from fallback completion, so
+  // the initial build is waited for -- up to FirstPreambleWait, past which
+  // the answer is the fallback's, marked incomplete (a first preamble whose
+  // modules take minutes to build left completion waiting minutes).
+  const TUScheduler::PreambleConsistency Consistency =
+      Opts.RunParser == CodeCompleteOptions::AlwaysParse ? TUScheduler::Stale
+      : ModulesManager && Opts.RunParser != CodeCompleteOptions::NeverParse
+          ? TUScheduler::StaleWithin
+          : TUScheduler::StaleOrAbsent;
+  WorkScheduler->runWithPreamble("CodeComplete", File, Consistency,
+                                 std::move(Task));
 }
 
