   EXPECT_NEAR(25, Compute({}), 0.01) << "no history -> max";
 }
 
+// A StaleWithin read waits for the first preamble only so long: a module
+// importer whose first preamble waits minutes for its modules is answered
+// without it meanwhile, and with it once it is there.
+TEST_F(TUSchedulerTests, StaleWithinGivesUpOnASlowFirstPreamble) {
+  class BlockFirstPreamble : public ParsingCallbacks {
+  public:
+    explicit BlockFirstPreamble(Notification &N) : N(N) {}
+    void onPreambleAST(
+        PathRef, llvm::StringRef, CapturedASTCtx,
+        std::shared_ptr<const include_cleaner::PragmaIncludes>) override {
+      N.wait();
+    }
+
+  private:
+    Notification &N;
+  };
+  Notification Release;
+  auto Opts = optsForTest();
+  Opts.FirstPreambleWait = std::chrono::milliseconds(50);
+  TUScheduler S(CDB, Opts, std::make_unique<BlockFirstPreamble>(Release));
+  Path File = testPath("foo.cpp");
+  FS.Files[testPath("foo.h")] = "int x;";
+  S.update(File, getInputs(File, "#include \"foo.h\"\nint y;"),
+           WantDiagnostics::Auto);
+
+  Notification Answered;
+  S.runWithPreamble("within", File, TUScheduler::StaleWithin,
+                    [&](Expected<InputsAndPreamble> IP) {
+                      ASSERT_TRUE(bool(IP));
+                      EXPECT_EQ(IP->Preamble, nullptr);
+                      Answered.notify();
+                    });
+  EXPECT_TRUE(Answered.wait(timeoutSeconds(10)))
+      << "answered while the first preamble is still being built";
+  Release.notify();
+  ASSERT_TRUE(S.blockUntilIdle(timeoutSeconds(60)));
+
+  bool HadPreamble = false;
+  S.runWithPreamble("after", File, TUScheduler::StaleWithin,
+                    [&](Expected<InputsAndPreamble> IP) {
+                      ASSERT_TRUE(bool(IP));
+                      HadPreamble = IP->Preamble != nullptr;
+                    });
+  ASSERT_TRUE(S.blockUntilIdle(timeoutSeconds(60)));
+  EXPECT_TRUE(HadPreamble);
+}
+
 TEST_F(TUSchedulerTests, AsyncPreambleThread) {
   // Blocks preamble thread while building preamble with \p BlockVersion until
   // \p N is notified.
