+TEST_F(PrerequisiteModulesTests, UnrelatedRootDoesNotChangeProducerGeneration) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Leaf.cppm", "export module Leaf;\nexport constexpr int leaf = 7;\n");
+  CDB.addFile("Base.cppm", "export module Base;\nimport Leaf;\nexport constexpr int base = leaf;\n");
+  CDB.addFile("Noise.cppm", "export module Noise;\nexport constexpr int noise = 1;\n");
+  CDB.addFile("Shared.cppm", "export module Shared;\nimport Base;\nexport int shared() { return base; }\n");
+  CDB.addFile("Plain.cpp", "import Shared;\nint main() { return shared(); }\n");
+  CDB.addFile("Mixed.cpp", "import Noise;\nimport Shared;\nint main() { return shared() + noise; }\n");
+  ModulesBuilder Builder(CDB);
+  auto Plain = Builder.buildPrerequisiteModulesFor(getFullPath("Plain.cpp"), FS);
+  ASSERT_TRUE(Plain);
+  HeaderSearchOptions PlainPublished;
+  Plain->adjustHeaderSearchOptionsForValidation(PlainPublished);
+  ASSERT_EQ(PlainPublished.PrebuiltModuleFiles.count("Shared"), 1u);
+  auto Mixed = Builder.buildPrerequisiteModulesFor(getFullPath("Mixed.cpp"), FS);
+  ASSERT_TRUE(Mixed);
+  HeaderSearchOptions MixedPublished;
+  Mixed->adjustHeaderSearchOptionsForValidation(MixedPublished);
+  ASSERT_EQ(MixedPublished.PrebuiltModuleFiles.count("Shared"), 1u);
+  EXPECT_EQ(PlainPublished.PrebuiltModuleFiles.at("Shared"),
+            MixedPublished.PrebuiltModuleFiles.at("Shared"))
+      << "Shared imports Base, so an unrelated Noise root cannot change its producer chain";
+  CDB.addFile("Noise.cppm", "export module Noise;\nexport constexpr int noise = 2;\n");
+  auto Changed = Builder.buildPrerequisiteModulesFor(getFullPath("Mixed.cpp"), FS);
+  ASSERT_TRUE(Changed);
+  HeaderSearchOptions ChangedPublished;
+  Changed->adjustHeaderSearchOptionsForValidation(ChangedPublished);
+  EXPECT_EQ(PlainPublished.PrebuiltModuleFiles.at("Shared"),
+            ChangedPublished.PrebuiltModuleFiles.at("Shared"));
+  auto Inputs = getInputs("Mixed.cpp", CDB);
+  auto Invocation = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(Invocation);
+  EXPECT_FALSE(Mixed->canReuse(*Invocation, FS.view(TestDir)));
+  EXPECT_TRUE(Changed->canReuse(*Invocation, FS.view(TestDir)));
+  CDB.addFile("Leaf.cppm", "export module Leaf;\nexport constexpr int leaf = 9;\n");
+  EXPECT_FALSE(Changed->canReuse(*Invocation, FS.view(TestDir)));
+  auto ChangedDependency = Builder.buildPrerequisiteModulesFor(getFullPath("Mixed.cpp"), FS);
+  ASSERT_TRUE(ChangedDependency);
+  HeaderSearchOptions DependencyPublished;
+  ChangedDependency->adjustHeaderSearchOptionsForValidation(DependencyPublished);
+  EXPECT_NE(ChangedPublished.PrebuiltModuleFiles.at("Shared"),
+            DependencyPublished.PrebuiltModuleFiles.at("Shared"));
+  EXPECT_TRUE(ChangedDependency->canReuse(*Invocation, FS.view(TestDir)));
+}
