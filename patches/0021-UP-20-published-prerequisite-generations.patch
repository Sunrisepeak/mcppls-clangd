+/// The digest of a producer's bytes, read once per published identity.
+/// \p Content is the file holding them: the immutable view a read lease
+/// copied (\p Leased), or the published file, which is read again only while
+/// its identity holds. nullopt when the bytes cannot be read as that identity.
+std::optional<std::string>
+producerDigest(const ModuleValidationCache::FileIdentity &Identity,
+               PathRef Content, bool Leased) {
+  using Key = std::tuple<uint64_t, uint64_t, uint64_t, int64_t>;
+  static std::mutex Mutex;
+  static std::map<Key, std::string> Digests;
+  const Key K{Identity.Size, Identity.ID.getDevice(), Identity.ID.getFile(),
+              Identity.ModTime.time_since_epoch().count()};
+  {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    if (auto It = Digests.find(K); It != Digests.end())
+      return It->second;
+  }
+  auto Buffer = llvm::MemoryBuffer::getFile(Content, /*IsText=*/false,
+                                            /*RequiresNullTerminator=*/false);
+  if (!Buffer || (*Buffer)->getBufferSize() != Identity.Size)
+    return std::nullopt;
+  if (!Leased && ModuleValidationCache::identityOf(Content) != Identity)
+    return std::nullopt;
+  const StringRef Bytes = (*Buffer)->getBuffer();
+  const auto Hash = llvm::xxh3_128bits(Bytes.bytes_begin(), Bytes.size());
+  std::string Digest = llvm::utohexstr(Hash.high64, /*LowerCase=*/true, 16) +
+                       llvm::utohexstr(Hash.low64, /*LowerCase=*/true, 16);
+  std::lock_guard<std::mutex> Lock(Mutex);
+  if (Digests.size() >= 4096)
+    Digests.clear();
+  Digests.emplace(K, Digest);
+  return Digest;
+}
