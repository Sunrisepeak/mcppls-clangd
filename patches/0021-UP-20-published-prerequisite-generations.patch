+TEST_F(PrerequisiteModulesTests, PrerequisitesLetGoOfAreFoundAgain) {
+  // A file's prerequisites dropped for a moment (an import being typed, a
+  // bounded build answered late) are the same read views when asked again,
+  // not new copies of every module.
+  CDB.addFile("M.cppm", "export module M;\nexport int MValue = 1;\n");
+  CDB.addFile("A.cppm", "export module A;\nimport M;\n");
+  ModulesBuilder Builder(CDB);
+  std::string First;
+  {
+    auto Info = Builder.buildPrerequisiteModulesFor(getFullPath("A.cppm"), FS);
+    ASSERT_TRUE(Info);
+    HeaderSearchOptions HS(TestDir);
+    Info->adjustHeaderSearchOptions(HS);
+    ASSERT_EQ(HS.PrebuiltModuleFiles.count("M"), 1u);
+    First = HS.PrebuiltModuleFiles["M"];
+  }
+  EXPECT_TRUE(llvm::sys::fs::exists(First));
+  auto Again = Builder.buildPrerequisiteModulesFor(getFullPath("A.cppm"), FS);
+  ASSERT_TRUE(Again);
+  HeaderSearchOptions HS(TestDir);
+  Again->adjustHeaderSearchOptions(HS);
+  ASSERT_EQ(HS.PrebuiltModuleFiles.count("M"), 1u);
+  EXPECT_EQ(HS.PrebuiltModuleFiles["M"], First);
+}
