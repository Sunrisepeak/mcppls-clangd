 #include "clang/Basic/Stack.h"
 #include "clang/Format/Format.h"
 #include "llvm/ADT/SmallString.h"
@@ -209,6 +210,13 @@ opt<CodeCompleteOptions::CodeCompletionParse> CodeCompletionParse{
     Hidden,
 };
 
+opt<std::string> CrashDumpsDir{
+    "crash-dumps-dir",
+    cat(Features),
+    desc("(Windows) write a minidump with full memory into this directory "
+         "when clangd terminates on an unhandled exception"),
+    init("")};
+
 opt<CodeCompleteOptions::CodeCompletionRankingModel> RankingModel{
     "ranking-model",
     cat(Features),
@@ -998,6 +1006,7 @@ clangd accepts flags on the commandline, and in the CLANGD_FLAGS environment var
   // the index fast path instead of re-deserializing prerequisite modules per
   // request (see CodeCompleteOptions::FastModulesCompletion).
   Opts.CodeComplete.FastModulesCompletion = ExperimentalModulesSupport;
+  clangd::installWindowsCrashDumps(CrashDumpsDir);
 
   RealThreadsafeFS TFS;
   std::vector<std::unique_ptr<config::Provider>> ProviderStack;
