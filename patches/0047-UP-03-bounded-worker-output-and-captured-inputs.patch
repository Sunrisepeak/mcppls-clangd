+TEST_F(PrerequisiteModulesTests,
+       ModuleWorkerOutputBudgetPrecedesPayloadWrites) {
+  auto Outputs = createModuleBuildWorkerOutput(TestDir, 16, 2);
+  auto Clone = Outputs.Backend->clone();
+  std::string First = (TestDir + "/first.pcm").str();
+  auto A = Outputs.Backend->createFile(First);
+  ASSERT_TRUE(bool(A));
+  A->getOS() << "12345678";
+  ASSERT_FALSE(bool(A->keep()));
+  auto B = Clone->createFile((TestDir + "/second.pcm").str());
+  ASSERT_TRUE(bool(B));
+  B->getOS() << "123456789";
+  auto Error = B->keep();
+  ASSERT_TRUE(bool(Error));
+  EXPECT_THAT(llvm::toString(std::move(Error)),
+              testing::HasSubstr("payload limit"));
+  EXPECT_FALSE(llvm::sys::fs::exists((TestDir + "/second.pcm").str()));
+  auto Contents = llvm::MemoryBuffer::getFile(First);
+  ASSERT_TRUE(bool(Contents));
+  EXPECT_EQ((*Contents)->getBuffer(), "12345678");
+  auto Extra = Clone->createFile((TestDir + "/third.pcm").str());
+  ASSERT_FALSE(bool(Extra));
+  llvm::consumeError(Extra.takeError());
+  // A failed file stays conservatively charged; overwriting a kept output or
+  // writing outside the private unit never restores/bypasses the reservation.
+  auto Reused = Outputs.Backend->createFile(First);
+  ASSERT_FALSE(bool(Reused));
+  llvm::consumeError(Reused.takeError());
+  auto Foreign = Clone->createFile((TestDir + "/../foreign.pcm").str());
+  ASSERT_FALSE(bool(Foreign));
+  llvm::consumeError(Foreign.takeError());
+}
+
+TEST_F(PrerequisiteModulesTests,
+       ModuleWorkerPwriteAndImplicitCacheShareBudget) {
+  auto Outputs = createModuleBuildWorkerOutput(TestDir, 16);
+  auto File = Outputs.Backend->createFile((TestDir + "/sparse.pcm").str());
+  ASSERT_TRUE(bool(File));
+  File->getOS() << "1234";
+  // Pwrite changes already-reserved bytes without double-charging them.
+  // raw_pwrite_stream requires this write to remain within tell().
+  File->getOS().pwrite("xx", 2, 2);
+  ASSERT_FALSE(bool(File->keep()));
+  auto Contents = llvm::MemoryBuffer::getFile((TestDir + "/sparse.pcm").str());
+  ASSERT_TRUE(bool(Contents));
+  EXPECT_EQ((*Contents)->getBuffer(), "12xx");
+  Contents->reset();
+  ASSERT_FALSE(llvm::sys::fs::remove((TestDir + "/sparse.pcm").str()));
+  const std::string CachePath = (TestDir + "/implicit.pcm").str();
+  off_t Size = 0;
+  time_t Time = 0;
+  auto Buffer = llvm::MemoryBuffer::getMemBuffer("1234567890123");
+  // The stream already charged four bytes. Deleting its payload does not
+  // restore this unit's conservative reservation. The implicit cache must
+  // reject a thirteen-byte buffer before its underlying temp receives bytes.
+  EXPECT_EQ(
+      Outputs.Cache->write(CachePath, Buffer->getMemBufferRef(), Size, Time),
+      std::make_error_code(std::errc::no_space_on_device));
+  EXPECT_FALSE(llvm::sys::fs::exists(CachePath));
+  Outputs.Cache->updateModuleTimestamp(CachePath);
+  auto Lock = Outputs.Cache->getLock(CachePath);
+  auto Owned = Lock->tryLock();
+  ASSERT_TRUE(bool(Owned));
+  EXPECT_TRUE(*Owned);
+  Outputs.Cache->maybePrune(TestDir, 1, 1);
+  // Auxiliary operations create no uncontrolled timestamp/lock/prune files.
+  std::error_code EC;
+  EXPECT_EQ(llvm::sys::fs::directory_iterator(TestDir, EC),
+            llvm::sys::fs::directory_iterator());
+  EXPECT_FALSE(EC);
+}
