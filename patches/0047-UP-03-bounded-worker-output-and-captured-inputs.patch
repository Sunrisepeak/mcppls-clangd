index 000000000..05afee575
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleBuildWorkerOutput.cpp
@@ -0,0 +1,320 @@
+//===--- ModuleBuildWorkerOutput.cpp - bounded worker outputs
+//--------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "ModuleBuildWorkerOutput.h"
+#include "clang/Basic/DiagnosticFrontend.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "clang/Frontend/FrontendActions.h"
+#include "clang/Lex/Preprocessor.h"
+#include "clang/Serialization/ASTWriter.h"
+#include "clang/Serialization/InMemoryModuleCache.h"
+#include "clang/Serialization/ModuleCache.h"
+#include "llvm/ADT/StringMap.h"
+#include "llvm/Support/AdvisoryLock.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualOutputBackends.h"
+#include <mutex>
+namespace clang::clangd {
+namespace {
+class Budget {
+public:
+  Budget(PathRef Root, uint64_t Limit, unsigned Files)
+      : Root(Root.str()), Limit(Limit), MaxFiles(Files) {}
+  bool start(StringRef Path) {
+    // Units are private, newly created directories. Reject foreign outputs,
+    // traversal, reuse and pre-existing files instead of overwriting them.
+    if (!llvm::sys::path::is_absolute(Path) || Path.contains('\0'))
+      return reject();
+    for (auto I = llvm::sys::path::begin(Path), E = llvm::sys::path::end(Path);
+         I != E; ++I)
+      if (*I == "..")
+        return reject();
+    if (!Path.starts_with(Root + "/") || llvm::sys::fs::exists(Path))
+      return reject();
+    std::lock_guard<std::mutex> Lock(Mutex);
+    if (Paths.size() >= MaxFiles || Paths.contains(Path)) {
+      Failure = true;
+      return false;
+    }
+    Paths.insert({Path, 0});
+    return true;
+  }
+  bool grow(StringRef Path, uint64_t End) {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    auto I = Paths.find(Path);
+    if (I == Paths.end()) {
+      Failure = true;
+      return false;
+    }
+    if (End <= I->second)
+      return true;
+    uint64_t Growth = End - I->second;
+    if (Growth > Limit - Used) {
+      Failure = true;
+      return false;
+    }
+    Used += Growth;
+    I->second = End;
+    return true;
+  }
+
+  void markFailure() {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    Failure = true;
+  }
+  llvm::Error check() {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    return Failure ? llvm::createStringError(
+                         "module worker output payload or file limit rejected")
+                   : llvm::Error::success();
+  }
+
+private:
+  bool reject() {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    Failure = true;
+    return false;
+  }
+  bool Failure = false;
+  std::string Root;
+  uint64_t Limit, Used = 0;
+  unsigned MaxFiles;
+  std::mutex Mutex;
+  llvm::StringMap<uint64_t> Paths;
+};
+class BoundedStream : public llvm::raw_pwrite_stream {
+public:
+  BoundedStream(llvm::raw_pwrite_stream &OS, std::shared_ptr<Budget> B,
+                StringRef Path)
+      : OS(OS), B(std::move(B)), Path(Path.str()) {
+    SetUnbuffered();
+  }
+  bool failed() const { return Failed; }
+
+private:
+  void write_impl(const char *Data, size_t Size) override {
+    if (Size > UINT64_MAX - Position || !B->grow(Path, Position + Size)) {
+      B->markFailure();
+      Failed = true;
+      return;
+    }
+    if (!Failed) {
+      OS.write(Data, Size);
+      Position += Size;
+    }
+  }
+  void pwrite_impl(const char *Data, size_t Size, uint64_t Offset) override {
+    if (Size > UINT64_MAX - Offset || !B->grow(Path, Offset + Size)) {
+      B->markFailure();
+      Failed = true;
+      return;
+    }
+    if (!Failed)
+      OS.pwrite(Data, Size, Offset);
+  }
+  uint64_t current_pos() const override { return Position; }
+  llvm::raw_pwrite_stream &OS;
+  std::shared_ptr<Budget> B;
+  std::string Path;
+  uint64_t Position = 0;
+  bool Failed = false;
+};
+class BoundedFile : public llvm::vfs::OutputFileImpl {
+public:
+  BoundedFile(std::unique_ptr<llvm::vfs::OutputFileImpl> File,
+              std::shared_ptr<Budget> B, StringRef Path)
+      : File(std::move(File)), OS(this->File->getOS(), std::move(B), Path) {}
+  llvm::Error keep() override {
+    OS.flush();
+    if (OS.failed()) {
+      llvm::consumeError(File->discard());
+      return llvm::createStringError(
+          "module worker output payload limit exceeded");
+    }
+    return File->keep();
+  }
+  llvm::Error discard() override { return File->discard(); }
+  llvm::raw_pwrite_stream &getOS() override { return OS; }
+
+private:
+  std::unique_ptr<llvm::vfs::OutputFileImpl> File;
+  BoundedStream OS;
+};
+class BoundedBackend : public llvm::vfs::OutputBackend {
+public:
+  explicit BoundedBackend(std::shared_ptr<Budget> B) : B(std::move(B)) {}
+
+private:
+  llvm::IntrusiveRefCntPtr<llvm::vfs::OutputBackend>
+  cloneImpl() const override {
+    return llvm::makeIntrusiveRefCnt<BoundedBackend>(B);
+  }
+  llvm::Expected<std::unique_ptr<llvm::vfs::OutputFileImpl>>
+  createFileImpl(StringRef Path,
+                 std::optional<llvm::vfs::OutputConfig> Config) override {
+    if (!B->start(Path))
+      return llvm::createStringError(
+          "module worker output path or file limit rejected");
+    llvm::vfs::OnDiskOutputBackend Disk;
+    auto File = Disk.createFile(Path, Config);
+    if (!File)
+      return File.takeError();
+    return std::make_unique<BoundedFile>(File->takeImpl(), B, Path);
+  }
+  std::shared_ptr<Budget> B;
+};
+// This cache is private to one worker unit, never shared with another process.
+// Advisory locks and timestamps are process-local, so no uncontrolled lock,
+// timestamp or age-prune files are created alongside the bounded payloads.
+// LLVM permits concurrent duplicate compilation behind weak advisory locks;
+// InMemoryModuleCache remains shared across the complete compiler tree.
+class PrivateLock : public llvm::AdvisoryLock {
+public:
+  llvm::Expected<bool> tryLock() override { return true; }
+  llvm::WaitForUnlockResult waitForUnlockFor(std::chrono::seconds) override {
+    return llvm::WaitForUnlockResult::Success;
+  }
+  std::error_code unsafeUnlock() override { return {}; }
+};
+class BoundedCache : public ModuleCache {
+public:
+  BoundedCache(llvm::IntrusiveRefCntPtr<llvm::vfs::OutputBackend> Backend)
+      : Backend(std::move(Backend)) {}
+  std::unique_ptr<llvm::AdvisoryLock> getLock(StringRef) override {
+    return std::make_unique<PrivateLock>();
+  }
+  time_t getModuleTimestamp(StringRef Path) override {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    auto I = Timestamps.find(Path);
+    return I == Timestamps.end() ? 0 : I->second;
+  }
+  void updateModuleTimestamp(StringRef Path) override {
+    std::lock_guard<std::mutex> Lock(Mutex);
+    // A timestamp is only meaningful for an output that this cache wrote.
+    auto I = Timestamps.find(Path);
+    if (I != Timestamps.end())
+      I->second = std::time(nullptr);
+  }
+  void maybePrune(StringRef, time_t, time_t) override {}
+  InMemoryModuleCache &getInMemoryModuleCache() override { return InMemory; }
+  const InMemoryModuleCache &getInMemoryModuleCache() const override {
+    return InMemory;
+  }
+  std::error_code write(StringRef Path, llvm::MemoryBufferRef Buffer,
+                        off_t &Size, time_t &ModTime) override {
+    auto File = Backend->createFile(Path);
+    if (!File) {
+      llvm::consumeError(File.takeError());
+      return std::make_error_code(std::errc::no_space_on_device);
+    }
+    // The stream checks the complete buffer before its first disk write.
+    File->getOS().write(Buffer.getBufferStart(), Buffer.getBufferSize());
+    if (auto Error = File->keep()) {
+      llvm::consumeError(std::move(Error));
+      return std::make_error_code(std::errc::no_space_on_device);
+    }
+    llvm::sys::fs::file_status Status;
+    if (auto Error = llvm::sys::fs::status(Path, Status))
+      return Error;
+    Size = Status.getSize();
+    ModTime = llvm::sys::toTimeT(Status.getLastModificationTime());
+    std::lock_guard<std::mutex> Lock(Mutex);
+    Timestamps.insert({Path, ModTime});
+    return {};
+  }
+  llvm::Expected<std::unique_ptr<llvm::MemoryBuffer>>
+  read(StringRef Path, off_t &Size, time_t &ModTime) override {
+    return readImpl(Path, Size, ModTime);
+  }
+
+private:
+  llvm::IntrusiveRefCntPtr<llvm::vfs::OutputBackend> Backend;
+  InMemoryModuleCache InMemory;
+  std::mutex Mutex;
+  llvm::StringMap<time_t> Timestamps;
+};
+class BoundedReducedGenerator : public ReducedBMIGenerator {
+public:
+  explicit BoundedReducedGenerator(CompilerInstance &CI)
+      : ReducedBMIGenerator(CI.getPreprocessor(), CI.getModuleCache(),
+                            CI.getFrontendOpts().OutputFile,
+                            CI.getCodeGenOpts()),
+        Backend(CI.getOutputManager()) {}
+  void HandleTranslationUnit(ASTContext &Ctx) override {
+    // Preserve the reduced-BMI serializer and named-module selection. The
+    // upstream CXX20ModulesGenerator bypasses OutputBackend with
+    // raw_fd_ostream.
+    PCHGenerator::HandleTranslationUnit(Ctx);
+    if (!isComplete())
+      return;
+    auto File = Backend.createFile(getOutputFile());
+    if (!File) {
+      fail(llvm::toString(File.takeError()));
+      return;
+    }
+    File->getOS() << getBufferPtr()->Data;
+    if (auto Error = File->keep())
+      fail(llvm::toString(std::move(Error)));
+  }
+
+private:
+  void fail(StringRef Message) {
+    getDiagnostics().Report(diag::err_fe_unable_to_open_output)
+        << getOutputFile() << Message;
+  }
+  llvm::vfs::OutputBackend &Backend;
+};
+class BoundedReducedAction : public GenerateReducedModuleInterfaceAction {
+  std::unique_ptr<ASTConsumer> CreateASTConsumer(CompilerInstance &CI,
+                                                 StringRef) override {
+    return std::make_unique<BoundedReducedGenerator>(CI);
+  }
+};
+} // namespace
+llvm::Error validateBoundedModuleBuildOutputs(const CompilerInvocation &CI) {
+  const auto &F = CI.getFrontendOpts();
+  const auto &D = CI.getDependencyOutputOpts();
+  const auto &Diag = CI.getDiagnosticOpts();
+  // ModuleOutputPath is inactive for GenerateReducedModuleInterfaceAction:
+  // unlike the full interface action, it always emits only OutputFile. Keep
+  // this driver-derived field unchanged instead of stripping an option.
+  const std::pair<bool, StringRef> Unsupported[] = {
+      {!F.Plugins.empty(), "Plugins"},
+      {!F.ActionName.empty() || F.ProgramAction == frontend::PluginAction,
+       "PluginAction"},
+      {!F.AddPluginActions.empty(), "AddPluginActions"},
+      {!F.PluginArgs.empty(), "PluginArgs"},
+      {!F.StatsFile.empty(), "StatsFile"},
+      {!F.TimeTracePath.empty(), "TimeTracePath"},
+      {!F.DumpMinimizationHintsPath.empty(), "DumpMinimizationHintsPath"},
+      {bool(F.EmitSymbolGraph), "EmitSymbolGraph"},
+      {!F.SymbolGraphOutputDir.empty(), "SymbolGraphOutputDir"},
+      {!F.ModuleFileExtensions.empty(), "ModuleFileExtensions"},
+      {!D.OutputFile.empty(), "DependencyOutputFile"},
+      {!D.HeaderIncludeOutputFile.empty(), "HeaderIncludeOutputFile"},
+      {!D.DOTOutputFile.empty(), "DOTOutputFile"},
+      {!D.ModuleDependencyOutputDir.empty(), "ModuleDependencyOutputDir"},
+      {!Diag.DiagnosticLogFile.empty(), "DiagnosticLogFile"},
+      {!Diag.DiagnosticSerializationFile.empty(),
+       "DiagnosticSerializationFile"}};
+  for (auto [Present, Name] : Unsupported)
+    if (Present)
+      return llvm::createStringError(
+          "bounded module worker rejects uncontrolled plugin or side output: " +
+          Name);
+  return llvm::Error::success();
+}
+ModuleBuildWorkerOutput
+createModuleBuildWorkerOutput(PathRef Root, uint64_t Bytes, unsigned MaxFiles) {
+  auto B = std::make_shared<Budget>(Root, Bytes, MaxFiles);
+  auto Backend = llvm::makeIntrusiveRefCnt<BoundedBackend>(B);
+  auto Cache = std::make_shared<BoundedCache>(Backend);
+  return {std::move(Backend), std::move(Cache), [B] { return B->check(); }};
+}
+std::unique_ptr<FrontendAction> createBoundedReducedModuleAction() {
+  return std::make_unique<BoundedReducedAction>();
+}
+} // namespace clang::clangd
