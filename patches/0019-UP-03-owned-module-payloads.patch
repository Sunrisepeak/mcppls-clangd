+  auto Denied = (*Cache)->reserve("too-large", Anchor, 1);
+  EXPECT_THAT_EXPECTED(Denied, llvm::Failed());
+  { std::error_code EC; llvm::raw_fd_ostream F((*Stable)->payload(), EC); ASSERT_FALSE(EC); F << "BMI"; }
+  ASSERT_THAT_ERROR((*Stable)->publish(), llvm::Succeeded());
+  auto Copy = (*Cache)->copy(*Stable);
+  ASSERT_THAT_EXPECTED(Copy, llvm::Succeeded());
+  auto Contents = llvm::MemoryBuffer::getFile((*Copy)->payload());
+  ASSERT_TRUE(Contents); EXPECT_EQ((*Contents)->getBuffer(), "BMI");
+  // Another factory/process view cannot collect either active physical inode.
+  auto Other = ModuleBuildCache::open(Root, 6, 4);
+  ASSERT_THAT_EXPECTED(Other, llvm::Succeeded());
+  EXPECT_THAT_EXPECTED((*Other)->reserve("pressure", Anchor, 1), llvm::Failed());
+  auto Collected = (*Other)->collect(4);
+  ASSERT_THAT_EXPECTED(Collected, llvm::Succeeded()); EXPECT_EQ(*Collected, 0u);
+  EXPECT_TRUE(llvm::sys::fs::exists((*Stable)->payload()));
+  EXPECT_TRUE(llvm::sys::fs::exists((*Copy)->payload()));
+  auto CopyPath = (*Copy)->payload();
+  Copy->reset();
+  EXPECT_FALSE(llvm::sys::fs::exists(CopyPath));
+  auto LeasedAgain = (*Other)->lookup("M");
+  ASSERT_THAT_EXPECTED(LeasedAgain, llvm::Succeeded()); ASSERT_TRUE(*LeasedAgain);
+  Stable->reset();
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("pressure", Anchor, 4), llvm::Failed());
+  Collected = (*Cache)->collect(4);
+  ASSERT_THAT_EXPECTED(Collected, llvm::Succeeded()); EXPECT_EQ(*Collected, 0u);
+  auto StablePath = (*LeasedAgain)->payload();
+  LeasedAgain->reset();
+  Collected = (*Cache)->collect(4);
+  ASSERT_THAT_EXPECTED(Collected, llvm::Succeeded()); EXPECT_EQ(*Collected, 1u);
+  EXPECT_FALSE(llvm::sys::fs::exists(StablePath));
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("after-cleanup", Anchor, 6), llvm::Succeeded());
+  EXPECT_TRUE(llvm::sys::fs::exists(Foreign + "/keep"));
+}
