+TEST_F(PrerequisiteModulesTests, OwnedImplicitBundleMainCopyAndCompanionLease) {
+  const auto Root = (TestDir + "/bundles/.owned-payload-v1").str();
+  const auto Anchor = (TestDir + "/source-anchor").str();
+  auto Write = [](StringRef File, StringRef Text) {
+    EXPECT_FALSE(
+        llvm::sys::fs::create_directories(llvm::sys::path::parent_path(File)));
+    std::error_code EC;
+    llvm::raw_fd_ostream Out(File, EC);
+    EXPECT_FALSE(EC);
+    Out << Text;
+  };
+  Write(Anchor, "");
+  ASSERT_FALSE(
+      llvm::sys::fs::create_directories(llvm::sys::path::parent_path(Root)));
+  auto Cache = ModuleBuildCache::open(Root, 20, 8);
+  ASSERT_THAT_EXPECTED(Cache, llvm::Succeeded());
+  auto Stable = (*Cache)->reserve("M", Anchor, 20, 16, 4);
+  ASSERT_THAT_EXPECTED(Stable, llvm::Succeeded());
+  auto Unit =
+      ModuleBuildWorkerUnit::create((*Stable)->payload(), (*Stable)->workers());
+  ASSERT_THAT_EXPECTED(Unit, llvm::Succeeded());
+  const auto Implicit = (*Unit)->file("module-cache/context/Builtin.pcm");
+  const auto Snapshot = (*Unit)->file("main.snapshot");
+  Write(Implicit, "IMPLICIT");
+  Write(Snapshot, "DATA");
+  Write((*Stable)->payload(), "MAIN");
+  ASSERT_THAT_ERROR((*Unit)->retainImplicitOutputs(), llvm::Succeeded());
+  EXPECT_FALSE(llvm::sys::fs::exists(Snapshot));
+  ASSERT_THAT_ERROR((*Stable)->publish(), llvm::Succeeded());
+  EXPECT_EQ((*Stable)->mainBytes(), 4u);
+  EXPECT_EQ((*Stable)->payloadBytes(), 12u);
+  auto Copy = (*Cache)->copy(*Stable);
+  ASSERT_THAT_EXPECTED(Copy, llvm::Succeeded());
+  EXPECT_EQ((*Copy)->payloadBytes(), 4u);
+  // Copying the entire 12-byte bundle would exhaust this exact 20-byte quota.
+  const auto CopyPath = (*Copy)->payload();
+  int Ready[2], Continue[2];
+  ASSERT_EQ(pipe(Ready), 0);
+  ASSERT_EQ(pipe(Continue), 0);
+  pid_t Child = fork();
+  ASSERT_GE(Child, 0);
+  if (!Child) {
+    close(Ready[0]);
+    close(Continue[1]);
+    // Close every inherited cache/OFD handle: the independent input API must
+    // acquire both copy and stable companion, rather than inherit ownership.
+    DIR *Descriptors = opendir("/proc/self/fd");
+    if (!Descriptors)
+      _exit(2);
+    std::vector<int> Close;
+    while (auto *Entry = readdir(Descriptors)) {
+      unsigned FD;
+      if (!StringRef(Entry->d_name).getAsInteger(10, FD) && FD > 2 &&
+          int(FD) != Ready[1] && int(FD) != Continue[0] &&
+          int(FD) != dirfd(Descriptors))
+        Close.push_back(FD);
+    }
+    closedir(Descriptors);
+    for (int FD : Close)
+      close(FD);
+    auto Input = ModuleBuildCache::acquireInput(CopyPath);
+    if (!Input || !*Input || (*Input)->mainBytes() != 4)
+      _exit(3);
+    auto Header = llvm::MemoryBuffer::getFile(Implicit);
+    if (!Header || (*Header)->getBuffer() != "IMPLICIT")
+      _exit(4);
+    if (write(Ready[1], "R", 1) != 1)
+      _exit(5);
+    char Signal;
+    if (read(Continue[0], &Signal, 1) != 1)
+      _exit(6);
+    _exit(0);
+  }
+  close(Ready[1]);
+  close(Continue[0]);
+  bool Reaped = false;
+  auto ChildCleanup = llvm::scope_exit([&] {
+    if (!Reaped) {
+      close(Continue[1]);
+      kill(Child, SIGKILL);
+      int Status;
+      waitpid(Child, &Status, 0);
+    }
+  });
+  char Signal;
+  ASSERT_EQ(read(Ready[0], &Signal, 1), 1);
+  close(Ready[0]);
+  Stable->reset();
+  Copy->reset();
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("pressure", Anchor, 5),
+                       llvm::Failed());
+  auto Collected = (*Cache)->collect(8);
+  ASSERT_THAT_EXPECTED(Collected, llvm::Succeeded());
+  EXPECT_EQ(*Collected, 0u);
+  EXPECT_TRUE(llvm::sys::fs::exists(Implicit));
+  EXPECT_TRUE(llvm::sys::fs::exists(CopyPath));
+  ASSERT_EQ(write(Continue[1], "X", 1), 1);
+  close(Continue[1]);
+  int Status;
+  ASSERT_EQ(waitpid(Child, &Status, 0), Child);
+  Reaped = true;
+  ASSERT_TRUE(WIFEXITED(Status));
+  ASSERT_EQ(WEXITSTATUS(Status), 0);
+  Collected = (*Cache)->collect(8);
+  ASSERT_THAT_EXPECTED(Collected, llvm::Succeeded());
+  EXPECT_EQ(*Collected, 2u);
+  EXPECT_FALSE(llvm::sys::fs::exists(Implicit));
+  EXPECT_FALSE(llvm::sys::fs::exists(CopyPath));
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("after-cleanup", Anchor, 20),
+                       llvm::Succeeded());
+}
