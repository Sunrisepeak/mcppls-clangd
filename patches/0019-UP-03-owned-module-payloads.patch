+TEST_F(PrerequisiteModulesTests, OwnedPayloadCrashChargesAndChangedIdentityRetain) {
+  auto Root = (TestDir + "/owned-crash").str();
+  auto Anchor = (TestDir + "/source-anchor").str();
+  { std::error_code EC; llvm::raw_fd_ostream F(Anchor, EC); ASSERT_FALSE(EC); }
+  int Ready[2]; ASSERT_EQ(pipe(Ready), 0);
+  pid_t Child = fork(); ASSERT_GE(Child, 0);
+  if (!Child) {
+    close(Ready[0]);
+    auto Cache = ModuleBuildCache::open(Root, 8, 2);
+    if (!Cache) _exit(2);
+    auto Reservation = (*Cache)->reserve("killed", Anchor, 8);
+    if (!Reservation) _exit(3);
+    { std::error_code EC; llvm::raw_fd_ostream F((*Reservation)->payload(), EC); if (EC) _exit(4); F << "12345678"; }
+    if (write(Ready[1], "R", 1) != 1) _exit(5);
+    for (;;) pause();
+  }
+  close(Ready[1]); char Token = 0;
+  ASSERT_EQ(read(Ready[0], &Token, 1), 1); close(Ready[0]);
+  auto Cache = ModuleBuildCache::open(Root, 8, 2);
+  ASSERT_THAT_EXPECTED(Cache, llvm::Succeeded());
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("before-kill", Anchor, 1), llvm::Failed());
+  ASSERT_EQ(kill(Child, SIGKILL), 0);
+  int Status = 0; ASSERT_EQ(waitpid(Child, &Status, 0), Child); ASSERT_TRUE(WIFSIGNALED(Status));
+  EXPECT_EQ(WTERMSIG(Status), SIGKILL);
+  // Kernel owner death alone does not free the persistent charge.
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("after-kill", Anchor, 1), llvm::Failed());
+  auto GC = (*Cache)->collect(2);
+  ASSERT_THAT_EXPECTED(GC, llvm::Succeeded()); EXPECT_EQ(*GC, 1u);
+  auto Stable = (*Cache)->reserve("changed", Anchor, 8);
+  ASSERT_THAT_EXPECTED(Stable, llvm::Succeeded());
+  { std::error_code EC; llvm::raw_fd_ostream F((*Stable)->payload(), EC); ASSERT_FALSE(EC); F << "12345678"; }
+  ASSERT_THAT_ERROR((*Stable)->publish(), llvm::Succeeded());
+  const auto Directory = llvm::sys::path::parent_path((*Stable)->payload()).str();
+  Stable->reset();
+  ASSERT_FALSE(llvm::sys::fs::rename(Directory, Directory + ".original"));
+  ASSERT_FALSE(llvm::sys::fs::create_directory(Directory));
+  { std::error_code EC; llvm::raw_fd_ostream F(Directory + "/payload.pcm", EC); ASSERT_FALSE(EC); F << "foreign"; }
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("pressure", Anchor, 1), llvm::Failed());
+  GC = (*Cache)->collect(2);
+  ASSERT_THAT_EXPECTED(GC, llvm::Succeeded()); EXPECT_EQ(*GC, 0u);
+  EXPECT_TRUE(llvm::sys::fs::exists(Directory + "/payload.pcm"));
+  EXPECT_THAT_EXPECTED((*Cache)->reserve("retained-charge", Anchor, 1), llvm::Failed());
+}
