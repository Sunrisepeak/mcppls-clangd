+llvm::StringRef ModuleBuildCache::root() const { return State->Root; }
+
+llvm::Expected<std::shared_ptr<ModuleBuildCache>>
+ModuleBuildCache::open(PathRef Root, uint64_t Bytes, unsigned Slots) {
+#ifndef __linux__
+  return failure("strict payload admission is only supported on Linux");
+#else
+  if (!llvm::sys::path::is_absolute(Root) || Root.contains('\0') || !Bytes ||
+      !Slots || Slots > MaximumSlots)
+    return failure("invalid root or payload/slot limits");
+  auto I = std::make_unique<Impl>();
+  I->Root = Root.str();
+  if (mkdir(I->Root.c_str(), 0700) && errno != EEXIST)
+    return ioError();
+  I->Directory.Value =
+      ::open(I->Root.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (I->Directory.Value < 0)
+    return ioError();
+  if (!owned(I->Directory.Value, true))
+    return failure("unrecognized root");
+  struct stat Existing;
+  if (fstatat(I->Directory.Value, "ledger-v1", &Existing,
+              AT_SYMLINK_NOFOLLOW)) {
+    if (errno != ENOENT)
+      return ioError();
+    DIR *D = fdopendir(dup(I->Directory.Value));
+    if (!D)
+      return ioError();
+    bool Empty = true;
+    while (auto *E = readdir(D)) {
+      StringRef N(E->d_name);
+      if (N != "." && N != ".." && N != "ledger-v1") {
+        Empty = false;
+        break;
+      }
+    }
+    closedir(D);
+    if (!Empty)
+      return failure("unmarked nonempty namespace");
+  }
+  I->Ledger.Value = openat(I->Directory.Value, "ledger-v1",
+                           O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+  if (I->Ledger.Value < 0)
+    return ioError();
+  if (!owned(I->Ledger.Value, false))
+    return failure("unrecognized ledger");
+  Lock Guard(I->Ledger.Value);
+  if (!Guard.acquire())
+    return ioError();
+  struct stat S;
+  if (fstat(I->Ledger.Value, &S))
+    return ioError();
+  const uint64_t Size = sizeof(Header) + uint64_t(Slots) * 2 * sizeof(Record);
+  if (!S.st_size) {
+    // Empty existing roots are deliberately not adopted: the namespace must
+    // have contained only our just-created ledger before initializing it.
+    DIR *D = fdopendir(dup(I->Directory.Value));
+    if (!D)
+      return ioError();
+    bool OnlyLedger = true;
+    while (auto *E = readdir(D)) {
+      StringRef N(E->d_name);
+      if (N != "." && N != ".." && N != "ledger-v1") {
+        OnlyLedger = false;
+        break;
+      }
+    }
+    closedir(D);
+    if (!OnlyLedger)
+      return failure("unmarked nonempty namespace");
+    I->Description = {Magic, sizeof(Record), Slots, Bytes};
+    if (ftruncate(I->Ledger.Value, Size) ||
+        !exactWrite(I->Ledger.Value, &I->Description, sizeof(Header), 0))
+      return ioError();
+    Record Empty{};
+    Empty.Sequence = 1;
+    Empty.Checksum = checksum(Empty);
+    for (unsigned Slot = 0; Slot < Slots; ++Slot)
+      if (!exactWrite(I->Ledger.Value, &Empty, sizeof(Empty),
+                      I->offset(Slot, 1)))
+        return ioError();
+    if (fdatasync(I->Ledger.Value) || fsync(I->Directory.Value))
+      return ioError();
+  } else if (uint64_t(S.st_size) != Size ||
+             !exactRead(I->Ledger.Value, &I->Description, sizeof(Header), 0) ||
+             I->Description.MagicValue != Magic ||
+             I->Description.RecordSize != sizeof(Record) ||
+             I->Description.Slots != Slots || I->Description.Limit != Bytes)
+    return failure("incompatible marked ledger or limits");
+  return std::shared_ptr<ModuleBuildCache>(new ModuleBuildCache(std::move(I)));
+#endif
+}
+llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+ModuleBuildCache::reserve(StringRef Key, PathRef Source, uint64_t Bytes,
+                          uint64_t OutputEnvelope, uint64_t CaptureEnvelope) {
+#ifndef __linux__
+  return failure("unsupported admission");
+#else
+  if (!State->rootMatches())
+    return failure("namespace identity changed");
+  if (!Bytes || Bytes > State->Description.Limit || Source.size() >= 1024 ||
+      Source.contains('\0') || !llvm::sys::path::is_absolute(Source))
+    return failure("invalid reservation envelope/source guard");
+  std::lock_guard<std::mutex> Guard(State->Mutex);
+  Lock Ledger(State->Ledger.Value);
+  if (!Ledger.acquire())
+    return ioError();
+  uint64_t Used = 0;
+  unsigned Candidate = State->Description.Slots;
+  Record Selected{};
+  FD Lease;
+  for (unsigned S = 0; S < State->Description.Slots; ++S) {
+    auto R = State->read(S);
+    if (!R)
+      return R.takeError();
+    if (R->Bytes > State->Description.Limit - Used)
+      return failure("invalid charged total");
+    Used += R->Bytes;
+    if (R->Type == Free && Candidate == State->Description.Slots) {
+      auto L = State->lease(S, true, true, true);
+      if (!L) {
+        llvm::consumeError(L.takeError());
+        continue;
+      }
+      FD CandidateLease(*L);
+      if (!State->leaseMatches(S, CandidateLease.Value, *R))
+        continue;
+      Lease.Value = CandidateLease.release();
+      Selected = *R;
+      Candidate = S;
+    }
+  }
+  if (Candidate == State->Description.Slots ||
+      Bytes > State->Description.Limit - Used) {
+    // Advisory cross-process pressure never authorizes deletion without leases.
+    // Retain idle stable generations until admission needs space/another slot.
+    uint64_t Pressure = Bytes;
+    if (!exactWrite(State->Ledger.Value, &Pressure, sizeof(Pressure),
+                    offsetof(Header, PressureBytes)))
+      return ioError();
+    return llvm::make_error<ModuleCachePressure>();
+  }
+  // Monotonically increasing per-slot generation survives clearing/reuse.
+  // Every reuse changes the immutable pathname; no old consumer observes ABA.
+  if (++Selected.Generation == 0)
+    return failure("generation counter exhausted");
+  Selected.Bytes = Bytes;
+  Selected.MainBytes = Selected.BundleFiles = 0;
+  Selected.BundleDigest = {};
+  Selected.Type = Reserved;
+  Selected.StableSlot = UINT64_MAX;
+  Selected.StableGeneration = 0;
+  Selected.OutputEnvelope = OutputEnvelope;
+  Selected.CaptureEnvelope = CaptureEnvelope;
+  Selected.Device = Selected.Inode = 0;
+  struct stat LeaseIdentity;
+  if (fstat(Lease.Value, &LeaseIdentity))
+    return ioError();
+  Selected.LeaseDevice = LeaseIdentity.st_dev;
+  Selected.LeaseInode = LeaseIdentity.st_ino;
+  std::memset(Selected.Key, 0, sizeof(Selected.Key));
+  std::memset(Selected.Source, 0, sizeof(Selected.Source));
+  std::memcpy(Selected.Key, digest(Key).data(), 64);
+  std::memcpy(Selected.Source, Source.data(), Source.size());
+  if (auto E = State->write(Candidate, Selected))
+    return std::move(E);
+  ++Selected.Sequence;
+  std::string Name = State->name(Candidate, Selected.Generation);
+  if (mkdirat(State->Directory.Value, Name.c_str(), 0700))
+    return ioError();
+  FD Gen(openat(State->Directory.Value, Name.c_str(),
+                O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  struct stat S;
+  if (Gen.Value < 0 || !owned(Gen.Value, true) || fstat(Gen.Value, &S))
+    return failure("invalid new generation");
+  Selected.Device = S.st_dev;
+  Selected.Inode = S.st_ino;
+  const auto Marker = State->marker(Candidate, Selected);
+  FD MarkerFile(openat(Gen.Value, "owned.generation",
+                       O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+                       0600));
+  if (MarkerFile.Value < 0 ||
+      !exactWrite(MarkerFile.Value, Marker.data(), Marker.size(), 0) ||
+      fdatasync(MarkerFile.Value) || fsync(Gen.Value))
+    return ioError();
+  if (auto E = State->write(Candidate, Selected))
+    return std::move(E);
+  ++Selected.Sequence;
+  if (fsync(State->Directory.Value))
+    return ioError();
+  auto I = std::make_unique<ModuleBuildCacheLease::Impl>();
+  I->Cache = shared_from_this();
+  I->Slot = Candidate;
+  I->Lease.Value = Lease.release();
+  I->Description = Selected;
+  return std::shared_ptr<ModuleBuildCacheLease>(
+      new ModuleBuildCacheLease(std::move(I)));
+#endif
+}
+llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+ModuleBuildCache::reserveUntil(
+    StringRef Key, PathRef Source, uint64_t Bytes, uint64_t OutputEnvelope,
+    uint64_t CaptureEnvelope, std::chrono::steady_clock::time_point Deadline,
+    const std::function<bool()> &Cancelled) {
+  for (;;) {
+    if (Cancelled && Cancelled())
+      return failure("worker admission cancelled");
+    const auto Now = std::chrono::steady_clock::now();
+    if (Now >= Deadline)
+      return failure("worker admission deadline exhausted");
+    auto Result = reserve(Key, Source, Bytes, OutputEnvelope, CaptureEnvelope);
+    if (Result)
+      return Result;
+    bool Pressure = false;
+    auto Error = llvm::handleErrors(Result.takeError(),
+        [&](const ModuleCachePressure &) { Pressure = true; });
+    if (Error)
+      return std::move(Error);
+    assert(Pressure);
+    // Never collect, evict a lease, compile without admission, or wait while
+    // holding the ledger/mutex. Another process can publish or release space.
+    std::this_thread::sleep_until((std::min)(Deadline,
+        std::chrono::steady_clock::now() + std::chrono::milliseconds(25)));
+  }
+}
+llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+ModuleBuildCache::lookup(StringRef Key, std::function<bool(PathRef)> Usable) {
+#ifndef __linux__
+  return failure("unsupported lookup");
+#else
+  const std::string K = digest(Key);
+  for (unsigned S = 0; S < State->Description.Slots; ++S) {
+    auto L = State->lease(S, false, true);
+    if (!L) {
+      llvm::consumeError(L.takeError());
+      continue;
+    }
+    FD Lease(*L);
+    auto R = [&]() -> llvm::Expected<Record> {
+      std::lock_guard<std::mutex> Guard(State->Mutex);
+      Lock Ledger(State->Ledger.Value);
+      if (!Ledger.acquire())
+        return ioError();
+      return State->read(S);
+    }();
+    if (!R)
+      return R.takeError();
+    if (R->Type != Stable || StringRef(R->Key) != K ||
+        !State->leaseMatches(S, Lease.Value, *R))
+      continue;
+    auto G = State->generation(S, *R);
+    if (!G)
+      return G.takeError();
+    FD Gen(*G);
+    struct stat F;
+    if (fstatat(Gen.Value, "payload.pcm", &F, AT_SYMLINK_NOFOLLOW) ||
+        !S_ISREG(F.st_mode) || F.st_nlink != 1 ||
+        uint64_t(F.st_size) != R->MainBytes)
+      return failure("stable payload changed");
+    auto Bundle = inventoryBundle(Gen.Value);
+    if (!Bundle)
+      return Bundle.takeError();
+    if (Bundle->Bytes != R->Bytes || Bundle->MainBytes != R->MainBytes ||
+        Bundle->CacheFiles != R->BundleFiles ||
+        Bundle->Digest != R->BundleDigest)
+      return failure("stable bundle changed");
+    if (Usable && !Usable(path(path(State->Root, State->name(S, R->Generation)),
+                               "payload.pcm")))
+      continue;
+    auto I = std::make_unique<ModuleBuildCacheLease::Impl>();
+    I->Cache = shared_from_this();
+    I->Slot = S;
+    I->Lease.Value = Lease.release();
+    I->Description = *R;
+    return std::shared_ptr<ModuleBuildCacheLease>(
+        new ModuleBuildCacheLease(std::move(I)));
+  }
+  return std::shared_ptr<ModuleBuildCacheLease>{};
+#endif
+}
+llvm::Error ModuleBuildCacheLease::publish() {
+#ifndef __linux__
+  return failure("unsupported publication");
+#else
+  auto &C = *State->Cache->State;
+  auto R = [&]() -> llvm::Expected<Record> {
+    std::lock_guard<std::mutex> Guard(C.Mutex);
+    Lock Ledger(C.Ledger.Value);
+    if (!Ledger.acquire())
+      return ioError();
+    return C.read(State->Slot);
+  }();
+  if (!R)
+    return R.takeError();
+  if (R->Generation != State->Description.Generation || R->Type != Reserved ||
+      !C.leaseMatches(State->Slot, State->Lease.Value, *R))
+    return failure("reservation changed before publication");
+  auto G = C.generation(State->Slot, *R);
+  if (!G)
+    return G.takeError();
+  FD Gen(*G);
+  // Empty worker roots from ordinary builds can be removed. A retained bundle
+  // keeps its ORIGINAL absolute implicit PCM paths; the inventory below must
+  // prove it contains only retired output, never capture/startup payload.
+  const std::string Workers = this->workers();
+  struct stat W;
+  if (!fstatat(Gen.Value, "workers", &W, AT_SYMLINK_NOFOLLOW)) {
+    if (!S_ISDIR(W.st_mode))
+      return failure("invalid worker root");
+    DIR *D = opendir(Workers.c_str());
+    if (!D)
+      return ioError();
+    bool Empty = true;
+    unsigned Count = 0;
+    while (auto *E = readdir(D)) {
+      StringRef N(E->d_name);
+      if (N == "." || N == "..")
+        continue;
+      if (++Count > 1 || N != "owned.root") {
+        Empty = false;
+        break;
+      }
+    }
+    closedir(D);
+    if (Empty &&
+        (unlink(path(Workers, "owned.root").c_str()) || rmdir(Workers.c_str())))
+      return failure("worker root cleanup remains charged");
+  } else if (errno != ENOENT)
+    return ioError();
+  auto Bundle = inventoryBundle(Gen.Value);
+  if (!Bundle)
+    return Bundle.takeError();
+  if (!Bundle->MainBytes || Bundle->Bytes > R->Bytes ||
+      (R->OutputEnvelope && Bundle->Bytes > R->OutputEnvelope))
+    return failure("invalid stable bundle or output envelope");
+  if (auto Error = syncBundle(*Bundle))
+    return Error;
+  FD Payload(
+      openat(Gen.Value, "payload.pcm", O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  if (Payload.Value < 0 || fsync(Payload.Value) || fsync(Gen.Value))
+    return ioError();
+  auto Confirmed = inventoryBundle(Gen.Value);
+  if (!Confirmed)
+    return Confirmed.takeError();
+  if (Confirmed->Digest != Bundle->Digest || Confirmed->Bytes != Bundle->Bytes)
+    return failure("bundle changed during publication");
+  R->Type = Stable;
+  R->Bytes = Bundle->Bytes;
+  R->MainBytes = Bundle->MainBytes;
+  R->BundleFiles = Bundle->CacheFiles;
+  R->BundleDigest = Bundle->Digest;
+  {
+    std::lock_guard<std::mutex> Guard(C.Mutex);
+    Lock Ledger(C.Ledger.Value);
+    if (!Ledger.acquire())
+      return ioError();
+    if (auto E = C.write(State->Slot, *R))
+      return E;
+  }
+  State->Description = *R;
+  State->Description.Type = Stable;
+  // Never release/reacquire during transfer: downgrade the same kernel lease.
+  struct flock Range{};
+  Range.l_type = F_RDLCK;
+  Range.l_whence = SEEK_SET;
+  // OFD range-lock conversion is one kernel operation, preserving continuous
+  // ownership. Unlike flock conversion it does not drop/reacquire the lease.
+  if (fcntl(State->Lease.Value, F_OFD_SETLK, &Range))
+    return ioError();
+  return llvm::Error::success();
+#endif
+}
+llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>> ModuleBuildCache::copy(
+    const std::shared_ptr<ModuleBuildCacheLease> &StableLease) {
+#ifndef __linux__
+  return failure("unsupported copy");
+#else
+  if (!StableLease || StableLease->State->Cache.get() != this ||
+      StableLease->State->Description.Type != Stable)
+    return failure("copy requires this namespace's stable lease");
+  const auto &R = StableLease->State->Description;
+  auto Result = reserve("read-copy", R.Source, R.MainBytes);
+  if (!Result)
+    return Result.takeError();
+  {
+    std::lock_guard<std::mutex> Guard(State->Mutex);
+    Lock Ledger(State->Ledger.Value);
+    if (!Ledger.acquire())
+      return ioError();
+    auto Entry = State->read((*Result)->State->Slot);
+    if (!Entry)
+      return Entry.takeError();
+    Entry->StableSlot = StableLease->State->Slot;
+    Entry->StableGeneration = R.Generation;
+    if (auto Error = State->write((*Result)->State->Slot, *Entry))
+      return std::move(Error);
+    (*Result)->State->Companion = StableLease;
+  }
+  FD Input(::open(StableLease->payload().c_str(),
+                  O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  FD Output(::open((*Result)->payload().c_str(),
+                   O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+  if (Input.Value < 0 || Output.Value < 0)
+    return ioError();
+  std::array<char, 65536> Buffer;
+  uint64_t Written = 0;
+  for (;;) {
+    ssize_t N = read(Input.Value, Buffer.data(), Buffer.size());
+    if (N < 0 && errno == EINTR)
+      continue;
+    if (N < 0)
+      return ioError();
+    if (!N)
+      break;
+    // Even a changed source cannot grow the copy past its PRE-WRITE charge.
+    if (uint64_t(N) > R.MainBytes - Written)
+      return failure("copy source grew");
+    if (!exactWrite(Output.Value, Buffer.data(), N, Written))
+      return ioError();
+    Written += N;
+  }
+  if (Written != R.MainBytes)
+    return failure("copy source size changed");
+  if (fdatasync(Output.Value))
+    return ioError();
+  auto &C = *State;
+  std::lock_guard<std::mutex> Guard(C.Mutex);
+  Lock Ledger(C.Ledger.Value);
+  if (!Ledger.acquire())
+    return ioError();
+  auto Current = C.read((*Result)->State->Slot);
+  if (!Current)
+    return Current.takeError();
+  Current->Type = Copy;
+  Current->MainBytes = Written;
+  if (auto E = C.write((*Result)->State->Slot, *Current))
+    return std::move(E);
+  (*Result)->State->Description.Type = Copy;
+  (*Result)->State->Description.MainBytes = Written;
+  struct flock Range{};
+  Range.l_type = F_RDLCK;
+  Range.l_whence = SEEK_SET;
+  if (fcntl((*Result)->State->Lease.Value, F_OFD_SETLK, &Range))
+    return ioError();
+  return Result;
+#endif
+}
+namespace {
+#ifdef __linux__
+struct ManagedPath {
+  std::string Root;
+  unsigned Slot;
+  uint64_t Generation;
+};
+llvm::Expected<std::optional<ManagedPath>> identifyManaged(PathRef Generation) {
+  StringRef Root = llvm::sys::path::parent_path(Generation);
+  if (llvm::sys::path::filename(Root) != ".owned-payload-v1")
+    return std::optional<ManagedPath>{};
+  StringRef Name = llvm::sys::path::filename(Generation);
+  if (!Name.consume_front("generation-"))
+    return failure("invalid managed generation name");
+  auto Parts = Name.split('-');
+  ManagedPath Result{Root.str(), 0, 0};
+  if (Parts.first.getAsInteger(10, Result.Slot) ||
+      Parts.second.getAsInteger(10, Result.Generation) ||
+      Result.Slot >= MaximumSlots || !Result.Generation)
+    return failure("invalid managed generation identifier");
+  return std::optional<ManagedPath>(Result);
+}
+llvm::Expected<std::shared_ptr<ModuleBuildCache>>
+openManaged(const ManagedPath &P) {
+  FD Directory(
+      ::open(P.Root.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  if (Directory.Value < 0 || !owned(Directory.Value, true))
+    return failure("unrecognized managed root");
+  FD Ledger(
+      openat(Directory.Value, "ledger-v1", O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  Header H;
+  if (Ledger.Value < 0 || !owned(Ledger.Value, false) ||
+      !exactRead(Ledger.Value, &H, sizeof(H), 0) || H.MagicValue != Magic ||
+      H.RecordSize != sizeof(Record) || !H.Slots || H.Slots > MaximumSlots ||
+      !H.Limit)
+    return failure("unrecognized managed ledger");
+  return ModuleBuildCache::open(P.Root, H.Limit, H.Slots);
+}
+#endif
+} // namespace
+llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+ModuleBuildCache::acquireGeneration(unsigned Slot, uint64_t Generation,
+                                    bool StableOnly) {
+#ifndef __linux__
+  return failure("managed read leases unavailable");
+#else
+  if (Slot >= State->Description.Slots)
+    return failure("managed slot out of range");
+  auto F = State->lease(Slot, false, true);
+  if (!F)
+    return F.takeError();
+  FD Lease(*F);
+  auto R = [&]() -> llvm::Expected<Record> {
+    std::lock_guard<std::mutex> Guard(State->Mutex);
+    Lock Ledger(State->Ledger.Value);
+    if (!Ledger.acquire())
+      return ioError();
+    return State->read(Slot);
+  }();
+  if (!R)
+    return R.takeError();
+  if (R->Generation != Generation || (R->Type != Stable && R->Type != Copy) ||
+      (StableOnly && R->Type != Stable) ||
+      !State->leaseMatches(Slot, Lease.Value, *R))
+    return failure("managed input retired or identity changed");
+  auto G = State->generation(Slot, *R);
+  if (!G)
+    return G.takeError();
+  FD Gen(*G);
+  struct stat Payload;
+  if (fstatat(Gen.Value, "payload.pcm", &Payload, AT_SYMLINK_NOFOLLOW) ||
+      !S_ISREG(Payload.st_mode) || Payload.st_nlink != 1 ||
+      Payload.st_uid != geteuid() || uint64_t(Payload.st_size) != R->MainBytes)
+    return failure("managed input payload changed");
+  if (R->Type == Stable) {
+    auto Bundle = inventoryBundle(Gen.Value);
+    if (!Bundle)
+      return Bundle.takeError();
+    if (Bundle->Bytes != R->Bytes || Bundle->MainBytes != R->MainBytes ||
+        Bundle->CacheFiles != R->BundleFiles ||
+        Bundle->Digest != R->BundleDigest)
+      return failure("managed input bundle changed");
+  }
+  std::shared_ptr<ModuleBuildCacheLease> Companion;
+  if (R->Type == Copy) {
+    if (R->StableSlot >= State->Description.Slots || R->StableSlot == Slot)
+      return failure("invalid managed stable companion");
+    auto Parent = acquireGeneration(R->StableSlot, R->StableGeneration, true);
+    if (!Parent)
+      return Parent.takeError();
+    if ((*Parent)->State->Description.Type != Stable)
+      return failure("managed companion is not stable");
+    Companion = std::move(*Parent);
+  }
+  auto I = std::make_unique<ModuleBuildCacheLease::Impl>();
+  I->Cache = shared_from_this();
+  I->Slot = Slot;
+  I->Lease.Value = Lease.release();
+  I->Description = *R;
+  I->Companion = std::move(Companion);
+  return std::shared_ptr<ModuleBuildCacheLease>(
+      new ModuleBuildCacheLease(std::move(I)));
+#endif
+}
+llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+ModuleBuildCache::acquireInput(PathRef Payload) {
+#ifndef __linux__
+  for (auto I = llvm::sys::path::begin(Payload),
+            E = llvm::sys::path::end(Payload);
+       I != E; ++I)
+    if (*I == ".owned-payload-v1")
+      return failure("managed read leases unavailable");
+  return std::shared_ptr<ModuleBuildCacheLease>{};
+#else
+  llvm::SmallString<256> Normalized(Payload);
+  llvm::sys::path::remove_dots(Normalized, true);
+  llvm::SmallString<256> Canonical;
+  if (!llvm::sys::fs::real_path(Normalized, Canonical))
+    Normalized = Canonical;
+  auto Identified = identifyManaged(llvm::sys::path::parent_path(Normalized));
+  if (!Identified)
+    return Identified.takeError();
+  if (!*Identified)
+    return std::shared_ptr<ModuleBuildCacheLease>{};
+  if (llvm::sys::path::filename(Normalized) != "payload.pcm")
+    return failure("unknown managed input filename");
+  auto Cache = openManaged(**Identified);
+  if (!Cache)
+    return Cache.takeError();
+  return (*Cache)->acquireGeneration((*Identified)->Slot,
+                                     (*Identified)->Generation);
+#endif
+}
+llvm::Error ModuleBuildCache::validateWorker(PathRef Unit,
+                                             uint64_t OutputLimit) {
+#ifndef __linux__
+  return failure("managed worker admission unavailable");
+#else
+  auto Identified = identifyManaged(
+      llvm::sys::path::parent_path(llvm::sys::path::parent_path(Unit)));
+  if (!Identified)
+    return Identified.takeError();
+  if (!*Identified || llvm::sys::path::filename(
+                          llvm::sys::path::parent_path(Unit)) != "workers")
+    return failure("managed worker has no reservation");
+  auto Cache = openManaged(**Identified);
+  if (!Cache)
+    return Cache.takeError();
+  auto &C = *(*Cache)->State;
+  if ((*Identified)->Slot >= C.Description.Slots)
+    return failure("managed slot out of range");
+  Lock Ledger(C.Ledger.Value);
+  if (!Ledger.acquire())
+    return ioError();
+  auto R = C.read((*Identified)->Slot);
+  if (!R)
+    return R.takeError();
+  if (R->Type != Reserved || R->Generation != (*Identified)->Generation ||
+      !OutputLimit || R->OutputEnvelope != OutputLimit || !R->CaptureEnvelope ||
+      R->CaptureEnvelope > UINT64_MAX - OutputLimit ||
+      R->Bytes != OutputLimit + R->CaptureEnvelope)
+    return failure("managed worker envelope changed");
+  auto G = C.generation((*Identified)->Slot, *R);
+  if (!G)
+    return G.takeError();
+  FD Gen(*G);
+  return llvm::Error::success();
+#endif
+}
+
+llvm::Expected<unsigned> ModuleBuildCache::collect(unsigned MaxSlots) {
+#ifndef __linux__
+  return failure("unsupported collection");
+#else
+  if (!State->rootMatches() || !State->ledgerMatches())
+    return failure("namespace or ledger identity changed");
+  bool Pressure = false;
+  {
+    std::unique_lock<std::mutex> Guard(State->Mutex, std::try_to_lock);
+    if (!Guard.owns_lock())
+      return 0;
+    Lock Ledger(State->Ledger.Value);
+    if (!Ledger.acquire(true))
+      return 0;
+    uint64_t Needed = 0;
+    if (!exactRead(State->Ledger.Value, &Needed, sizeof(Needed),
+                   offsetof(Header, PressureBytes)))
+      return failure("invalid pressure record");
+    if (Needed) {
+      uint64_t Used = 0;
+      unsigned Entries = 0;
+      for (unsigned S = 0; S < State->Description.Slots; ++S) {
+        auto R = State->read(S);
+        if (!R)
+          return R.takeError();
+        if (R->Bytes > State->Description.Limit - Used)
+          return failure("invalid charged total");
+        Used += R->Bytes;
+        Entries += R->Type != Free;
+      }
+      Pressure = Needed > State->Description.Limit - Used ||
+                 Entries == State->Description.Slots;
+      if (!Pressure) {
+        Needed = 0;
+        if (!exactWrite(State->Ledger.Value, &Needed, sizeof(Needed),
+                        offsetof(Header, PressureBytes)))
+          return ioError();
+      }
+    }
+  }
+  unsigned Removed = 0;
+  for (unsigned N = 0; N < (std::min)(MaxSlots, 128u); ++N) {
+    unsigned S;
+    {
+      std::unique_lock<std::mutex> Guard(State->Mutex, std::try_to_lock);
+      if (!Guard.owns_lock())
+        return Removed;
+      S = State->Cursor++ % State->Description.Slots;
+    }
+    auto L = State->lease(S, true, true);
+    if (!L) {
+      llvm::consumeError(L.takeError());
+      continue;
+    }
+    FD Lease(*L);
+    Record R;
+    {
+      std::unique_lock<std::mutex> Guard(State->Mutex, std::try_to_lock);
+      if (!Guard.owns_lock())
+        continue;
+      Lock Ledger(State->Ledger.Value);
+      if (!Ledger.acquire(true))
+        continue;
+      auto Current = State->read(S);
+      if (!Current)
+        return Current.takeError();
+      R = *Current;
+    }
+    if (R.Type == Free || (R.Type == Stable && !Pressure) ||
+        !State->leaseMatches(S, Lease.Value, R))
+      continue;
+    llvm::LockFileManager Source(R.Source);
+    auto Locked = Source.tryLock();
+    if (!Locked) {
+      llvm::consumeError(Locked.takeError());
+      continue;
+    }
+    if (!*Locked)
+      continue;
+    // The lease excludes all writers/readers while IO proceeds outside both
+    // admission locks. Requests cannot queue behind worker retirement/removal.
+    auto Clean = State->clean(S, R);
+    if (!Clean) {
+      llvm::consumeError(Clean.takeError());
+      continue;
+    }
+    if (!*Clean)
+      continue;
+    {
+      std::lock_guard<std::mutex> Guard(State->Mutex);
+      Lock Ledger(State->Ledger.Value);
+      if (!Ledger.acquire())
+        return ioError();
+      R.Type = Free;
+      R.Bytes = 0;
+      if (auto E = State->write(S, R))
+        return std::move(E);
+    }
+    ++Removed;
+  }
+  return Removed;
+#endif
+}
+llvm::Error rejectUnleasedOwnedModuleInputs(const CompilerInvocation &CI,
+                                            PathRef WorkingDirectory) {
+  auto Check = [&](PathRef P) -> llvm::Error {
+    llvm::SmallString<256> Absolute(P), Canonical;
+    if (llvm::sys::path::is_relative(Absolute)) {
+      Absolute = WorkingDirectory;
+      llvm::sys::path::append(Absolute, P);
+    }
+    llvm::sys::path::remove_dots(Absolute, true);
+    (void)llvm::sys::fs::real_path(Absolute, Canonical);
+    for (PathRef Candidate : {PathRef(Absolute), PathRef(Canonical)})
+      for (auto I = llvm::sys::path::begin(Candidate),
+                E = llvm::sys::path::end(Candidate);
+           I != E; ++I)
+        if (*I == ".owned-payload-v1")
+          return failure(
+              "explicit prebuilt module input has no owned generation lease");
+    return llvm::Error::success();
+  };
+  for (const auto &Entry : CI.getHeaderSearchOpts().PrebuiltModuleFiles)
+    if (auto E = Check(Entry.second))
+      return E;
+  for (const auto &P : CI.getHeaderSearchOpts().PrebuiltModulePaths)
+    if (auto E = Check(P))
+      return E;
+  // Unnamed -fmodule-file inputs are a separate frontend field.
+  for (const auto &P : CI.getFrontendOpts().ModuleFiles)
+    if (auto E = Check(P))
+      return E;
+  return llvm::Error::success();
+}
+} // namespace clang::clangd
