+char ModuleCachePressure::ID;
+void ModuleCachePressure::log(llvm::raw_ostream &OS) const {
+  OS << "owned module cache: payload or generation admission exhausted";
+}
+std::error_code ModuleCachePressure::convertToErrorCode() const {
+  return llvm::inconvertibleErrorCode();
+}
+namespace {
+llvm::Error failure(StringRef Message) {
+  return llvm::createStringError("owned module cache: " + Message);
+}
+std::string path(PathRef Root, StringRef Name) {
+  llvm::SmallString<256> P(Root);
+  llvm::sys::path::append(P, Name);
+  return P.str().str();
+}
+#ifdef __linux__
+// The format is local to one target ABI. Exact header/layout validation rejects
+// a different ABI instead of reinterpreting its reservations. Fixed-size banks
+// bound all reads. No PID, timestamp or arbitrary recursive scan establishes
+// GC.
+// Same namespace, new explicit layout. A layout-1 ledger remains charged and
+// rejects new admission; opening another independent quota is not a migration.
+constexpr uint64_t Magic = 0x324548434143434dULL;
+constexpr unsigned MaximumSlots = 4096;
+enum Kind : uint64_t { Free, Reserved, Stable, Copy, Retired, Erased };
+struct Header {
+  uint64_t MagicValue = Magic, RecordSize = 0, Slots = 0, Limit = 0;
+  uint64_t PressureBytes = 0;
+};
+struct Record {
+  uint64_t Sequence = 0, Generation = 0, Bytes = 0, Type = Free;
+  uint64_t Device = 0, Inode = 0, LeaseDevice = 0, LeaseInode = 0;
+  uint64_t StableSlot = UINT64_MAX, StableGeneration = 0;
+  uint64_t OutputEnvelope = 0, CaptureEnvelope = 0;
+  uint64_t MainBytes = 0, BundleFiles = 0;
+  char MainPath[32] = "payload.pcm";
+  std::array<uint8_t, 32> BundleDigest{};
+  char Key[65] = {};
+  char Source[1024] = {};
+  uint64_t Checksum = 0;
+};
+uint64_t checksum(const Record &R) {
+  return llvm::xxh3_64bits(reinterpret_cast<const uint8_t *>(&R),
+                           offsetof(Record, Checksum));
+}
+bool valid(const Record &R) {
+  return R.Sequence && R.Checksum == checksum(R) && R.Type <= Erased &&
+         R.Key[64] == 0 && R.Source[1023] == 0 && R.MainPath[11] == 0 &&
+         StringRef(R.MainPath) == "payload.pcm";
+}
+llvm::Error ioError() {
+  return llvm::errorCodeToError(
+      std::error_code(errno, std::generic_category()));
+}
+bool exactRead(int FD, void *Data, size_t N, off_t At) {
+  auto *P = static_cast<char *>(Data);
+  while (N) {
+    ssize_t Got = pread(FD, P, N, At);
+    if (Got < 0 && errno == EINTR)
+      continue;
+    if (Got <= 0)
+      return false;
+    P += Got;
+    N -= Got;
+    At += Got;
+  }
+  return true;
+}
+bool exactWrite(int FD, const void *Data, size_t N, off_t At) {
+  auto *P = static_cast<const char *>(Data);
+  while (N) {
+    ssize_t Got = pwrite(FD, P, N, At);
+    if (Got < 0 && errno == EINTR)
+      continue;
+    if (Got <= 0)
+      return false;
+    P += Got;
+    N -= Got;
+    At += Got;
+  }
+  return true;
+}
+bool owned(int FD, bool Directory) {
+  struct stat S;
+  return !fstat(FD, &S) && S.st_uid == geteuid() &&
+         (Directory ? S_ISDIR(S.st_mode) : S_ISREG(S.st_mode)) &&
+         !(S.st_mode & 0077) && (Directory || S.st_nlink == 1);
+}
+class FD {
+public:
+  int Value = -1;
+  explicit FD(int V = -1) : Value(V) {}
+  FD(FD &&Other) : Value(Other.Value) { Other.Value = -1; }
+  FD(const FD &) = delete;
+  ~FD() {
+    if (Value >= 0)
+      close(Value);
+  }
+  int release() {
+    int V = Value;
+    Value = -1;
+    return V;
+  }
+};
+class Lock {
+  int Descriptor;
+
+public:
+  explicit Lock(int FD) : Descriptor(FD) {}
+  bool acquire(bool Try = false) {
+    int R;
+    do {
+      R = flock(Descriptor, LOCK_EX | (Try ? LOCK_NB : 0));
+    } while (R < 0 && errno == EINTR);
+    return R == 0;
+  }
+  ~Lock() { flock(Descriptor, LOCK_UN); }
+};
+std::string digest(StringRef Key) {
+  auto H = llvm::SHA256::hash(llvm::arrayRefFromStringRef(Key));
+  return llvm::toHex(llvm::ArrayRef<uint8_t>(H), true);
+}
+
+struct BundleNode {
+  std::string Relative;
+  bool Directory;
+  uint64_t Device, Inode;
+  std::shared_ptr<FD> Parent;
+};
+struct BundleInventory {
+  uint64_t Bytes = 0, MainBytes = 0, CacheFiles = 0;
+  std::array<uint8_t, 32> Digest{};
+  std::vector<BundleNode> Nodes;
+};
+
+// Inspect only this leased, same-user generation. These bounds match the
+// supervisor's existing bounded unit cleanup, rather than admitting arbitrary
+// recursive trees. Directory cursors, names and inode identities are retained
+// for verified FD-relative deletion; no path alias or symlink is followed.
+llvm::Expected<BundleInventory> inventoryBundle(int Generation,
+                                                bool Retiring = false) {
+  BundleInventory Result;
+  llvm::SHA256 Hash;
+  auto Add = [&](StringRef Value) {
+    Hash.update(Value);
+    Hash.update(StringRef("\0", 1));
+  };
+  auto Marker = [](int Directory, StringRef Name, StringRef Expected) {
+    FD File(openat(Directory, Name.str().c_str(),
+                   O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+    struct stat S;
+    std::array<char, 64> Bytes{};
+    return File.Value >= 0 && !fstat(File.Value, &S) &&
+           uint64_t(S.st_size) == Expected.size() &&
+           Expected.size() <= Bytes.size() &&
+           exactRead(File.Value, Bytes.data(), Expected.size(), 0) &&
+           StringRef(Bytes.data(), Expected.size()) == Expected;
+  };
+  unsigned Units = 0;
+  std::function<llvm::Error(int, StringRef, unsigned)> Visit =
+      [&](int Directory, StringRef Relative, unsigned Depth) -> llvm::Error {
+    auto Parent = std::make_shared<FD>(fcntl(Directory, F_DUPFD_CLOEXEC, 0));
+    if (Parent->Value < 0)
+      return ioError();
+    if (!Retiring &&
+        ((Relative == "workers" &&
+          !Marker(Directory, "owned.root", "clangd-worker-root-v1\n")) ||
+         (Depth == 2 &&
+          !Marker(Directory, "bundle.unit", "clangd-worker-bundle-v1\n"))))
+      return failure("bundle ownership marker missing");
+    FD Cursor(openat(Directory, ".",
+                     O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    DIR *Stream = Cursor.Value < 0 ? nullptr : fdopendir(Cursor.release());
+    if (!Stream)
+      return ioError();
+    auto Close = llvm::scope_exit([&] { closedir(Stream); });
+    std::vector<std::string> Names;
+    errno = 0;
+    while (auto *Entry = readdir(Stream)) {
+      StringRef Name(Entry->d_name);
+      if (Name == "." || Name == "..")
+        continue;
+      if (Names.size() + Result.Nodes.size() >= 4608)
+        return failure("bundle inventory entry limit");
+      Names.push_back(Name.str());
+    }
+    if (errno)
+      return ioError();
+    llvm::sort(Names);
+    for (const auto &Name : Names) {
+      const std::string Child = Relative.empty() ? Name : path(Relative, Name);
+      if (Child.size() >= 1024 || Result.Nodes.size() >= 4608)
+        return failure("bundle inventory path/entry limit");
+      struct stat S;
+      if (fstatat(Directory, Name.c_str(), &S, AT_SYMLINK_NOFOLLOW))
+        return ioError();
+      if (S.st_uid != geteuid() ||
+          (!S_ISDIR(S.st_mode) && (!S_ISREG(S.st_mode) || S.st_nlink != 1)))
+        return failure("bundle contains foreign, aliased or nonregular output");
+      bool Metadata = false;
+      if (S_ISDIR(S.st_mode)) {
+        bool Known = false;
+        if (Relative.empty())
+          Known = Name == "workers";
+        else if (Relative == "workers") {
+          Known = StringRef(Name).starts_with("unit-") && ++Units == 1;
+        } else if (Depth == 2)
+          Known = Name == "module-cache";
+        else
+          Known = Relative.contains("/module-cache") && Depth < 6;
+        if (!Known)
+          return failure("unknown bundle directory");
+      } else if (Relative.empty()) {
+        Metadata = Name == "owned.generation";
+        if (!Metadata && Name != "payload.pcm" &&
+            !(Retiring && Name == "staged.pcm"))
+          return failure("unknown generation payload");
+        if (Name == "payload.pcm")
+          Result.MainBytes = S.st_size;
+      } else if (Relative == "workers") {
+        Metadata = Name == "owned.root" &&
+                   Marker(Directory, Name, "clangd-worker-root-v1\n");
+        if (!Metadata)
+          return failure("unknown bundle root marker");
+      } else if (Depth == 2) {
+        Metadata = Name == "bundle.unit" &&
+                   Marker(Directory, Name, "clangd-worker-bundle-v1\n");
+        if (!Metadata)
+          return failure("worker capture/startup payload remains");
+      } else {
+        if (!Relative.contains("/module-cache") ||
+            (llvm::sys::path::extension(Name) != ".pcm" &&
+             Name != "modules.idx" && Name != "modules.timestamp") ||
+            ++Result.CacheFiles > 128)
+          return failure("unknown or excessive implicit bundle output");
+      }
+      Result.Nodes.push_back({Child, bool(S_ISDIR(S.st_mode)),
+                              uint64_t(S.st_dev), uint64_t(S.st_ino), Parent});
+      Add(Child);
+      Add(std::to_string(S.st_mode));
+      Add(std::to_string(S.st_dev));
+      Add(std::to_string(S.st_ino));
+      Add(std::to_string(S.st_size));
+      Add(std::to_string(S.st_mtim.tv_sec));
+      Add(std::to_string(S.st_mtim.tv_nsec));
+      if (S_ISDIR(S.st_mode)) {
+        FD ChildFD(openat(Directory, Name.c_str(),
+                          O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+        struct stat Opened;
+        if (ChildFD.Value < 0 || fstat(ChildFD.Value, &Opened) ||
+            Opened.st_dev != S.st_dev || Opened.st_ino != S.st_ino)
+          return failure("bundle directory identity changed");
+        if (auto Error = Visit(ChildFD.Value, Child, Depth + 1))
+          return Error;
+      } else if (!Metadata) {
+        if (S.st_size < 0 || uint64_t(S.st_size) > UINT64_MAX - Result.Bytes)
+          return failure("bundle size overflow");
+        Result.Bytes += S.st_size;
+      }
+    }
+    return llvm::Error::success();
+  };
+  if (auto Error = Visit(Generation, {}, 0))
+    return std::move(Error);
+  Result.Digest = Hash.final();
+  return Result;
+}
+
+bool bundleNodeMatches(const BundleNode &Node) {
+  struct stat Named;
+  const auto Name = llvm::sys::path::filename(Node.Relative);
+  return !fstatat(Node.Parent->Value, Name.str().c_str(), &Named,
+                  AT_SYMLINK_NOFOLLOW) &&
+         uint64_t(Named.st_dev) == Node.Device &&
+         uint64_t(Named.st_ino) == Node.Inode &&
+         bool(S_ISDIR(Named.st_mode)) == Node.Directory &&
+         (Node.Directory || (S_ISREG(Named.st_mode) && Named.st_nlink == 1));
+}
+
+llvm::Error syncBundle(const BundleInventory &Bundle) {
+  for (const auto &Node : Bundle.Nodes) {
+    if (!bundleNodeMatches(Node))
+      return failure("bundle identity changed before durability");
+    const auto Name = llvm::sys::path::filename(Node.Relative);
+    FD File(openat(Node.Parent->Value, Name.str().c_str(),
+                   O_RDONLY | O_NOFOLLOW | O_CLOEXEC |
+                       (Node.Directory ? O_DIRECTORY : 0)));
+    struct stat Opened;
+    if (File.Value < 0 || fstat(File.Value, &Opened) ||
+        uint64_t(Opened.st_dev) != Node.Device ||
+        uint64_t(Opened.st_ino) != Node.Inode || fsync(File.Value))
+      return ioError();
+  }
+  return llvm::Error::success();
+}
+#endif
+} // namespace
+class ModuleBuildCache::Impl {
+public:
+  std::string Root;
+  std::mutex Mutex;
+  unsigned Cursor = 0;
+#ifdef __linux__
+  FD Directory, Ledger;
+  Header Description;
+  off_t offset(unsigned Slot, unsigned Bank) const {
+    return sizeof(Header) + (uint64_t(Slot) * 2 + Bank) * sizeof(Record);
+  }
+  bool ledgerMatches() const {
+    struct stat Opened, Named;
+    return !fstat(Ledger.Value, &Opened) &&
+           !fstatat(Directory.Value, "ledger-v1", &Named,
+                    AT_SYMLINK_NOFOLLOW) &&
+           S_ISREG(Named.st_mode) && Named.st_uid == geteuid() &&
+           Named.st_nlink == 1 && !(Named.st_mode & 0077) &&
+           Opened.st_dev == Named.st_dev && Opened.st_ino == Named.st_ino;
+  }
+  llvm::Expected<Record> read(unsigned Slot) {
+    if (!rootMatches() || !ledgerMatches())
+      return failure("namespace or ledger identity changed");
+    Record A{}, B{};
+    if (!exactRead(Ledger.Value, &A, sizeof(A), offset(Slot, 0)) ||
+        !exactRead(Ledger.Value, &B, sizeof(B), offset(Slot, 1)))
+      return failure("truncated ledger");
+    const bool VA = valid(A), VB = valid(B);
+    if (!VA && !VB)
+      return failure("ambiguous ledger record");
+    return VA && (!VB || A.Sequence >= B.Sequence) ? A : B;
+  }
+  llvm::Error write(unsigned Slot, Record R) {
+    if (++R.Sequence == 0)
+      return failure("record sequence exhausted");
+    R.Checksum = checksum(R);
+    // An acknowledged update is durable before any dependent payload write.
+    // A torn newer bank leaves the older, conservatively charged state intact.
+    if (!exactWrite(Ledger.Value, &R, sizeof(R),
+                    offset(Slot, R.Sequence & 1)) ||
+        fdatasync(Ledger.Value))
+      return ioError();
+    return llvm::Error::success();
+  }
+  std::string name(unsigned Slot, uint64_t Generation) const {
+    return "generation-" + std::to_string(Slot) + "-" +
+           std::to_string(Generation);
+  }
+  llvm::Expected<int> lease(unsigned Slot, bool Exclusive, bool Try,
+                            bool Create = false) {
+    std::string Name = "lease-" + std::to_string(Slot);
+    FD F(openat(Directory.Value, Name.c_str(),
+                O_RDWR | (Create ? O_CREAT : 0) | O_CLOEXEC | O_NOFOLLOW,
+                0600));
+    if (F.Value < 0)
+      return ioError();
+    if (!owned(F.Value, false))
+      return failure("unrecognized lease");
+    int R;
+    struct flock Range{};
+    Range.l_type = Exclusive ? F_WRLCK : F_RDLCK;
+    Range.l_whence = SEEK_SET;
+    do {
+      R = fcntl(F.Value, Try ? F_OFD_SETLK : F_OFD_SETLKW, &Range);
+    } while (R < 0 && errno == EINTR);
+    if (R)
+      return ioError();
+    return F.release();
+  }
+  bool leaseMatches(unsigned Slot, int FD, const Record &R) const {
+    struct stat Opened, Named;
+    const std::string Name = "lease-" + std::to_string(Slot);
+    return !fstat(FD, &Opened) &&
+           !fstatat(Directory.Value, Name.c_str(), &Named,
+                    AT_SYMLINK_NOFOLLOW) &&
+           S_ISREG(Named.st_mode) && Named.st_uid == geteuid() &&
+           Named.st_nlink == 1 && !(Named.st_mode & 0077) &&
+           Opened.st_dev == Named.st_dev && Opened.st_ino == Named.st_ino &&
+           (!R.LeaseInode || (uint64_t(Opened.st_dev) == R.LeaseDevice &&
+                              uint64_t(Opened.st_ino) == R.LeaseInode));
+  }
+  bool rootMatches() const {
+    struct stat Opened, Current;
+    return !fstat(Directory.Value, &Opened) && !lstat(Root.c_str(), &Current) &&
+           S_ISDIR(Current.st_mode) && Current.st_uid == geteuid() &&
+           !(Current.st_mode & 0077) && Opened.st_dev == Current.st_dev &&
+           Opened.st_ino == Current.st_ino;
+  }
+  std::string marker(unsigned Slot, const Record &R) const {
+    return "clangd-owned-generation-v2\n" + std::to_string(Slot) + "\n" +
+           std::to_string(R.Generation) + "\n" + std::to_string(R.LeaseDevice) +
+           "\n" + std::to_string(R.LeaseInode) + "\n";
+  }
+  llvm::Expected<int> generation(unsigned Slot, const Record &R) {
+    if (!rootMatches())
+      return failure("namespace identity changed");
+    FD F(openat(Directory.Value, name(Slot, R.Generation).c_str(),
+                O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (F.Value < 0)
+      return ioError();
+    struct stat S;
+    if (!owned(F.Value, true) || fstat(F.Value, &S) ||
+        uint64_t(S.st_dev) != R.Device || uint64_t(S.st_ino) != R.Inode)
+      return failure("generation identity changed");
+    FD Marker(
+        openat(F.Value, "owned.generation", O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+    const std::string Expected = marker(Slot, R);
+    struct stat M;
+    std::array<char, 128> Data{};
+    if (Marker.Value < 0 || !owned(Marker.Value, false) ||
+        fstat(Marker.Value, &M) || uint64_t(M.st_size) != Expected.size() ||
+        Expected.size() > Data.size() ||
+        !exactRead(Marker.Value, Data.data(), Expected.size(), 0) ||
+        StringRef(Data.data(), Expected.size()) != Expected)
+      return failure("unrecognized generation marker");
+    return F.release();
+  }
+  // Caller owns the slot's exclusive lease and the ledger lock. Deletion is
+  // restricted to known names. Unknown entries, symlinks and failed removals
+  // retain the full charge. Worker retirement uses BOTH existing worker leases.
+  llvm::Expected<bool> clean(unsigned Slot, Record &R) {
+    if (!R.Device || !R.Inode)
+      return false;
+    if (R.Type == Erased && rootMatches()) {
+      struct stat Missing;
+      if (fstatat(Directory.Value, name(Slot, R.Generation).c_str(), &Missing,
+                  AT_SYMLINK_NOFOLLOW) &&
+          errno == ENOENT) {
+        // Erased acknowledges removal AND an unlinked directory descriptor.
+        // Missing paths alone (which could be renamed) never release charges.
+        if (fsync(Directory.Value))
+          return false;
+        return true;
+      }
+    }
+    auto G = generation(Slot, R);
+    if (!G) {
+      llvm::consumeError(G.takeError());
+      return false;
+    }
+    FD Gen(*G);
+    std::optional<BundleInventory> RetainedBundle;
+    const std::string UnitRoot =
+        path(path(Root, name(Slot, R.Generation)), "workers");
+    struct stat W;
+    if (!fstatat(Gen.Value, "workers", &W, AT_SYMLINK_NOFOLLOW)) {
+      if (!S_ISDIR(W.st_mode) || W.st_uid != geteuid())
+        return false;
+      if (R.Type != Retired) {
+        ModuleBuildWorkerCollector Collector(UnitRoot);
+        auto Sweep = Collector.collect(32);
+        if (!Sweep) {
+          llvm::consumeError(Sweep.takeError());
+          return false;
+        }
+      }
+      // Live/incomplete/foreign units keep the generation charged. A
+      // completed retained bundle is inventoried through no-follow directory
+      // FDs before the generation can enter retirement.
+      FD WF(openat(Gen.Value, "workers",
+                   O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+      if (WF.Value < 0)
+        return false;
+      DIR *D = fdopendir(dup(WF.Value));
+      if (!D)
+        return ioError();
+      bool Empty = true;
+      unsigned Seen = 0;
+      while (auto *E = readdir(D)) {
+        StringRef N(E->d_name);
+        if (N == "." || N == "..")
+          continue;
+        if (++Seen > 1 || N != "owned.root") {
+          Empty = false;
+          break;
+        }
+      }
+      closedir(D);
+      if (!Empty) {
+        auto Bundle = inventoryBundle(Gen.Value, R.Type == Retired);
+        if (!Bundle) {
+          llvm::consumeError(Bundle.takeError());
+          return false;
+        }
+        if (R.Type == Stable &&
+            (Bundle->Bytes != R.Bytes || Bundle->MainBytes != R.MainBytes ||
+             Bundle->CacheFiles != R.BundleFiles ||
+             Bundle->Digest != R.BundleDigest))
+          return false;
+        RetainedBundle = std::move(*Bundle);
+      } else {
+        if ((unlinkat(WF.Value, "owned.root", 0) && errno != ENOENT) ||
+            unlinkat(Gen.Value, "workers", AT_REMOVEDIR))
+          return false;
+      }
+    } else if (errno != ENOENT)
+      return false;
+    DIR *D = fdopendir(dup(Gen.Value));
+    if (!D)
+      return ioError();
+    bool Known = true;
+    unsigned Seen = 0;
+    while (auto *E = readdir(D)) {
+      StringRef N(E->d_name);
+      if (N == "." || N == "..")
+        continue;
+      if (++Seen > 4 ||
+          (N != "payload.pcm" && N != "staged.pcm" &&
+           !(RetainedBundle && N == "workers") && N != "owned.generation")) {
+        Known = false;
+        break;
+      }
+      struct stat S;
+      if (RetainedBundle && N == "workers")
+        continue; // Every descendant was validated through no-follow FDs.
+      if (fstatat(Gen.Value, E->d_name, &S, AT_SYMLINK_NOFOLLOW) ||
+          !S_ISREG(S.st_mode) || S.st_uid != geteuid() || S.st_nlink != 1) {
+        Known = false;
+        break;
+      }
+    }
+    closedir(D);
+    if (!Known)
+      return false;
+    if (R.Type != Retired) {
+      std::lock_guard<std::mutex> Guard(Mutex);
+      Lock LedgerGuard(Ledger.Value);
+      if (!LedgerGuard.acquire())
+        return ioError();
+      R.Type = Retired;
+      if (auto Error = write(Slot, R))
+        return std::move(Error);
+      ++R.Sequence;
+    }
+    if (RetainedBundle) {
+      // Preflight all named identities before the first destructive operation.
+      // Open directory handles keep every unlink within the validated tree.
+      for (const auto &Node : RetainedBundle->Nodes)
+        if (!bundleNodeMatches(Node))
+          return false;
+      for (auto I = RetainedBundle->Nodes.rbegin(),
+                End = RetainedBundle->Nodes.rend();
+           I != End; ++I) {
+        if (I->Relative == "owned.generation")
+          continue;
+        if (!bundleNodeMatches(*I))
+          return false;
+        const auto Name = llvm::sys::path::filename(I->Relative);
+        if (unlinkat(I->Parent->Value, Name.str().c_str(),
+                     I->Directory ? AT_REMOVEDIR : 0))
+          return false;
+      }
+    }
+    for (const char *N : {"payload.pcm", "staged.pcm"})
+      if (unlinkat(Gen.Value, N, 0) && errno != ENOENT)
+        return false;
+    // Recheck the path immediately before removal. An externally replaced
+    // same-name directory is retained, never treated as our generation.
+    struct stat S;
+    const std::string Name = name(Slot, R.Generation);
+    if (fstatat(Directory.Value, Name.c_str(), &S, AT_SYMLINK_NOFOLLOW) ||
+        uint64_t(S.st_dev) != R.Device || uint64_t(S.st_ino) != R.Inode)
+      return false;
+    // Keep the version marker through every fallible payload deletion.
+    if (unlinkat(Gen.Value, "owned.generation", 0))
+      return false;
+    if (unlinkat(Directory.Value, Name.c_str(), AT_REMOVEDIR))
+      return false;
+    if (fsync(Directory.Value) || fstat(Gen.Value, &S) || S.st_nlink != 0)
+      return false;
+    {
+      std::lock_guard<std::mutex> Guard(Mutex);
+      Lock LedgerGuard(Ledger.Value);
+      if (!LedgerGuard.acquire())
+        return ioError();
+      R.Type = Erased;
+      if (auto Error = write(Slot, R))
+        return std::move(Error);
+      ++R.Sequence;
+    }
+    return true;
+  }
+#endif
+};
+class ModuleBuildCacheLease::Impl {
+public:
+  std::shared_ptr<ModuleBuildCache> Cache;
+  unsigned Slot = 0;
+#ifdef __linux__
+  FD Lease;
+  Record Description;
+  std::shared_ptr<ModuleBuildCacheLease> Companion;
+#endif
+};
+ModuleBuildCache::ModuleBuildCache(std::unique_ptr<Impl> I)
+    : State(std::move(I)) {}
+ModuleBuildCache::~ModuleBuildCache() = default;
+ModuleBuildCacheLease::ModuleBuildCacheLease(std::unique_ptr<Impl> I)
+    : State(std::move(I)) {}
+ModuleBuildCacheLease::~ModuleBuildCacheLease() {
+#ifdef __linux__
+  if (State->Description.Type == Stable)
+    return;
+  // A consuming worker owns an independent shared OFD lease. Its parent may
+  // disappear; failure to upgrade preserves the charge for later collection.
+  if (State->Description.Type == Copy) {
+    struct flock Range{};
+    Range.l_type = F_WRLCK;
+    Range.l_whence = SEEK_SET;
+    if (fcntl(State->Lease.Value, F_OFD_SETLK, &Range))
+      return;
+  }
+  auto &C = *State->Cache->State;
+  // The still-exclusive reservation protects cleanup; no request waits behind
+  // collector IO. Cleanup failure leaves the durable charge for maintenance.
+  Record R;
+  {
+    std::lock_guard<std::mutex> Guard(C.Mutex);
+    Lock Ledger(C.Ledger.Value);
+    if (!Ledger.acquire())
+      return;
+    auto Current = C.read(State->Slot);
+    if (!Current) {
+      llvm::consumeError(Current.takeError());
+      return;
+    }
+    R = *Current;
+    if (R.Generation != State->Description.Generation ||
+        !C.leaseMatches(State->Slot, State->Lease.Value, R))
+      return;
+  }
+  auto Clean = C.clean(State->Slot, R);
+  if (!Clean) {
+    llvm::consumeError(Clean.takeError());
+    return;
+  }
+  if (*Clean) {
+    std::lock_guard<std::mutex> Guard(C.Mutex);
+    Lock Ledger(C.Ledger.Value);
+    if (!Ledger.acquire())
+      return;
+    R.Type = Free;
+    R.Bytes = 0;
+    llvm::consumeError(C.write(State->Slot, R));
+  }
+#endif
+}
+std::string ModuleBuildCacheLease::payload() const {
+#ifdef __linux__
+  return path(path(State->Cache->root(),
+                   State->Cache->State->name(State->Slot,
+                                             State->Description.Generation)),
+              State->Description.MainPath);
+#else
+  return {};
+#endif
+}
+std::string ModuleBuildCacheLease::workers() const {
+  return path(llvm::sys::path::parent_path(payload()), "workers");
+}
