+namespace clang {
+class CompilerInvocation;
+namespace clangd {
+class ModuleBuildCache;
+// Only temporary capacity pressure is retryable. Corruption, changed identity
+// and I/O errors never become a request to wait or bypass admission.
+class ModuleCachePressure : public llvm::ErrorInfo<ModuleCachePressure> {
+public:
+  static char ID;
+  void log(llvm::raw_ostream &OS) const override;
+  std::error_code convertToErrorCode() const override;
+};
+// An immutable generation's kernel lease. Keeping this object alive protects
+// both its payload and its persistent charge. Reserved/copy generations clean
+// up on final release; stable generations remain eligible for bounded GC.
+class ModuleBuildCacheLease {
+public:
+  ~ModuleBuildCacheLease();
+  std::string payload() const;
+  std::string workers() const;
+  // Published main-copy size versus the entire retained generation's logical
+  // payload charge (including implicit modules and indexes).
+  uint64_t mainBytes() const;
+  uint64_t payloadBytes() const;
+  llvm::Error publish();
+
+private:
+  friend class ModuleBuildCache;
+  class Impl;
+  explicit ModuleBuildCacheLease(std::unique_ptr<Impl>);
+  std::unique_ptr<Impl> State;
+};
+// Linux-only, version-marked fixed-slot namespace. Limits bound logical payload
+// reservations and generation count, not physical allocation, metadata or RSS.
+// Each record has two checksummed durable banks; ambiguous identity or cleanup
+// preserves its reservation. No legacy/prebuilt paths are enrolled or removed.
+class ModuleBuildCache : public std::enable_shared_from_this<ModuleBuildCache> {
+public:
+  static llvm::Expected<std::shared_ptr<ModuleBuildCache>>
+  open(PathRef Root, uint64_t PayloadBytes, unsigned Slots);
+  ~ModuleBuildCache();
+  llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+  reserve(llvm::StringRef Key, PathRef SourceAnchor, uint64_t Bytes,
+          uint64_t OutputEnvelope = 0, uint64_t CaptureEnvelope = 0);
+  // Deadline includes admission waiting; callers must give the worker only
+  // its remaining time. Cross-process publication is polled outside all locks.
+  llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+  reserveUntil(llvm::StringRef Key, PathRef SourceAnchor, uint64_t Bytes,
+               uint64_t OutputEnvelope, uint64_t CaptureEnvelope,
+               std::chrono::steady_clock::time_point Deadline,
+               const std::function<bool()> &Cancelled);
+  llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+  lookup(llvm::StringRef Key, std::function<bool(PathRef)> Usable = {});
+  llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+  copy(const std::shared_ptr<ModuleBuildCacheLease> &Stable);
+  // Child-side bootstrap: take its own leases before consuming any managed
+  // prerequisite. Foreign paths return a null lease and remain untouched.
+  static llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+  acquireInput(PathRef Payload);
+  static llvm::Error validateWorker(PathRef Unit, uint64_t OutputLimit);
+
+private:
+  llvm::Expected<std::shared_ptr<ModuleBuildCacheLease>>
+  acquireGeneration(unsigned Slot, uint64_t Generation,
+                    bool StableOnly = false);
+
+public:
+  llvm::Expected<unsigned> collect(unsigned MaxSlots = 32);
+  llvm::StringRef root() const;
+
+private:
+  friend class ModuleBuildCacheLease;
+  class Impl;
+  explicit ModuleBuildCache(std::unique_ptr<Impl>);
+  std::unique_ptr<Impl> State;
+};
+// Compile-command references into the reserved owned namespace are not leased.
+// Reject them before parent AST/preamble compilation; internally supplied
+// prerequisite paths are injected only after this compile-command check.
+llvm::Error rejectUnleasedOwnedModuleInputs(const CompilerInvocation &,
+                                            PathRef WorkingDirectory);
+} // namespace clangd
+} // namespace clang
