+TEST_F(PrerequisiteModulesTests, UnsavedImportUsesExactRequestBuffer) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("M.cppm", "export module M;\nexport int draft_value = 1;\n");
+  CDB.addFile("Use.cpp", "int disk_value;\n");
+  ModulesBuilder Builder(CDB);
+  const auto Use = getFullPath("Use.cpp");
+  const std::string Draft = "import M;\nint probe() { return draft_value; }\n";
+
+  EXPECT_TRUE(Builder.hasBuildableRequiredModules(Use, FS, Draft));
+  auto WithImport = Builder.buildPrerequisiteModulesFor(Use, FS, Draft);
+  ASSERT_TRUE(WithImport);
+  HeaderSearchOptions WithImportOptions(TestDir);
+  WithImport->adjustHeaderSearchOptions(WithImportOptions);
+  EXPECT_EQ(WithImportOptions.PrebuiltModuleFiles.count("M"), 1u);
+
+  // The second request has no import, with the same on-disk file and CDB.
+  // A disk-only preamble-safety verdict or scanner sees the wrong generation.
+  const std::string NoImport = "int request_value;\n";
+  MockFS RequestFS;
+  RequestFS.OverlayRealFileSystemForModules = true;
+  RequestFS.Files[Use] = Draft;
+  auto FromRequestFS = Builder.buildPrerequisiteModulesFor(Use, RequestFS);
+  ASSERT_TRUE(FromRequestFS);
+  HeaderSearchOptions RequestOptions(TestDir);
+  FromRequestFS->adjustHeaderSearchOptions(RequestOptions);
+  EXPECT_EQ(RequestOptions.PrebuiltModuleFiles.count("M"), 1u);
+  // Explicit main contents also take precedence over a different global draft.
+  EXPECT_FALSE(Builder.hasBuildableRequiredModules(Use, RequestFS, NoImport));
+  EXPECT_FALSE(Builder.hasBuildableRequiredModules(Use, FS, NoImport));
+  auto WithoutImport = Builder.buildPrerequisiteModulesFor(Use, FS, NoImport);
+  ASSERT_TRUE(WithoutImport);
+  HeaderSearchOptions WithoutImportOptions(TestDir);
+  WithoutImport->adjustHeaderSearchOptions(WithoutImportOptions);
+  EXPECT_TRUE(WithoutImportOptions.PrebuiltModuleFiles.empty());
+  auto Disk = FS.view(TestDir)->getBufferForFile(Use);
+  ASSERT_TRUE(Disk);
+  EXPECT_EQ((*Disk)->getBuffer(), "int disk_value;\n");
+}
