+// The request's main buffer takes precedence over both disk and the global
+// DraftStore. Views remain independent, as required by ThreadsafeFS; workers
+// share immutable text, never a mutable FileSystem object.
+class RequestModuleFS : public ThreadsafeFS {
+public:
+  RequestModuleFS(const ThreadsafeFS &Base, PathRef MainFile,
+                  llvm::StringRef Contents)
+      : Base(Base), MainFile(MainFile), Contents(Contents) {}
+
+private:
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const override {
+    auto Overlay = llvm::makeIntrusiveRefCnt<llvm::vfs::OverlayFileSystem>(
+        Base.view(std::nullopt));
+    auto Main = llvm::makeIntrusiveRefCnt<llvm::vfs::InMemoryFileSystem>();
+    // DependencyScanningService keeps borrowed VFS buffers across worker
+    // views. Back this buffer with the request-owned string, whose lifetime
+    // covers every scanner, rather than a copy owned by this temporary view.
+    Main->addFile(MainFile, 0,
+                  llvm::MemoryBuffer::getMemBuffer(Contents, MainFile));
+    Overlay->pushOverlay(std::move(Main));
+    return Overlay;
+  }
+  const ThreadsafeFS &Base;
+  const std::string MainFile;
+  const std::string Contents;
+};
