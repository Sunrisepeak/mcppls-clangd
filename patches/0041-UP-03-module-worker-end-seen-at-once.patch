From 63d19773a1ed6f3ac972ddd9469e17d96118f131 Mon Sep 17 00:00:00 2001
From: sunrisepeak <speakshen@163.com>
Date: Mon, 2 Nov 2026 09:18:48 +0900
Subject: [PATCH] [clangd] A module worker's end is seen when it happens, not
 at the next poll

A worker's owner monitor slept ten milliseconds between its looks at the
owner, and the worker joined it on the way out, so each worker ended up to
ten milliseconds after its work was done. The monitor now waits on a
condition the worker signals as it ends. The parent looked at a running
worker every ten milliseconds as well; it now looks every millisecond for the
first fifty and every ten thereafter, since most workers end within a few
tens of milliseconds and the module waits for the parent to see it.

Measured on the warm-prime workspace (304 units, 176 modules, one worker
each, Linux x64): the median worker took 9 ms instead of 20 ms, the first
session was ready in 3.4 s instead of 4.9 s, and used 6.0 s of processor time
instead of 6.8 s.
---
 .../clangd/ModuleBuildWorker.cpp              | 23 ++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/clang-tools-extra/clangd/ModuleBuildWorker.cpp b/clang-tools-extra/clangd/ModuleBuildWorker.cpp
index 25f537bc1..eff4a6b04 100644
--- a/clang-tools-extra/clangd/ModuleBuildWorker.cpp
+++ b/clang-tools-extra/clangd/ModuleBuildWorker.cpp
@@ -27,6 +27,8 @@
 #include <atomic>
 #include <cstdlib>
 #include <limits>
+#include <condition_variable>
+#include <mutex>
 #include <thread>
 #ifdef _WIN32
 #include <windows.h>
@@ -268,13 +270,22 @@ public:
                             errno != EWOULDBLOCK && errno != EINTR))
           std::_Exit(1);
 #endif
-        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        // Woken at once when the worker is done, which then does not wait
+        // for the next look at its owner to end.
+        std::unique_lock<std::mutex> Lock(Self->Mutex);
+        Self->Wake.wait_for(Lock, std::chrono::milliseconds(10), [Self] {
+          return Self->Stopped.load(std::memory_order_relaxed);
+        });
       }
     });
     return std::move(Monitor);
   }
   ~WorkerOwnerMonitor() {
-    Stopped.store(true, std::memory_order_relaxed);
+    {
+      std::lock_guard<std::mutex> Lock(Mutex);
+      Stopped.store(true, std::memory_order_relaxed);
+    }
+    Wake.notify_all();
     if (Thread.joinable())
       Thread.join();
 #ifdef _WIN32
@@ -289,6 +300,8 @@ public:
 private:
   WorkerOwnerMonitor() = default;
   std::atomic<bool> Stopped{false};
+  std::mutex Mutex;
+  std::condition_variable Wake;
   std::thread Thread;
 #ifdef _WIN32
   HANDLE Handle = nullptr;
@@ -674,6 +687,9 @@ buildModuleInWorker(const CompilerInvocation &Invocation,
   // Declared after Cleanup: destruction always terminates/reaps before files
   // and any caller-owned source locks/prerequisite leases can be released.
   WorkerProcess Child(Process);
+  // Most workers end within a few tens of milliseconds, and the module waits
+  // for this to see it: looked at every millisecond at first, then every ten.
+  unsigned Looks = 0;
   for (;;) {
     if (auto Err = (*Diagnostics)->drain())
       return std::move(Err);
@@ -702,7 +718,8 @@ buildModuleInWorker(const CompilerInvocation &Invocation,
                         (*Diagnostics)->text())
               .str());
     }
-    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    std::this_thread::sleep_for(
+        std::chrono::milliseconds(++Looks <= 50 ? 1 : 10));
   }
   if (Cancelled() || std::chrono::steady_clock::now() >= Deadline)
     return llvm::createStringError(
-- 
