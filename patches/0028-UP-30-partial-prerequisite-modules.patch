+// One module that does not compile left an importer with no modules at
+// all, not even std. The others are built and used; the failed one and what
+// imports it are left out, and tried again once the failed source changes.
+TEST_F(PrerequisiteModulesTests, OneFailedModuleLeavesTheOthers) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("good.cppm", "export module good;\nexport int answer() { return 42; }\n");
+  CDB.addFile("bad.cppm", "export module bad;\nexport int broken() { return nope; }\n");
+  CDB.addFile("user.cppm", "export module user;\nimport bad;\nexport int use() { return broken(); }\n");
+  CDB.addFile("main.cpp", "import good;\nimport bad;\nimport user;\nint main() { return answer(); }\n");
+  ModulesBuilder Builder(CDB);
+
+  auto Modules = Builder.buildPrerequisiteModulesFor(getFullPath("main.cpp"), FS);
+  ASSERT_TRUE(Modules);
+  HeaderSearchOptions HSOpts;
+  Modules->adjustHeaderSearchOptions(HSOpts);
+  EXPECT_TRUE(HSOpts.PrebuiltModuleFiles.count("good"));
+  EXPECT_FALSE(HSOpts.PrebuiltModuleFiles.count("bad"));
+  EXPECT_FALSE(HSOpts.PrebuiltModuleFiles.count("user"));
+
+  auto Invocation = buildCompilerInvocation(getInputs("main.cpp", CDB), DiagConsumer);
+  EXPECT_TRUE(Modules->canReuse(*Invocation, FS.view(TestDir)))
+      << "not retried while the failed source is as it was";
+
+  // Fixed: the set is built again, and now has all three.
+  CDB.addFile("bad.cppm", "export module bad;\nexport int broken() { return 1; }\n");
+  EXPECT_FALSE(Modules->canReuse(*Invocation, FS.view(TestDir)));
+  auto Fixed = Builder.buildPrerequisiteModulesFor(getFullPath("main.cpp"), FS);
+  HeaderSearchOptions FixedOpts;
+  Fixed->adjustHeaderSearchOptions(FixedOpts);
+  EXPECT_TRUE(FixedOpts.PrebuiltModuleFiles.count("good"));
+  EXPECT_TRUE(FixedOpts.PrebuiltModuleFiles.count("bad"));
+  EXPECT_TRUE(FixedOpts.PrebuiltModuleFiles.count("user"));
+}
