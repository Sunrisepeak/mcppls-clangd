+  /// A module this set could not get: the file is served by the others, and
+  /// the set is not reused once the source that failed changes (an edit that
+  /// fixes it is tried; one that does not is not retried at every request).
+  struct FailedModule {
+    std::string Name;
+    std::string Source;   // the unit that did not compile
+    std::optional<std::pair<uint64_t, int64_t>> Stamp;   // its size, mtime
+    std::string Reason;
+  };
+  void addFailedModule(FailedModule Failure) {
+    FailedNames.insert(Failure.Name);
+    Failed.push_back(std::move(Failure));
+  }
+  bool hasFailedModule(llvm::StringRef Name) const {
+    return FailedNames.contains(Name);
+  }
+  const FailedModule *failureOf(llvm::StringRef Name) const {
+    for (const auto &F : Failed)
+      if (F.Name == Name)
+        return &F;
+    return nullptr;
+  }
+  llvm::ArrayRef<FailedModule> failedModules() const { return Failed; }
+  static std::optional<std::pair<uint64_t, int64_t>>
+  stampOf(llvm::vfs::FileSystem &VFS, llvm::StringRef Path) {
+    auto Status = VFS.status(Path);
+    if (!Status)
+      return std::nullopt;
+    return std::make_pair(Status->getSize(),
+                          static_cast<int64_t>(
+                              Status->getLastModificationTime()
+                                  .time_since_epoch()
+                                  .count()));
+  }
+
 private:
+  llvm::SmallVector<FailedModule, 2> Failed;
+  llvm::StringSet<> FailedNames;
   llvm::SmallVector<std::shared_ptr<const ModuleFile>, 8> RequiredModules;
   // A helper class to speedup the query if a module is built.
