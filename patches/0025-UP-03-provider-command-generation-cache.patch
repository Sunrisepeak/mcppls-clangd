+TEST(GlobalCompilationDatabaseTest, ProviderIndexFollowsDatabaseGeneration) {
+  MockFS FS;
+  DirectoryBasedGlobalCompilationDatabase::Options Opts(FS);
+  Opts.RevalidateAfter = std::chrono::seconds(0);
+  DirectoryBasedGlobalCompilationDatabase DB(Opts);
+  auto Publish = [&](llvm::StringRef Name) {
+    FS.Files[testPath("compile_commands.json")] = llvm::formatv(
+        R"cdb([
+          {{"directory":"{0}","file":"{0}/M.cppm",
+            "arguments":["clang","--precompile","-o","{0}/M.pcm"]},
+          {{"directory":"{0}","file":"{0}/Use.cpp",
+            "arguments":["clang","-fmodule-file={1}={0}/M.pcm"]}
+        ])cdb",
+        llvm::sys::path::convert_to_slash(testRoot()), Name);
+    ASSERT_TRUE(DB.getCompileCommand(testPath("Use.cpp")));
+  };
+  Publish("M");
+  auto Old = DB.getProjectModules(testPath("Use.cpp"));
+  ASSERT_TRUE(Old);
+  EXPECT_EQ(Old->getModuleNameState("M"),
+            ProjectModules::ModuleNameState::Unique);
+  Publish("Changed");
+  auto New = DB.getProjectModules(testPath("Use.cpp"));
+  ASSERT_TRUE(New);
+  EXPECT_EQ(New->getModuleNameState("Changed"),
+            ProjectModules::ModuleNameState::Unique);
+  EXPECT_EQ(Old->getModuleNameState("M"),
+            ProjectModules::ModuleNameState::Unique);
+}
