+  Adjusted->setCommandMangler([PCM](tooling::CompileCommand &Cmd, PathRef) {
+    for (auto &Arg : Cmd.CommandLine)
+      if (Arg == "-fmodule-file=M=" + PCM)
+        Arg = "-fmodule-file=Configured=" + PCM;
+  });
+  EXPECT_EQ(Adjusted->getModuleNameState("Configured"),
+            ProjectModules::ModuleNameState::Unique);
