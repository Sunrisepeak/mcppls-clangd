+class ProjectModulesCommandCache {
+public:
+  explicit ProjectModulesCommandCache(
+      std::shared_ptr<const tooling::CompilationDatabase> CDB)
+      : CDB(std::move(CDB)) {}
+
+  bool belongsTo(
+      const std::shared_ptr<const tooling::CompilationDatabase> &DB) const {
+    return CDB == DB;
+  }
+
+  std::shared_ptr<const std::vector<ProviderCommand>> getInventory() {
+    std::lock_guard<std::mutex> Lock(Mu);
+    if (!Inventory) {
+      auto Result = std::make_shared<std::vector<ProviderCommand>>();
+      for (const auto &File : CDB->getAllFiles()) {
+        auto Commands = CDB->getCompileCommands(File);
+        Result->push_back({File, Commands.empty() ? std::nullopt
+                                                  : std::optional(std::move(
+                                                        Commands.front()))});
+      }
+      vlog("Module provider inventory: {0} files", Result->size());
+      Inventory = std::move(Result);
+    }
+    return Inventory;
+  }
+
+  std::shared_ptr<const ProviderIndex>
+  getIndex(std::vector<ProviderCommand> Commands, const ThreadsafeFS &TFS);
+
+private:
+  std::shared_ptr<const tooling::CompilationDatabase> CDB;
+  std::mutex Mu;
+  std::shared_ptr<const std::vector<ProviderCommand>> Inventory;
+  std::vector<ProviderCommand> IndexedCommands;
+  std::shared_ptr<const ProviderIndex> Index;
+};
+
+std::shared_ptr<ProjectModulesCommandCache> createProjectModulesCommandCache(
+    std::shared_ptr<const tooling::CompilationDatabase> CDB) {
+  return std::make_shared<ProjectModulesCommandCache>(std::move(CDB));
+}
