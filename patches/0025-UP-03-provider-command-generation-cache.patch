+TEST_F(PrerequisiteModulesTests, ProviderResponseContentsAreNotMemoized) {
+  class Commands : public tooling::CompilationDatabase {
+  public:
+    std::vector<tooling::CompileCommand> Entries;
+    std::vector<std::string> getAllFiles() const override {
+      std::vector<std::string> Files;
+      for (const auto &Entry : Entries)
+        Files.push_back(Entry.Filename);
+      return Files;
+    }
+    std::vector<tooling::CompileCommand>
+    getCompileCommands(llvm::StringRef File) const override {
+      for (const auto &Entry : Entries)
+        if (Entry.Filename == File)
+          return {Entry};
+      return {};
+    }
+  };
+  auto CDB = std::make_shared<Commands>();
+  auto PCM = (TestDir + "/M.pcm").str();
+  auto RSP = (TestDir + "/modules.rsp").str();
