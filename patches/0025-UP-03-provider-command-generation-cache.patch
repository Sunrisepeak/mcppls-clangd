+      TestDir.str(), (TestDir + "/M.cppm").str(),
+      std::vector<std::string>{"clang", "--precompile", "-o", PCM}, "");
+  CDB->Entries.emplace_back(TestDir.str(), (TestDir + "/Use.cpp").str(),
+                            std::vector<std::string>{"clang", "@" + RSP}, "");
+  auto Cache = createProjectModulesCommandCache(CDB);
