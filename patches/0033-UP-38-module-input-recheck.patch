diff --git a/clang-tools-extra/clangd/ModuleInputSources.h b/clang-tools-extra/clangd/ModuleInputSources.h
index df7e4927b..4f6a72ece 100644
--- a/clang-tools-extra/clangd/ModuleInputSources.h
+++ b/clang-tools-extra/clangd/ModuleInputSources.h
@@ -30,6 +30,13 @@
 //   root at all when the project lies within it (a driver in /usr/bin and a
 //   project in /usr/src). A wrong guess costs a check, never a missed change.
 //
+// A client that reports the changes of the files it watches can ask for a
+// recheck interval (--module-input-recheck): a check that found the inputs of
+// a scan or a verdict as they were then holds for that long, until a change is
+// reported (a saved document, a watched file). A change the client does not
+// see is found at the next check after the interval, as clang's own
+// once-per-build-session module validation finds it at the next session.
+//
 //===----------------------------------------------------------------------===//
 
 #ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEINPUTSOURCES_H
@@ -45,6 +52,7 @@
 #include "llvm/Support/SHA256.h"
 #include <array>
 #include <atomic>
+#include <chrono>
 #include <cstdint>
 #include <memory>
 #include <mutex>
@@ -61,9 +69,10 @@ struct ModuleInputCounters {
   uint64_t Package = 0;       // of a package version whose markers held
   uint64_t System = 0;        // under a system root already checked
   uint64_t PackageChecks = 0; // package versions checked by their markers
+  uint64_t Recent = 0;        // scans and verdicts whose last check still holds
   ModuleInputCounters operator-(const ModuleInputCounters &O) const {
     return {Project - O.Project, Package - O.Package, System - O.System,
-            PackageChecks - O.PackageChecks};
+            PackageChecks - O.PackageChecks, Recent - O.Recent};
   }
 };
 inline ModuleInputCounters &moduleInputCounters() {
@@ -247,6 +256,20 @@ public:
       systemPaths().insert(Path);
   }
 
+  /// --module-input-recheck: how long a check that found a scan's or a
+  /// verdict's inputs as they were holds while no change is reported; zero
+  /// (the default) checks them every time.
+  static void setRecheckInterval(std::chrono::milliseconds Interval) {
+    recheckMillis().store(Interval.count());
+  }
+  static std::chrono::milliseconds recheckInterval() {
+    return std::chrono::milliseconds(recheckMillis().load());
+  }
+  /// A file may have changed on disk (a saved document, a watched file): the
+  /// checks made before are not taken as holding any more.
+  static void noteInputsChanged() { ++inputEpoch(); }
+  static uint64_t currentInputEpoch() { return inputEpoch().load(); }
+
   /// `Path` made absolute against `WorkingDirectory`, with `/` separators,
   /// no `.` or `..`, and lower case where the filesystem ignores it.
   static std::string normalized(llvm::StringRef Path,
@@ -293,6 +316,46 @@ private:
     static llvm::StringSet<> Paths;
     return Paths;
   }
+  static std::atomic<int64_t> &recheckMillis() {
+    static std::atomic<int64_t> Millis{0};
+    return Millis;
+  }
+  static std::atomic<uint64_t> &inputEpoch() {
+    static std::atomic<uint64_t> Epoch{0};
+    return Epoch;
+  }
+};
+
+/// When a check of one scan's or verdict's inputs last found them as they
+/// were. Copies share it: they describe the same inputs.
+class RecentInputCheck {
+public:
+  /// The last check still holds: it is within the recheck interval, and no
+  /// change was reported since the check began (`Epoch` is now's).
+  bool holds(uint64_t Epoch) const {
+    const auto Interval = ModuleInputSources::recheckInterval();
+    if (Interval.count() <= 0 || State->Epoch.load() != Epoch)
+      return false;
+    const int64_t Now = nowMillis();
+    return Now - State->At.load() < Interval.count();
+  }
+  /// A check that began at `Epoch` found every input as it was.
+  void held(uint64_t Epoch) const {
+    State->At.store(nowMillis());
+    State->Epoch.store(Epoch);
+  }
+
+private:
+  static int64_t nowMillis() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  }
+  struct Shared {
+    std::atomic<uint64_t> Epoch{~uint64_t(0)};
+    std::atomic<int64_t> At{0};
+  };
+  std::shared_ptr<Shared> State = std::make_shared<Shared>();
 };
 
 } // namespace clang::clangd
