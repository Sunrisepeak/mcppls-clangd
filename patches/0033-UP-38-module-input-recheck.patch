diff --git a/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp b/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
index 1a53cfe2d..bc94baae3 100644
--- a/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
+++ b/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
@@ -4488,6 +4488,74 @@ TEST_F(PrerequisiteModulesTests, ValidationVerdictsCheckPackagesByTheirMarkers)
   EXPECT_FALSE(Cache.isFresh(BMI, "chain", *RealFS));
 }
 
+TEST_F(PrerequisiteModulesTests, ValidationVerdictsHoldWithinTheRecheckInterval) {
+  writeTestFile(TestDir, "own.h", "int own;\n");
+  writeTestFile(TestDir, "M.pcm", "bmi\n");
+  const std::string Own = getFullPath("own.h");
+  const std::string BMI = getFullPath("M.pcm");
+  auto RealFS = llvm::vfs::getRealFileSystem();
+  auto Reset = llvm::make_scope_exit([] {
+    ModuleInputSources::setRecheckInterval(std::chrono::milliseconds(0));
+  });
+  // Without an interval, a project input is checked every time.
+  {
+    ModuleValidationCache Cache;
+    Cache.markFresh(BMI, "chain", {{Own, *ModuleValidationCache::identityOf(Own)}});
+    EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+    writeTestFile(TestDir, "own.h", "int own_changed;\n");
+    EXPECT_FALSE(Cache.isFresh(BMI, "chain", *RealFS));
+  }
+  ModuleInputSources::setRecheckInterval(std::chrono::seconds(60));
+  ModuleValidationCache Cache;
+  Cache.markFresh(BMI, "chain", {{Own, *ModuleValidationCache::identityOf(Own)}});
+  // The first lookup checks the inputs; the next ones, within the interval
+  // and with no change reported, take that check as holding.
+  EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+  writeTestFile(TestDir, "own.h", "int own_changed_again;\n");
+  const auto Before = moduleInputCounters();
+  EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+  EXPECT_EQ((moduleInputCounters() - Before).Recent, 1u);
+  EXPECT_EQ((moduleInputCounters() - Before).Project, 0u);
+  // A reported change: the inputs are checked again, and the change found.
+  ModuleInputSources::noteInputsChanged();
+  EXPECT_FALSE(Cache.isFresh(BMI, "chain", *RealFS));
+  // The BMI itself is checked every time.
+  Cache.markFresh(BMI, "chain", {{Own, *ModuleValidationCache::identityOf(Own)}});
+  EXPECT_TRUE(Cache.isFresh(BMI, "chain", *RealFS));
+  writeTestFile(TestDir, "M.pcm", "rebuilt bmi\n");
+  EXPECT_FALSE(Cache.isFresh(BMI, "chain", *RealFS));
+}
+
+TEST_F(PrerequisiteModulesTests, ScansHoldWithinTheRecheckInterval) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission covers this host's test commands only";
+  writeTestFile(TestDir, "include/dep.h", "import M;\n");
+  ModuleInputSources::setRecheckInterval(std::chrono::seconds(60));
+  auto Reset = llvm::make_scope_exit([] {
+    ModuleInputSources::setRecheckInterval(std::chrono::milliseconds(0));
+  });
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include \"dep.h\"\n", {"-I" + getFullPath("include")});
+  auto Generation = CDB.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  auto Scan = [&] {
+    WithContextValue Once(ModuleScanReplayEpoch, nextModuleScanReplayEpoch());
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    return Modules->getRequiredModules(getFullPath("Use.cpp"));
+  };
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  // Replayed once as it was: within the interval, with no change reported,
+  // the project's header is not replayed again.
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  writeTestFile(TestDir, "include/dep.h", "import N;\n");
+  const auto Before = moduleInputCounters();
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  EXPECT_GT((moduleInputCounters() - Before).Recent, 0u);
+  // The change reported (a saved document, a watched file): replayed, found.
+  ModuleInputSources::noteInputsChanged();
+  EXPECT_THAT(Scan(), testing::ElementsAre("N"));
+}
+
 TEST_F(PrerequisiteModulesTests, MemosKeptForTheNextSession) {
   if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
     GTEST_SKIP() << "scan memo admission covers this host's test commands only";
