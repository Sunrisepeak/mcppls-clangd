new file mode 100644
index 0000000..c6b3201
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleBuildWorkerOutput.h
@@ -0,0 +1,36 @@
+//===--- ModuleBuildWorkerOutput.h - bounded worker outputs -------*- C++
