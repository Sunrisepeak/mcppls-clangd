+TEST_F(PrerequisiteModulesTests, ModuleWorkerPreservesCapturedInputs) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("M.cppm", "#error disk main must not be read\n");
+  CDB.addFile("header.h", "#error disk header must not be read\n");
+  CDB.addFile("header.snapshot", "inline constexpr int Captured = 42;\n");
+  CDB.addFile("main.snapshot", R"cpp(module;
+#include "header.h"
+export module M;
+static_assert(Captured == 42);
+export int value() { return Captured; }
+)cpp");
+  CDB.addFile("staged.pcm", "");
+  llvm::vfs::YAMLVFSWriter Writer;
+  Writer.setUseExternalNames(false);
+  Writer.addFileMapping(getFullPath("header.h"),
+                        getFullPath("header.snapshot"));
+  std::string YAML;
+  llvm::raw_string_ostream OS(YAML);
+  Writer.write(OS);
+  CDB.addFile("snapshot.yaml", YAML);
+
+  auto Invocation =
+      buildCompilerInvocation(getInputs("M.cppm", CDB), DiagConsumer);
+  ASSERT_TRUE(Invocation);
+  Invocation->getFrontendOpts().OutputFile = getFullPath("staged.pcm");
+  ModuleBuildWorkerInputs Inputs;
+  auto Unsupported = serializeModuleBuildWorkerRequest(*Invocation, Inputs);
+  ASSERT_FALSE(static_cast<bool>(Unsupported));
+  EXPECT_THAT(llvm::toString(Unsupported.takeError()),
+              testing::HasSubstr("captured request filesystem"));
+  Inputs.FileSystem =
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays;
+  Inputs.WorkingDirectory = TestDir.str().str();
+  Inputs.MainFile = getFullPath("M.cppm");
+  Inputs.MainContentsFile = getFullPath("main.snapshot");
+  Inputs.OverlayFiles = {getFullPath("snapshot.yaml")};
+  auto Request = serializeModuleBuildWorkerRequest(*Invocation, Inputs);
+  ASSERT_TRUE(static_cast<bool>(Request))
+      << llvm::toString(Request.takeError());
+  CDB.addFile("request.json", *Request);
+  auto Err = runModuleBuildWorker(getFullPath("request.json"), "invalid");
+  EXPECT_THAT(llvm::toString(std::move(Err)),
+              testing::HasSubstr("invalid module worker owner token"));
+  Err = runModuleBuildWorker(getFullPath("request.json"));
+  EXPECT_FALSE(static_cast<bool>(Err)) << llvm::toString(std::move(Err));
+  EXPECT_TRUE(llvm::sys::fs::exists(Invocation->getFrontendOpts().OutputFile));
+  // A command directory that does not exist yet (a build tree before its first
+  // build) is reported, not fatal, as for an in-process build.
+  ModuleBuildWorkerInputs Unbuilt = Inputs;
+  Unbuilt.WorkingDirectory = getFullPath("not-built-yet");
+  auto UnbuiltRequest = serializeModuleBuildWorkerRequest(*Invocation, Unbuilt);
+  ASSERT_TRUE(static_cast<bool>(UnbuiltRequest))
+      << llvm::toString(UnbuiltRequest.takeError());
+  CDB.addFile("request.json", *UnbuiltRequest);
+  Err = runModuleBuildWorker(getFullPath("request.json"));
+  EXPECT_FALSE(static_cast<bool>(Err)) << llvm::toString(std::move(Err));
+  // Legal relative cc1 inputs keep their spelling and resolve against the
+  // captured working directory, rather than the supervisor's current directory.
+  CompilerInvocation Relative(*Invocation);
+  const auto Kind = Relative.getFrontendOpts().Inputs[0].getKind();
+  Relative.getFrontendOpts().Inputs[0] = FrontendInputFile("M.cppm", Kind);
+  auto RelativeRequest = serializeModuleBuildWorkerRequest(Relative, Inputs);
+  ASSERT_TRUE(static_cast<bool>(RelativeRequest))
+      << llvm::toString(RelativeRequest.takeError());
+  CDB.addFile("request.json", *RelativeRequest);
+  Err = runModuleBuildWorker(getFullPath("request.json"));
+  EXPECT_FALSE(static_cast<bool>(Err)) << llvm::toString(std::move(Err));
+  EXPECT_TRUE(llvm::sys::fs::exists(Invocation->getFrontendOpts().OutputFile));
+  Relative.getFrontendOpts().Inputs[0] = FrontendInputFile("Other.cppm", Kind);
+  auto Mismatch = serializeModuleBuildWorkerRequest(Relative, Inputs);
+  ASSERT_FALSE(static_cast<bool>(Mismatch));
+  EXPECT_THAT(llvm::toString(Mismatch.takeError()),
+              testing::HasSubstr("exactly its captured main file"));
+  // A failed attempt must not leave the earlier output looking successful.
+  CDB.addFile("main.snapshot", "#error captured failure\n");
+  Err = runModuleBuildWorker(getFullPath("request.json"));
+  ASSERT_TRUE(static_cast<bool>(Err));
+  llvm::consumeError(std::move(Err));
+  EXPECT_FALSE(llvm::sys::fs::exists(Invocation->getFrontendOpts().OutputFile));
+}
