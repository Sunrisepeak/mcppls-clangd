+  DiagnosticsEngine Diags(new DiagnosticIDs(), DiagOpts, &Consumer, false);
+  const char *Args[] = {"-std=c++20", "-x", "c++",
+                        Main.c_str(), "-o", Output.c_str()};
+  ASSERT_TRUE(CompilerInvocation::CreateFromArgs(CI, Args, Diags));
+  RealThreadsafeFS Real;
+  ModuleBuildWorkerOptions Options;
+  Options.Isolation = ModuleBuildWorkerOptions::Policy::Required;
+  Options.Executable = "/nonexistent-worker-must-not-launch";
+  Options.UnitRoot = (TestDir + "/workers").str();
+  Options.CaptureLimitBytes = 16;
+  auto Result = buildModuleInWorker(
+      CI, "export module M; export int value = 42;", Real, TestDir, Options);
+  ASSERT_FALSE(bool(Result));
+  EXPECT_THAT(llvm::toString(Result.takeError()),
+              testing::HasSubstr("capture payload"));
+  // Request/captured payloads and the staged output were never written.
+  std::error_code EC;
+  for (llvm::sys::fs::recursive_directory_iterator I(TestDir, EC), E;
+       I != E && !EC; I.increment(EC)) {
+    EXPECT_FALSE(StringRef(I->path()).ends_with("main.snapshot"));
+    EXPECT_FALSE(StringRef(I->path()).ends_with("filesystem.yaml"));
+    EXPECT_FALSE(StringRef(I->path()).ends_with("request.json"));
+    EXPECT_FALSE(StringRef(I->path()).ends_with(".pcm"));
+  }
+  EXPECT_FALSE(EC);
+  Options.Isolation = ModuleBuildWorkerOptions::Policy::InProcess;
+  Result = buildModuleInWorker(CI, "", Real, TestDir, Options);
+  ASSERT_FALSE(bool(Result));
+  EXPECT_THAT(llvm::toString(Result.takeError()),
+              testing::HasSubstr("forbids"));
+  CI.getFrontendOpts().DumpMinimizationHintsPath = (TestDir + "/unowned").str();
+  auto Invalid = validateBoundedModuleBuildOutputs(CI);
+  ASSERT_TRUE(bool(Invalid));
+  EXPECT_THAT(llvm::toString(std::move(Invalid)),
+              testing::HasSubstr("side output"));
+  CI.getFrontendOpts().DumpMinimizationHintsPath.clear();
+  CI.getFrontendOpts().ActionName = "unsupported-plugin";
+  Invalid = validateBoundedModuleBuildOutputs(CI);
+  ASSERT_TRUE(bool(Invalid));
+  EXPECT_THAT(llvm::toString(std::move(Invalid)),
+              testing::HasSubstr("PluginAction"));
+}
