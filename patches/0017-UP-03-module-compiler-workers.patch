+TEST_F(PrerequisiteModulesTests, ModuleWorkerCollectionRequiresBothOwnersGone) {
+  const std::string Root = (TestDir + "/owned-workers").str();
+  auto Parent = ModuleBuildWorkerUnit::create(
+      (TestDir + "/staged.pcm").str(), Root);
+  ASSERT_TRUE(static_cast<bool>(Parent));
+  auto Write = [&](StringRef Path, StringRef Text) {
+    std::error_code EC;
+    llvm::raw_fd_ostream Out(Path, EC);
+    ASSERT_FALSE(EC);
+    Out << Text;
+  };
+  auto Fixture = [&](StringRef Name, bool Marked) {
+    std::string Directory = (Root + "/" + Name).str();
+    EXPECT_FALSE(llvm::sys::fs::create_directories(Directory));
+    Write(Directory + "/parent.lease", "");
+    Write(Directory + "/worker.lease", "");
+    if (Marked)
+      Write(Directory + "/owned.unit", "clangd-worker-unit-v1\n");
+    Write(Directory + "/output.pcm", "owned partial output");
+    return Directory;
+  };
+  const std::string Orphan = Fixture("orphan", true);
+  const std::string Worker = Fixture("worker-only", true);
+  auto WorkerLease = ModuleBuildWorkerLease::acquire(Worker, true);
+  ASSERT_TRUE(static_cast<bool>(WorkerLease));
+  const std::string Legacy = Fixture("legacy", false);
+  const std::string Retired = Fixture("retired", true);
+  ASSERT_FALSE(llvm::sys::fs::rename(Retired + "/owned.unit",
+                                      Retired + "/retired.unit"));
+  auto LateWorker = ModuleBuildWorkerLease::acquire(Retired, true);
+  ASSERT_FALSE(static_cast<bool>(LateWorker));
+  EXPECT_THAT(llvm::toString(LateWorker.takeError()),
+              testing::HasSubstr("retired before startup"));
+  Write(Retired + "/request.json", "invalid request must not be read");
+  EXPECT_THAT(llvm::toString(runModuleBuildWorker(Retired + "/request.json")),
+              testing::HasSubstr("retired before startup"));
+
+  // A lexical alias must not bypass same-process lease ownership: merely
+  // opening/closing a second POSIX descriptor can release the owner's lock.
+  ModuleBuildWorkerCollector Collector(Root + "/../owned-workers");
+  auto Swept = Collector.collect();
+  ASSERT_TRUE(static_cast<bool>(Swept));
+  EXPECT_EQ(Swept->Removed, 2u);
+  EXPECT_FALSE(llvm::sys::fs::exists(Orphan));
+  EXPECT_FALSE(llvm::sys::fs::exists(Retired));
+  EXPECT_TRUE(llvm::sys::fs::exists((*Parent)->directory()));
+  EXPECT_TRUE(llvm::sys::fs::exists(Worker + "/output.pcm"));
+  EXPECT_TRUE(llvm::sys::fs::exists(Legacy + "/output.pcm"));
+  auto Throttled = Collector.collect();
+  ASSERT_TRUE(static_cast<bool>(Throttled));
+  EXPECT_TRUE(Throttled->Deferred);
+  EXPECT_EQ(Throttled->Examined, 0u);
+  ModuleBuildWorkerCollector SmallBatch(Root);
+  auto Limited = SmallBatch.collect(2);
+  ASSERT_TRUE(static_cast<bool>(Limited));
+  EXPECT_LE(Limited->Examined, 2u);
+}
