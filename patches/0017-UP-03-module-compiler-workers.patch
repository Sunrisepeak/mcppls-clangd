+namespace clang::clangd {
+
+// Empty configured roots default to a versioned root beside the caller's
+// staged output, keeping final rename on the same filesystem.
+std::string defaultModuleBuildWorkerRoot(PathRef StagedOutput);
+
+class ModuleBuildWorkerLease {
+public:
+  static llvm::Expected<std::unique_ptr<ModuleBuildWorkerLease>>
+  acquire(PathRef Unit, bool Worker);
+  ~ModuleBuildWorkerLease();
+
+private:
+  ModuleBuildWorkerLease(PathRef Unit, llvm::StringRef OwnershipKey);
+  std::string Unit;
+  std::string OwnershipKey;
+  int FD = -1;
+};
+
+class ModuleBuildWorkerUnit {
+public:
+  static llvm::Expected<std::unique_ptr<ModuleBuildWorkerUnit>>
+  create(PathRef StagedOutput, PathRef ConfiguredRoot = {});
+  ~ModuleBuildWorkerUnit();
+  std::string file(llvm::StringRef Name) const;
+  const std::string &directory() const { return Directory; }
+
+private:
+  ModuleBuildWorkerUnit() = default;
+  std::string Directory;
+  std::unique_ptr<ModuleBuildWorkerLease> ParentLease;
+};
+
+struct ModuleBuildWorkerSweepResult {
+  unsigned Examined = 0;
+  unsigned Removed = 0;
+  bool Deferred = false;
+};
+
+// Maintenance-only: never called by buildModuleInWorker. One collector owns
+// its directory cursor and a 30s cadence. Calls do not wait for another sweep
+// or any lease. Each call examines at most min(MaxEntries, 128) root entries.
+// Unit removal can perform filesystem I/O, so call from a maintenance thread.
+class ModuleBuildWorkerCollector {
+public:
+  explicit ModuleBuildWorkerCollector(PathRef Root);
+  ~ModuleBuildWorkerCollector();
+  llvm::Expected<ModuleBuildWorkerSweepResult>
+  collect(unsigned MaxEntries = 32);
+
+private:
+  class Impl;
+  std::unique_ptr<Impl> State;
+};
+} // namespace clang::clangd
+#endif
