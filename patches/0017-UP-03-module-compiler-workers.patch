+++ b/clang-tools-extra/clangd/ModuleBuildWorkerStorage.cpp
@@ -0,0 +1,319 @@
+//===--- ModuleBuildWorkerStorage.cpp - compiler worker ownership ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#include "ModuleBuildWorkerStorage.h"
+#include "llvm/ADT/ScopeExit.h"
+#include "llvm/ADT/StringMap.h"
+#include "llvm/ADT/StringSet.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/Process.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <chrono>
+#include <mutex>
+#ifndef _WIN32
+#include <cerrno>
+#include <unistd.h>
+#endif
+
+namespace clang::clangd {
+using llvm::StringRef;
+namespace {
+constexpr llvm::StringLiteral RootMarker = "clangd-worker-root-v1\n";
+constexpr llvm::StringLiteral UnitMarker = "clangd-worker-unit-v1\n";
+std::mutex ActiveUnitsMutex;
+// POSIX record locks do not exclude another thread in the same process, and
+// closing its second descriptor could release the first descriptor's lock.
+llvm::StringMap<unsigned> ActiveUnits;
+llvm::StringSet<> CollectingUnits;
+
+llvm::Expected<std::string> ownershipKey(PathRef Unit) {
+  llvm::sys::fs::UniqueID ID;
+  if (auto EC = llvm::sys::fs::getUniqueID(Unit, ID))
+    return llvm::errorCodeToError(EC);
+  // Physical directory identity also covers case aliases on filesystems
+  // where real_path() can preserve the caller's component spelling.
+  return std::to_string(ID.getDevice()) + ":" + std::to_string(ID.getFile());
+}
+
+std::string unitPath(PathRef Unit, StringRef Name) {
+  llvm::SmallString<256> Path(Unit);
+  llvm::sys::path::append(Path, Name);
+  return Path.str().str();
+}
+bool hasMarker(PathRef Path, StringRef Marker) {
+  uint64_t Size = 0;
+  if (llvm::sys::fs::file_size(Path, Size) || Size != Marker.size())
+    return false;
+  auto Contents = llvm::MemoryBuffer::getFile(Path);
+  return Contents && (*Contents)->getBuffer() == Marker;
+}
+llvm::Error writeMarker(PathRef Path, StringRef Marker) {
+  std::error_code EC;
+  llvm::raw_fd_ostream Out(Path, EC);
+  if (EC)
+    return llvm::errorCodeToError(EC);
+  Out << Marker;
+  Out.flush();
+  if (Out.has_error()) {
+    EC = Out.error();
+    Out.clear_error();
+    return llvm::errorCodeToError(EC);
+  }
+  return llvm::Error::success();
+}
+std::error_code removeOwnerPipe(PathRef Unit) {
+  const std::string Path = unitPath(Unit, "owner.pipe");
+#ifdef _WIN32
+  return llvm::sys::fs::remove(Path);
+#else
+  // LLVM's remove()/remove_directories() intentionally skip FIFO files.
+  if (unlink(Path.c_str()) && errno != ENOENT)
+    return std::error_code(errno, std::generic_category());
+  return {};
+#endif
+}
+llvm::Error prepareRoot(PathRef Root) {
+  if (!llvm::sys::path::is_absolute(Root) || Root.contains('\0'))
+    return llvm::createStringError("worker unit root must be absolute");
+  if (auto EC = llvm::sys::fs::create_directories(Root))
+    return llvm::errorCodeToError(EC);
+  const std::string MarkerPath = unitPath(Root, "owned.root");
+  if (!llvm::sys::fs::exists(MarkerPath)) {
+    int FD = -1;
+    llvm::SmallString<256> Temporary;
+    if (auto EC = llvm::sys::fs::createUniqueFile(
+            unitPath(Root, "root-marker-%%%%%%"), FD, Temporary))
+      return llvm::errorCodeToError(EC);
+    auto Cleanup = llvm::scope_exit([&] { llvm::sys::fs::remove(Temporary); });
+    llvm::raw_fd_ostream Out(FD, true);
+    Out << RootMarker;
+    Out.flush();
+    if (Out.has_error()) {
+      auto EC = Out.error();
+      Out.clear_error();
+      return llvm::errorCodeToError(EC);
+    }
+    // Publish complete contents without replacing another root marker.
+    if (auto EC = llvm::sys::fs::create_hard_link(Temporary, MarkerPath))
+      if (EC != std::errc::file_exists)
+        return llvm::errorCodeToError(EC);
+  }
+  if (!hasMarker(MarkerPath, RootMarker))
+    return llvm::createStringError("unrecognized worker unit root");
+  return llvm::Error::success();
+}
+} // namespace
+
+std::string defaultModuleBuildWorkerRoot(PathRef Output) {
+  return unitPath(llvm::sys::path::parent_path(Output),
+                  ".clangd-module-workers-v1");
+}
+
+ModuleBuildWorkerLease::ModuleBuildWorkerLease(PathRef Unit, StringRef Key)
+    : Unit(Unit), OwnershipKey(Key) {
+  // acquire() owns ActiveUnitsMutex until this registration is complete.
+  ++ActiveUnits[OwnershipKey];
+}
+ModuleBuildWorkerLease::~ModuleBuildWorkerLease() {
+  if (FD >= 0) {
+    llvm::sys::fs::unlockFile(FD);
+    llvm::sys::Process::SafelyCloseFileDescriptor(FD);
+  }
+  std::lock_guard<std::mutex> Guard(ActiveUnitsMutex);
+  auto I = ActiveUnits.find(OwnershipKey);
+  if (--I->second == 0)
+    ActiveUnits.erase(I);
+}
+llvm::Expected<std::unique_ptr<ModuleBuildWorkerLease>>
+ModuleBuildWorkerLease::acquire(PathRef Unit, bool Worker) {
+  llvm::SmallString<256> Canonical;
+  if (auto EC = llvm::sys::fs::real_path(Unit, Canonical))
+    return llvm::errorCodeToError(EC);
+  Unit = Canonical;
+  auto Key = ownershipKey(Unit);
+  if (!Key)
+    return Key.takeError();
+  std::unique_ptr<ModuleBuildWorkerLease> Lease;
+  {
+    std::lock_guard<std::mutex> Guard(ActiveUnitsMutex);
+    if (CollectingUnits.contains(*Key))
+      return llvm::createStringError("worker unit is being collected");
+    Lease.reset(new ModuleBuildWorkerLease(Unit, *Key));
+  }
+  if (auto EC = llvm::sys::fs::openFileForReadWrite(
+          unitPath(Unit, Worker ? "worker.lease" : "parent.lease"), Lease->FD,
+          Worker ? llvm::sys::fs::CD_OpenExisting : llvm::sys::fs::CD_CreateNew,
+          llvm::sys::fs::OF_None))
+    return llvm::errorCodeToError(EC);
+  if (auto EC = llvm::sys::fs::tryLockFile(Lease->FD))
+    return llvm::errorCodeToError(EC);
+  // Check after acquiring, not before: a collector retires this marker while
+  // owning both leases, then closes handles to permit Windows deletion.
+  if (Worker && !hasMarker(unitPath(Unit, "owned.unit"), UnitMarker))
+    return llvm::createStringError("worker unit was retired before startup");
+  return std::move(Lease);
+}
+
+llvm::Expected<std::unique_ptr<ModuleBuildWorkerUnit>>
+ModuleBuildWorkerUnit::create(PathRef Output, PathRef ConfiguredRoot) {
+  std::string Root = ConfiguredRoot.empty()
+                         ? defaultModuleBuildWorkerRoot(Output)
+                         : ConfiguredRoot.str();
+  if (auto Err = prepareRoot(Root))
+    return std::move(Err);
+  auto Unit = std::unique_ptr<ModuleBuildWorkerUnit>(new ModuleBuildWorkerUnit);
+  llvm::SmallString<256> Directory;
+  if (auto EC = llvm::sys::fs::createUniqueDirectory(unitPath(Root, "unit"),
+                                                     Directory))
+    return llvm::errorCodeToError(EC);
+  Unit->Directory = Directory.str().str();
+  auto Lease = ModuleBuildWorkerLease::acquire(Unit->Directory, false);
+  if (!Lease)
+    return Lease.takeError();
+  Unit->ParentLease = std::move(*Lease);
+  if (auto Err = writeMarker(Unit->file("worker.lease"), ""))
+    return std::move(Err);
+  // Only fully initialized, leased units advertise collector ownership.
+  if (auto Err = writeMarker(Unit->file("owned.unit"), UnitMarker))
+    return std::move(Err);
+  return std::move(Unit);
+}
+std::string ModuleBuildWorkerUnit::file(StringRef Name) const {
+  return unitPath(Directory, Name);
+}
+ModuleBuildWorkerUnit::~ModuleBuildWorkerUnit() {
+  if (Directory.empty())
+    return;
+  // Parent lease is still held while retiring the marker. Delayed child
+  // startup must not begin compilation after normal failure cleanup either.
+  llvm::sys::fs::remove(file("owned.unit"));
+  // Windows cannot unlink open lease files. The worker has been reaped by
+  // the caller before this object is destroyed.
+  ParentLease.reset();
+  removeOwnerPipe(Directory);
+  llvm::sys::fs::remove_directories(Directory);
+}
+
+class ModuleBuildWorkerCollector::Impl {
+public:
+  explicit Impl(PathRef Root) : Root(Root) {}
+  std::string Root;
+  std::mutex Mutex;
+  std::chrono::steady_clock::time_point NextSweep{};
+  llvm::sys::fs::directory_iterator Cursor;
+};
+ModuleBuildWorkerCollector::ModuleBuildWorkerCollector(PathRef Root)
+    : State(std::make_unique<Impl>(Root)) {}
+ModuleBuildWorkerCollector::~ModuleBuildWorkerCollector() = default;
+
+llvm::Expected<ModuleBuildWorkerSweepResult>
+ModuleBuildWorkerCollector::collect(unsigned MaxEntries) {
+  ModuleBuildWorkerSweepResult Result;
+  std::unique_lock<std::mutex> SweepGuard(State->Mutex, std::try_to_lock);
+  if (!SweepGuard.owns_lock() ||
+      std::chrono::steady_clock::now() < State->NextSweep) {
+    Result.Deferred = true;
+    return Result;
+  }
+  State->NextSweep =
+      std::chrono::steady_clock::now() + std::chrono::seconds(30);
+  if (!llvm::sys::path::is_absolute(State->Root) ||
+      StringRef(State->Root).contains('\0'))
+    return llvm::createStringError("worker collection root must be absolute");
+  if (!hasMarker(unitPath(State->Root, "owned.root"), RootMarker))
+    return llvm::createStringError("unrecognized worker collection root");
+  std::error_code EC;
+  const llvm::sys::fs::directory_iterator End;
+  if (State->Cursor == End)
+    State->Cursor = llvm::sys::fs::directory_iterator(State->Root, EC, false);
+  if (EC)
+    return llvm::errorCodeToError(EC);
+  const unsigned Limit = (std::min)(MaxEntries, 128u);
+  while (State->Cursor != End && Result.Examined < Limit) {
+    const auto Entry = *State->Cursor;
+    State->Cursor.increment(EC);
+    if (EC)
+      return llvm::errorCodeToError(EC);
+    ++Result.Examined;
+    llvm::SmallString<256> Canonical;
+    if (llvm::sys::fs::real_path(Entry.path(), Canonical))
+      continue;
+    const std::string Unit = Canonical.str().str();
+    auto Key = ownershipKey(Unit);
+    if (!Key) {
+      llvm::consumeError(Key.takeError());
+      continue;
+    }
+    const bool Retired = hasMarker(unitPath(Unit, "retired.unit"), UnitMarker);
+    if (Entry.type() != llvm::sys::fs::file_type::directory_file ||
+        (!Retired && !hasMarker(unitPath(Unit, "owned.unit"), UnitMarker)))
+      continue;
+    // Same-process ownership must be checked before opening either sidecar.
+    // Reserve collection under the mutex, then release before all filesystem
+    // I/O. Requests never wait behind a collector's opens/removals.
+    std::unique_lock<std::mutex> ActiveGuard(ActiveUnitsMutex,
+                                             std::try_to_lock);
+    if (!ActiveGuard.owns_lock() || ActiveUnits.contains(*Key) ||
+        CollectingUnits.contains(*Key))
+      continue;
+    CollectingUnits.insert(*Key);
+    ActiveGuard.unlock();
+    auto ReleaseCollection = llvm::scope_exit([&] {
+      std::lock_guard<std::mutex> Guard(ActiveUnitsMutex);
+      CollectingUnits.erase(*Key);
+    });
+    int ParentFD = -1, WorkerFD = -1;
+    auto Close = llvm::scope_exit([&] {
+      for (int FD : {ParentFD, WorkerFD})
+        if (FD >= 0) {
+          llvm::sys::fs::unlockFile(FD);
+          llvm::sys::Process::SafelyCloseFileDescriptor(FD);
+        }
+    });
+    if (llvm::sys::fs::openFileForReadWrite(
+            unitPath(Unit, "parent.lease"), ParentFD,
+            llvm::sys::fs::CD_OpenExisting, llvm::sys::fs::OF_None) ||
+        llvm::sys::fs::tryLockFile(ParentFD) ||
+        llvm::sys::fs::openFileForReadWrite(
+            unitPath(Unit, "worker.lease"), WorkerFD,
+            llvm::sys::fs::CD_OpenExisting, llvm::sys::fs::OF_None) ||
+        llvm::sys::fs::tryLockFile(WorkerFD))
+      continue;
+    // Retire under BOTH leases. A worker starting after we close them must
+    // fail its post-lock marker check, even before deletion has completed.
+    if (!Retired && llvm::sys::fs::rename(unitPath(Unit, "owned.unit"),
+                                          unitPath(Unit, "retired.unit")))
+      continue;
+    // Close before deletion on Windows. No startup can cross retired.unit.
+    Close.release();
+    for (int FD : {ParentFD, WorkerFD}) {
+      llvm::sys::fs::unlockFile(FD);
+      llvm::sys::Process::SafelyCloseFileDescriptor(FD);
+    }
+    if (removeOwnerPipe(Unit))
+      continue;
+    llvm::sys::fs::remove_directories(Unit);
+    if (!llvm::sys::fs::exists(Unit))
+      ++Result.Removed;
+    else {
+      // Keep failed removals eligible for a later sweep. The retired marker
+      // permanently forbids frontend startup, even if recursive deletion
+      // already removed one of the sidecars before encountering an IO error.
+      for (StringRef Name :
+           {StringRef("parent.lease"), StringRef("worker.lease")})
+        if (!llvm::sys::fs::exists(unitPath(Unit, Name)))
+          llvm::consumeError(writeMarker(unitPath(Unit, Name), ""));
+      llvm::consumeError(
+          writeMarker(unitPath(Unit, "retired.unit"), UnitMarker));
+    }
+  }
+  return Result;
+}
+} // namespace clang::clangd
