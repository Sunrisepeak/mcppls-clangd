+//===--- ModuleBuildWorker.cpp - isolated compiler protocol
+//----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#include "ModuleBuildWorker.h"
+#include "Compiler.h"
+#include "ModuleBuildMemoryBudget.h"
+#include "ModuleBuildWorkerOutput.h"
+#include "ModuleBuildWorkerStorage.h"
+#include "support/Logger.h"
+#include "clang/Frontend/FrontendActions.h"
+#include "clang/Frontend/TextDiagnosticPrinter.h"
+#include "clang/Lex/PreprocessorOptions.h"
+#include "llvm/ADT/ScopeExit.h"
+#include "llvm/ADT/StringMap.h"
+#include "llvm/Config/llvm-config.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/Process.h"
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <limits>
+#include <thread>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <cerrno>
+#include <csignal>
+#include <fcntl.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#endif
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/JSON.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+namespace clang::clangd {
+namespace {
+constexpr int ProtocolVersion = 1;
+// Version 1 workers ignore unknown resource fields. A bounded parent must not
+// launch one and mistake its successful response for enforcement.
+constexpr int BoundedProtocolVersion = 2;
+constexpr llvm::StringLiteral CapturedFileSystem =
+    "disk-with-captured-overlays";
+
+llvm::Error applyAddressSpaceLimit(uint64_t Bytes) {
+  if (!Bytes)
+    return llvm::Error::success();
+#if defined(RLIMIT_AS) && !defined(_WIN32)
+  struct rlimit Previous;
+  if (getrlimit(RLIMIT_AS, &Previous))
+    return llvm::errorCodeToError(
+        std::error_code(errno, std::generic_category()));
+  if (Bytes > (std::numeric_limits<rlim_t>::max)())
+    return llvm::createStringError("module worker address limit is too large");
+  const rlim_t Limit = (std::min)(static_cast<rlim_t>(Bytes), Previous.rlim_max);
+  struct rlimit Requested { Limit, Limit };
+  if (setrlimit(RLIMIT_AS, &Requested))
+    return llvm::errorCodeToError(
+        std::error_code(errno, std::generic_category()));
+  struct rlimit Actual;
+  if (getrlimit(RLIMIT_AS, &Actual))
+    return llvm::errorCodeToError(
+        std::error_code(errno, std::generic_category()));
+  if (Actual.rlim_cur != Limit || Actual.rlim_max != Limit)
+    return llvm::createStringError("module worker address limit did not apply");
+  // LLVM's ordinary allocation failure path may allocate while printing a
+  // stack, recursively exhaust this deliberately bounded process and hang.
+  // This internal worker cannot publish its staged output; the parent owns
+  // cleanup after this immediate, allocation-free failure exit.
+  llvm::install_bad_alloc_error_handler(
+      [](void *, const char *, bool) { std::_Exit(1); }, nullptr);
+  return llvm::Error::success();
+#else
+  return llvm::createStringError(
+      "module worker address-space limits are unsupported on this platform");
+#endif
+}
+
+llvm::Error validateInputs(const ModuleBuildWorkerInputs &Inputs) {
+  if (Inputs.FileSystem !=
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays)
+    return llvm::createStringError(
+        "module worker requires a captured request filesystem");
+  for (StringRef Path :
+       {StringRef(Inputs.WorkingDirectory), StringRef(Inputs.MainFile),
+        StringRef(Inputs.MainContentsFile)})
+    if (!llvm::sys::path::is_absolute(Path) || Path.contains('\0'))
+      return llvm::createStringError(
+          "module worker input paths must be absolute");
+  for (StringRef Path : Inputs.OverlayFiles)
+    if (!llvm::sys::path::is_absolute(Path) || Path.contains('\0'))
+      return llvm::createStringError(
+          "module worker overlay paths must be absolute");
+  return llvm::Error::success();
+}
+
+std::string capturedMainPath(PathRef File, PathRef WorkingDirectory) {
+  if (llvm::sys::path::is_absolute(File))
+    return File.str();
+  llvm::SmallString<256> Resolved(WorkingDirectory);
+  llvm::sys::path::append(Resolved, File);
+  // Preserve component spelling and symlink semantics. The invocation keeps
+  // its original relative input and the worker installs this working directory.
+  return Resolved.str().str();
+}
+
+llvm::Error validateInvocation(const CompilerInvocation &Invocation,
+                               const ModuleBuildWorkerInputs &Inputs) {
+  const auto &Frontend = Invocation.getFrontendOpts();
+  if (Frontend.Inputs.size() != 1 || !Frontend.Inputs[0].isFile() ||
+      capturedMainPath(Frontend.Inputs[0].getFile(), Inputs.WorkingDirectory) !=
+          Inputs.MainFile)
+    return llvm::createStringError(
+        "module worker requires exactly its captured main file");
+  if (!llvm::sys::path::is_absolute(Frontend.OutputFile) ||
+      StringRef(Frontend.OutputFile).contains('\0') ||
+      Frontend.OutputFile == Inputs.MainFile ||
+      Frontend.OutputFile == Inputs.MainContentsFile)
+    return llvm::createStringError(
+        "module worker requires a separate staged output path");
+  if (!Invocation.getPreprocessorOpts().RemappedFileBuffers.empty())
+    return llvm::createStringError(
+        "module worker cannot serialize remapped buffer pointers");
+  return llvm::Error::success();
+}
+
+// The child inherits only the read side on POSIX. Keeping another write side
+// in the child would hide owner death forever. Windows inherits a handle to
+// the actual parent process object, which remains the same object after PID
+// reuse. This object is not a replacement for the supervisor's kill/reap.
+class WorkerOwner {
+public:
+  static llvm::Expected<std::unique_ptr<WorkerOwner>> create(PathRef PipePath) {
+    auto Owner = std::unique_ptr<WorkerOwner>(new WorkerOwner);
+#ifdef _WIN32
+    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentProcess(),
+                         GetCurrentProcess(), &Owner->Handle, SYNCHRONIZE, TRUE,
+                         0))
+      return llvm::createStringError(
+          "failed creating module worker owner handle");
+#else
+    // Opening the writer with O_CLOEXEC is atomic. A pipe()+fcntl() pair
+    // would allow another concurrent spawn to inherit the writer in between
+    // and keep the worker alive after this parent dies.
+    if (mkfifo(PipePath.str().c_str(), 0600))
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+    Owner->PipePath = PipePath.str();
+    Owner->Pipe[0] =
+        open(PipePath.str().c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (Owner->Pipe[0] < 0)
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+    Owner->Pipe[1] =
+        open(PipePath.str().c_str(), O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    // The read end must reach the worker. Extra inherited readers are harmless
+    // because EOF is determined solely by the non-inherited parent writer.
+    if (Owner->Pipe[1] < 0 || fcntl(Owner->Pipe[0], F_SETFD, 0) < 0)
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+#endif
+    return std::move(Owner);
+  }
+  std::string token() const {
+#ifdef _WIN32
+    return std::to_string(reinterpret_cast<uintptr_t>(Handle));
+#else
+    return std::to_string(Pipe[0]);
+#endif
+  }
+  ~WorkerOwner() {
+#ifdef _WIN32
+    if (Handle)
+      CloseHandle(Handle);
+#else
+    for (int FD : Pipe)
+      if (FD >= 0)
+        close(FD);
+    if (!PipePath.empty())
+      unlink(PipePath.c_str()); // remove_directories() skips FIFO entries.
+#endif
+  }
+
+private:
+  WorkerOwner() = default;
+#ifdef _WIN32
+  HANDLE Handle = nullptr;
+#else
+  int Pipe[2] = {-1, -1};
+  std::string PipePath;
+#endif
+};
+
+class WorkerOwnerMonitor {
+public:
+  static llvm::Expected<std::unique_ptr<WorkerOwnerMonitor>>
+  create(StringRef Token) {
+    uint64_t Value = 0;
+    if (Token.getAsInteger(10, Value) || !Value)
+      return llvm::createStringError("invalid module worker owner token");
+    auto Monitor = std::unique_ptr<WorkerOwnerMonitor>(new WorkerOwnerMonitor);
+#ifdef _WIN32
+    if (Value > (std::numeric_limits<uintptr_t>::max)())
+      return llvm::createStringError("invalid module worker owner handle");
+    Monitor->Handle = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(Value));
+    DWORD Flags = 0;
+    if (!GetHandleInformation(Monitor->Handle, &Flags)) {
+      Monitor->Handle = nullptr;
+      return llvm::createStringError("missing inherited module worker owner");
+    }
+#else
+    if (Value <= 2 || Value > (std::numeric_limits<int>::max)())
+      return llvm::createStringError("invalid module worker owner descriptor");
+    int FD = static_cast<int>(Value);
+    int Flags = fcntl(FD, F_GETFL);
+    if (Flags < 0 || fcntl(FD, F_SETFL, Flags | O_NONBLOCK) < 0)
+      return llvm::createStringError("missing inherited module worker owner");
+    Monitor->FD = FD;
+#endif
+    auto *Self = Monitor.get();
+    Monitor->Thread = std::thread([Self] {
+      while (!Self->Stopped.load(std::memory_order_relaxed)) {
+#ifdef _WIN32
+        if (WaitForSingleObject(Self->Handle, 0) != WAIT_TIMEOUT)
+          std::_Exit(1);
+#else
+        char Byte;
+        ssize_t Result = read(Self->FD, &Byte, 1);
+        if (Result == 0 || (Result < 0 && errno != EAGAIN &&
+                            errno != EWOULDBLOCK && errno != EINTR))
+          std::_Exit(1);
+#endif
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      }
+    });
+    return std::move(Monitor);
+  }
+  ~WorkerOwnerMonitor() {
+    Stopped.store(true, std::memory_order_relaxed);
+    if (Thread.joinable())
+      Thread.join();
+#ifdef _WIN32
+    if (Handle)
+      CloseHandle(Handle);
+#else
+    if (FD >= 0)
+      close(FD);
+#endif
+  }
+
+private:
+  WorkerOwnerMonitor() = default;
+  std::atomic<bool> Stopped{false};
+  std::thread Thread;
+#ifdef _WIN32
+  HANDLE Handle = nullptr;
+#else
+  int FD = -1;
+#endif
+};
+// This deliberately avoids Program.cpp's process-global SIGALRM timeout.
+class WorkerProcess {
+public:
+  explicit WorkerProcess(llvm::sys::ProcessInfo Process) : Process(Process) {}
+  ~WorkerProcess() {
+    if (Active) {
+      terminate();
+      auto Reaped = reap(/*Blocking=*/true);
+      if (!Reaped)
+        llvm::consumeError(Reaped.takeError());
+    }
+  }
+  llvm::Expected<std::optional<int>> reap(bool Blocking) {
+#ifdef _WIN32
+    DWORD State = WaitForSingleObject(Process.Process, Blocking ? INFINITE : 0);
+    if (State == WAIT_TIMEOUT)
+      return std::optional<int>{};
+    if (State != WAIT_OBJECT_0)
+      return llvm::createStringError("failed waiting for module worker");
+    DWORD Code = 1;
+    if (!GetExitCodeProcess(Process.Process, &Code))
+      return llvm::createStringError(
+          "failed reading module worker exit status");
+    CloseHandle(Process.Process);
+    Active = false;
+    return std::optional<int>(static_cast<int>(Code));
+#else
+    int Status = 0;
+    struct rusage Usage;
+    pid_t Result;
+    do {
+      Result = wait4(Process.Pid, &Status, Blocking ? 0 : WNOHANG, &Usage);
+    } while (Result < 0 && errno == EINTR);
+    if (Result == 0)
+      return std::optional<int>{};
+    if (Result < 0) {
+      if (errno == ECHILD)
+        Active = false; // Never signal a PID already reaped elsewhere.
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+    }
+    Active = false;
+    llvm::sys::ProcessStatistics Stats;
+    auto Micros = [](const timeval &Time) {
+      return std::chrono::seconds(Time.tv_sec) +
+             std::chrono::microseconds(Time.tv_usec);
+    };
+    Stats.UserTime = Micros(Usage.ru_utime);
+    Stats.TotalTime = Stats.UserTime + Micros(Usage.ru_stime);
+#ifdef __APPLE__
+    Stats.PeakMemory = Usage.ru_maxrss / 1024;
+#else
+    Stats.PeakMemory = Usage.ru_maxrss;
+#endif
+    Statistics = Stats;
+    return std::optional<int>(WIFEXITED(Status) ? WEXITSTATUS(Status) : -1);
+#endif
+  }
+  void terminate() {
+#ifdef _WIN32
+    TerminateProcess(Process.Process, 1);
+#else
+    kill(Process.Pid, SIGKILL);
+#endif
+  }
+  std::optional<llvm::sys::ProcessStatistics> Statistics;
+
+private:
+  llvm::sys::ProcessInfo Process;
+  bool Active = true;
+};
+
+llvm::Error writeSnapshot(PathRef Path, StringRef Contents,
+                          std::optional<int64_t> MTime = std::nullopt) {
+  int FD = -1;
+  if (auto EC = llvm::sys::fs::openFileForWrite(Path, FD))
+    return llvm::errorCodeToError(EC);
+  llvm::raw_fd_ostream Out(FD, true);
+  Out << Contents;
+  Out.flush();
+  if (Out.has_error()) {
+    auto EC = Out.error();
+    Out.clear_error();
+    return llvm::errorCodeToError(EC);
+  }
+  if (MTime) {
+    llvm::sys::TimePoint<> Time{std::chrono::seconds(*MTime)};
+    if (auto EC = llvm::sys::fs::setLastAccessAndModificationTime(FD, Time))
+      return llvm::errorCodeToError(EC);
+  }
+  return llvm::Error::success();
+}
+
+#ifndef __linux__
+std::string workerDiagnostics(PathRef Path) {
+  // A diagnostic file cannot force an unbounded parent allocation.
+  uint64_t Size = 0;
+  if (llvm::sys::fs::file_size(Path, Size))
+    return {};
+  auto Text = llvm::MemoryBuffer::getFileSlice(
+      Path, (std::min<uint64_t>)(Size, 64 * 1024), 0);
+  return Text ? (*Text)->getBuffer().str() : std::string{};
+}
+
+#endif
+
+// A bounded read of a regular diagnostic file only bounds parent memory: the
+// child could fill the disk before returning. Linux redirects into an owned
+// FIFO instead. Polling drains a finite batch and retains a bounded prefix;
+// excess bytes are discarded, with pipe backpressure bounding queued output.
+// No diagnostic reader thread may outlive the owned child or block shutdown.
+class WorkerDiagnostics {
+public:
+  static llvm::Expected<std::unique_ptr<WorkerDiagnostics>>
+  create(PathRef Path) {
+    auto Result =
+        std::unique_ptr<WorkerDiagnostics>(new WorkerDiagnostics(Path));
+#ifdef __linux__
+    if (mkfifo(Result->Path.c_str(), 0600))
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+    Result->OwnsFIFO = true;
+    Result->FD = open(Result->Path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (Result->FD < 0)
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+    Result->Prefix.reserve(Limit);
+#endif
+    return Result;
+  }
+  ~WorkerDiagnostics() {
+#ifdef __linux__
+    if (FD >= 0)
+      close(FD);
+    if (OwnsFIFO)
+      unlink(Path.c_str());
+#endif
+  }
+  llvm::Error drain() {
+#ifdef __linux__
+    char Buffer[4096];
+    // Count even interrupted reads: noisy output and signals cannot postpone
+    // the next cancellation/deadline or specific-child reap check indefinitely.
+    for (unsigned I = 0; I < 16; ++I) {
+      ssize_t N = read(FD, Buffer, sizeof(Buffer));
+      if (N < 0) {
+        if (errno == EINTR)
+          continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+          break;
+        return llvm::errorCodeToError(
+            std::error_code(errno, std::generic_category()));
+      }
+      // EOF before the child opens its writer is harmless; after launch every
+      // poll checks again. We never wait for another writer or an inherited FD.
+      if (!N)
+        break;
+      size_t Keep = (std::min)(size_t(N), Limit - Prefix.size());
+      Prefix.append(Buffer, Keep);
+      Truncated |= Keep != size_t(N);
+    }
+#endif
+    return llvm::Error::success();
+  }
+  std::string text() const {
+#ifdef __linux__
+    return Prefix +
+           (Truncated ? "\n[module worker diagnostics truncated]\n" : "");
+#else
+    return workerDiagnostics(Path);
+#endif
+  }
+
+private:
+  explicit WorkerDiagnostics(PathRef Path) : Path(Path.str()) {}
+  const std::string Path;
+#ifdef __linux__
+  static constexpr size_t Limit = 64 * 1024;
+  int FD = -1;
+  bool OwnsFIFO = false, Truncated = false;
+  std::string Prefix;
+#endif
+};
+
+} // namespace
+
+llvm::Expected<std::string>
+serializeModuleBuildWorkerRequest(const CompilerInvocation &Invocation,
+                                  const ModuleBuildWorkerInputs &Inputs) {
+  if (auto Err = validateInputs(Inputs))
+    return std::move(Err);
+  if (auto Err = validateInvocation(Invocation, Inputs))
+    return std::move(Err);
+  if (Inputs.OutputLimitBytes >
+      static_cast<uint64_t>((std::numeric_limits<int64_t>::max)()))
+    return llvm::createStringError("module worker output limit is too large");
+  if (Inputs.OutputLimitBytes)
+    if (auto Error = validateBoundedModuleBuildOutputs(Invocation))
+      return std::move(Error);
+  if (Inputs.AddressSpaceLimitBytes >
+      static_cast<uint64_t>((std::numeric_limits<int64_t>::max)()))
+    return llvm::createStringError("module worker address limit is too large");
+  llvm::json::Object Request{
+      {"version", Inputs.OutputLimitBytes || Inputs.AddressSpaceLimitBytes
+                      ? BoundedProtocolVersion
+                      : ProtocolVersion},
+      {"filesystem", CapturedFileSystem},
+      {"directory", Inputs.WorkingDirectory},
+      {"mainFile", Inputs.MainFile},
+      {"mainContentsFile", Inputs.MainContentsFile},
+      {"overlays", llvm::json::Array(Inputs.OverlayFiles)},
+      {"addressSpaceLimitBytes",
+       static_cast<int64_t>(Inputs.AddressSpaceLimitBytes)},
+      {"outputLimitBytes", static_cast<int64_t>(Inputs.OutputLimitBytes)},
+      {"cc1Arguments", llvm::json::Array(Invocation.getCC1CommandLine())}};
+  return llvm::formatv("{0}", llvm::json::Value(std::move(Request))).str();
+}
+
+llvm::Expected<std::optional<ModuleBuildWorkerResult>>
+buildModuleInWorker(const CompilerInvocation &Invocation,
+                    StringRef MainContents, const ThreadsafeFS &FS,
+                    PathRef WorkingDirectory,
+                    const ModuleBuildWorkerOptions &Options) {
+  // This lease outlives the specific-child guard below: all workers sharing the
+  // owner remain charged to one group until their final reap/cleanup completes.
+  auto MemoryBudget = Options.MemoryBudget;
+  const bool PayloadBound =
+      Options.OutputLimitBytes || Options.CaptureLimitBytes;
+  if (PayloadBound)
+    if (auto Error = validateBoundedModuleBuildOutputs(Invocation))
+      return std::move(Error);
+  if (Options.Isolation == ModuleBuildWorkerOptions::Policy::InProcess) {
+    if (MemoryBudget || PayloadBound)
+      return llvm::createStringError(
+          "module worker resource budget forbids in-process fallback");
+    return std::optional<ModuleBuildWorkerResult>{};
+  }
+  const auto Started = std::chrono::steady_clock::now();
+  auto Snapshot = FS.snapshotForModuleBuild();
+  if (!Snapshot) {
+    if (Options.Isolation == ModuleBuildWorkerOptions::Policy::WhenSupported &&
+        !MemoryBudget && !PayloadBound)
+      return std::optional<ModuleBuildWorkerResult>{};
+    return llvm::createStringError(
+        "required module worker cannot export request filesystem");
+  }
+  if (Options.Timeout <= std::chrono::milliseconds::zero() ||
+      !llvm::sys::path::is_absolute(Options.Executable))
+    return llvm::createStringError(
+        "module worker requires an executable and positive timeout");
+  const auto Deadline = Started + Options.Timeout;
+  auto Cancelled = [&] { return Options.Cancelled && Options.Cancelled(); };
+  if (Cancelled())
+    return llvm::createStringError("module worker was cancelled before launch");
+  const std::string Output = Invocation.getFrontendOpts().OutputFile;
+  if (!llvm::sys::path::is_absolute(Output) || StringRef(Output).contains('\0'))
+    return llvm::createStringError(
+        "module worker staged output must be absolute");
+  if (llvm::sys::fs::exists(Output))
+    return llvm::createStringError(
+        "module worker staged output already exists");
+  auto Unit = ModuleBuildWorkerUnit::create(Output, Options.UnitRoot);
+  if (!Unit)
+    return Unit.takeError();
+  bool Success = false;
+  auto Cleanup = llvm::scope_exit([&] {
+    if (!Success)
+      llvm::sys::fs::remove(Output);
+  });
+  auto Path = [&](StringRef Name) { return (*Unit)->file(Name); };
+  ModuleBuildWorkerInputs Inputs;
+  Inputs.AddressSpaceLimitBytes = Options.AddressSpaceLimitBytes;
+  Inputs.OutputLimitBytes = Options.OutputLimitBytes;
+  Inputs.FileSystem =
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays;
+  Inputs.WorkingDirectory = WorkingDirectory.str();
+  if (Invocation.getFrontendOpts().Inputs.size() != 1 ||
+      !Invocation.getFrontendOpts().Inputs[0].isFile())
+    return llvm::createStringError("module worker requires a single main file");
+  Inputs.MainFile = capturedMainPath(
+      Invocation.getFrontendOpts().Inputs[0].getFile(), WorkingDirectory);
+  Inputs.MainContentsFile = Path("main.snapshot");
+  // Flatten repeated paths with last-overlay-wins semantics.
+  llvm::StringMap<const ModuleBuildFileSystemSnapshot::File *> Files;
+  for (const auto &File : Snapshot->OverlayFiles)
+    Files[File.Path] = &File;
+  llvm::vfs::YAMLVFSWriter Writer;
+  Writer.setUseExternalNames(false);
+  unsigned Index = 0;
+  for (const auto &Entry : Files) {
+    const auto &File = *Entry.getValue();
+    if (!llvm::sys::path::is_absolute(File.Path))
+      return llvm::createStringError(
+          "captured module worker paths must be absolute");
+    std::string ContentsPath = Path("overlay-" + std::to_string(Index++));
+    Writer.addFileMapping(File.Path, ContentsPath);
+  }
+  std::string YAML;
+  llvm::raw_string_ostream YAMLStream(YAML);
+  Writer.write(YAMLStream);
+  Inputs.OverlayFiles = {Path("filesystem.yaml")};
+  CompilerInvocation WorkerInvocation(Invocation);
+  const std::string WorkerOutput = Path("output.pcm");
+  WorkerInvocation.getFrontendOpts().OutputFile = WorkerOutput;
+  WorkerInvocation.getHeaderSearchOpts().ModuleCachePath = Path("module-cache");
+  auto Request = serializeModuleBuildWorkerRequest(WorkerInvocation, Inputs);
+  if (!Request)
+    return Request.takeError();
+  const std::string RequestPath = Path("request.json");
+  // Serialize and count every snapshot before the first payload write. Main
+  // bytes also appear in a top overlay and must be charged twice when present.
+  uint64_t CaptureBytes = 0;
+  auto Count = [&](uint64_t Bytes) {
+    if (Bytes > UINT64_MAX - CaptureBytes)
+      return false;
+    CaptureBytes += Bytes;
+    return !Options.CaptureLimitBytes ||
+           CaptureBytes <= Options.CaptureLimitBytes;
+  };
+  if ((PayloadBound && Files.size() + 3 > Options.CaptureLimitFiles) ||
+      !Count(MainContents.size()) || !Count(YAML.size()) ||
+      !Count(Request->size()))
+    return llvm::createStringError(
+        "module worker capture payload or file limit exceeded");
+  for (const auto &Entry : Files)
+    if (!Count(Entry.getValue()->Contents.size()))
+      return llvm::createStringError(
+          "module worker capture payload limit exceeded");
+  if (auto Error = writeSnapshot(Inputs.MainContentsFile, MainContents))
+    return std::move(Error);
+  Index = 0;
+  for (const auto &Entry : Files) {
+    const auto &File = *Entry.getValue();
+    if (auto Error = writeSnapshot(Path("overlay-" + std::to_string(Index++)),
+                                   File.Contents, File.ModificationTime))
+      return std::move(Error);
+  }
+  if (auto Error = writeSnapshot(Inputs.OverlayFiles.front(), YAML))
+    return std::move(Error);
+  if (auto Error = writeSnapshot(RequestPath, *Request))
+    return std::move(Error);
+  if (Cancelled() || std::chrono::steady_clock::now() >= Deadline)
+    return llvm::createStringError(
+        "module worker was cancelled or timed out during capture");
+  const std::string DiagnosticsPath = Path("stderr.log");
+  auto Diagnostics = WorkerDiagnostics::create(DiagnosticsPath);
+  if (!Diagnostics)
+    return Diagnostics.takeError();
+  auto Owner = WorkerOwner::create(Path("owner.pipe"));
+  if (!Owner)
+    return Owner.takeError();
+  const std::string OwnerToken = (*Owner)->token();
+  if (Cancelled() || std::chrono::steady_clock::now() >= Deadline)
+    return llvm::createStringError(
+        "module worker cancelled or timed out during owner setup");
+  std::array<std::optional<StringRef>, 3> Redirects{
+      StringRef(""), StringRef(""), StringRef(DiagnosticsPath)};
+  const std::string MemoryToken =
+      MemoryBudget ? MemoryBudget->bootstrapToken() : "";
+  std::array<StringRef, 5> Args{Options.Executable, "--module-build-worker",
+                                RequestPath, OwnerToken, MemoryToken};
+  std::string LaunchError;
+  bool Failed = false;
+  auto Process =
+      llvm::sys::ExecuteNoWait(Options.Executable, Args, std::nullopt,
+                               Redirects, 0, &LaunchError, &Failed);
+  if (Failed || Process.Pid == llvm::sys::ProcessInfo::InvalidPid)
+    return llvm::createStringError("failed to launch module worker: " +
+                                   LaunchError);
+  // Declared after Cleanup: destruction always terminates/reaps before files
+  // and any caller-owned source locks/prerequisite leases can be released.
+  WorkerProcess Child(Process);
+  for (;;) {
+    if (auto Err = (*Diagnostics)->drain())
+      return std::move(Err);
+    auto Status = Child.reap(/*Blocking=*/false);
+    if (!Status)
+      return Status.takeError();
+    if (*Status) {
+      if (auto Err = (*Diagnostics)->drain())
+        return std::move(Err);
+      if (**Status != 0)
+        return llvm::createStringError("module worker failed: " +
+                                       (*Diagnostics)->text());
+      break;
+    }
+    const bool WasCancelled = Cancelled();
+    if (WasCancelled || std::chrono::steady_clock::now() >= Deadline) {
+      Child.terminate();
+      auto Reaped = Child.reap(/*Blocking=*/true);
+      if (!Reaped)
+        return Reaped.takeError();
+      if (auto Err = (*Diagnostics)->drain())
+        return std::move(Err);
+      return llvm::createStringError(
+          llvm::formatv("module worker {0} (pid {1}): {2}",
+                        WasCancelled ? "cancelled" : "timed out", Process.Pid,
+                        (*Diagnostics)->text())
+              .str());
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  if (Cancelled() || std::chrono::steady_clock::now() >= Deadline)
+    return llvm::createStringError(
+        "module worker cancelled or timed out before accepting output");
+  // A BMI must not reference prerequisites about to disappear with this
+  // worker's private cache. Explicit prerequisite copies remain parent-owned.
+  std::error_code EC;
+  for (llvm::sys::fs::recursive_directory_iterator I(Path("module-cache"), EC),
+       End;
+       I != End && !EC; I.increment(EC))
+    if (llvm::sys::path::extension(I->path()) == ".pcm")
+      return llvm::createStringError(
+          "module worker built uncaptured implicit prerequisites");
+  if (EC && EC != std::errc::no_such_file_or_directory)
+    return llvm::errorCodeToError(EC);
+  if (!llvm::sys::fs::exists(WorkerOutput))
+    return llvm::createStringError("module worker produced no staged output");
+  if (auto EC = llvm::sys::fs::rename(WorkerOutput, Output))
+    return llvm::errorCodeToError(EC);
+  Success = true;
+  return std::optional<ModuleBuildWorkerResult>(
+      {std::chrono::duration_cast<std::chrono::milliseconds>(
+           std::chrono::steady_clock::now() - Started),
+       Child.Statistics});
+}
+
+llvm::Error runModuleBuildWorker(PathRef RequestFile, StringRef OwnerToken) {
+  return runModuleBuildWorker(RequestFile, OwnerToken, {});
+}
+
+llvm::Error runModuleBuildWorker(PathRef RequestFile, StringRef OwnerToken,
+                                 StringRef MemoryBudgetToken) {
+  std::unique_ptr<WorkerOwnerMonitor> Owner;
+  if (!OwnerToken.empty()) {
+    auto Monitor = WorkerOwnerMonitor::create(OwnerToken);
+    if (!Monitor)
+      return Monitor.takeError();
+    Owner = std::move(*Monitor);
+  }
+  if (auto Err = enterModuleBuildWorkerMemoryBudget(MemoryBudgetToken))
+    return Err;
+  std::unique_ptr<ModuleBuildWorkerLease> WorkerLease;
+  const auto UnitDirectory = llvm::sys::path::parent_path(RequestFile);
+  llvm::SmallString<256> RootMarker(
+      llvm::sys::path::parent_path(UnitDirectory));
+  llvm::sys::path::append(RootMarker, "owned.root");
+  // Direct protocol probes remain supported outside owned roots. A replay
+  // inside an owned root must retain its worker lease even without an owner
+  // token, and a retired unit must never restart through that debug path.
+  if (!OwnerToken.empty() || llvm::sys::fs::exists(RootMarker)) {
+    auto Lease = ModuleBuildWorkerLease::acquire(UnitDirectory, true);
+    if (!Lease)
+      return Lease.takeError();
+    WorkerLease = std::move(*Lease);
+  }
+  auto Buffer = llvm::MemoryBuffer::getFile(RequestFile);
+  if (!Buffer)
+    return llvm::errorCodeToError(Buffer.getError());
+  auto Request = llvm::json::parse((*Buffer)->getBuffer());
+  if (!Request)
+    return Request.takeError();
+  const auto *Object = Request->getAsObject();
+  if (!Object ||
+      (Object->getInteger("version") != ProtocolVersion &&
+       Object->getInteger("version") != BoundedProtocolVersion) ||
+      Object->getString("filesystem") != CapturedFileSystem)
+    return llvm::createStringError(
+        "unsupported module worker request protocol");
+  if (Object->getInteger("version") == ProtocolVersion &&
+      (Object->getInteger("outputLimitBytes").value_or(0) > 0 ||
+       Object->getInteger("addressSpaceLimitBytes").value_or(0) > 0))
+    return llvm::createStringError(
+        "bounded module worker requires protocol version 2");
+  if (Object->getInteger("version") == BoundedProtocolVersion &&
+      Object->getInteger("outputLimitBytes").value_or(0) <= 0 &&
+      Object->getInteger("addressSpaceLimitBytes").value_or(0) <= 0)
+    return llvm::createStringError(
+        "bounded module worker protocol requires a resource ceiling");
+  if (Object->get("addressSpaceLimitBytes")) {
+    auto Limit = Object->getInteger("addressSpaceLimitBytes");
+    if (!Limit || *Limit < 0)
+      return llvm::createStringError("invalid module worker address limit");
+    // The small request JSON is already loaded. Apply/read back the ceiling
+    // before loading the captured main, overlays or invoking the frontend.
+    if (auto Err = applyAddressSpaceLimit(static_cast<uint64_t>(*Limit)))
+      return Err;
+  }
+  uint64_t OutputLimit = 0;
+  if (Object->get("outputLimitBytes")) {
+    auto Limit = Object->getInteger("outputLimitBytes");
+    if (!Limit || *Limit < 0)
+      return llvm::createStringError("invalid module worker output limit");
+    OutputLimit = static_cast<uint64_t>(*Limit);
+  }
+  ModuleBuildWorkerInputs Inputs;
+  Inputs.FileSystem =
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays;
+  std::vector<std::string> Arguments;
+  llvm::json::Path::Root Root;
+  llvm::json::ObjectMapper Mapper(*Request, Root);
+  if (!Mapper.map("directory", Inputs.WorkingDirectory) ||
+      !Mapper.map("mainFile", Inputs.MainFile) ||
+      !Mapper.map("mainContentsFile", Inputs.MainContentsFile) ||
+      !Mapper.map("overlays", Inputs.OverlayFiles) ||
+      !Mapper.map("cc1Arguments", Arguments))
+    return Root.getError();
+  if (auto Err = validateInputs(Inputs))
+    return Err;
+
+  DiagnosticOptions DiagnosticOpts;
+  TextDiagnosticPrinter Printer(llvm::errs(), DiagnosticOpts);
+  DiagnosticsEngine Diags(new DiagnosticIDs(), DiagnosticOpts, &Printer, false);
+  std::vector<const char *> ArgumentRefs;
+  for (const auto &Arg : Arguments) {
+    if (StringRef(Arg).contains('\0'))
+      return llvm::createStringError(
+          "module worker arguments cannot contain NUL");
+    ArgumentRefs.push_back(Arg.c_str());
+  }
+  auto Invocation = std::make_unique<CompilerInvocation>();
+  if (!CompilerInvocation::CreateFromArgs(*Invocation, ArgumentRefs, Diags))
+    return llvm::createStringError("invalid module worker compiler invocation");
+  if (auto Err = validateInvocation(*Invocation, Inputs))
+    return Err;
+  if (OutputLimit)
+    if (auto Error = validateBoundedModuleBuildOutputs(*Invocation))
+      return Error;
+
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> VFS(
+      llvm::vfs::createPhysicalFileSystem().release());
+  // As for an in-process build (ThreadsafeFS::view): a command's directory that
+  // does not exist yet, such as a build tree before its first build, is
+  // reported and the build goes on.
+  if (auto EC = VFS->setCurrentWorkingDirectory(Inputs.WorkingDirectory))
+    elog("VFS: failed to set CWD to {0}: {1}", Inputs.WorkingDirectory,
+         EC.message());
+  for (StringRef Path : Inputs.OverlayFiles) {
+    auto YAML = llvm::MemoryBuffer::getFile(Path);
+    if (!YAML)
+      return llvm::errorCodeToError(YAML.getError());
+    auto Overlay = llvm::vfs::getVFSFromYAML(std::move(*YAML), nullptr, Path,
+                                             nullptr, VFS);
+    if (!Overlay)
+      return llvm::createStringError(
+          "invalid captured module worker filesystem overlay");
+    VFS = llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>(Overlay.release());
+  }
+  auto Main = llvm::MemoryBuffer::getFile(Inputs.MainContentsFile);
+  if (!Main)
+    return llvm::errorCodeToError(Main.getError());
+  const std::string Output = Invocation->getFrontendOpts().OutputFile;
+  bool Success = false;
+  auto Cleanup = llvm::scope_exit([&] {
+    if (!Success)
+      llvm::sys::fs::remove(Output);
+  });
+  ModuleBuildWorkerOutput Outputs;
+  if (OutputLimit) {
+    StringRef UnitRoot = llvm::sys::path::parent_path(Inputs.MainContentsFile);
+    // Supervised requests put the sole output directly in their private unit.
+    if (llvm::sys::path::parent_path(Output) != UnitRoot ||
+        Invocation->getHeaderSearchOpts().ModuleCachePath !=
+            (UnitRoot + "/module-cache").str())
+      return llvm::createStringError(
+          "bounded worker outputs require its private unit");
+    Outputs = createModuleBuildWorkerOutput(UnitRoot, OutputLimit);
+  }
+  auto Clang =
+      prepareCompilerInstance(std::move(Invocation), nullptr, std::move(*Main),
+                              std::move(VFS), Printer, Outputs.Cache);
+  if (!Clang)
+    return llvm::createStringError("failed to prepare module worker compiler");
+  std::unique_ptr<FrontendAction> Action;
+  if (OutputLimit) {
+    Clang->setOutputManager(std::move(Outputs.Backend));
+    Action = createBoundedReducedModuleAction();
+  } else {
+    Action = std::make_unique<GenerateReducedModuleInterfaceAction>();
+  }
+  if (!Clang->ExecuteAction(*Action) ||
+      Clang->getDiagnostics().hasErrorOccurred() ||
+      !llvm::sys::fs::exists(Output))
+    return llvm::createStringError("module worker compilation failed");
+  if (Outputs.Check)
+    if (auto Error = Outputs.Check())
+      return Error;
+  Success = true;
+  return llvm::Error::success();
+}
+} // namespace clang::clangd
