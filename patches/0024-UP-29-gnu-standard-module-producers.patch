+// Only unconditional real tokens of the installed GNU producer count. In
+// particular, comments, strings and a disabled conditional module declaration
+// cannot establish the source role. This is a bounded lexical discriminator,
+// not preprocessing or a replacement for the normal compiler validation.
+bool hasGNUStdProducerRole(StringRef Source, bool Compat) {
+  auto Prefix =
+      llvm::MemoryBuffer::getMemBufferCopy(Source.take_front(32 * 1024));
+  LangOptions Lang;
+  Lang.CPlusPlus = true;
+  Lexer Lex(SourceLocation::getFromRawEncoding(1), Lang,
+            Prefix->getBufferStart(), Prefix->getBufferStart(),
+            Prefix->getBufferEnd());
+  unsigned ConditionalDepth = 0;
+  bool Directive = false;
+  llvm::SmallVector<tok::TokenKind, 8> Kinds;
+  llvm::SmallVector<std::string, 8> Words;
+  Token T;
+  while (!Lex.LexFromRawLexer(T)) {
+    if (T.isAtStartOfLine())
+      Directive = false;
+    if (T.is(tok::hash) && T.isAtStartOfLine()) {
+      Directive = true;
+      Lex.LexFromRawLexer(T);
+      if (!T.is(tok::raw_identifier))
+        return false;
+      auto Name = T.getRawIdentifier();
+      if (Name == "if" || Name == "ifdef" || Name == "ifndef") {
+        if (++ConditionalDepth > 64)
+          return false;
+      } else if (Name == "endif") {
+        if (!ConditionalDepth)
+          return false;
+        --ConditionalDepth;
+      }
+      continue;
+    }
+    if (Directive || T.is(tok::comment))
+      continue;
+    if (ConditionalDepth)
+      return false;
+    Kinds.push_back(T.getKind());
+    Words.push_back(T.is(tok::raw_identifier) ? T.getRawIdentifier().str()
+                                              : "");
+    const unsigned Expected = Compat ? 8 : 6;
+    if (Kinds.size() == Expected) {
+      bool Role = Words[0] == "module" && Kinds[1] == tok::semi &&
+                  Words[2] == "export" && Words[3] == "module" &&
+                  Words[4] == "std";
+      return Role && (Compat ? Kinds[5] == tok::period &&
+                                   Words[6] == "compat" && Kinds[7] == tok::semi
+                             : Kinds[5] == tok::semi);
+    }
+  }
+  return false;
+}
+
 } // namespace
 
+bool translateGNUStdModuleProducer(tooling::CompileCommand &Cmd, StringRef File,
+                                   llvm::vfs::FileSystem &RequestFS) {
+  auto &Args = Cmd.CommandLine;
+  if (Args.empty() || !llvm::is_contained(Args, "-fmodules") ||
+      llvm::is_contained(Args, "-fno-modules") ||
+      hasExplicitClangModuleInputs(Args))
+    return false;
+  for (size_t I = 1; I < Args.size(); ++I) {
+    StringRef A = Args[I];
+    if (A.starts_with("-fmodule-header") || A.starts_with("-x="))
+      return false;
+    if (A == "-x") {
+      if (I + 1 == Args.size() || Args[++I] != "c++")
+        return false;
+    } else if (A.starts_with("-x") && A != "-xc++")
+      return false;
+  }
+  bool Compat = llvm::sys::path::filename(File) == "std.compat.cc";
+  if (!Compat && llvm::sys::path::filename(File) != "std.cc")
+    return false;
+  llvm::SmallString<256> Driver, Source;
+  if (RequestFS.getRealPath(Args.front(), Driver) || !isGCCDriverName(Driver) ||
+      llvm::sys::path::filename(llvm::sys::path::parent_path(Driver)) !=
+          "bin" ||
+      RequestFS.getRealPath(File, Source))
+    return false;
+  llvm::SmallString<256> IncludeRoot(
+      llvm::sys::path::parent_path(llvm::sys::path::parent_path(Driver)));
+  llvm::sys::path::append(IncludeRoot, "include", "c++");
+  StringRef Relative = Source;
+  if (!Relative.consume_front(IncludeRoot) || !Relative.consume_front("/"))
+    return false;
+  auto [Version, Suffix] = Relative.split('/');
+  if (Version.empty() ||
+      !llvm::all_of(Version,
+                    [](char C) { return llvm::isDigit(C) || C == '.'; }) ||
+      Suffix != (Compat ? "bits/std.compat.cc" : "bits/std.cc"))
+    return false;
+  auto Before = RequestFS.status(File);
+  constexpr uint64_t MaxSourceBytes = 128 * 1024;
+  if (!Before || !Before->isRegularFile() || Before->getSize() > MaxSourceBytes)
+    return false;
+  auto Opened = RequestFS.openFileForRead(File);
+  if (!Opened)
+    return false;
+  auto OpenStatus = (*Opened)->status();
+  if (!OpenStatus || !OpenStatus->isRegularFile() ||
+      OpenStatus->getUniqueID() != Before->getUniqueID() ||
+      OpenStatus->getSize() != Before->getSize() ||
+      OpenStatus->getLastModificationTime() !=
+          Before->getLastModificationTime())
+    return false;
+  // FileSize is only a hint, not a portable prefix-read guarantee. Admission
+  // above bounds the known source; unsupported/changing VFS results decline.
+  auto Buffer = (*Opened)->getBuffer(File, OpenStatus->getSize(), true, true);
+  auto After = (*Opened)->status();
+  auto PathAfter = RequestFS.status(File);
+  llvm::SmallString<256> Rechecked;
+  if (!Buffer || !After || !PathAfter ||
+      (*Buffer)->getBufferSize() > MaxSourceBytes ||
+      (*Buffer)->getBufferSize() != OpenStatus->getSize() ||
+      After->getUniqueID() != OpenStatus->getUniqueID() ||
+      After->getSize() != OpenStatus->getSize() ||
+      After->getLastModificationTime() !=
+          OpenStatus->getLastModificationTime() ||
+      PathAfter->getUniqueID() != OpenStatus->getUniqueID() ||
+      PathAfter->getSize() != OpenStatus->getSize() ||
+      PathAfter->getLastModificationTime() !=
+          OpenStatus->getLastModificationTime() ||
+      RequestFS.getRealPath(File, Rechecked) || Rechecked != Source ||
+      !hasGNUStdProducerRole((*Buffer)->getBuffer(), Compat))
+    return false;
+  Args.insert(llvm::find(Args, "--"), "-fno-implicit-module-maps");
+  vlog("GNU installed standard-module producer: disabling implicit Clang "
+       "module maps");
+  return true;
+}
