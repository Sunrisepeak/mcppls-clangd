+// Recognize GNU libstdc++'s installed named std/std.compat producer through
+// the actual request filesystem. Unknown provenance or explicit Clang module
+// inputs leave the command unchanged. No source-role result is cached.
+bool translateGNUStdModuleProducer(tooling::CompileCommand &Cmd,
+                                   llvm::StringRef File,
+                                   llvm::vfs::FileSystem &RequestFS);
+
 // Removes args from a command-line in a semantically-aware way.
 //
 // Internally this builds a large (0.5MB) table of clang options on first use.
