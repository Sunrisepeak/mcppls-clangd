+#if LLVM_ON_UNIX
+TEST(CommandMangler, InstalledGNUStdProducerRequiresCurrentSourceRole) {
+  llvm::SmallString<256> Root;
+  ASSERT_FALSE(llvm::sys::fs::createUniqueDirectory("GNUStdProducer", Root));
+  auto Cleanup =
+      llvm::scope_exit([&] { llvm::sys::fs::remove_directories(Root); });
+  auto Path = [&](StringRef Relative) { return (Root + "/" + Relative).str(); };
+  ASSERT_FALSE(llvm::sys::fs::create_directories(Path("bin")));
+  ASSERT_FALSE(
+      llvm::sys::fs::create_directories(Path("include/c++/16.1.0/bits")));
+  auto Write = [&](StringRef File, StringRef Contents) {
+    std::error_code EC;
+    llvm::raw_fd_ostream OS(File, EC);
+    EXPECT_FALSE(EC);
+    OS << Contents;
+  };
+  Write(Path("bin/g++"), "GCC driver identity (never executed)");
+  Write(Path("bin/clang++"), "Clang driver identity (never executed)");
+  const std::string Source = Path("include/c++/16.1.0/bits/std.cc");
+  const std::string Role =
+      "module;\n#include <bits/stdc++.h>\nexport module std;\n";
+  Write(Source, Role);
+  auto FS = llvm::vfs::getRealFileSystem();
+  auto Command = [&](std::vector<std::string> Extra = {}) {
+    tooling::CompileCommand Cmd;
+    Cmd.Directory = Root.str().str();
+    Cmd.CommandLine = {Path("bin/g++"), "-std=c++23", "-fmodules"};
+    Cmd.CommandLine.insert(Cmd.CommandLine.end(), Extra.begin(), Extra.end());
+    Cmd.CommandLine.insert(Cmd.CommandLine.end(), {"--", Source});
+    return Cmd;
+  };
+  auto Positive = Command();
+  EXPECT_TRUE(translateGNUStdModuleProducer(Positive, Source, *FS));
+  EXPECT_THAT(Positive.CommandLine, Contains("-fmodules"));
+  EXPECT_THAT(Positive.CommandLine, Contains("-fno-implicit-module-maps"));
+  for (const char *Flag :
+       {"-fimplicit-module-maps", "-fmodule-map-file=map",
+        "-fmodule-file=std=std.pcm", "-fprebuilt-module-path=pcms",
+        "-fbuiltin-module-map", "-fno-modules", "-fmodule-header"}) {
+    auto Explicit = Command({Flag});
+    auto Original = Explicit.CommandLine;
+    EXPECT_FALSE(translateGNUStdModuleProducer(Explicit, Source, *FS)) << Flag;
+    EXPECT_EQ(Explicit.CommandLine, Original);
+  }
+  for (StringRef Language : {"c", "c++-header", "c++-module"}) {
+    auto OtherRole = Command({"-x", Language.str()});
+    EXPECT_FALSE(translateGNUStdModuleProducer(OtherRole, Source, *FS));
+  }
+  auto ExplicitCpp = Command({"-x", "c++"});
+  EXPECT_TRUE(translateGNUStdModuleProducer(ExplicitCpp, Source, *FS));
+  auto Clang = Command();
+  Clang.CommandLine.front() = Path("bin/clang++");
+  EXPECT_FALSE(translateGNUStdModuleProducer(Clang, Source, *FS));
+  ASSERT_FALSE(
+      llvm::sys::fs::create_link(Path("bin/clang++"), Path("bin/g++-99")));
+  auto Alias = Command();
+  Alias.CommandLine.front() = Path("bin/g++-99");
+  EXPECT_FALSE(translateGNUStdModuleProducer(Alias, Source, *FS));
+  Write(Path("std.cc"), Role);
+  ASSERT_FALSE(
+      llvm::sys::fs::create_directories(Path("other/include/c++/16.1.0/bits")));
+  Write(Path("other/include/c++/16.1.0/bits/std.cc"), Role);
+  auto OtherInstall = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(
+      OtherInstall, Path("other/include/c++/16.1.0/bits/std.cc"), *FS));
+  auto Foreign = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(Foreign, Path("std.cc"), *FS));
+  Write(Path("ordinary.cpp"), Role);
+  EXPECT_FALSE(
+      translateGNUStdModuleProducer(Foreign, Path("ordinary.cpp"), *FS));
+  llvm::sys::fs::file_status Before;
+  ASSERT_FALSE(llvm::sys::fs::status(Source, Before));
+  auto Changed = Role;
+  Changed.replace(Changed.find("module std"), 10, "module bad");
+  ASSERT_EQ(Changed.size(), Role.size());
+  Write(Source, Changed);
+  ASSERT_FALSE(llvm::sys::fs::setLastAccessAndModificationTime(
+      Source, Before.getLastModificationTime()));
+  llvm::sys::fs::file_status SameStamp;
+  ASSERT_FALSE(llvm::sys::fs::status(Source, SameStamp));
+  ASSERT_EQ(SameStamp.getUniqueID(), Before.getUniqueID());
+  ASSERT_EQ(SameStamp.getSize(), Before.getSize());
+  ASSERT_EQ(SameStamp.getLastModificationTime(),
+            Before.getLastModificationTime());
+  auto NoCachedRole = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(NoCachedRole, Source, *FS));
+  // A current overlay is authoritative even if the disk producer is valid.
+  Write(Source, Role);
+  auto Overlay = llvm::makeIntrusiveRefCnt<llvm::vfs::OverlayFileSystem>(FS);
+  auto Memory = llvm::makeIntrusiveRefCnt<llvm::vfs::InMemoryFileSystem>();
+  Memory->addFile(Source, 0, llvm::MemoryBuffer::getMemBufferCopy(Changed));
+  Overlay->pushOverlay(Memory);
+  auto Dirty = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(Dirty, Source, *Overlay));
+  Write(Source, "#if 0\n" + Role + "#endif\n");
+  auto Disabled = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(Disabled, Source, *FS));
+  Write(Source, "/*" + std::string(32 * 1024, ' ') + "*/\n" + Role);
+  auto LateRole = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(LateRole, Source, *FS));
+  Write(Source, Role + std::string(128 * 1024, ' '));
+  auto Oversized = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(Oversized, Source, *FS));
+  ASSERT_FALSE(llvm::sys::fs::remove(Source));
+  ASSERT_FALSE(llvm::sys::fs::create_link(Path("std.cc"), Source));
+  auto Escape = Command();
+  EXPECT_FALSE(translateGNUStdModuleProducer(Escape, Source, *FS));
+  const auto Compat = Path("include/c++/16.1.0/bits/std.compat.cc");
+  Write(Compat, "module;\nexport module std.compat;\n");
+  auto CompatCmd = Command();
+  CompatCmd.CommandLine.back() = Compat;
+  EXPECT_TRUE(translateGNUStdModuleProducer(CompatCmd, Compat, *FS));
+}
+#endif
