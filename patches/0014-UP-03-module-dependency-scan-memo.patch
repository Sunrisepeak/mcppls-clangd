--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleDependencyScanCache.h
@@ -0,0 +1,1004 @@
+//===--- ModuleDependencyScanCache.h -----------------------------*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
