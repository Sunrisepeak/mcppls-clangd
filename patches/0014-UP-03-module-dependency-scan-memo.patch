+TEST_F(PrerequisiteModulesTests, ScanMemoIndexRetainsCollidingFactDifferences) {
+  ModuleScanManifest Inputs;
+  ModuleScanManifest::Observation Original{ModuleScanManifest::Read, "same.h"};
+  Inputs.add(Original);
+  // Same operation/path hash deliberately collides. Every differing outcome
+  // must survive, through multiple table growths and manifest copies.
+  for (size_t I = 1; I < 512; ++I) {
+    auto Different = Original;
+    Different.RequestedSize = I;
+    Inputs.add(Different);
+    Inputs.add(Different);
+  }
+  ASSERT_TRUE(Inputs.Complete);
+  ASSERT_EQ(Inputs.observations().size(), 512u);
+  EXPECT_EQ(Inputs.RepeatedFacts, 511u);
+  auto Copy = Inputs;
+  for (const auto &O : Inputs.observations())
+    Copy.add(O);
+  EXPECT_EQ(Copy.observations().size(), Inputs.observations().size());
+  EXPECT_EQ(Copy.RepeatedFacts, 1023u);
+  // The index is owned metadata and must be accounted beyond the facts.
+  size_t FactsOnly = sizeof(Inputs) + Inputs.WorkingDirectory.capacity() + 32;
+  for (const auto &O : Inputs.observations())
+    FactsOnly += sizeof(O) + O.Path.capacity() + O.Name.capacity() + 64;
+  EXPECT_GT(Inputs.ownedBytes(), FactsOnly);
+  // A large status name is metadata even when Path/Name are small.
+  auto View = FS.view(TestDir);
+  auto Status = View->status(TestDir);
+  ASSERT_TRUE(Status);
+  ModuleScanManifest Large;
+  auto Huge = Original;
+  Huge.Info.emplace(*Status);
+  Huge.Info->Name.assign(ModuleScanManifest::ByteLimit, 'x');
+  Large.add(std::move(Huge));
+  EXPECT_FALSE(Large.Complete);
+  EXPECT_TRUE(Large.observations().empty());
+}
