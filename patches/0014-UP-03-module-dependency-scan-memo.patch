+TEST_F(PrerequisiteModulesTests, ScanMemoHashesCompleteLargeHeaderContents) {
+  // Unsupported native toolchains intentionally rescan instead of admitting
+  // a manifest. Keep the complete-byte semantic control on those hosts too.
+  const bool AdmittedHost =
+      llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux();
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include \"large.h\"\n");
+  CDB.addFile("large.h", "import M;\n");
+  auto Generation = CDB.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  const auto Use = getFullPath("Use.cpp");
+  const auto Header = getFullPath("large.h");
+  auto Scan = [&] {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    return Modules->getRequiredModules(Use);
+  };
+  // Exercise tree/chunk boundaries and a large input. Altering only its tail
+  // must invalidate reuse even with identical size, identity and full mtime.
+  for (size_t Padding :
+       {size_t(1023), size_t(1024), size_t(1025), size_t(65535), size_t(65536),
+        size_t(65537), size_t(1024 * 1024)}) {
+    SCOPED_TRACE(Padding);
+    auto Write = [&](char Module) {
+      std::error_code EC;
+      llvm::raw_fd_ostream Out(Header, EC);
+      EXPECT_FALSE(EC);
+      Out << std::string(Padding, ' ') << "import " << Module << ";\n";
+    };
+    Write('M');
+    EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+    auto Before = getModuleDependencyScanCache().stats();
+    EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+    if (AdmittedHost)
+      EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+    else
+      EXPECT_EQ(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+    llvm::sys::fs::file_status Original;
+    ASSERT_FALSE(llvm::sys::fs::status(Header, Original));
+    Write('N');
+    ASSERT_FALSE(llvm::sys::fs::setLastAccessAndModificationTime(
+        Header, Original.getLastAccessedTime(),
+        Original.getLastModificationTime()));
+    llvm::sys::fs::file_status Changed;
+    ASSERT_FALSE(llvm::sys::fs::status(Header, Changed));
+    ASSERT_EQ(Original.getSize(), Changed.getSize());
+    ASSERT_EQ(Original.getLastModificationTime(),
+              Changed.getLastModificationTime());
+    EXPECT_THAT(Scan(), testing::ElementsAre("N"));
+    if (AdmittedHost)
+      EXPECT_GT(getModuleDependencyScanCache().stats().Invalidations,
+                Before.Invalidations);
+    else {
+      EXPECT_EQ(getModuleDependencyScanCache().stats().Invalidations,
+                Before.Invalidations);
+      EXPECT_EQ(getModuleDependencyScanCache().stats().Stores, Before.Stores);
+    }
+  }
+}
