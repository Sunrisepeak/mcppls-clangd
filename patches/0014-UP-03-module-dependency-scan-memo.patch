+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEDEPENDENCYSCANCACHE_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEDEPENDENCYSCANCACHE_H
+
+#include "support/Cancellation.h"
+#include "support/Logger.h"
+#include "support/ThreadsafeFS.h"
+#include "clang/Tooling/CompilationDatabase.h"
+#include "llvm/ADT/Hashing.h"
+#include "llvm/ADT/SmallString.h"
+#include "llvm/Config/llvm-config.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#ifdef _WIN32
+#include "llvm/Support/Windows/WindowsSupport.h"
+#include <cstdlib>
+#include <cwchar>
+#elif defined(__APPLE__)
+#include <crt_externs.h>
+#else
+extern "C" {
+extern char **environ;
+}
+#endif
+#include "llvm/Support/BLAKE3.h"
+#include "llvm/Support/SHA256.h"
+#include "llvm/Support/VirtualFileSystem.h"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <list>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace clang::clangd {
+
+struct ModuleScanResult {
+  std::optional<std::string> ModuleName;
+  std::vector<std::string> RequiredModules;
+  // An observed semantic failure is reusable, but is never a provider result.
+  std::optional<std::string> FailureDiagnostic;
+  static constexpr size_t FailureDiagnosticByteLimit = 64 * 1024;
+};
+
+// A manifest records operations, not just files successfully included. Missing
+// search candidates and __has_include probes affect a successful scan too.
+// The recorder must sit below a FRESH dependency-scanning service per miss.
+class ModuleScanManifest {
+public:
+  // Complete real project scans can require over 5700 distinct facts.
+  // This bounds replay work; owned metadata still shares the 32 MiB budget.
+  static constexpr size_t ProbeLimit = 8192;
+  static constexpr size_t ByteLimit = 32 * 1024 * 1024;
+  using Digest = std::array<uint8_t, 32>;
+  static Digest fingerprint(llvm::StringRef Bytes) {
+    // Hash every byte with a full 256-bit cryptographic digest. LLVM's bundled
+    // BLAKE3 uses runtime CPU dispatch; no platform-specific target requirement
+    // or persisted module/cache-key format is introduced here.
+    llvm::BLAKE3 Hash;
+    Hash.update(Bytes);
+    return Hash.final();
+  }
+
+  // The driver consults environment outside VFS, including target-specific
+  // and user-named variables. Fingerprint the complete environment rather
+  // than relying on a list of known variable names. Concurrent environment
+  // mutation is unsupported by the compiler itself; ordinary changes between
+  // requests invalidate reuse and are checked again before publication.
+  static std::optional<Digest> environment(const tooling::CompileCommand &) {
+    llvm::SHA256 Hash;
+#ifdef _WIN32
+    // GetEnv uses Win32, while several driver paths use CRT getenv. Observe
+    // both blocks so either source changing invalidates the entry.
+    if (wchar_t *Block = ::GetEnvironmentStringsW()) {
+      const wchar_t *End = Block;
+      while (*End)
+        End += std::wcslen(End) + 1;
+      Hash.update(
+          llvm::ArrayRef<uint8_t>(reinterpret_cast<const uint8_t *>(Block),
+                                  (End - Block + 1) * sizeof(wchar_t)));
+      ::FreeEnvironmentStringsW(Block);
+    } else {
+      return std::nullopt;
+    }
+    char **Values = _environ;
+#elif defined(__APPLE__)
+    char **Values = *_NSGetEnviron();
+#else
+    char **Values = ::environ;
+#endif
+    for (; Values && *Values; ++Values) {
+      Hash.update(llvm::StringRef(*Values));
+      Hash.update(llvm::StringRef("\0", 1));
+    }
+    return Hash.final();
+  }
+
+  struct Status {
+    std::string Name;
+    llvm::sys::fs::UniqueID ID;
+    llvm::sys::TimePoint<> MTime;
+    uint64_t Size;
+    uint32_t User, Group;
+    llvm::sys::fs::file_type Type;
+    llvm::sys::fs::perms Permissions;
+    bool External;
+    explicit Status(const llvm::vfs::Status &S)
+        : Name(S.getName()), ID(S.getUniqueID()),
+          MTime(S.getLastModificationTime()), Size(S.getSize()),
+          User(S.getUser()), Group(S.getGroup()), Type(S.getType()),
+          Permissions(S.getPermissions()), External(S.ExposesExternalVFSPath) {}
+    bool sameMetadata(const llvm::vfs::Status &S) const {
+      return Name == S.getName() && MTime == S.getLastModificationTime() &&
+             Size == S.getSize() && User == S.getUser() &&
+             Group == S.getGroup() && Type == S.getType() &&
+             Permissions == S.getPermissions() &&
+             External == S.ExposesExternalVFSPath;
+    }
+    bool operator==(const Status &Other) const {
+      return Name == Other.Name && ID == Other.ID && MTime == Other.MTime &&
+             Size == Other.Size && User == Other.User && Group == Other.Group &&
+             Type == Other.Type && Permissions == Other.Permissions &&
+             External == Other.External;
+    }
+  };
+  enum Kind {
+    Stat,
+    Open,
+    FileStat,
+    FileName,
+    Read,
+    Exists,
+    Absolute,
+    DirectoryBegin,
+    DirectoryNext,
+    RealPath
+  };
+  struct Observation {
+    Kind Operation;
+    std::string Path;
+    std::error_code Error;
+    std::optional<Status> Info;
+    std::string Name;
+    Digest Bytes = {};
+    uint64_t Size = 0;
+    int64_t RequestedSize = -1;
+    bool NullTerminated = true;
+    bool Found = false;
+    bool Binary = false;
+    llvm::sys::fs::file_type EntryType = llvm::sys::fs::file_type::type_unknown;
+    bool operator==(const Observation &Other) const {
+      return Operation == Other.Operation && Path == Other.Path &&
+             Error == Other.Error && Info == Other.Info && Name == Other.Name &&
+             Bytes == Other.Bytes && Size == Other.Size &&
+             RequestedSize == Other.RequestedSize &&
+             NullTerminated == Other.NullTerminated && Found == Other.Found &&
+             Binary == Other.Binary && EntryType == Other.EntryType;
+    }
+  };
+  std::string WorkingDirectory;
+  // When the recording began. Not part of the manifest's identity.
+  std::chrono::system_clock::time_point RecordedAt =
+      std::chrono::system_clock::now();
+  bool Complete = true;
+  uint64_t NextDirectory = 0;
+  size_t RepeatedFacts = 0;
+
+  llvm::ArrayRef<Observation> observations() const { return Observations; }
+
+  void add(Observation O) {
+    if (!Complete)
+      return;
+    const bool Indexed =
+        O.Operation != DirectoryBegin && O.Operation != DirectoryNext;
+    // Hash only selects candidates. Equality still compares EVERY recorded
+    // field, so collisions and different outcomes never discard an input.
+    if (Indexed && !FactIndex.empty()) {
+      auto Slot = findSlot(FactIndex, O);
+      if (FactIndex[Slot]) {
+        ++RepeatedFacts;
+        return;
+      }
+    }
+    const size_t IndexCapacity = !Indexed            ? FactIndex.size()
+                                 : FactIndex.empty() ? 32
+                                 : (IndexedFacts + 1) * 2 > FactIndex.size()
+                                     ? FactIndex.size() * 2
+                                     : FactIndex.size();
+    const size_t FactCapacity =
+        Observations.size() < Observations.capacity()
+            ? Observations.capacity()
+            : std::min(ProbeLimit,
+                       std::max(size_t(32), Observations.capacity() * 2));
+    const size_t Strings = stringBytes(O);
+    size_t Projected = sizeof(*this) + WorkingDirectory.capacity() + 32 +
+                       RecordedStringBytes + Strings +
+                       FactCapacity * sizeof(Observation) +
+                       IndexCapacity * sizeof(uint32_t);
+    // Reserve/rebuild may temporarily hold old and new allocations. Include
+    // that peak too; the retained index itself is at most 16384 four-byte
+    // slots.
+    if (IndexCapacity != FactIndex.size())
+      Projected += FactIndex.capacity() * sizeof(uint32_t);
+    if (FactCapacity != Observations.capacity())
+      Projected += Observations.capacity() * sizeof(Observation);
+    if (Observations.size() >= ProbeLimit || Strings > ByteLimit ||
+        Projected > ByteLimit) {
+      vlog("Module dependency scan manifest probe boundary: probes={0}, "
+           "repeatedFacts={1}", Observations.size(), RepeatedFacts);
+      Complete = false;
+      return;
+    }
+    Observations.reserve(FactCapacity);
+    if (IndexCapacity != FactIndex.size()) {
+      std::vector<uint32_t> Grown(IndexCapacity, 0);
+      for (size_t I = 0; I < Observations.size(); ++I) {
+        const auto &Earlier = Observations[I];
+        if (Earlier.Operation != DirectoryBegin &&
+            Earlier.Operation != DirectoryNext)
+          Grown[findSlot(Grown, Earlier)] = I + 1;
+      }
+      FactIndex = std::move(Grown);
+    }
+    RecordedStringBytes += Strings;
+    Observations.push_back(std::move(O));
+    if (Indexed) {
+      FactIndex[findSlot(FactIndex, Observations.back())] = Observations.size();
+      ++IndexedFacts;
+    }
+  }
+
+  size_t ownedBytes() const {
+    size_t Size = sizeof(*this) + WorkingDirectory.capacity() + 32 +
+                  Observations.capacity() * sizeof(Observation) +
+                  FactIndex.capacity() * sizeof(uint32_t);
+    for (const auto &O : Observations)
+      Size += O.Path.capacity() + O.Name.capacity() + 64 +
+              (O.Info ? O.Info->Name.capacity() + 32 : 0);
+    return Size;
+  }
+
+  bool matches(llvm::vfs::FileSystem &FS) const {
+    if (!Complete || Observations.empty())
+      return false;
+    auto CWD = FS.getCurrentWorkingDirectory();
+    if (!CWD || *CWD != WorkingDirectory)
+      return false;
+    // Overlay snapshots assign fresh IDs to immutable buffers. Require the
+    // SAME alias partition, rather than accepting arbitrary ID changes or
+    // requiring a particular overlay instance. This preserves pragma-once and
+    // FileManager identity relationships among all observed files/directories.
+    using ID = std::pair<uint64_t, uint64_t>;
+    std::map<ID, ID> Forward, Reverse;
+    std::map<uint64_t, llvm::vfs::directory_iterator> Directories;
+    std::unique_ptr<llvm::vfs::File> Held;
+    std::string HeldPath;
+    bool HeldBinary = false;
+    std::optional<llvm::vfs::Status> HeldOnDisk;
+    auto Release = [&] {
+      bool Closed = !Held || !Held->close();
+      Held.reset();
+      HeldOnDisk.reset();
+      return Closed;
+    };
+    auto SameStatus = [&](const Observation &O,
+                          const llvm::ErrorOr<llvm::vfs::Status> &Now) {
+      if (O.Error)
+        return !Now && O.Error == Now.getError();
+      if (!Now || !O.Info || !O.Info->sameMetadata(*Now))
+        return false;
+      ID Old{O.Info->ID.getDevice(), O.Info->ID.getFile()};
+      ID New{Now->getUniqueID().getDevice(), Now->getUniqueID().getFile()};
+      auto A = Forward.emplace(Old, New);
+      auto B = Reverse.emplace(New, Old);
+      return A.first->second == New && B.first->second == Old;
+    };
+    for (const auto &O : Observations) {
+      if (isCancelled())
+        return false;
+      if (O.Operation == Stat) {
+        if (!SameStatus(O, FS.status(O.Path)))
+          return false;
+        continue;
+      }
+      if (O.Operation == Exists) {
+        if (FS.exists(O.Path) != O.Found)
+          return false;
+        continue;
+      }
+      if (O.Operation == DirectoryBegin || O.Operation == DirectoryNext) {
+        std::error_code EC;
+        auto &I = Directories[O.Size];
+        if (O.Operation == DirectoryBegin)
+          I = FS.dir_begin(O.Path, EC);
+        else {
+          if (I == llvm::vfs::directory_iterator())
+            return false;
+          I.increment(EC);
+        }
+        bool Found = I != llvm::vfs::directory_iterator();
+        if (EC != O.Error || Found != O.Found ||
+            (Found && (I->path() != O.Name || I->type() != O.EntryType)))
+          return false;
+        continue;
+      }
+      if (O.Operation == Absolute) {
+        llvm::SmallString<256> Path(O.Path);
+        if (FS.makeAbsolute(Path) != O.Error || Path.str() != O.Name)
+          return false;
+        continue;
+      }
+      if (O.Operation == RealPath) {
+        llvm::SmallString<256> Resolved;
+        if (FS.getRealPath(O.Path, Resolved) != O.Error ||
+            Resolved.str() != O.Name)
+          return false;
+        continue;
+      }
+      // A file's observations replay through one handle, opened again
+      // wherever the scanner opened it again.
+      if (O.Operation == Open || !Held || HeldPath != O.Path ||
+          HeldBinary != O.Binary) {
+        if (!Release())
+          return false;
+        auto File = O.Binary ? FS.openFileForReadBinary(O.Path)
+                             : FS.openFileForRead(O.Path);
+        if (!File) {
+          if (O.Operation != Open || !O.Error || O.Error != File.getError())
+            return false;
+          continue;
+        }
+        Held = std::move(*File);
+        HeldPath = O.Path;
+        HeldBinary = O.Binary;
+      }
+      bool Match = true;
+      if (O.Operation == Open)
+        Match = !O.Error;
+      else if (O.Operation == FileStat) {
+        auto Now = Held->status();
+        Match = SameStatus(O, Now);
+        if (Match && Now && unchangedOnDisk(O, *Now))
+          HeldOnDisk = *Now;
+      } else if (O.Operation == FileName) {
+        auto Name = Held->getName();
+        Match = O.Error ? !Name && Name.getError() == O.Error
+                        : Name && *Name == O.Name;
+      } else if (O.Operation == Read) {
+        // Bytes read whole from a file shown unchanged on disk are the bytes
+        // read then: clang's own input validation trusts the same metadata.
+        if (!O.Error && O.RequestedSize < 0 && HeldOnDisk &&
+            HeldOnDisk->getSize() == O.Size)
+          continue;
+        auto Buffer =
+            Held->getBuffer(O.Name, O.RequestedSize, O.NullTerminated, true);
+        Match = O.Error ? !Buffer && Buffer.getError() == O.Error
+                        : Buffer && (*Buffer)->getBufferSize() == O.Size &&
+                              fingerprint((*Buffer)->getBuffer()) == O.Bytes;
+      }
+      if (!Match)
+        return false;
+    }
+    return Release() && !isCancelled();
+  }
+
+  // A file whose metadata equals what was recorded can still have other bytes
+  // when it is an overlay buffer, or was written again within the timestamp
+  // granularity of the recording. Neither holds for a file on disk, with the
+  // same identity, last modified well before the recording began.
+  bool unchangedOnDisk(const Observation &O,
+                       const llvm::vfs::Status &Now) const {
+    if (!O.Info || O.Info->ID != Now.getUniqueID() ||
+        O.Info->MTime == llvm::sys::TimePoint<>() ||
+        O.Info->MTime + std::chrono::seconds(30) >= RecordedAt)
+      return false;
+    llvm::SmallString<256> Path(O.Path);
+    if (llvm::sys::path::is_relative(Path))
+      llvm::sys::path::make_absolute(WorkingDirectory, Path);
+    llvm::sys::fs::file_status Disk;
+    return !llvm::sys::fs::status(Path, Disk) &&
+           Disk.getUniqueID() == Now.getUniqueID() &&
+           Disk.getSize() == Now.getSize() &&
+           Disk.getLastModificationTime() == Now.getLastModificationTime();
+  }
+
+private:
+  static size_t stringBytes(const Observation &O) {
+    return O.Path.capacity() + O.Name.capacity() + 64 +
+           (O.Info ? O.Info->Name.capacity() + 32 : 0);
+  }
+  size_t findSlot(llvm::ArrayRef<uint32_t> Table, const Observation &O) const {
+    size_t Slot =
+        size_t(llvm::hash_combine(O.Operation, O.Path)) & (Table.size() - 1);
+    while (Table[Slot] && !(Observations[Table[Slot] - 1] == O))
+      Slot = (Slot + 1) & (Table.size() - 1);
+    return Slot;
+  }
+  // Only add() mutates observations, preserving the accounting/index invariant.
+  // Public ownedBytes() still recomputes actual capacities after manifest
+  // copies.
+  std::vector<Observation> Observations;
+  std::vector<uint32_t> FactIndex;
+  size_t RecordedStringBytes = 0, IndexedFacts = 0;
+};
+
+class ModuleScanRecordingFS : public llvm::vfs::ProxyFileSystem {
+public:
+  ModuleScanRecordingFS(llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> Base,
+                        std::shared_ptr<ModuleScanManifest> Manifest)
+      : ProxyFileSystem(std::move(Base)), Manifest(std::move(Manifest)) {
+    auto CWD = getUnderlyingFS().getCurrentWorkingDirectory();
+    if (CWD)
+      this->Manifest->WorkingDirectory = *CWD;
+    else
+      this->Manifest->Complete = false;
+  }
+
+  llvm::ErrorOr<llvm::vfs::Status> status(const llvm::Twine &Path) override {
+    auto Result = getUnderlyingFS().status(Path);
+    ModuleScanManifest::Observation O{ModuleScanManifest::Stat, absolute(Path)};
+    if (Result)
+      O.Info.emplace(*Result);
+    else
+      O.Error = Result.getError();
+    Manifest->add(std::move(O));
+    return Result;
+  }
+  bool exists(const llvm::Twine &Path) override {
+    bool Result = getUnderlyingFS().exists(Path);
+    ModuleScanManifest::Observation O{ModuleScanManifest::Exists,
+                                      absolute(Path)};
+    O.Found = Result;
+    Manifest->add(std::move(O));
+    return Result;
+  }
+  llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>
+  openFileForRead(const llvm::Twine &Path) override {
+    return open(Path, false);
+  }
+  llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>>
+  openFileForReadBinary(const llvm::Twine &Path) override {
+    return open(Path, true);
+  }
+
+  // Directory iteration records exactly the prefix the driver observed.
+  // Other unsupported operations delegate unchanged and decline admission.
+  llvm::vfs::directory_iterator dir_begin(const llvm::Twine &Path,
+                                          std::error_code &EC) override {
+    auto Result = getUnderlyingFS().dir_begin(Path, EC);
+    uint64_t ID = Manifest->NextDirectory++;
+    recordDirectory(ModuleScanManifest::DirectoryBegin, Path.str(), ID, Result,
+                    EC, Manifest);
+    if (Result == llvm::vfs::directory_iterator())
+      return Result;
+    return llvm::vfs::directory_iterator(std::make_shared<ObservedDirectory>(
+        std::move(Result), Path.str(), ID, Manifest));
+  }
+  std::error_code getRealPath(const llvm::Twine &Path,
+                              llvm::SmallVectorImpl<char> &Out) override {
+    // Preserve the original input spelling and CWD. Do not replace lookup
+    // paths with canonical paths: symlink changes must invalidate replay.
+    // An initially populated output is outside this observation contract.
+    if (!Out.empty())
+      Manifest->Complete = false;
+    auto EC = getUnderlyingFS().getRealPath(Path, Out);
+    ModuleScanManifest::Observation O{ModuleScanManifest::RealPath, Path.str()};
+    O.Error = EC;
+    O.Name.assign(Out.begin(), Out.end());
+    Manifest->add(std::move(O));
+    return EC;
+  }
+  void visitChildFileSystems(VisitCallbackTy Callback) override {
+    if (Manifest->Complete)
+      vlog("Module dependency scan manifest unsupported child filesystem visit");
+    Manifest->Complete = false;
+    getUnderlyingFS().visitChildFileSystems(Callback);
+  }
+  std::error_code isLocal(const llvm::Twine &Path, bool &Result) override {
+    if (Manifest->Complete)
+      vlog("Module dependency scan manifest unsupported locality: {0}", Path);
+    Manifest->Complete = false;
+    return getUnderlyingFS().isLocal(Path, Result);
+  }
+  std::error_code setCurrentWorkingDirectory(const llvm::Twine &Path) override {
+    std::string Target = absolute(Path);
+    auto EC = getUnderlyingFS().setCurrentWorkingDirectory(Path);
+    auto Now = getUnderlyingFS().getCurrentWorkingDirectory();
+    if (EC || !Now || *Now != Manifest->WorkingDirectory ||
+        Target != Manifest->WorkingDirectory)
+      Manifest->Complete = false;
+    return EC;
+  }
+  llvm::ErrorOr<std::string> getCurrentWorkingDirectory() const override {
+    auto Now = getUnderlyingFS().getCurrentWorkingDirectory();
+    if (!Now || *Now != Manifest->WorkingDirectory)
+      Manifest->Complete = false;
+    return Now;
+  }
+  std::error_code
+  makeAbsolute(llvm::SmallVectorImpl<char> &Path) const override {
+    ModuleScanManifest::Observation O{
+        ModuleScanManifest::Absolute,
+        llvm::StringRef(Path.data(), Path.size()).str()};
+    auto EC = getUnderlyingFS().makeAbsolute(Path);
+    O.Error = EC;
+    O.Name = llvm::StringRef(Path.data(), Path.size()).str();
+    Manifest->add(std::move(O));
+    return EC;
+  }
+
+private:
+  static void recordDirectory(ModuleScanManifest::Kind Kind, std::string Path,
+                              uint64_t ID,
+                              const llvm::vfs::directory_iterator &I,
+                              std::error_code EC,
+                              const std::shared_ptr<ModuleScanManifest> &M) {
+    ModuleScanManifest::Observation O{Kind, std::move(Path)};
+    O.Size = ID;
+    O.Error = EC;
+    O.Found = I != llvm::vfs::directory_iterator();
+    if (O.Found) {
+      O.Name = I->path();
+      O.EntryType = I->type();
+    }
+    M->add(std::move(O));
+  }
+  class ObservedDirectory : public llvm::vfs::detail::DirIterImpl {
+  public:
+    ObservedDirectory(llvm::vfs::directory_iterator Base, std::string Path,
+                      uint64_t ID, std::shared_ptr<ModuleScanManifest> Manifest)
+        : Base(std::move(Base)), Path(std::move(Path)), ID(ID),
+          Manifest(std::move(Manifest)) {
+      CurrentEntry = *this->Base;
+    }
+    std::error_code increment() override {
+      std::error_code EC;
+      Base.increment(EC);
+      CurrentEntry = Base == llvm::vfs::directory_iterator()
+                         ? llvm::vfs::directory_entry()
+                         : *Base;
+      recordDirectory(ModuleScanManifest::DirectoryNext, Path, ID, Base, EC,
+                      Manifest);
+      return EC;
+    }
+
+  private:
+    llvm::vfs::directory_iterator Base;
+    std::string Path;
+    uint64_t ID;
+    std::shared_ptr<ModuleScanManifest> Manifest;
+  };
+  std::string absolute(const llvm::Twine &Path) const {
+    llvm::SmallString<256> Result;
+    Path.toVector(Result);
+    if (makeAbsolute(Result))
+      Manifest->Complete = false;
+    return Result.str().str();
+  }
+  llvm::ErrorOr<std::unique_ptr<llvm::vfs::File>> open(const llvm::Twine &Path,
+                                                       bool Binary) {
+    auto Result = Binary ? getUnderlyingFS().openFileForReadBinary(Path)
+                         : getUnderlyingFS().openFileForRead(Path);
+    std::string Name = absolute(Path);
+    ModuleScanManifest::Observation O{ModuleScanManifest::Open, Name};
+    O.Binary = Binary;
+    if (!Result)
+      O.Error = Result.getError();
+    Manifest->add(std::move(O));
+    if (!Result)
+      return Result;
+    return std::make_unique<ObservedFile>(std::move(*Result), std::move(Name),
+                                          Manifest, Binary);
+  }
+  class ObservedFile : public llvm::vfs::File {
+  public:
+    ObservedFile(std::unique_ptr<llvm::vfs::File> Base, std::string Path,
+                 std::shared_ptr<ModuleScanManifest> Manifest, bool Binary)
+        : Base(std::move(Base)), Path(std::move(Path)),
+          Manifest(std::move(Manifest)), Binary(Binary) {}
+    ~ObservedFile() override {
+      if (!Closed)
+        close();
+    }
+    llvm::ErrorOr<llvm::vfs::Status> status() override {
+      auto Result = Base->status();
+      ModuleScanManifest::Observation O{ModuleScanManifest::FileStat, Path};
+      O.Binary = Binary;
+      if (Result)
+        O.Info.emplace(*Result);
+      else
+        O.Error = Result.getError();
+      Manifest->add(std::move(O));
+      return Result;
+    }
+    llvm::ErrorOr<std::string> getName() override {
+      auto Result = Base->getName();
+      ModuleScanManifest::Observation O{ModuleScanManifest::FileName, Path};
+      O.Binary = Binary;
+      if (Result)
+        O.Name = *Result;
+      else
+        O.Error = Result.getError();
+      Manifest->add(std::move(O));
+      return Result;
+    }
+    llvm::ErrorOr<std::unique_ptr<llvm::MemoryBuffer>>
+    getBuffer(const llvm::Twine &Name, int64_t Size, bool NullTerm,
+              bool /*Volatile*/) override {
+      auto Result = Base->getBuffer(Name, Size, NullTerm, true);
+      ModuleScanManifest::Observation O{ModuleScanManifest::Read, Path};
+      O.Binary = Binary;
+      O.Name = Name.str();
+      O.RequestedSize = Size;
+      O.NullTerminated = NullTerm;
+      if (Result) {
+        // Default driver .cfg files can redirect to an unobserved native
+        // toolchain. Their absence is replayable; a present file declines.
+        if (llvm::StringRef(Path).ends_with(".cfg"))
+          Manifest->Complete = false;
+        O.Size = (*Result)->getBufferSize();
+        O.Bytes = ModuleScanManifest::fingerprint((*Result)->getBuffer());
+      } else
+        O.Error = Result.getError();
+      Manifest->add(std::move(O));
+      return Result;
+    }
+    std::error_code close() override {
+      auto EC = Base->close();
+      Closed = true;
+      if (EC)
+        Manifest->Complete = false;
+      return EC;
+    }
+
+  private:
+    std::unique_ptr<llvm::vfs::File> Base;
+    std::string Path;
+    std::shared_ptr<ModuleScanManifest> Manifest;
+    bool Closed = false;
+    bool Binary;
+  };
+  std::shared_ptr<ModuleScanManifest> Manifest;
+};
+
+// Process-wide bounds also cover evicted entries borrowed by validators. CDB
+// identities are weak: expired generations cannot match or retain whole CDBs.
+class ModuleDependencyScanCache {
+  struct Budget {
+    std::atomic<size_t> Entries{0}, Bytes{0};
+    bool reserve(size_t Size) {
+      auto Count = Entries.load();
+      do {
+        if (Count >= 256)
+          return false;
+      } while (!Entries.compare_exchange_weak(Count, Count + 1));
+      auto Total = Bytes.load();
+      do {
+        if (Size > ModuleScanManifest::ByteLimit - Total) {
+          --Entries;
+          return false;
+        }
+      } while (!Bytes.compare_exchange_weak(Total, Total + Size));
+      return true;
+    }
+  };
+  struct Entry {
+    std::weak_ptr<const tooling::CompilationDatabase> CDB;
+    std::string File;
+    tooling::CompileCommand Command;
+    ModuleScanManifest::Digest MainBytes, Environment;
+    ModuleScanManifest Inputs;
+    ModuleScanResult Result;
+    std::shared_ptr<Budget> Owner;
+    size_t Bytes;
+    ~Entry() {
+      Owner->Bytes.fetch_sub(Bytes);
+      --Owner->Entries;
+    }
+  };
+
+  // Flights coordinate publication only. Their independently bounded metadata
+  // does not consume the retained manifest budget or own scanner results/VFSs.
+  struct FlightBudget {
+    std::atomic<size_t> Bytes{0};
+  };
+  struct Flight {
+    std::weak_ptr<const tooling::CompilationDatabase> CDB;
+    std::string File;
+    tooling::CompileCommand Command;
+    ModuleScanManifest::Digest MainBytes, Environment;
+    std::thread::id Thread;
+    std::mutex Mu;
+    std::condition_variable Published;
+    bool Done = false;
+    std::shared_ptr<FlightBudget> Budget;
+    size_t Bytes = 0;
+    ~Flight() {
+      if (Budget)
+        Budget->Bytes.fetch_sub(Bytes);
+    }
+  };
+  struct Flights {
+    std::mutex Mu;
+    std::atomic<uint64_t> Followers{0};
+    std::vector<std::shared_ptr<Flight>> Active;
+    std::shared_ptr<FlightBudget> Budget = std::make_shared<FlightBudget>();
+    Flights() { Active.reserve(64); }
+  };
+
+public:
+  class PublicationFlight {
+  public:
+    PublicationFlight() = default;
+    PublicationFlight(PublicationFlight &&Other) noexcept
+        : Registry(std::move(Other.Registry)), Item(std::move(Other.Item)),
+          Leader(std::exchange(Other.Leader, false)) {}
+    PublicationFlight &operator=(PublicationFlight &&Other) noexcept {
+      finish();
+      Registry = std::move(Other.Registry);
+      Item = std::move(Other.Item);
+      Leader = std::exchange(Other.Leader, false);
+      return *this;
+    }
+    ~PublicationFlight() { finish(); }
+    bool follower() const { return Item && !Leader; }
+    // A notification grants no result: callers must perform ordinary lookup,
+    // including complete manifest replay against their own current VFS.
+    void wait() {
+      if (!follower())
+        return;
+      auto Deadline =
+          std::chrono::steady_clock::now() + std::chrono::milliseconds(150);
+      std::unique_lock<std::mutex> Lock(Item->Mu);
+      while (!Item->Done && !isCancelled()) {
+        auto Now = std::chrono::steady_clock::now();
+        if (Now >= Deadline)
+          break;
+        Item->Published.wait_until(
+            Lock, std::min(Deadline, Now + std::chrono::milliseconds(5)));
+      }
+    }
+
+  private:
+    friend class ModuleDependencyScanCache;
+    PublicationFlight(std::shared_ptr<Flights> Registry,
+                      std::shared_ptr<Flight> Item, bool Leader)
+        : Registry(std::move(Registry)), Item(std::move(Item)), Leader(Leader) {
+    }
+    void finish() {
+      if (!Leader || !Item)
+        return;
+      // Remove before notifying. A subsequent owner rechecks the cache after
+      // acquiring its flight, closing the publication/acquisition race.
+      {
+        std::lock_guard<std::mutex> Lock(Registry->Mu);
+        auto &Active = Registry->Active;
+        Active.erase(std::remove(Active.begin(), Active.end(), Item),
+                     Active.end());
+      }
+      {
+        std::lock_guard<std::mutex> Lock(Item->Mu);
+        Item->Done = true;
+      }
+      Item->Published.notify_all();
+      Leader = false;
+    }
+    std::shared_ptr<Flights> Registry;
+    std::shared_ptr<Flight> Item;
+    bool Leader = false;
+  };
+
+  PublicationFlight beginPublication(
+      const std::shared_ptr<const tooling::CompilationDatabase> &CDB,
+      llvm::StringRef File, const tooling::CompileCommand &Command,
+      ModuleScanManifest::Digest MainBytes,
+      ModuleScanManifest::Digest Environment) {
+    constexpr size_t KeyLimit = 64 * 1024;
+    constexpr size_t TotalLimit = 4 * 1024 * 1024;
+    // Bound allocation before copying any request-owned strings or argv.
+    size_t Estimate = sizeof(Flight) + 64;
+    auto Add = [&](size_t Size) {
+      if (Size > (KeyLimit - Estimate) / 2)
+        return false;
+      Estimate += Size * 2;
+      return true;
+    };
+    if (!Add(File.size() + 32) || !Add(Command.Directory.size() + 32) ||
+        !Add(Command.Filename.size() + 32) ||
+        !Add(Command.Output.size() + 32) ||
+        !Add(Command.Heuristic.size() + 32) ||
+        Command.CommandLine.size() > KeyLimit / (2 * sizeof(std::string)) ||
+        !Add(Command.CommandLine.size() * sizeof(std::string)))
+      return {};
+    for (const auto &Arg : Command.CommandLine)
+      if (!Add(Arg.size() + 32))
+        return {};
+    if (!CDB || isCancelled())
+      return {};
+    std::lock_guard<std::mutex> Lock(FlightRegistry->Mu);
+    for (const auto &Existing : FlightRegistry->Active)
+      if (Existing->CDB.lock() == CDB && Existing->File == File &&
+          Existing->Command == Command && Existing->MainBytes == MainBytes &&
+          Existing->Environment == Environment) {
+        // Recursive scans must never wait for themselves.
+        if (Existing->Thread == std::this_thread::get_id())
+          return {};
+        ++FlightRegistry->Followers;
+        return {FlightRegistry, Existing, false};
+      }
+    // Include the fixed registry index in the independent 4 MiB allowance.
+    const size_t RegistryBytes =
+        sizeof(Flights) + sizeof(FlightBudget) + 64 +
+        FlightRegistry->Active.capacity() * sizeof(std::shared_ptr<Flight>);
+    if (FlightRegistry->Active.size() >= 64 ||
+        Estimate >
+            TotalLimit - RegistryBytes - FlightRegistry->Budget->Bytes.load())
+      return {};
+    auto Item = std::make_shared<Flight>();
+    Item->CDB = CDB;
+    Item->File = File.str();
+    Item->Command = Command;
+    Item->MainBytes = MainBytes;
+    Item->Environment = Environment;
+    Item->Thread = std::this_thread::get_id();
+    size_t Bytes = sizeof(Flight) + 64 + Item->File.capacity() + 32 +
+                   Item->Command.Directory.capacity() + 32 +
+                   Item->Command.Filename.capacity() + 32 +
+                   Item->Command.Output.capacity() + 32 +
+                   Item->Command.Heuristic.capacity() + 32 +
+                   Item->Command.CommandLine.capacity() * sizeof(std::string);
+    for (const auto &Arg : Item->Command.CommandLine)
+      Bytes += Arg.capacity() + 32;
+    if (Bytes > KeyLimit || Bytes > TotalLimit - RegistryBytes -
+                                        FlightRegistry->Budget->Bytes.load())
+      return {};
+    Item->Bytes = Bytes;
+    Item->Budget = FlightRegistry->Budget;
+    Item->Budget->Bytes.fetch_add(Bytes);
+    FlightRegistry->Active.push_back(Item);
+    return {FlightRegistry, std::move(Item), true};
+  }
+  uint64_t publicationFollowers() const {
+    return FlightRegistry->Followers.load();
+  }
+  std::pair<size_t, size_t> publicationBounds() const {
+    std::lock_guard<std::mutex> Lock(FlightRegistry->Mu);
+    return {FlightRegistry->Active.size(),
+            FlightRegistry->Budget->Bytes.load()};
+  }
+  struct Stats {
+    uint64_t Hits, Misses, Invalidations, Stores, Declines, Evictions;
+    size_t Entries, Bytes;
+  };
+  Stats stats() const {
+    return {Hits.load(),           Misses.load(),      Invalidations.load(),
+            Stores.load(),         Declines.load(),    Evictions.load(),
+            Owner->Entries.load(), Owner->Bytes.load()};
+  }
+  std::optional<ModuleScanResult>
+  lookup(const std::shared_ptr<const tooling::CompilationDatabase> &CDB,
+         llvm::StringRef File, const tooling::CompileCommand &Command,
+         ModuleScanManifest::Digest MainBytes, llvm::vfs::FileSystem &FS) {
+    auto Environment = ModuleScanManifest::environment(Command);
+    if (!Environment) {
+      ++Misses;
+      return std::nullopt;
+    }
+    std::shared_ptr<Entry> Candidate;
+    {
+      std::lock_guard<std::mutex> Lock(Mu);
+      for (auto I = Entries.begin(); I != Entries.end();) {
+        auto Generation = (*I)->CDB.lock();
+        if (!Generation) {
+          I = Entries.erase(I);
+          continue;
+        }
+        if (Generation == CDB && (*I)->File == File &&
+            (*I)->Command == Command && (*I)->MainBytes == MainBytes &&
+            (*I)->Environment == *Environment) {
+          Candidate = *I;
+          Entries.splice(Entries.begin(), Entries, I);
+          break;
+        }
+        ++I;
+      }
+    }
+    if (!Candidate) {
+      ++Misses;
+      return std::nullopt;
+    }
+    if (!Candidate->Inputs.matches(FS)) {
+      if (isCancelled())
+        return std::nullopt;
+      std::lock_guard<std::mutex> Lock(Mu);
+      Entries.remove(Candidate);
+      ++Misses;
+      ++Invalidations;
+      vlog("Module dependency scan memo invalidated: {0}", File);
+      return std::nullopt;
+    }
+    if (isCancelled())
+      return std::nullopt;
+    ++Hits;
+    vlog("Module dependency scan memo hit: {0}", File);
+    return Candidate->Result;
+  }
+
+  void store(const std::shared_ptr<const tooling::CompilationDatabase> &CDB,
+             llvm::StringRef File, tooling::CompileCommand Command,
+             ModuleScanManifest::Digest MainBytes,
+             ModuleScanManifest::Digest Environment, ModuleScanManifest Inputs,
+             ModuleScanResult Result, llvm::vfs::FileSystem &FS) {
+    if (isCancelled() ||
+        (Result.FailureDiagnostic &&
+         Result.FailureDiagnostic->capacity() >
+             ModuleScanResult::FailureDiagnosticByteLimit) ||
+        Environment != ModuleScanManifest::environment(Command) ||
+        !Inputs.matches(FS) || isCancelled()) {
+      ++Declines;
+      vlog("Module dependency scan memo declined: {0}", File);
+      return;
+    }
+    size_t Bytes = Inputs.ownedBytes() + sizeof(Entry) + File.size() + 32 +
+                   Command.Directory.capacity() + Command.Filename.capacity() +
+                   Command.Output.capacity() + Command.Heuristic.capacity() +
+                   Command.CommandLine.capacity() * sizeof(std::string) + 160 +
+                   Result.RequiredModules.capacity() * sizeof(std::string);
+    for (const auto &Arg : Command.CommandLine)
+      Bytes += Arg.capacity() + 32;
+    for (const auto &Name : Result.RequiredModules)
+      Bytes += Name.capacity() + 32;
+    if (Result.ModuleName)
+      Bytes += Result.ModuleName->capacity() + 32;
+    if (Result.FailureDiagnostic)
+      Bytes += Result.FailureDiagnostic->capacity() + 32;
+    if (Bytes > ModuleScanManifest::ByteLimit) {
+      ++Declines;
+      return;
+    }
+    std::lock_guard<std::mutex> Lock(Mu);
+    if (isCancelled()) {
+      ++Declines;
+      return;
+    }
+    while (!Owner->reserve(Bytes)) {
+      if (isCancelled()) {
+        ++Declines;
+        return;
+      }
+      if (Entries.empty()) {
+        ++Declines;
+        vlog("Module dependency scan memo budget decline: {0}", File);
+        return;
+      }
+      Entries.pop_back();
+      ++Evictions;
+    }
+    auto Added = std::make_shared<Entry>();
+    Added->CDB = CDB;
+    Added->File = File;
+    Added->Command = std::move(Command);
+    Added->MainBytes = MainBytes;
+    Added->Environment = Environment;
+    Added->Inputs = std::move(Inputs);
+    Added->Result = std::move(Result);
+    Added->Owner = Owner;
+    Added->Bytes = Bytes;
+    if (isCancelled()) {
+      ++Declines;
+      return;
+    }
+    Entries.push_front(std::move(Added));
+    ++Stores;
+    vlog("Module dependency scan memo stored: {0} (entries={1}, bytes={2})",
+         File, Owner->Entries.load(), Owner->Bytes.load());
+  }
+
+private:
+  std::shared_ptr<Flights> FlightRegistry = std::make_shared<Flights>();
+  std::mutex Mu;
+  std::list<std::shared_ptr<Entry>> Entries;
+  std::shared_ptr<Budget> Owner = std::make_shared<Budget>();
+  std::atomic<uint64_t> Hits{0}, Misses{0}, Invalidations{0}, Stores{0},
+      Declines{0}, Evictions{0};
+};
