 namespace {
+// Only GNU/Linux toolchain discovery has a reviewed VFS observation contract.
+// Other targets can consult native registries/configuration outside that VFS.
+// Require both host and inferred/explicit command targets, rather than relying
+// on the host or executable basename alone. Unknown indirection declines.
+bool hasObservableDriverInputs(const tooling::CompileCommand &Command) {
+  llvm::Triple Target(llvm::sys::getDefaultTargetTriple());
+  if (!Target.isOSLinux() || Target.isAndroid() || Command.CommandLine.empty())
+    return false;
+  auto Name = driver::ToolChain::getTargetAndModeFromProgramName(
+      Command.CommandLine.front());
+  if (!Name.TargetPrefix.empty()) {
+    if (!Name.TargetIsValid)
+      return false;
+    Target = llvm::Triple(llvm::Triple::normalize(Name.TargetPrefix));
+    if (!Target.isOSLinux() || Target.isAndroid())
+      return false;
+  }
+  if (Name.DriverMode &&
+      llvm::StringRef(Name.DriverMode) != "--driver-mode=gcc" &&
+      llvm::StringRef(Name.DriverMode) != "--driver-mode=g++")
+    return false;
+  for (size_t I = 1; I < Command.CommandLine.size(); ++I) {
+    llvm::StringRef Arg = Command.CommandLine[I];
+    // Driver/frontend native CPU selection observes host state outside VFS.
+    // Reject standalone values too, including -Xclang -target-cpu ... native.
+    if (Arg == "native" || Arg.ends_with("=native"))
+      return false;
+    if (Arg == "-target" || Arg == "--target") {
+      if (++I == Command.CommandLine.size())
+        return false;
+      Target = llvm::Triple(llvm::Triple::normalize(Command.CommandLine[I]));
+    } else if (Arg.consume_front("--target=") || Arg.consume_front("-target="))
+      Target = llvm::Triple(llvm::Triple::normalize(Arg));
+    else if (Arg.starts_with("--driver-mode=")) {
+      if (Arg != "--driver-mode=gcc" && Arg != "--driver-mode=g++")
+        return false;
+    } else if (Arg.starts_with("--config") || Arg == "-arch" ||
+               Arg.starts_with("-Xarch_") || Arg.starts_with("--offload") ||
+               Arg.starts_with("--cuda") || Arg.starts_with("--hip") ||
+               Arg.starts_with("-fopenmp-targets=") ||
+               Arg.starts_with("-fsycl") || Arg == "-xhip" || Arg == "-xcuda")
+      return false;
+    else if (Arg == "-x" && I + 1 < Command.CommandLine.size() &&
+             (Command.CommandLine[I + 1] == "hip" ||
+              Command.CommandLine[I + 1] == "cuda"))
+      return false;
+  }
+  return Target.isOSLinux() && !Target.isAndroid();
+}
+// Filesystem replay cannot reproduce wall-clock builtin expansion. Observe
+// actual preprocessing: comments, strings, inactive branches and ordinary
+// token pasting need not prevent otherwise verified reuse.
+class ModuleScanBuiltinCollector : public DependencyCollector {
+  class Callbacks : public PPCallbacks {
+  public:
+    explicit Callbacks(std::shared_ptr<ModuleScanManifest> Inputs)
+        : Inputs(std::move(Inputs)) {}
+    void MacroExpands(const Token &Tok, const MacroDefinition &Definition,
+                      SourceRange, const MacroArgs *) override {
+      const MacroInfo *Info = Definition.getMacroInfo();
+      if (!Info || !Info->isBuiltinMacro() || !Tok.getIdentifierInfo())
+        return;
+      llvm::StringRef Name = Tok.getIdentifierInfo()->getName();
+      if (Name == "__DATE__" || Name == "__TIME__" || Name == "__TIMESTAMP__")
+        Inputs->Complete = false;
+    }
+
+  private:
+    std::shared_ptr<ModuleScanManifest> Inputs;
+  };
+
+public:
+  explicit ModuleScanBuiltinCollector(std::shared_ptr<ModuleScanManifest> Inputs)
+      : Inputs(std::move(Inputs)) {}
+  void attachToPreprocessor(Preprocessor &PP) override {
+    PP.addPPCallbacks(std::make_unique<Callbacks>(Inputs));
+  }
+
+private:
+  std::shared_ptr<ModuleScanManifest> Inputs;
+};
