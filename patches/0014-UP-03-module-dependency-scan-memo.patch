+TEST_F(PrerequisiteModulesTests, ScanMemoCompactsIdenticalIdempotentFacts) {
+  auto View = FS.view(TestDir);
+  auto Inputs = std::make_shared<ModuleScanManifest>();
+  auto Recording = llvm::makeIntrusiveRefCnt<ModuleScanRecordingFS>(View, Inputs);
+  llvm::SmallString<256> Path("same.h");
+  ASSERT_FALSE(Recording->makeAbsolute(Path));
+  ASSERT_EQ(Inputs->observations().size(), 1u);
+  const auto Original = Inputs->observations().front();
+  for (size_t I = 0; I < ModuleScanManifest::ProbeLimit * 2; ++I)
+    Inputs->add(Original);
+  EXPECT_TRUE(Inputs->Complete);
+  EXPECT_EQ(Inputs->observations().size(), 1u);
+  EXPECT_TRUE(Inputs->matches(*View));
+  auto Changed = Original;
+  Changed.Name += "/different";
+  Inputs->add(Changed);
+  EXPECT_EQ(Inputs->observations().size(), 2u);
+  EXPECT_FALSE(Inputs->matches(*View));
+  Changed = Original;
+  Changed.Binary = true;
+  Inputs->add(Changed);
+  EXPECT_EQ(Inputs->observations().size(), 3u);
+  Changed = Original;
+  Changed.Bytes.front() = 1;
+  Inputs->add(Changed);
+  EXPECT_EQ(Inputs->observations().size(), 4u);
+  // All status fields participate, including alias identity.
+  auto Status = View->status(TestDir);
+  ASSERT_TRUE(Status);
+  ModuleScanManifest::Observation Stat{ModuleScanManifest::Stat,
+                                       TestDir.str().str()};
+  Stat.Info.emplace(*Status);
+  Inputs->add(Stat);
+  Inputs->add(Stat);
+  EXPECT_EQ(Inputs->observations().size(), 5u);
+  Stat.Info->ID = llvm::sys::fs::UniqueID(100, 200);
+  Inputs->add(Stat);
+  EXPECT_EQ(Inputs->observations().size(), 6u);
+  Changed.Operation = ModuleScanManifest::DirectoryBegin;
+  Inputs->add(Changed);
+  Inputs->add(Changed);
+  EXPECT_EQ(Inputs->observations().size(), 8u);
+  ModuleScanManifest Bounded;
+  for (size_t I = 0; I < ModuleScanManifest::ProbeLimit; ++I)
+    Bounded.add(Changed); // Ordered directory events cannot be compacted.
+  EXPECT_TRUE(Bounded.Complete);
+  EXPECT_EQ(Bounded.observations().size(), ModuleScanManifest::ProbeLimit);
+  Bounded.add(Changed);
+  EXPECT_FALSE(Bounded.Complete);
+  EXPECT_EQ(Bounded.observations().size(), ModuleScanManifest::ProbeLimit);
+}
