+TEST_F(PrerequisiteModulesTests, ScanMemoTrustsSettledHeaderMetadata) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission currently covers Linux drivers";
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "#include \"settled.h\"\n");
+  CDB.addFile("settled.h", "import M;\n");
+  auto Generation = CDB.toolingCDB();
+  auto Commands = createProjectModulesCommandCache(Generation, true);
+  const auto Use = getFullPath("Use.cpp");
+  const auto Header = getFullPath("settled.h");
+  auto Scan = [&] {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Commands);
+    return Modules->getRequiredModules(Use);
+  };
+  auto Write = [&](char Module, std::optional<llvm::sys::TimePoint<>> When) {
+    {
+      std::error_code EC;
+      llvm::raw_fd_ostream Out(Header, EC);
+      ASSERT_FALSE(EC);
+      Out << "import " << Module << ";\n";
+    }
+    if (When)
+      ASSERT_FALSE(
+          llvm::sys::fs::setLastAccessAndModificationTime(Header, *When, *When));
+  };
+  // A header last modified long before the scan, still the same file with
+  // the same size and time, is not read again: its metadata is trusted, as
+  // clang trusts it for a module's inputs.
+  const llvm::sys::TimePoint<> Settled =
+      std::chrono::system_clock::now() - std::chrono::hours(1);
+  Write('M', Settled);
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  auto Before = getModuleDependencyScanCache().stats();
+  Write('N', Settled);
+  EXPECT_THAT(Scan(), testing::ElementsAre("M"));
+  EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  // A header modified around the scan is: equal metadata does not show that
+  // a write within the timestamp's granularity left the bytes alone.
+  Write('P', std::nullopt);
+  EXPECT_THAT(Scan(), testing::ElementsAre("P"));
+  llvm::sys::fs::file_status Recent;
+  ASSERT_FALSE(llvm::sys::fs::status(Header, Recent));
+  Before = getModuleDependencyScanCache().stats();
+  Write('Q', Recent.getLastModificationTime());
+  EXPECT_THAT(Scan(), testing::ElementsAre("Q"));
+  EXPECT_GT(getModuleDependencyScanCache().stats().Invalidations,
+            Before.Invalidations);
+}
