+      if (O.Operation == ModuleScanManifest::Read)
+        LastRead.add(O);
+    ASSERT_EQ(LastRead.observations().size(), 1u);
+    auto ReplayTask = cancelableTask();
+    CancelOnReadFS CancelDuringReplay(FS, Use, ReplayTask.second);
+    auto ReplayView = CancelDuringReplay.view(Command.Directory);
+    WithContext Context(std::move(ReplayTask.first));
+    ModuleDependencyScanCache CanceledCache;
+    ModuleScanResult SmallFailure;
+    SmallFailure.FailureDiagnostic = "observed semantic error";
+    CanceledCache.store(Generation, Use, Command, MainBytes, *Environment,
+                        LastRead, SmallFailure, *ReplayView);
+    EXPECT_EQ(CancelDuringReplay.Triggered, 1u);
+    EXPECT_TRUE(isCancelled());
+    EXPECT_EQ(CanceledCache.stats().Stores, 0u);
+    EXPECT_EQ(CanceledCache.stats().Entries, 0u);
+    EXPECT_EQ(CanceledCache.stats().Bytes, 0u);
+  }
+  auto Task = cancelableTask();
+  Task.second();
+  WithContext Context(std::move(Task.first));
+  Failure.FailureDiagnostic = "observed semantic error";
+  Cache.store(Generation, Use, Command, MainBytes, *Environment, *Inputs,
+              Failure, *View);
+  EXPECT_EQ(Cache.stats().Stores, Before.Stores);
+  EXPECT_FALSE(Cache.lookup(Generation, Use, Command, MainBytes, *View));
+}
