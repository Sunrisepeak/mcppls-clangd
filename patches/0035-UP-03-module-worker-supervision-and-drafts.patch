+llvm::Expected<std::optional<ModuleBuildWorkerResult>>
+buildModuleInWorker(const CompilerInvocation &Invocation,
+                    StringRef MainContents, const ThreadsafeFS &FS,
+                    PathRef WorkingDirectory,
+                    const ModuleBuildWorkerOptions &Options) {
+  if (Options.Isolation == ModuleBuildWorkerOptions::Policy::InProcess)
+    return std::optional<ModuleBuildWorkerResult>{};
+  const auto Started = std::chrono::steady_clock::now();
+  auto Snapshot = FS.snapshotForModuleBuild();
+  if (!Snapshot) {
+    if (Options.Isolation == ModuleBuildWorkerOptions::Policy::WhenSupported)
+      return std::optional<ModuleBuildWorkerResult>{};
+    return llvm::createStringError(
+        "required module worker cannot export request filesystem");
+  }
+  if (Options.Timeout <= std::chrono::milliseconds::zero() ||
+      !llvm::sys::path::is_absolute(Options.Executable))
+    return llvm::createStringError(
+        "module worker requires an executable and positive timeout");
+  const auto Deadline = Started + Options.Timeout;
+  auto Cancelled = [&] { return Options.Cancelled && Options.Cancelled(); };
+  if (Cancelled())
+    return llvm::createStringError("module worker was cancelled before launch");
+  const std::string Output = Invocation.getFrontendOpts().OutputFile;
+  if (!llvm::sys::path::is_absolute(Output) || StringRef(Output).contains('\0'))
+    return llvm::createStringError(
+        "module worker staged output must be absolute");
+  if (llvm::sys::fs::exists(Output))
+    return llvm::createStringError(
+        "module worker staged output already exists");
+  llvm::SmallString<256> Directory;
+  if (auto EC = llvm::sys::fs::createUniqueDirectory("clangd-module-worker",
+                                                     Directory))
+    return llvm::errorCodeToError(EC);
+  bool Success = false;
+  auto Cleanup = llvm::scope_exit([&] {
+    llvm::sys::fs::remove_directories(Directory);
+    if (!Success)
+      llvm::sys::fs::remove(Output);
+  });
+  auto Path = [&](StringRef Name) {
+    llvm::SmallString<256> Result(Directory);
+    llvm::sys::path::append(Result, Name);
+    return Result.str().str();
+  };
+  ModuleBuildWorkerInputs Inputs;
+  Inputs.FileSystem =
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays;
+  Inputs.WorkingDirectory = WorkingDirectory.str();
+  if (Invocation.getFrontendOpts().Inputs.size() != 1 ||
+      !Invocation.getFrontendOpts().Inputs[0].isFile())
+    return llvm::createStringError("module worker requires a single main file");
+  Inputs.MainFile = Invocation.getFrontendOpts().Inputs[0].getFile().str();
+  Inputs.MainContentsFile = Path("main.snapshot");
+  if (auto Err = writeSnapshot(Inputs.MainContentsFile, MainContents))
+    return std::move(Err);
+  // Flatten repeated paths with last-overlay-wins semantics.
+  llvm::StringMap<const ModuleBuildFileSystemSnapshot::File *> Files;
+  for (const auto &File : Snapshot->OverlayFiles)
+    Files[File.Path] = &File;
+  llvm::vfs::YAMLVFSWriter Writer;
+  Writer.setUseExternalNames(false);
+  unsigned Index = 0;
+  for (const auto &Entry : Files) {
+    const auto &File = *Entry.getValue();
+    if (!llvm::sys::path::is_absolute(File.Path))
+      return llvm::createStringError(
+          "captured module worker paths must be absolute");
+    std::string ContentsPath = Path("overlay-" + std::to_string(Index++));
+    if (auto Err =
+            writeSnapshot(ContentsPath, File.Contents, File.ModificationTime))
+      return std::move(Err);
+    Writer.addFileMapping(File.Path, ContentsPath);
+  }
+  std::string YAML;
+  llvm::raw_string_ostream YAMLStream(YAML);
+  Writer.write(YAMLStream);
+  Inputs.OverlayFiles = {Path("filesystem.yaml")};
+  if (auto Err = writeSnapshot(Inputs.OverlayFiles.front(), YAML))
+    return std::move(Err);
+  CompilerInvocation WorkerInvocation(Invocation);
+  WorkerInvocation.getHeaderSearchOpts().ModuleCachePath = Path("module-cache");
+  auto Request = serializeModuleBuildWorkerRequest(WorkerInvocation, Inputs);
+  if (!Request)
+    return Request.takeError();
+  const std::string RequestPath = Path("request.json");
+  if (auto Err = writeSnapshot(RequestPath, *Request))
+    return std::move(Err);
+  if (Cancelled() || std::chrono::steady_clock::now() >= Deadline)
+    return llvm::createStringError(
+        "module worker was cancelled or timed out during capture");
+  const std::string DiagnosticsPath = Path("stderr.log");
+  std::array<std::optional<StringRef>, 3> Redirects{
+      StringRef(""), StringRef(""), StringRef(DiagnosticsPath)};
+  std::array<StringRef, 3> Args{Options.Executable, "--module-build-worker",
+                                RequestPath};
+  std::string LaunchError;
+  bool Failed = false;
+  auto Process =
+      llvm::sys::ExecuteNoWait(Options.Executable, Args, std::nullopt,
+                               Redirects, 0, &LaunchError, &Failed);
+  if (Failed || Process.Pid == llvm::sys::ProcessInfo::InvalidPid)
+    return llvm::createStringError("failed to launch module worker: " +
+                                   LaunchError);
+  // Declared after Cleanup: destruction always terminates/reaps before files
+  // and any caller-owned source locks/prerequisite leases can be released.
+  WorkerProcess Child(Process);
+  for (;;) {
+    auto Status = Child.reap(/*Blocking=*/false);
+    if (!Status)
+      return Status.takeError();
+    if (*Status) {
+      if (**Status != 0)
+        return llvm::createStringError("module worker failed: " +
+                                       workerDiagnostics(DiagnosticsPath));
+      break;
+    }
+    const bool WasCancelled = Cancelled();
+    if (WasCancelled || std::chrono::steady_clock::now() >= Deadline) {
+      Child.terminate();
+      auto Reaped = Child.reap(/*Blocking=*/true);
+      if (!Reaped)
+        return Reaped.takeError();
+      return llvm::createStringError(
+          llvm::formatv("module worker {0} (pid {1}): {2}",
+                        WasCancelled ? "cancelled" : "timed out", Process.Pid,
+                        workerDiagnostics(DiagnosticsPath))
+              .str());
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  if (Cancelled() || std::chrono::steady_clock::now() >= Deadline)
+    return llvm::createStringError(
+        "module worker cancelled or timed out before accepting output");
+  // A BMI must not reference prerequisites about to disappear with this
+  // worker's private cache. Explicit prerequisite copies remain parent-owned.
+  std::error_code EC;
+  for (llvm::sys::fs::recursive_directory_iterator I(Path("module-cache"), EC),
+       End;
+       I != End && !EC; I.increment(EC))
+    if (llvm::sys::path::extension(I->path()) == ".pcm")
+      return llvm::createStringError(
+          "module worker built uncaptured implicit prerequisites");
+  if (EC && EC != std::errc::no_such_file_or_directory)
+    return llvm::errorCodeToError(EC);
+  if (!llvm::sys::fs::exists(Output))
+    return llvm::createStringError("module worker produced no staged output");
+  Success = true;
+  return std::optional<ModuleBuildWorkerResult>(
+      {std::chrono::duration_cast<std::chrono::milliseconds>(
+           std::chrono::steady_clock::now() - Started),
+       Child.Statistics});
+}
