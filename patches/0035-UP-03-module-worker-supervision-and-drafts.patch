+// This deliberately avoids Program.cpp's process-global SIGALRM timeout.
+class WorkerProcess {
+public:
+  explicit WorkerProcess(llvm::sys::ProcessInfo Process) : Process(Process) {}
+  ~WorkerProcess() {
+    if (Active) {
+      terminate();
+      auto Reaped = reap(/*Blocking=*/true);
+      if (!Reaped)
+        llvm::consumeError(Reaped.takeError());
+    }
+  }
+  llvm::Expected<std::optional<int>> reap(bool Blocking) {
+#ifdef _WIN32
+    DWORD State = WaitForSingleObject(Process.Process, Blocking ? INFINITE : 0);
+    if (State == WAIT_TIMEOUT)
+      return std::optional<int>{};
+    if (State != WAIT_OBJECT_0)
+      return llvm::createStringError("failed waiting for module worker");
+    DWORD Code = 1;
+    if (!GetExitCodeProcess(Process.Process, &Code))
+      return llvm::createStringError(
+          "failed reading module worker exit status");
+    CloseHandle(Process.Process);
+    Active = false;
+    return std::optional<int>(static_cast<int>(Code));
+#else
+    int Status = 0;
+    struct rusage Usage;
+    pid_t Result;
+    do {
+      Result = wait4(Process.Pid, &Status, Blocking ? 0 : WNOHANG, &Usage);
+    } while (Result < 0 && errno == EINTR);
+    if (Result == 0)
+      return std::optional<int>{};
+    if (Result < 0) {
+      if (errno == ECHILD)
+        Active = false; // Never signal a PID already reaped elsewhere.
+      return llvm::errorCodeToError(
+          std::error_code(errno, std::generic_category()));
+    }
+    Active = false;
+    llvm::sys::ProcessStatistics Stats;
+    auto Micros = [](const timeval &Time) {
+      return std::chrono::seconds(Time.tv_sec) +
+             std::chrono::microseconds(Time.tv_usec);
+    };
+    Stats.UserTime = Micros(Usage.ru_utime);
+    Stats.TotalTime = Stats.UserTime + Micros(Usage.ru_stime);
+#ifdef __APPLE__
+    Stats.PeakMemory = Usage.ru_maxrss / 1024;
+#else
+    Stats.PeakMemory = Usage.ru_maxrss;
+#endif
+    Statistics = Stats;
+    return std::optional<int>(WIFEXITED(Status) ? WEXITSTATUS(Status) : -1);
+#endif
+  }
+  void terminate() {
+#ifdef _WIN32
+    TerminateProcess(Process.Process, 1);
+#else
+    kill(Process.Pid, SIGKILL);
+#endif
+  }
+  std::optional<llvm::sys::ProcessStatistics> Statistics;
+
+private:
+  llvm::sys::ProcessInfo Process;
+  bool Active = true;
+};
+
+llvm::Error writeSnapshot(PathRef Path, StringRef Contents,
+                          std::optional<int64_t> MTime = std::nullopt) {
+  int FD = -1;
+  if (auto EC = llvm::sys::fs::openFileForWrite(Path, FD))
+    return llvm::errorCodeToError(EC);
+  llvm::raw_fd_ostream Out(FD, true);
+  Out << Contents;
+  Out.flush();
+  if (Out.has_error()) {
+    auto EC = Out.error();
+    Out.clear_error();
+    return llvm::errorCodeToError(EC);
+  }
+  if (MTime) {
+    llvm::sys::TimePoint<> Time{std::chrono::seconds(*MTime)};
+    if (auto EC = llvm::sys::fs::setLastAccessAndModificationTime(FD, Time))
+      return llvm::errorCodeToError(EC);
+  }
+  return llvm::Error::success();
+}
+
+std::string workerDiagnostics(PathRef Path) {
+  // A diagnostic file cannot force an unbounded parent allocation.
+  uint64_t Size = 0;
+  if (llvm::sys::fs::file_size(Path, Size))
+    return {};
+  auto Text = llvm::MemoryBuffer::getFileSlice(
+      Path, std::min<uint64_t>(Size, 64 * 1024), 0);
+  return Text ? (*Text)->getBuffer().str() : std::string{};
+}
+
 } // namespace
 
