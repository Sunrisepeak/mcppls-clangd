+  } FS;
+  CompilerInvocation Invocation;
+  ModuleBuildWorkerOptions Options;
+  auto Result = buildModuleInWorker(Invocation, "", FS, TestDir, Options);
+  ASSERT_TRUE(static_cast<bool>(Result));
+  EXPECT_FALSE(*Result);
+  Options.Isolation = ModuleBuildWorkerOptions::Policy::WhenSupported;
+  Result = buildModuleInWorker(Invocation, "", FS, TestDir, Options);
+  ASSERT_TRUE(static_cast<bool>(Result));
+  EXPECT_FALSE(*Result);
+  Options.Isolation = ModuleBuildWorkerOptions::Policy::Required;
+  Result = buildModuleInWorker(Invocation, "", FS, TestDir, Options);
+  ASSERT_FALSE(static_cast<bool>(Result));
+  EXPECT_THAT(llvm::toString(Result.takeError()),
+              testing::HasSubstr("cannot export"));
