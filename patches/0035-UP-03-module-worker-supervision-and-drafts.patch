+// A faithful disk-based view with immutable virtual-file overlays. Unknown
+// filesystem implementations must not advertise this capability. Snapshot
+// files preserve their request timestamp and virtual path in the child.
+struct ModuleBuildFileSystemSnapshot {
+  struct File {
+    std::string Path;
+    std::string Contents;
+    int64_t ModificationTime = 0; // seconds since the Unix epoch
+  };
+  std::vector<File> OverlayFiles;
+};
+
 /// Wrapper for vfs::FileSystem for use in multithreaded programs like clangd.
 /// As FileSystem is not threadsafe, concurrent threads must each obtain one.
 /// Implementations may choose to depend on Context::current() e.g. to implement
@@ -42,9 +58,23 @@ private:
   /// Overridden by implementations to provide a vfs::FileSystem.
   /// This is distinct from view(NoneType) to avoid GCC's -Woverloaded-virtual.
   virtual llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const = 0;
+
+public:
+  // nullopt means this view cannot be faithfully exported to a disk-based
+  // compiler worker. It does not authorize replacing the view with real disk.
+  virtual std::optional<ModuleBuildFileSystemSnapshot>
+  snapshotForModuleBuild() const {
+    return std::nullopt;
+  }
 };
 
 class RealThreadsafeFS : public ThreadsafeFS {
+public:
+  std::optional<ModuleBuildFileSystemSnapshot>
+  snapshotForModuleBuild() const override {
+    return ModuleBuildFileSystemSnapshot{};
+  }
+
 private:
   llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> viewImpl() const override;
 };
