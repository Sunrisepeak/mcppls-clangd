+TEST(DraftStore, AtomicSnapshotRetainsVersionsAndExportsDirtyHeaders) {
+  RealThreadsafeFS Base;
+  DraftStore Store;
+  Store.addDraft("/header.h", "1", "old header");
+  Store.addDraft("/M.cppm", "1", "old module");
+  auto Captured = Store.snapshot();
+  auto FS = createDraftStoreFS(Base, Store);
+  auto Exported = FS->snapshotForModuleBuild();
+  ASSERT_TRUE(Exported);
+  ASSERT_EQ(Exported->OverlayFiles.size(), 2u);
+  Store.addDraft("/header.h", "2", "new header");
+  Store.removeDraft("/M.cppm");
+  auto View = DraftStore::asVFS(Captured);
+  auto Header = View->getBufferForFile("/header.h");
+  ASSERT_TRUE(Header);
+  EXPECT_EQ((*Header)->getBuffer(), "old header");
+  EXPECT_TRUE(View->exists("/M.cppm"));
+  for (const auto &File : Exported->OverlayFiles)
+    EXPECT_TRUE(File.Contents == "old header" || File.Contents == "old module");
+  auto Current = FS->snapshotForModuleBuild();
+  ASSERT_TRUE(Current);
+  ASSERT_EQ(Current->OverlayFiles.size(), 1u);
+  EXPECT_EQ(Current->OverlayFiles[0].Contents, "new header");
+}
