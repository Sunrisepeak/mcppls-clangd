+std::unique_ptr<ThreadsafeFS> createDraftStoreFS(const ThreadsafeFS &Base,
+                                                 const DraftStore &Drafts) {
+  return std::make_unique<DraftStoreFS>(Base, Drafts);
+}
+
+DraftStore::Snapshot DraftStore::snapshot() const {
   std::lock_guard<std::mutex> Guard(Mutex);
-  for (const auto &Draft : Drafts)
-    MemFS->addFile(Draft.getKey(), Draft.getValue().MTime,
-                   std::make_unique<SharedStringBuffer>(
-                       Draft.getValue().D.Contents, Draft.getKey()));
+  Snapshot Result;
+  Result.reserve(Drafts.size());
+  for (const auto &File : Drafts)
+    Result.push_back(
+        {File.getKey().str(), File.getValue().D, File.getValue().MTime});
+  return Result;
+}
+
+llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>
+DraftStore::asVFS(const Snapshot &Files) {
+  auto MemFS = llvm::makeIntrusiveRefCnt<llvm::vfs::InMemoryFileSystem>();
+  for (const auto &File : Files)
+    MemFS->addFile(File.File, File.MTime,
+                   std::make_unique<SharedStringBuffer>(File.Contents.Contents,
+                                                        File.File));
   return MemFS;
 }
+
+llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> DraftStore::asVFS() const {
+  return asVFS(snapshot());
+}
