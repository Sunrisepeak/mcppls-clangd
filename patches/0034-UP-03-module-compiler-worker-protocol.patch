new file mode 100644
index 000000000..55a3f6a19
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleBuildWorker.cpp
@@ -0,0 +1,163 @@
+//===--- ModuleBuildWorker.cpp - isolated compiler protocol
+//----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#include "ModuleBuildWorker.h"
+#include "Compiler.h"
+#include "clang/Frontend/FrontendActions.h"
+#include "clang/Frontend/TextDiagnosticPrinter.h"
+#include "clang/Lex/PreprocessorOptions.h"
+#include "llvm/ADT/ScopeExit.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/JSON.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+namespace clang::clangd {
+namespace {
+constexpr int ProtocolVersion = 1;
+constexpr llvm::StringLiteral CapturedFileSystem =
+    "disk-with-captured-overlays";
+
+llvm::Error validateInputs(const ModuleBuildWorkerInputs &Inputs) {
+  if (Inputs.FileSystem !=
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays)
+    return llvm::createStringError(
+        "module worker requires a captured request filesystem");
+  for (StringRef Path :
+       {StringRef(Inputs.WorkingDirectory), StringRef(Inputs.MainFile),
+        StringRef(Inputs.MainContentsFile)})
+    if (!llvm::sys::path::is_absolute(Path) || Path.contains('\0'))
+      return llvm::createStringError(
+          "module worker input paths must be absolute");
+  for (StringRef Path : Inputs.OverlayFiles)
+    if (!llvm::sys::path::is_absolute(Path) || Path.contains('\0'))
+      return llvm::createStringError(
+          "module worker overlay paths must be absolute");
+  return llvm::Error::success();
+}
+
+llvm::Error validateInvocation(const CompilerInvocation &Invocation,
+                               const ModuleBuildWorkerInputs &Inputs) {
+  const auto &Frontend = Invocation.getFrontendOpts();
+  if (Frontend.Inputs.size() != 1 || !Frontend.Inputs[0].isFile() ||
+      Frontend.Inputs[0].getFile() != Inputs.MainFile)
+    return llvm::createStringError(
+        "module worker requires exactly its captured main file");
+  if (!llvm::sys::path::is_absolute(Frontend.OutputFile) ||
+      StringRef(Frontend.OutputFile).contains('\0') ||
+      Frontend.OutputFile == Inputs.MainFile ||
+      Frontend.OutputFile == Inputs.MainContentsFile)
+    return llvm::createStringError(
+        "module worker requires a separate staged output path");
+  if (!Invocation.getPreprocessorOpts().RemappedFileBuffers.empty())
+    return llvm::createStringError(
+        "module worker cannot serialize remapped buffer pointers");
+  return llvm::Error::success();
+}
+} // namespace
+
+llvm::Expected<std::string>
+serializeModuleBuildWorkerRequest(const CompilerInvocation &Invocation,
+                                  const ModuleBuildWorkerInputs &Inputs) {
+  if (auto Err = validateInputs(Inputs))
+    return std::move(Err);
+  if (auto Err = validateInvocation(Invocation, Inputs))
+    return std::move(Err);
+  llvm::json::Object Request{
+      {"version", ProtocolVersion},
+      {"filesystem", CapturedFileSystem},
+      {"directory", Inputs.WorkingDirectory},
+      {"mainFile", Inputs.MainFile},
+      {"mainContentsFile", Inputs.MainContentsFile},
+      {"overlays", llvm::json::Array(Inputs.OverlayFiles)},
+      {"cc1Arguments", llvm::json::Array(Invocation.getCC1CommandLine())}};
+  return llvm::formatv("{0}", llvm::json::Value(std::move(Request))).str();
+}
+
+llvm::Error runModuleBuildWorker(PathRef RequestFile) {
+  auto Buffer = llvm::MemoryBuffer::getFile(RequestFile);
+  if (!Buffer)
+    return llvm::errorCodeToError(Buffer.getError());
+  auto Request = llvm::json::parse((*Buffer)->getBuffer());
+  if (!Request)
+    return Request.takeError();
+  const auto *Object = Request->getAsObject();
+  if (!Object || Object->getInteger("version") != ProtocolVersion ||
+      Object->getString("filesystem") != CapturedFileSystem)
+    return llvm::createStringError(
+        "unsupported module worker request protocol");
+  ModuleBuildWorkerInputs Inputs;
+  Inputs.FileSystem =
+      ModuleBuildWorkerInputs::FileSystemKind::DiskWithCapturedOverlays;
+  std::vector<std::string> Arguments;
+  llvm::json::Path::Root Root;
+  llvm::json::ObjectMapper Mapper(*Request, Root);
+  if (!Mapper.map("directory", Inputs.WorkingDirectory) ||
+      !Mapper.map("mainFile", Inputs.MainFile) ||
+      !Mapper.map("mainContentsFile", Inputs.MainContentsFile) ||
+      !Mapper.map("overlays", Inputs.OverlayFiles) ||
+      !Mapper.map("cc1Arguments", Arguments))
+    return Root.getError();
+  if (auto Err = validateInputs(Inputs))
+    return Err;
+
+  DiagnosticOptions DiagnosticOpts;
+  TextDiagnosticPrinter Printer(llvm::errs(), DiagnosticOpts);
+  DiagnosticsEngine Diags(new DiagnosticIDs(), DiagnosticOpts, &Printer, false);
+  std::vector<const char *> ArgumentRefs;
+  for (const auto &Arg : Arguments) {
+    if (StringRef(Arg).contains('\0'))
+      return llvm::createStringError(
+          "module worker arguments cannot contain NUL");
+    ArgumentRefs.push_back(Arg.c_str());
+  }
+  auto Invocation = std::make_unique<CompilerInvocation>();
+  if (!CompilerInvocation::CreateFromArgs(*Invocation, ArgumentRefs, Diags))
+    return llvm::createStringError("invalid module worker compiler invocation");
+  if (auto Err = validateInvocation(*Invocation, Inputs))
+    return Err;
+
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> VFS(
+      llvm::vfs::createPhysicalFileSystem().release());
+  if (auto EC = VFS->setCurrentWorkingDirectory(Inputs.WorkingDirectory))
+    return llvm::errorCodeToError(EC);
+  for (StringRef Path : Inputs.OverlayFiles) {
+    auto YAML = llvm::MemoryBuffer::getFile(Path);
+    if (!YAML)
+      return llvm::errorCodeToError(YAML.getError());
+    auto Overlay = llvm::vfs::getVFSFromYAML(std::move(*YAML), nullptr, Path,
+                                             nullptr, VFS);
+    if (!Overlay)
+      return llvm::createStringError(
+          "invalid captured module worker filesystem overlay");
+    VFS = llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem>(Overlay.release());
+  }
+  auto Main = llvm::MemoryBuffer::getFile(Inputs.MainContentsFile);
+  if (!Main)
+    return llvm::errorCodeToError(Main.getError());
+  const std::string Output = Invocation->getFrontendOpts().OutputFile;
+  bool Success = false;
+  auto Cleanup = llvm::scope_exit([&] {
+    if (!Success)
+      llvm::sys::fs::remove(Output);
+  });
+  auto Clang =
+      prepareCompilerInstance(std::move(Invocation), nullptr, std::move(*Main),
+                              std::move(VFS), Printer);
+  if (!Clang)
+    return llvm::createStringError("failed to prepare module worker compiler");
+  GenerateReducedModuleInterfaceAction Action;
+  if (!Clang->ExecuteAction(Action) ||
+      Clang->getDiagnostics().hasErrorOccurred() ||
+      !llvm::sys::fs::exists(Output))
+    return llvm::createStringError("module worker compilation failed");
+  Success = true;
+  return llvm::Error::success();
+}
+} // namespace clang::clangd
diff --git a/clang-tools-extra/clangd/ModuleBuildWorker.h b/clang-tools-extra/clangd/ModuleBuildWorker.h
new file mode 100644
index 000000000..69987c96f
--- /dev/null
+++ b/clang-tools-extra/clangd/ModuleBuildWorker.h
@@ -0,0 +1,53 @@
+//===--- ModuleBuildWorker.h - isolated compiler protocol --------*- C++
+//-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#ifndef LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEBUILDWORKER_H
+#define LLVM_CLANG_TOOLS_EXTRA_CLANGD_MODULEBUILDWORKER_H
+
+#include "support/Path.h"
+#include "llvm/Support/Error.h"
+#include <string>
+#include <vector>
+
+namespace clang {
+class CompilerInvocation;
+namespace clangd {
+
+// These files belong to the parent until the child has been reaped. The main
+// buffer and every virtual overlay backing file must contain the exact request
+// bytes, including unsaved drafts. Keep prerequisite ModuleFile owners alive
+// too: their copy-on-read leases are not transferred to the child.
+struct ModuleBuildWorkerInputs {
+  enum class FileSystemKind { Unsupported, DiskWithCapturedOverlays };
+  FileSystemKind FileSystem = FileSystemKind::Unsupported;
+  std::string WorkingDirectory;
+  std::string MainFile;
+  std::string MainContentsFile;
+  std::vector<std::string> OverlayFiles;
+};
+
+// Only opt into DiskWithCapturedOverlays if it reproduces the entire request
+// filesystem. Arbitrary ThreadsafeFS implementations cannot be serialized by
+// assuming disk contents. Serialize the finalized invocation before
+// prepareCompilerInstance adds its process-local remapped-buffer pointers.
+llvm::Expected<std::string>
+serializeModuleBuildWorkerRequest(const CompilerInvocation &Invocation,
+                                  const ModuleBuildWorkerInputs &Inputs);
+
+// Internal clangd executable mode. Never publishes the staged output. Clang
+// may also write its configured implicit-module cache, which the parent must
+// redirect into the worker-owned temporary directory. Failed compilation
+// removes the staged output. The parent must
+// independently own launch, cancellation, timeout, termination, specific-child
+// reap, and cleanup after a crash/kill. This entry alone provides no hard
+// bound.
+llvm::Error runModuleBuildWorker(PathRef RequestFile);
+
+} // namespace clangd
+} // namespace clang
+#endif
