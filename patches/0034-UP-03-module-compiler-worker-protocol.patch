   clang::noteBottomOfStack();
   llvm::InitLLVM X(argc, argv);
   llvm::InitializeAllTargetInfos();
+  // The internal compiler worker has no LSP transport or inherited clangd
+  // configuration. Its sole input is the versioned captured-request file.
+  if (argc == 3 && llvm::StringRef(argv[1]) == "--module-build-worker") {
+    if (auto Err = runModuleBuildWorker(argv[2])) {
+      llvm::errs() << llvm::toString(std::move(Err)) << "\n";
+      return 1;
+    }
+    return 0;
+  }
   llvm::sys::AddSignalHandler(
       [](void *) {
         ThreadCrashReporter::runCrashHandlers();
