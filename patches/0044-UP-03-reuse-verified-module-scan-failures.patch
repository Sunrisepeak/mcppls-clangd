+TEST_F(PrerequisiteModulesTests, FailedScanMemoRevalidatesHeadersAndDrafts) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission currently covers Linux drivers";
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Broken.cppm", "export module Broken;\n#include \"repair.h\"\n"
+                            "import M;\n");
+  auto Generation = CDB.toolingCDB();
+  auto Cache = createProjectModulesCommandCache(Generation, true);
+  const auto Broken = getFullPath("Broken.cppm");
+  auto Scan = [&](const ThreadsafeFS &RequestFS) {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+    Modules->setFileSystem(RequestFS);
+    return Modules->getRequiredModules(Broken);
+  };
+  EXPECT_TRUE(Scan(FS).empty());
+  auto Before = getModuleDependencyScanCache().stats();
+  EXPECT_TRUE(Scan(FS).empty());
+  EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  // Failure cannot publish the partially scanned provider.
+  auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+  EXPECT_TRUE(Modules->getModuleNameForSource(Broken).empty());
+
+  auto Header = (TestDir + "/repair.h").str();
+  auto Write = [&](llvm::StringRef Text) {
+    std::error_code EC;
+    llvm::raw_fd_ostream Stream(Header, EC);
+    ASSERT_FALSE(EC);
+    Stream << Text;
+  };
+  // A formerly absent input becomes present but still fails semantically.
+  Write("#error bad\n");
+  Before = getModuleDependencyScanCache().stats();
+  EXPECT_TRUE(Scan(FS).empty());
+  EXPECT_GT(getModuleDependencyScanCache().stats().Invalidations,
+            Before.Invalidations);
+  Before = getModuleDependencyScanCache().stats();
+  EXPECT_TRUE(Scan(FS).empty());
+  EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  llvm::sys::fs::file_status Original;
+  ASSERT_FALSE(llvm::sys::fs::status(Header, Original));
+  Write("// goodxxx\n");
+  ASSERT_FALSE(llvm::sys::fs::setLastAccessAndModificationTime(
+      Header, Original.getLastAccessedTime(), Original.getLastModificationTime()));
+  EXPECT_THAT(Scan(FS), testing::ElementsAre("M"));
+  Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+  EXPECT_EQ(Modules->getModuleNameForSource(Broken), "Broken");
+
+  MockFS Draft;
+  Draft.OverlayRealFileSystemForModules = true;
+  Draft.Files[Header] = "#error bad\n";
+  Draft.Timestamps[Header] = 123456789;
+  EXPECT_TRUE(Scan(Draft).empty());
+  Before = getModuleDependencyScanCache().stats();
+  EXPECT_TRUE(Scan(Draft).empty());
+  EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  Draft.Files[Header] = "// goodxxx\n";
+  EXPECT_THAT(Scan(Draft), testing::ElementsAre("M"));
+}
