+TEST_F(PrerequisiteModulesTests, FailedScanMemoRejectsOversizedAndCanceledEntries) {
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Use.cpp", "int probe;\n");
+  auto Generation = CDB.toolingCDB();
+  const auto Use = getFullPath("Use.cpp");
+  auto Command = Generation->getCompileCommands(Use).front();
+  auto View = FS.view(TestDir);
+  auto Inputs = std::make_shared<ModuleScanManifest>();
+  auto Recording = llvm::makeIntrusiveRefCnt<ModuleScanRecordingFS>(View, Inputs);
+  auto Main = Recording->getBufferForFile(Use);
+  ASSERT_TRUE(Main);
+  const auto MainBytes = ModuleScanManifest::fingerprint((*Main)->getBuffer());
+  const auto Environment = ModuleScanManifest::environment(Command);
+  ASSERT_TRUE(Environment);
+  ASSERT_TRUE(Inputs->matches(*View));
+  ModuleDependencyScanCache Cache;
+  ModuleScanResult Failure;
+  Failure.FailureDiagnostic = "observed semantic error";
+  Cache.store(Generation, Use, Command, MainBytes, *Environment, *Inputs,
+              Failure, *View);
+  auto Hit = Cache.lookup(Generation, Use, Command, MainBytes, *View);
+  ASSERT_TRUE(Hit);
+  EXPECT_EQ(Hit->FailureDiagnostic, Failure.FailureDiagnostic);
+  EXPECT_GT(Cache.stats().Bytes, Failure.FailureDiagnostic->capacity());
+  const auto Before = Cache.stats();
+  Failure.FailureDiagnostic->resize(ModuleScanResult::FailureDiagnosticByteLimit + 1);
+  Cache.store(Generation, Use, Command, MainBytes, *Environment, *Inputs,
+              Failure, *View);
+  EXPECT_EQ(Cache.stats().Stores, Before.Stores);
+  EXPECT_GT(Cache.stats().Declines, Before.Declines);
+  {
+    // Cancel during the last filesystem observation, after store's initial
+    // cancellation check. Neither replay nor publication may succeed.
+    ModuleScanManifest LastRead = *Inputs;
+    LastRead.Observations.erase(
+        std::remove_if(LastRead.Observations.begin(), LastRead.Observations.end(),
+                       [](const ModuleScanManifest::Observation &O) {
+                         return O.Operation != ModuleScanManifest::Read;
+                       }),
+        LastRead.Observations.end());
+    ASSERT_EQ(LastRead.Observations.size(), 1u);
+    auto ReplayTask = cancelableTask();
+    CancelOnReadFS CancelDuringReplay(FS, Use, ReplayTask.second);
+    auto ReplayView = CancelDuringReplay.view(Command.Directory);
+    WithContext Context(std::move(ReplayTask.first));
+    ModuleDependencyScanCache CanceledCache;
+    ModuleScanResult SmallFailure;
+    SmallFailure.FailureDiagnostic = "observed semantic error";
+    CanceledCache.store(Generation, Use, Command, MainBytes, *Environment,
+                        LastRead, SmallFailure, *ReplayView);
+    EXPECT_EQ(CancelDuringReplay.Triggered, 1u);
+    EXPECT_TRUE(isCancelled());
+    EXPECT_EQ(CanceledCache.stats().Stores, 0u);
+    EXPECT_EQ(CanceledCache.stats().Entries, 0u);
+    EXPECT_EQ(CanceledCache.stats().Bytes, 0u);
+  }
+  auto Task = cancelableTask();
+  Task.second();
+  WithContext Context(std::move(Task.first));
+  Failure.FailureDiagnostic = "observed semantic error";
+  Cache.store(Generation, Use, Command, MainBytes, *Environment, *Inputs,
+              Failure, *View);
+  EXPECT_EQ(Cache.stats().Stores, Before.Stores);
+  EXPECT_FALSE(Cache.lookup(Generation, Use, Command, MainBytes, *View));
+}
