+TEST_F(PrerequisiteModulesTests, FailedScanMemoCommandAndGenerationChanges) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "scan memo admission currently covers Linux drivers";
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  const char *Source = "#ifndef FIX\n#error blocked\n#endif\n"
+                       "export module Broken;\nimport M;\n";
+  CDB.addFile("Broken.cppm", Source);
+  auto Generation = CDB.toolingCDB();
+  auto Cache = createProjectModulesCommandCache(Generation, true);
+  const auto Broken = getFullPath("Broken.cppm");
+  auto Scan = [&](bool Fixed) {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+    Modules->setCommandMangler([Fixed](tooling::CompileCommand &Command, PathRef) {
+      if (Fixed)
+        Command.CommandLine.insert(Command.CommandLine.end() - 1, "-DFIX");
+    });
+    return Modules->getRequiredModules(Broken);
+  };
+  EXPECT_TRUE(Scan(false).empty());
+  auto Before = getModuleDependencyScanCache().stats();
+  EXPECT_TRUE(Scan(false).empty());
+  EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  EXPECT_THAT(Scan(true), testing::ElementsAre("M"));
+  EXPECT_TRUE(Scan(false).empty());
+
+  PerFileModulesCompilationDatabase OtherCDB(TestDir, FS);
+  OtherCDB.addFile("Broken.cppm", Source);
+  auto OtherGeneration = OtherCDB.toolingCDB();
+  Before = getModuleDependencyScanCache().stats();
+  auto Modules = clang::clangd::getProjectModules(
+      OtherGeneration, FS, createProjectModulesCommandCache(OtherGeneration, true));
+  EXPECT_TRUE(Modules->getRequiredModules(Broken).empty());
+  EXPECT_EQ(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+}
