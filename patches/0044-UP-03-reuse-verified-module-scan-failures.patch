+TEST_F(PrerequisiteModulesTests, ScanMemoRealPathRetargetsAndMissingInputs) {
+  if (!llvm::Triple(llvm::sys::getDefaultTargetTriple()).isOSLinux())
+    GTEST_SKIP() << "requires a local symlink and hardlink";
+  PerFileModulesCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("A.h", "same bytes\n");
+  auto A = getFullPath("A.h");
+  auto B = (TestDir + "/B.h").str();
+  auto Link = (TestDir + "/alias.h").str();
+  ASSERT_FALSE(llvm::sys::fs::create_hard_link(A, B));
+  ASSERT_FALSE(llvm::sys::fs::create_symlink(A, Link));
+  llvm::sys::fs::file_status SA, SB;
+  ASSERT_FALSE(llvm::sys::fs::status(A, SA));
+  ASSERT_FALSE(llvm::sys::fs::status(B, SB));
+  ASSERT_EQ(SA.getUniqueID(), SB.getUniqueID());
+  ASSERT_EQ(SA.getSize(), SB.getSize());
+  ASSERT_EQ(SA.getLastModificationTime(), SB.getLastModificationTime());
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> View(
+      llvm::vfs::createPhysicalFileSystem().release());
+  ASSERT_FALSE(View->setCurrentWorkingDirectory(TestDir));
+  auto Inputs = std::make_shared<ModuleScanManifest>();
+  auto Recording = llvm::makeIntrusiveRefCnt<ModuleScanRecordingFS>(View, Inputs);
+  llvm::SmallString<256> Resolved;
+  ASSERT_FALSE(Recording->getRealPath(Link, Resolved));
+  EXPECT_TRUE(Inputs->matches(*View));
+  ASSERT_FALSE(llvm::sys::fs::remove(Link));
+  ASSERT_FALSE(llvm::sys::fs::create_symlink(B, Link));
+  // Bytes, inode alias and timestamp remain identical. Canonical spelling
+  // changes, so replay must still fail.
+  EXPECT_FALSE(Inputs->matches(*View));
+
+  auto Missing = (TestDir + "/missing.h").str();
+  Inputs = std::make_shared<ModuleScanManifest>();
+  Recording = llvm::makeIntrusiveRefCnt<ModuleScanRecordingFS>(View, Inputs);
+  Resolved.clear();
+  ASSERT_TRUE(Recording->getRealPath(Missing, Resolved));
+  EXPECT_TRUE(Inputs->matches(*View));
+  ASSERT_FALSE(llvm::sys::fs::create_symlink(A, Missing));
+  EXPECT_FALSE(Inputs->matches(*View));
+}
