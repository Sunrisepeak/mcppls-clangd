--- a/clang-tools-extra/clangd/TUScheduler.cpp
+++ b/clang-tools-extra/clangd/TUScheduler.cpp
@@ -52,6 +52,7 @@
 #include "Config.h"
 #include "Diagnostics.h"
 #include "GlobalCompilationDatabase.h"
+#include "ModulesBuilder.h"
 #include "ParsedAST.h"
 #include "Preamble.h"
 #include "clang-include-cleaner/Record.h"
@@ -898,9 +899,20 @@ void ASTWorker::update(ParseInputs Inputs, WantDiagnostics WantDiags,
     else
       Inputs.CompileCommand = CDB.getFallbackCommand(FileName);
 
+    // A preamble may only be mixed with imports that remain textual. Resolve
+    // this from current request bytes/VFS before constructing the preamble,
+    // under the same file configuration context as command lookup. Keep this
+    // potentially expensive inventory work off the document-update caller.
+    if (Inputs.ModulesManager && !Inputs.Opts.SkipPreambleBuild)
+      Inputs.Opts.SkipPreambleBuild =
+          Inputs.ModulesManager->hasBuildableRequiredModules(
+              FileName, *Inputs.TFS, Inputs.Contents);
+
     bool InputsAreTheSame =
-        std::tie(FileInputs.CompileCommand, FileInputs.Contents) ==
-        std::tie(Inputs.CompileCommand, Inputs.Contents);
+        std::tie(FileInputs.CompileCommand, FileInputs.Contents,
+                 FileInputs.Opts.SkipPreambleBuild) ==
+        std::tie(Inputs.CompileCommand, Inputs.Contents,
+                 Inputs.Opts.SkipPreambleBuild);
     // Cached AST is invalidated.
     if (!InputsAreTheSame) {
       IdleASTs.take(this);
@@ -1195,8 +1207,10 @@ void ASTWorker::generateDiagnostics(
   }
   // Used to check whether we can update AST cache.
   bool InputsAreLatest =
-      std::tie(FileInputs.CompileCommand, FileInputs.Contents) ==
-      std::tie(Inputs.CompileCommand, Inputs.Contents);
+      std::tie(FileInputs.CompileCommand, FileInputs.Contents,
+               FileInputs.Opts.SkipPreambleBuild) ==
+      std::tie(Inputs.CompileCommand, Inputs.Contents,
+               Inputs.Opts.SkipPreambleBuild);
   // Take a shortcut and don't report the diagnostics, since they should be the
   // same. All the clients should handle the lack of OnUpdated() call anyway to
   // handle empty result from buildAST.
