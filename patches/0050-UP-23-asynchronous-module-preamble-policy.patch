Subject: [PATCH] [clangd] Resolve module preamble policy on the update worker


diff --git a/clang-tools-extra/clangd/ClangdServer.cpp b/clang-tools-extra/clangd/ClangdServer.cpp
index fcf9bd4a7..c36a53aef 100644
--- a/clang-tools-extra/clangd/ClangdServer.cpp
+++ b/clang-tools-extra/clangd/ClangdServer.cpp
@@ -298,7 +298,9 @@ void ClangdServer::addDocument(PathRef File, llvm::StringRef Contents,
   Inputs.ClangTidyProvider = ClangTidyProvider;
   Inputs.FeatureModules = FeatureModules;
   Inputs.ModulesManager = ModulesManager;
-  adjustParseInputs(Inputs, File);
+  // Resolve module-dependent policy on the update worker, like the command.
+  // didChange must not synchronously scan the project's provider inventory.
+  Inputs.Opts.SkipPreambleBuild = SkipPreambleBuild;
   bool NewFile = WorkScheduler->update(File, Inputs, WantDiags);
   // If we loaded Foo.h, we want to make sure Foo.cpp is indexed.
   if (NewFile && BackgroundIdx)
@@ -1188,27 +1190,6 @@ void ClangdServer::profile(MemoryTree &MT) const {
   WorkScheduler->profile(MT.child("tuscheduler"));
 }
 
-void ClangdServer::adjustParseInputs(ParseInputs &Inputs, PathRef File) const {
-  // FIXME (upstream): don't skip the preamble when the TU requires C++20
-  // named modules. Mixing PCH and *loaded module files* may cause different
-  // issues (incorrect diagnostics, crashes) due to instability of such
-  // scenario support in clang. A TU whose imports are all third-party never
-  // loads a named-module BMI, so its parse is a plain textual one and the
-  // preamble stays safe there.
-  auto NeedsPreambleSkip = [this, File, &Inputs]() {
-    if (!ModulesManager)
-      return false;
-    // Required modules check uses compile commands extracted from the
-    // compilation database.
-    // We use context provider here to make command mangler to use compile
-    // command adjustments from the config.
-    WithContext Ctx(ContextProvider ? ContextProvider(File)
-                                    : Context::current().clone());
-    return ModulesManager->hasBuildableRequiredModules(File, *Inputs.TFS,
-                                                       Inputs.Contents);
-  };
-  Inputs.Opts.SkipPreambleBuild = SkipPreambleBuild || NeedsPreambleSkip();
-}
 
 } // namespace clangd
 } // namespace clang
diff --git a/clang-tools-extra/clangd/ClangdServer.h b/clang-tools-extra/clangd/ClangdServer.h
