+TEST(ClangdServerTest, DocumentUpdateDoesNotWaitForModuleInventory) {
+  Notification AllowInventory;
+  Notification EnteredInventory;
+  Notification UpdateReturned;
+  class DelayedModulesDatabase : public MockCompilationDatabase {
+  public:
+    DelayedModulesDatabase(Notification &Allow, Notification &Entered)
+        : Allow(Allow), Entered(Entered) {}
+    std::unique_ptr<ProjectModules>
+    getProjectModules(PathRef File) const override {
+      Entered.notify();
+      Allow.wait();
+      return nullptr;
+    }
+  private:
+    Notification &Allow;
+    Notification &Entered;
+  } CDB(AllowInventory, EnteredInventory);
+  MockFS FS;
+  auto File = testPath("module-policy.cpp");
+  FS.Files[File] = "int CurrentValue = 42;";
+  ModulesBuilder Modules(CDB);
+  auto Opts = ClangdServer::optsForTest();
+  Opts.ModulesManager = &Modules;
+  ClangdServer Server(CDB, FS, Opts);
+  AsyncTaskRunner Calls;
+  Calls.runAsync("update", [&] {
+    Server.addDocument(File, FS.Files[File]);
+    UpdateReturned.notify();
+  });
+  // Release the database before asserting, so a failing baseline never leaves
+  // an update or server destructor blocked. This is a synchronization control,
+  // not a timing target for production completion.
+  bool Returned = UpdateReturned.wait(timeoutSeconds(2));
+  bool Scanned = EnteredInventory.wait(timeoutSeconds(2));
+  AllowInventory.notify();
+  Calls.wait();
+  EXPECT_TRUE(Returned);
+  EXPECT_TRUE(Scanned);
+  ASSERT_TRUE(Server.blockUntilIdleForTest());
+  Annotations Completion("int CurrentValue = 42;\nint v = CurrentV^");
+  Server.addDocument(File, Completion.code());
+  auto Result = cantFail(runCodeComplete(Server, File, Completion.point(),
+                                          CodeCompleteOptions()));
+  EXPECT_THAT(Result.Completions,
+              testing::Contains(Field(&CodeCompletion::Name, "CurrentValue")));
+}
