+++ b/clang-tools-extra/clangd/CodeComplete.cpp
@@ -1513,9 +1513,11 @@ bool semaCodeComplete(std::unique_ptr<CodeCompleteConsumer> Consumer,
            inModuleDeclarations(Input.ParseInput.Contents, Input.Offset,
                                 CI->getLangOpts());
   }();
-  // The completion's module queries share one replay of each memoized scan.
+  // The completion's module queries share one replay of each memoized scan
+  // (codeComplete may have begun it).
   std::optional<WithContextValue> ReplayOnce;
-  if (Input.ParseInput.ModulesManager)
+  if (Input.ParseInput.ModulesManager &&
+      !Context::current().get(ModuleScanReplayEpoch))
     ReplayOnce.emplace(ModuleScanReplayEpoch, nextModuleScanReplayEpoch());
   if (RequiredModules && Input.ParseInput.ModulesManager &&
       !InDirectiveRegion) {
@@ -2437,6 +2439,47 @@ clang::CodeCompleteOptions CodeCompleteOptions::getClangCompleteOpts() const {
   return Result;
 }
 
+// Whether a line of the text begins an import declaration (`import`, or
+// `export import`, then a name, a partition or a header). A lexical guess that
+// errs towards yes: a line that only looks like one costs a load that would
+// have happened anyway.
+static bool mayImportModules(llvm::StringRef Content) {
+  while (!Content.empty()) {
+    auto [Line, Rest] = Content.split('\n');
+    Content = Rest;
+    Line = Line.ltrim();
+    if (Line.consume_front("export") && !Line.empty() &&
+        !isAsciiIdentifierContinue(Line.front()))
+      Line = Line.ltrim();
+    if (Line.consume_front("import") &&
+        (Line.empty() || !isAsciiIdentifierContinue(Line.front())))
+      return true;
+  }
+  return false;
+}
+
+// Whether the draft imports a module now, itself or through a header: one
+// imported since the preamble is built for the request alone, and the index
+// knows nothing of it. An import line in the draft answers without a scan;
+// the scan is the one the request's own module check replays.
+static bool importsModulesNow(PathRef File, const ParseInputs &Input,
+                              size_t Offset) {
+  if (mayImportModules(Input.Contents))
+    return true;
+  if (!Input.ModulesManager)
+    return false;
+  // Inside a directive the preamble is not used: nothing to decide, no scan.
+  if (llvm::StringRef(Input.Contents)
+          .take_front(Offset)
+          .rsplit('\n')
+          .second.ltrim()
+          .starts_with("#"))
+    return true;
+  return !Input.ModulesManager
+              ->getRequiredModuleNames(File, *Input.TFS, Input.Contents)
+              .empty();
+}
+
 CompletionPrefix guessCompletionPrefix(llvm::StringRef Content,
                                        unsigned Offset) {
   assert(Offset <= Content.size());
@@ -2582,6 +2625,17 @@ CodeCompleteResult codeComplete(PathRef FileName, Position Pos,
     elog("Code completion position was invalid {0}", Offset.takeError());
     return CodeCompleteResult();
   }
+  // The completion's module queries share one replay of each memoized scan.
+  std::optional<WithContextValue> ReplayOnce;
+  if (ParseInput.ModulesManager)
+    ReplayOnce.emplace(ModuleScanReplayEpoch, nextModuleScanReplayEpoch());
+  // Sema loads the preamble's declarations itself only for what the index
+  // cannot give: a file that imports no module has every preamble symbol in
+  // the index, as without module support.
+  if (Opts.ForceLoadPreamble && Preamble && Preamble->RequiredModules &&
+      Preamble->RequiredModules->getRequiredModuleNames().empty() &&
+      !importsModulesNow(FileName, ParseInput, *Offset))
+    Opts.ForceLoadPreamble = false;
 
   auto Content = llvm::StringRef(ParseInput.Contents).take_front(*Offset);
   if (auto OffsetBeforeComment = maybeFunctionArgumentCommentStart(Content)) {
diff --git a/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp b/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
index bc94baae3..47d981ce7 100644
--- a/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
+++ b/clang-tools-extra/clangd/unittests/PrerequisiteModulesTest.cpp
@@ -38,6 +38,7 @@
 #include "ProjectModules.h"
 #include "TestFS.h"
 #include "TestTU.h"
+#include "index/MemIndex.h"
 #include "support/Cancellation.h"
 #include "support/Path.h"
 #include "support/ThreadsafeFS.h"
@@ -2708,6 +2709,51 @@ void func() {
   EXPECT_EQ(Result.Completions[0].Name, "printA");
 }
 
+// A preamble built before the file imported anything loads no module; the
+// import typed since is built for the completion itself, and Sema has to read
+// what it exports even with an index, which knows nothing of it.
+TEST_F(PrerequisiteModulesTests, CompletionLoadsModulesImportedSinceThePreamble) {
+  MockDirectoryCompilationDatabase CDB(TestDir, FS);
+
+  CDB.addFile("A.cppm", R"cpp(
+export module A;
+export void printA();
+  )cpp");
+  CDB.addFile("Use.cpp", R"cpp(
+void func() {
+}
+)cpp");
+
+  ModulesBuilder Builder(CDB);
+  ParseInputs Use = getInputs("Use.cpp", CDB);
+  Use.ModulesManager = &Builder;
+  std::unique_ptr<CompilerInvocation> CI =
+      buildCompilerInvocation(Use, DiagConsumer);
+  ASSERT_TRUE(CI);
+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Use,
+                                /*InMemory=*/true, /*Callback=*/nullptr);
+  ASSERT_TRUE(Preamble);
+  ASSERT_TRUE(Preamble->RequiredModules);
+  EXPECT_TRUE(Preamble->RequiredModules->getRequiredModuleNames().empty());
+
+  Annotations Draft(R"cpp(
+import A;
+void func() {
+  print^
+}
+)cpp");
+  Use.Contents = Draft.code().str();
+  auto Index = MemIndex::build(SymbolSlab(), RefSlab(), RelationSlab());
+  CodeCompleteOptions Opts;
+  Opts.Index = Index.get();
+  Opts.ForceLoadPreamble = true;
+  auto Result = codeComplete(getFullPath("Use.cpp"), Draft.point(),
+                             Preamble.get(), Use, Opts);
+  EXPECT_TRUE(llvm::any_of(Result.Completions, [](const CodeCompletion &C) {
+    return C.Name == "printA";
+  }));
+}
+
