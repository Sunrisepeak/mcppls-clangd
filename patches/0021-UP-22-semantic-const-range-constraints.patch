diff --git a/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-range-constraints.cpp b/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-range-constraints.cpp
new file mode 100644
index 000000000..5014dfd46
--- /dev/null
+++ b/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-range-constraints.cpp
@@ -0,0 +1,124 @@
+// RUN: %check_clang_tidy -std=c++20 %s misc-const-correctness %t --
+// RUN: %clang_cc1 -std=c++20 -fsyntax-only %t.cpp
+
+struct MutableRange {
+  int *begin();
+  int *end();
+};
+
+struct ConstRange {
+  int *begin();
+  int *end();
+  const int *begin() const;
+  const int *end() const;
+};
+
+template <class R> struct View {
+  R Base;
+  auto begin() { return Base.begin(); }
+  auto end() { return Base.end(); }
+  auto begin() const requires requires(const R &Rng) { Rng.begin(); } {
+    return Base.begin();
+  }
+  auto end() const requires requires(const R &Rng) { Rng.end(); } {
+    return Base.end();
+  }
+};
+
+void constrainedUnavailableConstIteration() {
+  View<MutableRange> Range;
+  for (const int Value : Range)
+    (void)Value;
+}
+
+void constrainedAvailableConstIteration() {
+  // CHECK-MESSAGES: :[[@LINE+1]]:3: warning: variable 'Range' of type 'View<ConstRange>' can be declared 'const'
+  View<ConstRange> Range;
+  for (const int Value : Range)
+    (void)Value;
+}
+
+void mutableReferenceIteration() {
+  ConstRange Range;
+  for (int &Value : Range)
+    Value = 1;
+}
+
+struct Number { int Value; };
+int operator|(const Number &N, int Mask) { return N.Value | Mask; }
+
+void ordinaryUserPipe() {
+  // CHECK-MESSAGES: :[[@LINE+1]]:3: warning: variable 'Input' of type 'Number' can be declared 'const'
+  Number Input{3};
+  (void)(Input | 1);
+}
+
+void ordinaryReadOnlyValue() {
+  // CHECK-MESSAGES: :[[@LINE+1]]:3: warning: variable 'Value' of type 'int' can be declared 'const'
+  int Value = 42;
+  (void)Value;
+}
+
+void unusedMutableRange() {
+  // CHECK-MESSAGES: :[[@LINE+1]]:3: warning: variable 'Range' of type 'View<MutableRange>' can be declared 'const'
+  View<MutableRange> Range;
+  (void)Range;
+}
+
+namespace constrained_pipe {
+struct Adaptor {};
+template <class R>
+  requires requires(R &&Range) { Range.begin(); }
+int operator|(R &&, Adaptor) { return 0; }
+
+void unavailableConstPipe() {
+  View<MutableRange> Range;
+  (void)(Range | Adaptor{});
+}
+
+void availableConstPipe() {
+  // CHECK-MESSAGES: :[[@LINE+1]]:3: warning: variable 'Range' of type 'View<ConstRange>' can be declared 'const'
+  View<ConstRange> Range;
+  (void)(Range | Adaptor{});
+}
+
+void explicitUnavailableConstPipe() {
+  View<MutableRange> Range;
+  (void)operator|(Range, Adaptor{});
+}
+} // namespace constrained_pipe
+
+class PrivateConstRange {
+  int *begin();
+  int *end();
+  const int *begin() const;
+  const int *end() const;
+
+public:
+  void iterate() {
+    // Access is checked in the original function context.
+    // CHECK-MESSAGES: :[[@LINE+1]]:5: warning: variable 'Range' of type 'PrivateConstRange' can be declared 'const'
+    PrivateConstRange Range;
+    for (const int Value : Range)
+      (void)Value;
+  }
+};
+
+namespace deduced_return {
+struct Adaptor {};
+template <class R> auto operator|(R &&, Adaptor) {
+  // Adding const makes this instantiation invalid, but its error must not
+  // escape the provisional analysis and poison later diagnostics.
+  static_assert(requires(R &Range) { Range.begin(); });
+  return 0;
+}
+void unavailableConstBody() {
+  MutableRange Range;
+  (void)(Range | Adaptor{});
+}
+void laterReadOnlyValue() {
+  // CHECK-MESSAGES: :[[@LINE+1]]:3: warning: variable 'Value' of type 'int' can be declared 'const'
+  int Value = 42;
+  (void)Value;
+}
+} // namespace deduced_return
diff --git a/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-ranges.cpp b/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-ranges.cpp
index df1817ad4..55b2e84f4 100644
--- a/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-ranges.cpp
+++ b/clang-tools-extra/test/clang-tidy/checkers/misc/const-correctness-cxx20-ranges.cpp
@@ -1,9 +1,7 @@
-// A variable fed into a ranges pipeline (operator|) forwards the range by
-// reference into constrained adaptor templates, so declaring it 'const'
-// propagates into adaptors whose begin() is non-const (filter, drop_while,
-// chunk_by, split) and the code stops compiling. Such a variable must not be
-// suggested as 'const' even though the mutation analyzer cannot see the
-// forwarding. A range that is only iterated directly keeps the suggestion.
+// A declared forwarding pipe without a visible body can require a mutable
+// reference. This range exposes only mutable iteration; direct iteration must
+// not receive a const suggestion either. Viable const pipes and constrained
+// const iteration are covered in const-correctness-cxx20-range-constraints.cpp.
 //
 // RUN: %check_clang_tidy %s misc-const-correctness %t --
 
