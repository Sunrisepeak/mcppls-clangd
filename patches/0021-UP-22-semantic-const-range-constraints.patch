+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/ScopeExit.h"
 #include <cassert>
 
 using namespace clang::ast_matchers;
@@ -227,35 +232,118 @@ namespace {
 /// Classify for a variable in what the Const-Check is interested.
 enum class VariableCategory { Value, Reference, Pointer };
 
-/// Whether the variable flows into a ranges pipeline through operator|.
-/// The pipeline forwards the range by reference, so declaring the variable
-/// 'const' propagates into every downstream adaptor - where adaptors with
-/// caching iteration (filter, drop_while, chunk_by, split) only support
-/// non-const begin() and the code stops compiling. The mutation analyzer
-/// cannot see this: the pipe's parameter is a forwarding reference inside
-/// constrained templates, which no concrete non-const-reference parameter
-/// matches.
-template <typename T>
-ast_matchers::internal::Matcher<T>
-findFirst(const ast_matchers::internal::Matcher<T> &Matcher) {
-  return anyOf(Matcher, hasDescendant(Matcher));
-}
-
-bool isFedIntoRangesPipeline(const VarDecl *Variable, const Stmt *Scope,
-                             ASTContext *Context) {
-  // The pipe appears either as an overloaded-operator node or, depending on
-  // the standard library, as a plain call of a function named operator|.
-  const auto AsOperatorCall = cxxOperatorCallExpr(
-      hasAnyOperatorName("|"),
-      hasAnyArgument(declRefExpr(to(decl(equalsNode(Variable))))));
-  const auto AsPlainPipeCall = callExpr(
-      hasAnyArgument(declRefExpr(to(decl(equalsNode(Variable))))),
-      callee(functionDecl(hasName("operator|"))));
-  return !match(traverse(TK_AsIs,
-                         findFirst(
-                             stmt(anyOf(AsOperatorCall, AsPlainPipeCall)))),
-                *Scope, *Context)
-              .empty();
+/// Mutation analysis follows the instantiated program, but adding const can
+/// invalidate constraints that were satisfied by its non-const argument. Probe
+/// only actual range consumption, using the same semantic analysis as parsing.
+/// These provisional expressions are not inserted into the user's AST.
+bool requiresMutableRange(const VarDecl *Variable, const Stmt *Scope,
+                          ASTContext &Context, Sema *SemanticAnalysis) {
+  if (!SemanticAnalysis || !Variable->getType()->isRecordType())
+    return false;
+
+  const auto Reference =
+      ignoringParenImpCasts(declRefExpr(to(varDecl(equalsNode(Variable)))));
+  const auto Uses =
+      match(traverse(TK_AsIs,
+                     findAll(stmt(anyOf(
+                         cxxForRangeStmt(hasRangeInit(Reference)).bind("loop"),
+                         callExpr(callee(functionDecl(hasName("operator|"))),
+                                  hasAnyArgument(Reference))
+                             .bind("pipe"))))),
+            *Scope, Context);
+  for (const auto &Use : Uses) {
+    Sema &S = *SemanticAnalysis;
+    Sema::ContextRAII RestoreContext(
+        S, const_cast<DeclContext *>(Variable->getDeclContext()));
+    EnterExpressionEvaluationContext Unevaluated(
+        S, Sema::ExpressionEvaluationContext::Unevaluated);
+    Sema::TentativeAnalysisScope Tentative(S);
+    // A deduced return type can instantiate a body, whose diagnostics are
+    // outside the immediate SFINAE context. No provisional failure is a
+    // diagnostic in the original program.
+    DiagnosticsEngine &Diagnostics = S.getDiagnostics();
+    bool PreviouslySuppressed = Diagnostics.getSuppressAllDiagnostics();
+    Diagnostics.setSuppressAllDiagnostics(true);
+    DiagnosticErrorTrap ProbeErrors(Diagnostics);
+    llvm::scope_exit RestoreDiagnostics(
+        [&] { Diagnostics.setSuppressAllDiagnostics(PreviouslySuppressed); });
+    QualType ConstType = Context.getConstType(Variable->getType());
+    auto *ConstValue = new (Context)
+        OpaqueValueExpr(Variable->getLocation(), ConstType, VK_LValue);
+
+    if (const auto *Loop = Use.getNodeAs<CXXForRangeStmt>("loop")) {
+      // The range-for member lookup is selected only if both member names
+      // exist. ADL-only ranges remain the mutation analyzer's responsibility.
+      const auto *Record = Variable->getType()->getAsCXXRecordDecl();
+      auto HasMember = [&](StringRef Name) {
+        return !Record->lookup(&Context.Idents.get(Name)).empty();
+      };
+      if (!HasMember("begin") || !HasMember("end"))
+        continue;
+      for (StringRef Name : {"begin", "end"}) {
+        CXXScopeSpec SS;
+        auto Member = S.BuildMemberReferenceExpr(
+            ConstValue, ConstType, Loop->getBeginLoc(), false, SS,
+            SourceLocation(), nullptr,
+            DeclarationNameInfo(&Context.Idents.get(Name), Loop->getBeginLoc()),
+            nullptr, nullptr);
+        if (Member.isInvalid() ||
+            S.BuildCallExpr(nullptr, Member.get(), Loop->getBeginLoc(), {},
+                            Loop->getEndLoc())
+                .isInvalid() ||
+            ProbeErrors.hasErrorOccurred())
+          return true;
+      }
+    } else if (const auto *Pipe = Use.getNodeAs<CallExpr>("pipe")) {
+      const FunctionDecl *Function = Pipe->getDirectCallee();
+      // Member operators have an implicit object rather than an ordinary
+      // function argument; do not reconstruct them as free function calls.
+      if (!Function || isa<CXXMethodDecl>(Function))
+        continue;
+      UnresolvedSet<4> Candidates;
+      for (NamedDecl *Candidate :
+           Function->getDeclContext()->lookup(Function->getDeclName()))
+        Candidates.addDecl(Candidate);
+      // Hidden friends may not appear in ordinary lookup. Keep the original
+      // function/template as a candidate and let ADL find its peers.
+      NamedDecl *Original = Function->getPrimaryTemplate();
+      if (!Original)
+        Original = const_cast<FunctionDecl *>(Function);
+      Candidates.addDecl(Original);
+      const auto *OriginalCallee =
+          dyn_cast<DeclRefExpr>(Pipe->getCallee()->IgnoreParenImpCasts());
+      TemplateArgumentListInfo TemplateArgs;
+      if (OriginalCallee && OriginalCallee->hasExplicitTemplateArgs())
+        OriginalCallee->copyTemplateArgumentsInto(TemplateArgs);
+      bool RequiresADL = isa<CXXOperatorCallExpr>(Pipe) ||
+                         (OriginalCallee && !OriginalCallee->hasQualifier());
+      Expr *Callee = UnresolvedLookupExpr::Create(
+          Context, nullptr,
+          OriginalCallee ? OriginalCallee->getQualifierLoc()
+                         : NestedNameSpecifierLoc(),
+          SourceLocation(),
+          DeclarationNameInfo(Function->getDeclName(), Pipe->getExprLoc()),
+          RequiresADL,
+          OriginalCallee && OriginalCallee->hasExplicitTemplateArgs()
+              ? &TemplateArgs
+              : nullptr,
+          Candidates.begin(), Candidates.end(), false, false);
+      SmallVector<Expr *, 2> Arguments;
+      for (const Expr *Argument : Pipe->arguments()) {
+        const Expr *Bare = Argument->IgnoreParenImpCasts();
+        const auto *Ref = dyn_cast<DeclRefExpr>(Bare);
+        Arguments.push_back(Ref && Ref->getDecl() == Variable
+                                ? ConstValue
+                                : const_cast<Expr *>(Bare));
+      }
+      if (S.BuildCallExpr(nullptr, Callee, Pipe->getExprLoc(), Arguments,
+                          Pipe->getEndLoc())
+              .isInvalid() ||
+          ProbeErrors.hasErrorOccurred())
+        return true;
+    }
+  }
+  return false;
 }
 
 } // namespace
@@ -300,7 +388,7 @@ void ConstCorrectnessCheck::check(const MatchFinder::MatchResult &Result) {
     // Offload const-analysis to utility function.
     if (isMutated(Variable, LocalScope, Function, Result.Context))
       return;
-    if (isFedIntoRangesPipeline(Variable, LocalScope, Result.Context))
+    if (requiresMutableRange(Variable, LocalScope, *Result.Context, getSema()))
       return;
 
     auto Diag = diag(Variable->getBeginLoc(),
