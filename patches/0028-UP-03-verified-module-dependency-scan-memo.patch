+                        "#else\nimport M;\n#endif\n");
+  auto Generation = CDB.toolingCDB();
+  auto Cache = createProjectModulesCommandCache(Generation, true);
+  const auto Source = getFullPath("M.cppm");
+  {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+    EXPECT_EQ(Modules->getModuleNameForSource(Source), "Root");
+    EXPECT_THAT(Modules->getRequiredModules(Source), testing::ElementsAre("M"));
+  }
+  auto Before = getModuleDependencyScanCache().stats();
+  {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+    // globalScan sees a memo hit, and must still populate this facade's map.
+    EXPECT_EQ(Modules->getSourceForModuleName("Root", Source), Source);
+  }
+  EXPECT_GT(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+    Modules->setCommandMangler([](tooling::CompileCommand &Cmd, PathRef) {
+      Cmd.CommandLine.push_back("-DNEXT");
+    });
+    EXPECT_THAT(Modules->getRequiredModules(Source), testing::ElementsAre("N"));
+    EXPECT_EQ(Modules->getSourceForModuleName("Root", Source), Source);
+  }
+  // The Linux host does not make cross-target native discovery observable.
+  Before = getModuleDependencyScanCache().stats();
+  for (unsigned I = 0; I != 2; ++I) {
+    auto Modules = clang::clangd::getProjectModules(Generation, FS, Cache);
+    Modules->setCommandMangler([](tooling::CompileCommand &Cmd, PathRef) {
+      Cmd.CommandLine.push_back("--target=x86_64-pc-windows-msvc");
+    });
+    EXPECT_EQ(Modules->getModuleNameForSource(Source), "Root");
+  }
+  EXPECT_EQ(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+  // Callers without proof of original response-file provenance never share
+  // scan results, even if their now-expanded command happens to match.
+  auto UnknownInputs = createProjectModulesCommandCache(Generation);
+  Before = getModuleDependencyScanCache().stats();
+  for (unsigned I = 0; I != 2; ++I) {
+    auto Modules =
+        clang::clangd::getProjectModules(Generation, FS, UnknownInputs);
+    EXPECT_EQ(Modules->getModuleNameForSource(Source), "Root");
+  }
+  EXPECT_EQ(getModuleDependencyScanCache().stats().Hits, Before.Hits);
+}
