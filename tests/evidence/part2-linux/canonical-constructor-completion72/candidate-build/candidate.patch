+TEST_F(PrerequisiteModulesTests, ConstructorsFromSharedHeaderModulesAreUnique) {
+  VerifiedScanCompilationDatabase CDB(TestDir, FS);
+  CDB.addFile("Shared.hpp", R"cpp(
+    #pragma once
+    template <typename T> struct SharedBox {
+      SharedBox();
+      SharedBox(int value);
+      template <typename U> SharedBox(U *value);
+    };
+  )cpp");
+  for (auto Name : {"First", "Second"}) {
+    CDB.addFile(std::string(Name) + ".cppm",
+                std::string("module;\n#include \"Shared.hpp\"\nexport module ") +
+                    Name + ";\nexport namespace api { using ::SharedBox; }\n");
+  }
+  Annotations Use(R"cpp(
+    #include "Shared.hpp"
+    import First;
+    import Second;
+    void use() { api::Shared^ }
+  )cpp");
+  CDB.addFile("Use.cpp", Use.code());
+  ModulesBuilder Builder(CDB);
+  auto Inputs = getInputs("Use.cpp", CDB);
+  Inputs.ModulesManager = &Builder;
+  auto CI = buildCompilerInvocation(Inputs, DiagConsumer);
+  ASSERT_TRUE(CI);
+  auto Preamble = buildPreamble(getFullPath("Use.cpp"), *CI, Inputs, true, nullptr);
+  ASSERT_TRUE(Preamble);
+  ASSERT_TRUE(Preamble->RequiredModules);
+  HeaderSearchOptions Modules(TestDir);
+  Preamble->RequiredModules->adjustHeaderSearchOptions(Modules);
+  ASSERT_EQ(Modules.PrebuiltModuleFiles.count("First"), 1u);
+  ASSERT_EQ(Modules.PrebuiltModuleFiles.count("Second"), 1u);
+  CodeCompleteOptions Opts;
+  Opts.BundleOverloads = false;
+  Opts.Limit = 0;
+  auto Results = codeComplete(getFullPath("Use.cpp"), Use.point(), Preamble.get(),
+                              Inputs, Opts);
+  std::vector<std::string> Signatures;
+  for (const auto &Result : Results.Completions)
+    if (Result.Name == "SharedBox" &&
+        Result.Kind == CompletionItemKind::Constructor)
+      Signatures.push_back(Result.Signature);
+  EXPECT_THAT(Signatures, testing::UnorderedElementsAre(
+                              "<typename T>()", "<typename T>(int value)",
+                              "<typename T>(U *value)"));
+}
