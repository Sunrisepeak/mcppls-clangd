{
  "name": "part2-final70-product-completion",
  "description": "Fixed inferred module project and product binary. Direct same-engine edited completions and product repeats. Repeated unchanged requests measure warm latency, not proof of a product answer-cache hit. Existing direct runner uses another engine while product is idle: controlled product comparison, never exclusive raw-engine qualification.",
  "server-arguments": [
    "--no-discover"
  ],
  "checks": [
    {
      "id": "P-status",
      "kind": "status",
      "source": "inferred",
      "profile-kind": "semantic-kit",
      "state": "ready",
      "engine-name": "clangd"
    },
    {
      "id": "P-diagnostics",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "P-vector",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ],
      "expect": "vector"
    },
    {
      "id": "P-edited-against-direct",
      "kind": "completion-baseline",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ],
      "rounds": 30,
      "interval-ms": 150,
      "edit": true,
      "baseline-arguments": [
        "--experimental-modules-support",
        "--use-dirty-headers",
        "--compile-commands-dir={engine-database}",
        "--background-index",
        "--background-index-priority=background",
        "--header-insertion=never",
        "--pretty=false",
        "--log=info"
      ],
      "budget": {
        "ratio": 1.3,
        "slackMs": 30,
        "engineShare": 1.0,
        "maxEmpty": 0
      }
    },
    {
      "id": "P-warm-unchanged",
      "kind": "latency",
      "phase": "idle",
      "rounds": 30,
      "interval-ms": 150,
      "requests": [
        {
          "name": "std-vector",
          "kind": "completion",
          "file": "src/main.cpp",
          "at": [
            4,
            11
          ],
          "expect": "vector"
        }
      ],
      "budget": {
        "completion.p95": 0.2,
        "engineShare": 1.0,
        "maxEmptyShare": 0,
        "wrong": 0,
        "timeouts": 0
      }
    }
  ]
}
