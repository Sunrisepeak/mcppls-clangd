{
  "id": "UP-12-galtranslpp-unresolved-imports",
  "platform": "win32-x64",
  "project": "up12-galtranslpp",
  "baseline": "crash",
  "timeout_seconds": 60,
  "flags": [
    "--experimental-modules-support",
    "--background-index=false",
    "-j=2"
  ],
  "qualification": "candidate; native normalized baseline not verified",
  "sequence": [
    {
      "method": "initialize",
      "params": {
        "rootUri": "${PROJECT_URI}",
        "capabilities": {}
      }
    },
    {
      "method": "initialized",
      "notify": true,
      "params": {}
    },
    {
      "method": "workspace/didChangeConfiguration",
      "notify": true,
      "params": {
        "settings": {
          "compilationDatabaseChanges": {
            "${PROJECT_PATH}/GPPDefines.ixx": {
              "workingDirectory": "${PROJECT_PATH}",
              "compilationCommand": [
                "clang++",
                "--target=x86_64-pc-windows-msvc",
                "-std=c++23",
                "-O3",
                "-g",
                "-flto",
                "-x",
                "c++-module",
                "${PROJECT_PATH}/GPPDefines.ixx"
              ]
            }
          }
        }
      }
    },
    {
      "method": "textDocument/didOpen",
      "notify": true,
      "params": {
        "textDocument": {
          "uri": "${PROJECT_URI}/GPPDefines.ixx",
          "languageId": "cpp",
          "version": 1,
          "text": "${FILE_TEXT:GPPDefines.ixx}"
        }
      }
    },
    {
      "method": "textDocument/documentSymbol",
      "params": {
        "textDocument": {
          "uri": "${PROJECT_URI}/GPPDefines.ixx"
        }
      },
      "expect": {
        "/result/14/name": "NameType",
        "/result/14/kind": 10
      }
    }
  ]
}
