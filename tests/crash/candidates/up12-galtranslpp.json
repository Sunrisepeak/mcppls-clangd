{
  "id": "UP-12-galtranslpp-unresolved-imports",
  "platform": "win32-x64",
  "project": "up12-galtranslpp",
  "baseline": "crash",
  "timeout_seconds": 60,
  "flags": [
    "--experimental-modules-support",
    "--background-index=false",
    "-j=2"
  ],
  "qualification": "candidate; native normalized baseline not verified",
  "sequence": [
    {
      "method": "initialize",
      "params": {
        "rootUri": "${PROJECT_URI}",
        "capabilities": {}
      }
    },
    {
      "method": "initialized",
      "notify": true,
      "params": {}
    },
    {
      "action": "write-file",
      "file": "compile_commands.json",
      "contents": "[\n  {\n    \"directory\": \"${PROJECT_PATH}\",\n    \"file\": \"${PROJECT_PATH}/GPPDefines.ixx\",\n    \"arguments\": [\n      \"clang++\",\n      \"--target=x86_64-pc-windows-msvc\",\n      \"-std=c++23\",\n      \"-O3\",\n      \"-g\",\n      \"-flto\",\n      \"-x\",\n      \"c++-module\",\n      \"${PROJECT_PATH}/GPPDefines.ixx\"\n    ]\n  }\n]"
    },
    {
      "method": "textDocument/didOpen",
      "notify": true,
      "params": {
        "textDocument": {
          "uri": "${PROJECT_URI}/GPPDefines.ixx",
          "languageId": "cpp",
          "version": 1,
          "text": "${FILE_TEXT:GPPDefines.ixx}"
        }
      }
    },
    {
      "method": "textDocument/documentSymbol",
      "params": {
        "textDocument": {
          "uri": "${PROJECT_URI}/GPPDefines.ixx"
        }
      },
      "expect": {
        "/result/14/name": "NameType",
        "/result/14/kind": 10
      }
    }
  ]
}
